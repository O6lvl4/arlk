// Natural numbers with addition defined by rewrite rules. Computation
// happens inside the kernel: refl proves 2 + 2 = 4 because both sides
// rewrite to the same numeral.

room logic
symbol Prop: Type
symbol Prf(p: Prop) -> Type

room nat uses logic

symbol Nat: Type
symbol zero: Nat
symbol succ(n: Nat) -> Nat

symbol plus(m: Nat, n: Nat) -> Nat
rule plus(zero, n) = n  where n: Nat
rule plus(succ(m), n) = succ(plus(m, n))  where m: Nat, n: Nat

symbol mult(m: Nat, n: Nat) -> Nat
rule mult(zero, n) = zero  where n: Nat
rule mult(succ(m), n) = plus(n, mult(m, n))  where m: Nat, n: Nat

symbol eq(m: Nat, n: Nat) -> Prop
symbol refl(n: Nat) -> Prf(eq(n, n))

def two: Nat = succ(succ(zero))
def four: Nat = succ(succ(two))

eval plus(two, two)
eval mult(two, succ(two))

theorem two_plus_two: Prf(eq(plus(two, two), four)) = refl(four)

theorem two_times_two: Prf(eq(mult(two, two), plus(two, two))) = refl(four)

axioms two_times_two
