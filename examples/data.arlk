// Inductive types, defined and checked by Arlk itself: the recursors and
// their computation rules are generated, then checked by the kernel.
// Implicit parameters (in [...], like Almide's generics) and universe
// levels are inferred. `match` compiles to the recursor (structural
// recursion), and a theorem proved by `match` is a proof by induction.

room data

type Nat: Type =
  | zero
  | succ(n: Nat)

def add(m: Nat, n: Nat) -> Nat = match n {
  zero => m,
  succ(k) => Nat.succ(add(m, k)),
}

def one: Nat = Nat.succ(Nat.zero)
def two: Nat = Nat.succ(one)

eval add(one, two)

type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
  | refl: Eq(A, a, a)

// The kernel computes 1 + 1, so reflexivity proves it equals 2.
theorem one_plus_one: Eq(Nat, add(one, one), two) = Eq.refl

def cong[u, v, A: Sort(u), B: Sort(v)](f: A -> B, x: A, y: A, h: Eq(A, x, y)) -> Eq(B, f(x), f(y)) =
  Eq.rec((y': A, e: Eq(A, x, y')) => Eq(B, f(x), f(y')), Eq.refl, y, h)

// 0 + n = n does not compute (add recurses on its second argument): it
// needs induction on n.
theorem zero_add(n: Nat) -> Eq(Nat, add(Nat.zero, n), n) = match n {
  zero => Eq.refl,
  succ(k) => cong(Nat.succ, add(Nat.zero, k), k, zero_add(k)),
}

type List[u](A: Type(u)): Type(u) =
  | nil
  | cons(head: A, tail: List(A))

def length[u, A: Type(u)](xs: List(A)) -> Nat = match xs {
  nil => Nat.zero,
  cons(h, t) => Nat.succ(length(t)),
}

def map[u, v, A: Type(u), B: Type(v)](f: A -> B, xs: List(A)) -> List(B) = match xs {
  nil => List.nil,
  cons(h, t) => List.cons(f(h), map(f, t)),
}

def numbers: List(Nat) = List.cons(Nat.zero, List.cons(one, List.nil))

eval map(Nat.succ, numbers)
theorem map_keeps_length: Eq(_, length(map(Nat.succ, numbers)), length(numbers)) = Eq.refl

// Families indexed by a value: vectors know their length.
type Vec[u](A: Type(u)): (n: Nat) -> Type(u) =
  | vnil: Vec(A, Nat.zero)
  | vcons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Nat.succ(n))

def pair: Vec(Nat, two) = Vec.vcons(one, Nat.zero, Vec.vcons(Nat.zero, one, Vec.vnil))

// Records, like Almide's: fields, `p.x`, `Point { x: ..., y: ... }`.
type Point = { x: Nat, y: Nat }

def swap(p: Point) -> Point = Point { x: p.y, y: p.x }
def corner: Point = Point { x: Nat.zero, y: two }

theorem swap_corner: Eq(Nat, swap(corner).x, two) = Eq.refl

// A field's type may depend on an earlier field.
type Sigma[u, v](A: Type(u), B: A -> Type(v)): Type(max(u, v)) = { fst: A, snd: B(fst) }

def sized: Sigma(Nat, (n: Nat) => Vec(Nat, n)) = Sigma { fst: two, snd: pair }

// Propositions: Or eliminates only into Prop, And and False anywhere.
type Or(a: Sort(0), b: Sort(0)): Sort(0) =
  | inl(h: a)
  | inr(h: b)

type And(a: Sort(0), b: Sort(0)): Sort(0) =
  | intro(left: a, right: b)

type False: Sort(0) =

theorem and_swap(a: Sort(0), b: Sort(0), h: And(a, b)) -> And(b, a) =
  And.rec((x: And(a, b)) => And(b, a), (l: a, r: b) => And.intro(r, l), h)

theorem or_swap(a: Sort(0), b: Sort(0), h: Or(a, b)) -> Or(b, a) =
  Or.rec((x: Or(a, b)) => Or(b, a), (l: a) => Or.inr(l), (r: b) => Or.inl(r), h)

def explode[u](A: Sort(u), h: False) -> A = False.rec((x: False) => A, h)

axioms zero_add
