room almide_batch uses almide

// batch.almd:11-11  type Item
type Item: Type =
  | Red
  | Green
  | Blue

// batch.almd:6-9  fn flush
def flush[A: Type](pending: List(A), ready: List(A)) -> List(A) = match pending {
  nil => ready,
  cons(h, t) => flush(t, append(List.cons(h, List.nil), ready)),
}
