// A list reverse, written in the subset of Almide that Arlk models
// (docs/ALMIDE_SUBSET.md). `arlk absorb-almide` turns the pure functions
// below into Arlk definitions; examples/almide/reverse_proof.arlk proves
// that reverse keeps the length of every list.

type Color =
  | Red
  | Green
  | Blue

fn reverse[A](xs: List[A]) -> List[A] = match xs {
  [] => [],
  [h, ..t] => reverse(t) + [h],
}

// Outside the model (an effect): used to compare the model with the
// compiled program on examples.
effect fn main() -> Unit = {
  let shown = reverse([Red, Green, Blue, Blue]) |> list.map((c) => match c {
    Red => "Red",
    Green => "Green",
    Blue => "Blue",
  })
  println(list.join(shown, " "))
}
