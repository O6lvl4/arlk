room almide_reverse uses almide

// reverse.almd:6-9  type Color
type Color: Type =
  | Red
  | Green
  | Blue

// reverse.almd:11-14  fn reverse
def reverse[A: Type](xs: List(A)) -> List(A) = match xs {
  nil => List.nil,
  cons(h, t) => append(reverse(t), List.cons(h, List.nil)),
}
