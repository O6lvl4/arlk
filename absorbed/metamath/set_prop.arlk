theorem expdcom(ph: wff, ps: wff, ch: wff, th: wff, expd_1: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(ps, wi(ch, wi(ph, th)))) =
  ex(ps, ch, wi(ph, th), com12(ph, wa(ps, ch), th, expd_1))
theorem expd(ph: wff, ps: wff, ch: wff, th: wff, expd_1: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(ph, wi(ps, wi(ch, th)))) =
