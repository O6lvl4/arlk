  anbi1d(wb(ph, ps), ph, ps, ch, id(wb(ph, ps)))
theorem anbi2(ph: wff, ps: wff, ch: wff) -> Prf(wi(wb(ph, ps), wb(wa(ch, ph), wa(ch, ps)))) =
