  impbii(wa(wa(ph, ps), ch), wa(ph, wa(ps, ch)), anassrs(ph, ps, ch, wa(ph, wa(ps, ch)), id(wa(ph, wa(ps, ch)))), anasss(ph, ps, ch, wa(wa(ph, ps), ch), id(wa(wa(ph, ps), ch))))
