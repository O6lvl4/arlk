theorem imp4c(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, imp4_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, ta)))))) -> Prf(wi(ph, wi(wa(wa(ps, ch), th), ta))) =
  impd(ph, wa(ps, ch), th, ta, impd(ph, ps, ch, wi(th, ta), imp4_1))
