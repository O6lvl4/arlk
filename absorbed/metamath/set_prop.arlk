theorem rb_imdf(ph: wff, ps: wff) -> Prf(wn(wo(wn(wo(wn(wi(ph, ps)), wo(wn(ph), ps))), wn(wo(wn(wo(wn(ph), ps)), wi(ph, ps)))))) =
  mpbi(wb(wi(ph, ps), wo(wn(ph), ps)), wn(wo(wn(wo(wn(wi(ph, ps)), wo(wn(ph), ps))), wn(wo(wn(wo(wn(ph), ps)), wi(ph, ps))))), imor(ph, ps), rb_bijust(wi(ph, ps), wo(wn(ph), ps)))
theorem anmp(ph: wff, ps: wff, anmp_min: Prf(ph), anmp_maj: Prf(wo(wn(ph), ps))) -> Prf(ps) =
  ax_mp(ph, ps, anmp_min, imorri(ph, ps, anmp_maj))
theorem rb_ax1(ph: wff, ps: wff, ch: wff) -> Prf(wo(wn(wo(wn(ps), ch)), wo(wn(wo(ph, ps)), wo(ph, ch)))) =
  imori(wo(wn(ps), ch), wo(wn(wo(ph, ps)), wo(ph, ch)), 3imtr3i(wi(ps, ch), wi(wo(ph, ps), wo(ph, ch)), wo(wn(ps), ch), wo(wn(wo(ph, ps)), wo(ph, ch)), orim2(ph, ps, ch), imor(ps, ch), imor(wo(ph, ps), wo(ph, ch))))
theorem rb_ax2(ph: wff, ps: wff) -> Prf(wo(wn(wo(ph, ps)), wo(ps, ph))) =
  orri(wn(wo(ph, ps)), wo(ps, ph), con1i(wo(ps, ph), wn(wo(ph, ps)), con3i(wo(ph, ps), wo(ps, ph), pm1.4(ph, ps))))
theorem rb_ax3(ph: wff, ps: wff) -> Prf(wo(wn(ph), wo(ps, ph))) =
  orri(wn(ph), wo(ps, ph), con1i(wo(ps, ph), wn(ph), pm2.46(ps, ph)))
theorem rb_ax4(ph: wff) -> Prf(wo(wn(wo(ph, ph)), ph)) =
  orri(wn(wo(ph, ph)), ph, con1i(ph, wn(wo(ph, ph)), con3i(wo(ph, ph), ph, pm1.2(ph))))
theorem rbsyl(ph: wff, ps: wff, ch: wff, rbsyl_1: Prf(wo(wn(ps), ch)), rbsyl_2: Prf(wo(ph, ps))) -> Prf(wo(ph, ch)) =
  anmp(wo(ph, ps), wo(ph, ch), rbsyl_2, anmp(wo(wn(ps), ch), wo(wn(wo(ph, ps)), wo(ph, ch)), rbsyl_1, rb_ax1(ph, ps, ch)))
theorem rblem1(ph: wff, ps: wff, ch: wff, th: wff, rblem1_1: Prf(wo(wn(ph), ps)), rblem1_2: Prf(wo(wn(ch), th))) -> Prf(wo(wn(wo(ph, ch)), wo(ps, th))) =
  rbsyl(wn(wo(ph, ch)), wo(ps, ch), wo(ps, th), anmp(wo(wn(ch), th), wo(wn(wo(ps, ch)), wo(ps, th)), rblem1_2, rb_ax1(ps, ch, th)), rbsyl(wn(wo(ph, ch)), wo(ch, ps), wo(ps, ch), rb_ax2(ch, ps), rbsyl(wn(wo(ph, ch)), wo(ch, ph), wo(ch, ps), anmp(wo(wn(ph), ps), wo(wn(wo(ch, ph)), wo(ch, ps)), rblem1_1, rb_ax1(ch, ph, ps)), rb_ax2(ph, ch))))
theorem rblem2(ph: wff, ps: wff, ch: wff) -> Prf(wo(wn(wo(ch, ph)), wo(ch, wo(ph, ps)))) =
  anmp(wo(wn(ph), wo(ph, ps)), wo(wn(wo(ch, ph)), wo(ch, wo(ph, ps))), rbsyl(wn(ph), wo(ps, ph), wo(ph, ps), rb_ax2(ps, ph), rb_ax3(ph, ps)), rb_ax1(ch, ph, wo(ph, ps)))
theorem rblem3(ph: wff, ps: wff, ch: wff) -> Prf(wo(wn(wo(ch, ph)), wo(wo(ch, ps), ph))) =
  rbsyl(wn(wo(ch, ph)), wo(ph, wo(ch, ps)), wo(wo(ch, ps), ph), rb_ax2(ph, wo(ch, ps)), rbsyl(wn(wo(ch, ph)), wo(ph, ch), wo(ph, wo(ch, ps)), rblem2(ch, ps, ph), rb_ax2(ch, ph)))
theorem rblem4(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, rblem4_1: Prf(wo(wn(ph), th)), rblem4_2: Prf(wo(wn(ps), ta)), rblem4_3: Prf(wo(wn(ch), et))) -> Prf(wo(wn(wo(wo(ph, ps), ch)), wo(wo(et, ta), th))) =
  rbsyl(wn(wo(wo(ph, ps), ch)), wo(wo(ch, ps), ph), wo(wo(et, ta), th), rblem1(wo(ch, ps), wo(et, ta), ph, th, rblem1(ch, et, ps, ta, rblem4_3, rblem4_2), rblem4_1), rbsyl(wn(wo(wo(ph, ps), ch)), wo(wo(ps, ch), ph), wo(wo(ch, ps), ph), rbsyl(wn(wo(wo(ps, ch), ph)), wo(ph, wo(ch, ps)), wo(wo(ch, ps), ph), rb_ax2(ph, wo(ch, ps)), rbsyl(wn(wo(wo(ps, ch), ph)), wo(ph, wo(ps, ch)), wo(ph, wo(ch, ps)), anmp(wo(wn(wo(ps, ch)), wo(ch, ps)), wo(wn(wo(ph, wo(ps, ch))), wo(ph, wo(ch, ps))), rb_ax2(ps, ch), rb_ax1(ph, wo(ps, ch), wo(ch, ps))), rb_ax2(wo(ps, ch), ph))), rbsyl(wn(wo(wo(ph, ps), ch)), wo(wo(wo(ps, ch), ph), wo(wo(ps, ch), ph)), wo(wo(ps, ch), ph), rb_ax4(wo(wo(ps, ch), ph)), rblem1(wo(ph, ps), wo(wo(ps, ch), ph), ch, wo(wo(ps, ch), ph), rbsyl(wn(wo(ph, ps)), wo(ph, wo(ps, ch)), wo(wo(ps, ch), ph), rb_ax2(ph, wo(ps, ch)), rblem2(ps, ch, ph)), anmp(wo(wn(ch), wo(ps, ch)), wo(wn(ch), wo(wo(ps, ch), ph)), rb_ax3(ch, ps), rblem2(wo(ps, ch), ph, wn(ch)))))))
theorem rblem5(ph: wff, ps: wff) -> Prf(wo(wn(wo(wn(wn(ph)), ps)), wo(wn(wn(ps)), ph))) =
  rbsyl(wn(wo(wn(wn(ph)), ps)), wo(ph, wn(wn(ps))), wo(wn(wn(ps)), ph), rb_ax2(ph, wn(wn(ps))), rblem1(wn(wn(ph)), ph, ps, wn(wn(ps)), anmp(wo(wn(ph), ph), wo(wn(wn(wn(ph))), ph), rbsyl(wn(ph), wo(ph, ph), ph, rb_ax4(ph), rb_ax3(ph, ph)), rblem1(wn(ph), wn(wn(wn(ph))), ph, ph, anmp(wo(wn(wn(wn(ph))), wn(wn(ph))), wo(wn(wn(ph)), wn(wn(wn(ph)))), rbsyl(wn(wn(wn(ph))), wo(wn(wn(ph)), wn(wn(ph))), wn(wn(ph)), rb_ax4(wn(wn(ph))), rb_ax3(wn(wn(ph)), wn(wn(ph)))), rb_ax2(wn(wn(wn(ph))), wn(wn(ph)))), rbsyl(wn(ph), wo(ph, ph), ph, rb_ax4(ph), rb_ax3(ph, ph)))), anmp(wo(wn(wn(ps)), wn(ps)), wo(wn(ps), wn(wn(ps))), rbsyl(wn(wn(ps)), wo(wn(ps), wn(ps)), wn(ps), rb_ax4(wn(ps)), rb_ax3(wn(ps), wn(ps))), rb_ax2(wn(wn(ps)), wn(ps)))))
theorem rblem6(ph: wff, ps: wff, rblem6_1: Prf(wn(wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph)))))) -> Prf(wo(wn(ph), ps)) =
  anmp(wn(wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph)))), wo(wn(ph), ps), rblem6_1, anmp(wo(wn(wn(wo(wn(ph), ps))), wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph)))), wo(wn(wn(wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph))))), wo(wn(ph), ps)), anmp(wo(wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph))), wn(wn(wo(wn(ph), ps)))), wo(wn(wn(wo(wn(ph), ps))), wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph)))), anmp(wo(wn(wo(wn(ph), ps)), wn(wn(wo(wn(ph), ps)))), wo(wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph))), wn(wn(wo(wn(ph), ps)))), anmp(wo(wn(wn(wo(wn(ph), ps))), wn(wo(wn(ph), ps))), wo(wn(wo(wn(ph), ps)), wn(wn(wo(wn(ph), ps)))), rbsyl(wn(wn(wo(wn(ph), ps))), wo(wn(wo(wn(ph), ps)), wn(wo(wn(ph), ps))), wn(wo(wn(ph), ps)), rb_ax4(wn(wo(wn(ph), ps))), rb_ax3(wn(wo(wn(ph), ps)), wn(wo(wn(ph), ps)))), rb_ax2(wn(wn(wo(wn(ph), ps))), wn(wo(wn(ph), ps)))), rblem3(wn(wn(wo(wn(ph), ps))), wn(wo(wn(ps), ph)), wn(wo(wn(ph), ps)))), rb_ax2(wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph))), wn(wn(wo(wn(ph), ps))))), rblem5(wo(wn(ph), ps), wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph))))))
theorem rblem7(ph: wff, ps: wff, rblem7_1: Prf(wn(wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph)))))) -> Prf(wo(wn(ps), ph)) =
  anmp(wn(wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph)))), wo(wn(ps), ph), rblem7_1, anmp(wo(wn(wn(wo(wn(ps), ph))), wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph)))), wo(wn(wn(wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph))))), wo(wn(ps), ph)), rb_ax3(wn(wo(wn(ps), ph)), wn(wo(wn(ph), ps))), rblem5(wo(wn(ps), ph), wo(wn(wo(wn(ph), ps)), wn(wo(wn(ps), ph))))))
theorem re1axmp(ph: wff, ps: wff, re1axmp_min: Prf(ph), re1axmp_maj: Prf(wi(ph, ps))) -> Prf(ps) =
  anmp(ph, ps, re1axmp_min, anmp(wi(ph, ps), wo(wn(ph), ps), re1axmp_maj, rblem6(wi(ph, ps), wo(wn(ph), ps), rb_imdf(ph, ps))))
theorem re2luk1(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch)))) =
  {
    let z'1: Prf(wo(wn(wn(wo(wn(ps), ch))), wn(wo(wn(ps), ch)))) = rbsyl(wn(wn(wo(wn(ps), ch))), wo(wn(wo(wn(ps), ch)), wn(wo(wn(ps), ch))), wn(wo(wn(ps), ch)), rb_ax4(wn(wo(wn(ps), ch))), rb_ax3(wn(wo(wn(ps), ch)), wn(wo(wn(ps), ch))))
    anmp(wo(wn(wi(ph, ps)), wi(wi(ps, ch), wi(ph, ch))), wi(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch))), rbsyl(wn(wi(ph, ps)), wo(wn(wi(ps, ch)), wi(ph, ch)), wi(wi(ps, ch), wi(ph, ch)), rblem7(wi(wi(ps, ch), wi(ph, ch)), wo(wn(wi(ps, ch)), wi(ph, ch)), rb_imdf(wi(ps, ch), wi(ph, ch))), rbsyl(wn(wi(ph, ps)), wo(wn(ph), ps), wo(wn(wi(ps, ch)), wi(ph, ch)), rbsyl(wn(wo(wn(ph), ps)), wo(wn(wo(wn(ps), ch)), wo(wn(ph), ch)), wo(wn(wi(ps, ch)), wi(ph, ch)), rblem1(wn(wo(wn(ps), ch)), wn(wi(ps, ch)), wo(wn(ph), ch), wi(ph, ch), anmp(wo(wn(wi(ps, ch)), wo(wn(ps), ch)), wo(wn(wn(wo(wn(ps), ch))), wn(wi(ps, ch))), rblem6(wi(ps, ch), wo(wn(ps), ch), rb_imdf(ps, ch)), rbsyl(wn(wo(wn(wi(ps, ch)), wo(wn(ps), ch))), wo(wn(wi(ps, ch)), wn(wn(wo(wn(ps), ch)))), wo(wn(wn(wo(wn(ps), ch))), wn(wi(ps, ch))), rb_ax2(wn(wi(ps, ch)), wn(wn(wo(wn(ps), ch)))), rblem1(wn(wi(ps, ch)), wn(wi(ps, ch)), wo(wn(ps), ch), wn(wn(wo(wn(ps), ch))), rbsyl(wn(wn(wi(ps, ch))), wo(wn(wi(ps, ch)), wn(wi(ps, ch))), wn(wi(ps, ch)), rb_ax4(wn(wi(ps, ch))), rb_ax3(wn(wi(ps, ch)), wn(wi(ps, ch)))), anmp(wo(wn(wn(wo(wn(ps), ch))), wn(wo(wn(ps), ch))), wo(wn(wo(wn(ps), ch)), wn(wn(wo(wn(ps), ch)))), z'1, rb_ax2(wn(wn(wo(wn(ps), ch))), wn(wo(wn(ps), ch))))))), rblem7(wi(ph, ch), wo(wn(ph), ch), rb_imdf(ph, ch))), anmp(wo(wn(wo(wn(ps), ch)), wo(wn(wo(wn(ph), ps)), wo(wn(ph), ch))), wo(wn(wo(wn(ph), ps)), wo(wn(wo(wn(ps), ch)), wo(wn(ph), ch))), rb_ax1(wn(ph), ps, ch), rbsyl(wn(wo(wn(wo(wn(ps), ch)), wo(wn(wo(wn(ph), ps)), wo(wn(ph), ch)))), wo(wo(wn(wo(wn(ps), ch)), wo(wn(ph), ch)), wn(wo(wn(ph), ps))), wo(wn(wo(wn(ph), ps)), wo(wn(wo(wn(ps), ch)), wo(wn(ph), ch))), rb_ax2(wo(wn(wo(wn(ps), ch)), wo(wn(ph), ch)), wn(wo(wn(ph), ps))), rbsyl(wn(wo(wn(wo(wn(ps), ch)), wo(wn(wo(wn(ph), ps)), wo(wn(ph), ch)))), wo(wo(wn(wo(wn(ph), ps)), wo(wn(ph), ch)), wn(wo(wn(ps), ch))), wo(wo(wn(wo(wn(ps), ch)), wo(wn(ph), ch)), wn(wo(wn(ph), ps))), rblem4(wn(wo(wn(ph), ps)), wo(wn(ph), ch), wn(wo(wn(ps), ch)), wn(wo(wn(ph), ps)), wo(wn(ph), ch), wn(wo(wn(ps), ch)), rbsyl(wn(wn(wo(wn(ph), ps))), wo(wn(wo(wn(ph), ps)), wn(wo(wn(ph), ps))), wn(wo(wn(ph), ps)), rb_ax4(wn(wo(wn(ph), ps))), rb_ax3(wn(wo(wn(ph), ps)), wn(wo(wn(ph), ps)))), rbsyl(wn(wo(wn(ph), ch)), wo(wo(wn(ph), ch), wo(wn(ph), ch)), wo(wn(ph), ch), rb_ax4(wo(wn(ph), ch)), rb_ax3(wo(wn(ph), ch), wo(wn(ph), ch))), z'1), rb_ax2(wn(wo(wn(ps), ch)), wo(wn(wo(wn(ph), ps)), wo(wn(ph), ch))))))), rblem6(wi(ph, ps), wo(wn(ph), ps), rb_imdf(ph, ps)))), rblem7(wi(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch))), wo(wn(wi(ph, ps)), wi(wi(ps, ch), wi(ph, ch))), rb_imdf(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch)))))
  }
theorem re2luk2(ph: wff) -> Prf(wi(wi(wn(ph), ph), ph)) =
  anmp(wo(wn(wi(wn(ph), ph)), ph), wi(wi(wn(ph), ph), ph), rbsyl(wn(wi(wn(ph), ph)), wo(wn(wn(ph)), ph), ph, rbsyl(wn(wo(wn(wn(ph)), ph)), wo(ph, ph), ph, rb_ax4(ph), rblem1(wn(wn(ph)), ph, ph, ph, anmp(wo(wn(ph), ph), wo(wn(wn(wn(ph))), ph), rbsyl(wn(ph), wo(ph, ph), ph, rb_ax4(ph), rb_ax3(ph, ph)), rblem1(wn(ph), wn(wn(wn(ph))), ph, ph, anmp(wo(wn(wn(wn(ph))), wn(wn(ph))), wo(wn(wn(ph)), wn(wn(wn(ph)))), rbsyl(wn(wn(wn(ph))), wo(wn(wn(ph)), wn(wn(ph))), wn(wn(ph)), rb_ax4(wn(wn(ph))), rb_ax3(wn(wn(ph)), wn(wn(ph)))), rb_ax2(wn(wn(wn(ph))), wn(wn(ph)))), rbsyl(wn(ph), wo(ph, ph), ph, rb_ax4(ph), rb_ax3(ph, ph)))), rbsyl(wn(ph), wo(ph, ph), ph, rb_ax4(ph), rb_ax3(ph, ph)))), rblem6(wi(wn(ph), ph), wo(wn(wn(ph)), ph), rb_imdf(wn(ph), ph))), rblem7(wi(wi(wn(ph), ph), ph), wo(wn(wi(wn(ph), ph)), ph), rb_imdf(wi(wn(ph), ph), ph)))
theorem re2luk3(ph: wff, ps: wff) -> Prf(wi(ph, wi(wn(ph), ps))) =
  anmp(wo(wn(ph), wi(wn(ph), ps)), wi(ph, wi(wn(ph), ps)), rbsyl(wn(ph), wo(wn(wn(ph)), ps), wi(wn(ph), ps), rblem7(wi(wn(ph), ps), wo(wn(wn(ph)), ps), rb_imdf(wn(ph), ps)), anmp(wo(wn(ph), wn(wn(ph))), wo(wn(ph), wo(wn(wn(ph)), ps)), anmp(wo(wn(wn(ph)), wn(ph)), wo(wn(ph), wn(wn(ph))), rbsyl(wn(wn(ph)), wo(wn(ph), wn(ph)), wn(ph), rb_ax4(wn(ph)), rb_ax3(wn(ph), wn(ph))), rb_ax2(wn(wn(ph)), wn(ph))), rblem2(wn(wn(ph)), ps, wn(ph)))), rblem7(wi(ph, wi(wn(ph), ps)), wo(wn(ph), wi(wn(ph), ps)), rb_imdf(ph, wi(wn(ph), ps))))
theorem mptnan(ph: wff, ps: wff, mptnan_min: Prf(ph), mptnan_maj: Prf(wn(wa(ph, ps)))) -> Prf(wn(ps)) =
  ax_mp(ph, wn(ps), mptnan_min, imnani(ph, ps, mptnan_maj))
theorem mptxor(ph: wff, ps: wff, mptxor_min: Prf(ph), mptxor_maj: Prf(wxo(ph, ps))) -> Prf(wn(ps)) =
  mptnan(ph, ps, mptxor_min, ax_mp(wxo(ph, ps), wn(wa(ph, ps)), mptxor_maj, xornan(ph, ps)))
theorem mtpor(ph: wff, ps: wff, mtpor_min: Prf(wn(ph)), mtpor_max: Prf(wo(ph, ps))) -> Prf(ps) =
  ax_mp(wn(ph), ps, mtpor_min, ori(ph, ps, mtpor_max))
theorem mtpxor(ph: wff, ps: wff, mtpxor_min: Prf(wn(ph)), mtpxor_maj: Prf(wxo(ph, ps))) -> Prf(ps) =
  mtpor(ph, ps, mtpxor_min, ax_mp(wxo(ph, ps), wo(ph, ps), mtpxor_maj, xoror(ph, ps)))
theorem stoic1a(ph: wff, ps: wff, th: wff, stoic1_1: Prf(wi(wa(ph, ps), th))) -> Prf(wi(wa(ph, wn(th)), wn(ps))) =
  con3dimp(ph, ps, th, ex(ph, ps, th, stoic1_1))
theorem stoic1b(ph: wff, ps: wff, th: wff, stoic1_1: Prf(wi(wa(ph, ps), th))) -> Prf(wi(wa(ps, wn(th)), wn(ph))) =
  stoic1a(ps, ph, th, ancoms(ph, ps, th, stoic1_1))
theorem stoic2a(ph: wff, ps: wff, ch: wff, th: wff, stoic2a_1: Prf(wi(wa(ph, ps), ch)), stoic2a_2: Prf(wi(wa(ph, ch), th))) -> Prf(wi(wa(ph, ps), th)) =
  syldan(ph, ps, ch, th, stoic2a_1, stoic2a_2)
theorem stoic2b(ph: wff, ps: wff, ch: wff, th: wff, stoic2b_1: Prf(wi(wa(ph, ps), ch)), stoic2b_2: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(wa(ph, ps), th)) =
  mpd3an3(ph, ps, ch, th, stoic2b_1, stoic2b_2)
theorem stoic3(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, stoic3_1: Prf(wi(wa(ph, ps), ch)), stoic3_2: Prf(wi(wa(ch, th), ta))) -> Prf(wi(w3a(ph, ps, th), ta)) =
  3impa(ph, ps, th, ta, sylan(wa(ph, ps), ch, th, ta, stoic3_1, stoic3_2))
theorem stoic4a(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, stoic4a_1: Prf(wi(wa(ph, ps), ch)), stoic4a_2: Prf(wi(w3a(ch, ph, th), ta))) -> Prf(wi(w3a(ph, ps, th), ta)) =
  syl3anc(w3a(ph, ps, th), ch, ph, th, ta, 3adant3(ph, ps, ch, th, stoic4a_1), simp1(ph, ps, th), simp3(ph, ps, th), stoic4a_2)
theorem stoic4b(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, stoic4b_1: Prf(wi(wa(ph, ps), ch)), stoic4b_2: Prf(wi(wa(w3a(ch, ph, ps), th), ta))) -> Prf(wi(w3a(ph, ps, th), ta)) =
  syl31anc(w3a(ph, ps, th), ch, ph, ps, th, ta, 3adant3(ph, ps, ch, th, stoic4b_1), simp1(ph, ps, th), simp2(ph, ps, th), simp3(ph, ps, th), stoic4b_2)

axioms stoic4b
