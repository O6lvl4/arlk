// Absorbed from Metamath by `arlk absorb-mm`: the database up to stoic4b
// (1776 theorems). Check it with `arlk check <this file>`;
// no Metamath verifier is needed. The check is relative to the axioms and
// syntax facts below (see `axioms`).
room setmm

symbol wff: Type
symbol some_wff: wff
symbol Prf(p: wff) -> Type
theorem idi(ph: wff, idi_1: Prf(ph)) -> Prf(ph) =
  idi_1
theorem a1ii(ph: wff, ps: wff, a1ii_1: Prf(ph), a1ii_2: Prf(ps)) -> Prf(ph) =
  a1ii_1
symbol wn(ph: wff) -> wff
symbol wi(ph: wff, ps: wff) -> wff
symbol ax_mp(ph: wff, ps: wff, min: Prf(ph), maj: Prf(wi(ph, ps))) -> Prf(ps)
symbol ax_1(ph: wff, ps: wff) -> Prf(wi(ph, wi(ps, ph)))
symbol ax_2(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, wi(ps, ch)), wi(wi(ph, ps), wi(ph, ch))))
symbol ax_3(ph: wff, ps: wff) -> Prf(wi(wi(wn(ph), wn(ps)), wi(ps, ph)))
theorem mp2(ph: wff, ps: wff, ch: wff, mp2_1: Prf(ph), mp2_2: Prf(ps), mp2_3: Prf(wi(ph, wi(ps, ch)))) -> Prf(ch) =
  ax_mp(ps, ch, mp2_2, ax_mp(ph, wi(ps, ch), mp2_1, mp2_3))
theorem mp2b(ph: wff, ps: wff, ch: wff, mp2b_1: Prf(ph), mp2b_2: Prf(wi(ph, ps)), mp2b_3: Prf(wi(ps, ch))) -> Prf(ch) =
  ax_mp(ps, ch, ax_mp(ph, ps, mp2b_1, mp2b_2), mp2b_3)
theorem a1i(ph: wff, ps: wff, a1i_1: Prf(ph)) -> Prf(wi(ps, ph)) =
  ax_mp(ph, wi(ps, ph), a1i_1, ax_1(ph, ps))
theorem 2a1i(ph: wff, ps: wff, ch: wff, 2a1i_1: Prf(ph)) -> Prf(wi(ps, wi(ch, ph))) =
  a1i(wi(ch, ph), ps, a1i(ph, ch, 2a1i_1))
theorem ax1w(ph: wff, ps: wff, ch: wff) -> Prf(wi(ph, wi(ps, wi(ch, ps)))) =
  a1i(wi(ps, wi(ch, ps)), ph, ax_1(ps, ch))
theorem mp1i(ph: wff, ps: wff, ch: wff, mp1i_1: Prf(ph), mp1i_2: Prf(wi(ph, ps))) -> Prf(wi(ch, ps)) =
  a1i(ps, ch, ax_mp(ph, ps, mp1i_1, mp1i_2))
theorem a2i(ph: wff, ps: wff, ch: wff, a2i_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(wi(ph, ps), wi(ph, ch))) =
  ax_mp(wi(ph, wi(ps, ch)), wi(wi(ph, ps), wi(ph, ch)), a2i_1, ax_2(ph, ps, ch))
theorem mpd(ph: wff, ps: wff, ch: wff, mpd_1: Prf(wi(ph, ps)), mpd_2: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, ch)) =
  ax_mp(wi(ph, ps), wi(ph, ch), mpd_1, a2i(ph, ps, ch, mpd_2))
theorem imim2i(ph: wff, ps: wff, ch: wff, imim2i_1: Prf(wi(ph, ps))) -> Prf(wi(wi(ch, ph), wi(ch, ps))) =
  a2i(ch, ph, ps, a1i(wi(ph, ps), ch, imim2i_1))
theorem syl(ph: wff, ps: wff, ch: wff, syl_1: Prf(wi(ph, ps)), syl_2: Prf(wi(ps, ch))) -> Prf(wi(ph, ch)) =
  mpd(ph, ps, ch, syl_1, a1i(wi(ps, ch), ph, syl_2))
theorem 3syl(ph: wff, ps: wff, ch: wff, th: wff, 3syl_1: Prf(wi(ph, ps)), 3syl_2: Prf(wi(ps, ch)), 3syl_3: Prf(wi(ch, th))) -> Prf(wi(ph, th)) =
  syl(ph, ch, th, syl(ph, ps, ch, 3syl_1, 3syl_2), 3syl_3)
theorem 4syl(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 4syl_1: Prf(wi(ph, ps)), 4syl_2: Prf(wi(ps, ch)), 4syl_3: Prf(wi(ch, th)), 4syl_4: Prf(wi(th, ta))) -> Prf(wi(ph, ta)) =
  syl(ph, th, ta, 3syl(ph, ps, ch, th, 4syl_1, 4syl_2, 4syl_3), 4syl_4)
theorem mpi(ph: wff, ps: wff, ch: wff, mpi_1: Prf(ps), mpi_2: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, ch)) =
  mpd(ph, ps, ch, a1i(ps, ph, mpi_1), mpi_2)
theorem mpisyl(ph: wff, ps: wff, ch: wff, th: wff, mpisyl_1: Prf(wi(ph, ps)), mpisyl_2: Prf(ch), mpisyl_3: Prf(wi(ps, wi(ch, th)))) -> Prf(wi(ph, th)) =
  syl(ph, ps, th, mpisyl_1, mpi(ps, ch, th, mpisyl_2, mpisyl_3))
theorem id(ph: wff) -> Prf(wi(ph, ph)) =
  mpd(ph, wi(ph, ph), ph, ax_1(ph, ph), ax_1(ph, wi(ph, ph)))
theorem idALT(ph: wff) -> Prf(wi(ph, ph)) =
  ax_mp(wi(ph, wi(ph, ph)), wi(ph, ph), ax_1(ph, ph), ax_mp(wi(ph, wi(wi(ph, ph), ph)), wi(wi(ph, wi(ph, ph)), wi(ph, ph)), ax_1(ph, wi(ph, ph)), ax_2(ph, wi(ph, ph), ph)))
theorem idd(ph: wff, ps: wff) -> Prf(wi(ph, wi(ps, ps))) =
  a1i(wi(ps, ps), ph, id(ps))
theorem a1d(ph: wff, ps: wff, ch: wff, a1d_1: Prf(wi(ph, ps))) -> Prf(wi(ph, wi(ch, ps))) =
  syl(ph, ps, wi(ch, ps), a1d_1, ax_1(ps, ch))
theorem 2a1d(ph: wff, ps: wff, ch: wff, th: wff, 2a1d_1: Prf(wi(ph, ps))) -> Prf(wi(ph, wi(ch, wi(th, ps)))) =
  a1d(ph, wi(th, ps), ch, a1d(ph, ps, th, 2a1d_1))
theorem a1i13(ph: wff, ps: wff, ch: wff, th: wff, a1i13_1: Prf(wi(ps, th))) -> Prf(wi(ph, wi(ps, wi(ch, th)))) =
  a1i(wi(ps, wi(ch, th)), ph, a1d(ps, th, ch, a1i13_1))
theorem 2a1(ph: wff, ps: wff, ch: wff) -> Prf(wi(ph, wi(ps, wi(ch, ph)))) =
  2a1d(ph, ph, ps, ch, id(ph))
theorem a2d(ph: wff, ps: wff, ch: wff, th: wff, a2d_1: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(ph, wi(wi(ps, ch), wi(ps, th)))) =
  syl(ph, wi(ps, wi(ch, th)), wi(wi(ps, ch), wi(ps, th)), a2d_1, ax_2(ps, ch, th))
theorem sylcom(ph: wff, ps: wff, ch: wff, th: wff, sylcom_1: Prf(wi(ph, wi(ps, ch))), sylcom_2: Prf(wi(ps, wi(ch, th)))) -> Prf(wi(ph, wi(ps, th))) =
  syl(ph, wi(ps, ch), wi(ps, th), sylcom_1, a2i(ps, ch, th, sylcom_2))
theorem syl5com(ph: wff, ps: wff, ch: wff, th: wff, syl5com_1: Prf(wi(ph, ps)), syl5com_2: Prf(wi(ch, wi(ps, th)))) -> Prf(wi(ph, wi(ch, th))) =
  sylcom(ph, ch, ps, th, a1d(ph, ps, ch, syl5com_1), syl5com_2)
theorem com12(ph: wff, ps: wff, ch: wff, com12_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ps, wi(ph, ch))) =
  syl5com(ps, ps, ph, ch, id(ps), com12_1)
theorem syl11(ph: wff, ps: wff, ch: wff, th: wff, syl11_1: Prf(wi(ph, wi(ps, ch))), syl11_2: Prf(wi(th, ph))) -> Prf(wi(ps, wi(th, ch))) =
  com12(th, ps, ch, syl(th, ph, wi(ps, ch), syl11_2, syl11_1))
theorem syl5(ph: wff, ps: wff, ch: wff, th: wff, syl5_1: Prf(wi(ph, ps)), syl5_2: Prf(wi(ch, wi(ps, th)))) -> Prf(wi(ch, wi(ph, th))) =
