theorem nanbi1d(ph: wff, ps: wff, ch: wff, th: wff, nanbid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wnan(ps, th), wnan(ch, th)))) =
  syl(ph, wb(ps, ch), wb(wnan(ps, th), wnan(ch, th)), nanbid_1, nanbi1(ps, ch, th))
theorem nanbi2d(ph: wff, ps: wff, ch: wff, th: wff, nanbid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wnan(th, ps), wnan(th, ch)))) =
  syl(ph, wb(ps, ch), wb(wnan(th, ps), wnan(th, ch)), nanbid_1, nanbi2(ps, ch, th))
theorem nanbi12d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, nanbid_1: Prf(wi(ph, wb(ps, ch))), nanbi12d_2: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(wnan(ps, th), wnan(ch, ta)))) =
  syl2anc(ph, wb(ps, ch), wb(th, ta), wb(wnan(ps, th), wnan(ch, ta)), nanbid_1, nanbi12d_2, nanbi12(ps, ch, th, ta))
theorem nanass(ph: wff, ps: wff, ch: wff) -> Prf(wb(wb(ph, ch), wb(wnan(wnan(ph, ps), ch), wnan(ph, wnan(ps, ch))))) =
  bitri(wb(ph, ch), wb(wnan(ch, wnan(ps, ph)), wnan(ph, wnan(ps, ch))), wb(wnan(wnan(ph, ps), ch), wnan(ph, wnan(ps, ch))), impbii(wb(ph, ch), wb(wnan(ch, wnan(ps, ph)), wnan(ph, wnan(ps, ch))), nanbi12d(wb(ph, ch), ch, ph, wnan(ps, ph), wnan(ps, ch), bicom1(ph, ch), nanbi2(ph, ch, ps)), bija(wnan(ch, wnan(ps, ph)), wnan(ph, wnan(ps, ch)), wb(ph, ch), impbid21d(wnan(ch, wnan(ps, ph)), wnan(ph, wnan(ps, ch)), ph, ch, sylbi(wnan(ph, wnan(ps, ch)), wi(ph, wa(ps, ch)), wi(ph, ch), nannan(ph, ps, ch), imim2i(wa(ps, ch), ch, ph, simpr(ps, ch))), sylbi(wnan(ch, wnan(ps, ph)), wi(ch, wa(ps, ph)), wi(ch, ph), nannan(ch, ps, ph), imim2i(wa(ps, ph), ph, ch, simpr(ps, ph)))), syl2imc(wn(wnan(ph, wnan(ps, ch))), ph, wn(wnan(ch, wnan(ps, ph))), ch, wb(ph, ch), sylbir(wn(wnan(ph, wnan(ps, ch))), wa(ph, wnan(ps, ch)), ph, nanan(ph, wnan(ps, ch)), simpl(ph, wnan(ps, ch))), sylbir(wn(wnan(ch, wnan(ps, ph))), wa(ch, wnan(ps, ph)), ch, nanan(ch, wnan(ps, ph)), simpl(ch, wnan(ps, ph))), pm5.1im(ph, ch)))), bibi1i(wnan(ch, wnan(ps, ph)), wnan(wnan(ph, ps), ch), wnan(ph, wnan(ps, ch)), bitri(wnan(ch, wnan(ps, ph)), wnan(ch, wnan(ph, ps)), wnan(wnan(ph, ps), ch), nanbi2i(wnan(ps, ph), wnan(ph, ps), ch, nancom(ps, ph)), nancom(ch, wnan(ph, ps)))))
symbol wxo(ph: wff, ps: wff) -> wff
symbol df_xor(ph: wff, ps: wff) -> Prf(wb(wxo(ph, ps), wn(wb(ph, ps))))
theorem xnor(ph: wff, ps: wff) -> Prf(wb(wb(ph, ps), wn(wxo(ph, ps)))) =
  con2bii(wxo(ph, ps), wb(ph, ps), df_xor(ph, ps))
theorem xorcom(ph: wff, ps: wff) -> Prf(wb(wxo(ph, ps), wxo(ps, ph))) =
  bitr4i(wxo(ph, ps), wn(wb(ps, ph)), wxo(ps, ph), xchbinx(wxo(ph, ps), wb(ph, ps), wb(ps, ph), df_xor(ph, ps), bicom(ph, ps)), df_xor(ps, ph))
theorem xorass(ph: wff, ps: wff, ch: wff) -> Prf(wb(wxo(wxo(ph, ps), ch), wxo(ph, wxo(ps, ch)))) =
  3bitr4i(wn(wb(wxo(ph, ps), ch)), wn(wb(ph, wxo(ps, ch))), wxo(wxo(ph, ps), ch), wxo(ph, wxo(ps, ch)), 3bitr2ri(wn(wb(ph, wxo(ps, ch))), wb(ph, wn(wxo(ps, ch))), wb(wn(wxo(ph, ps)), ch), wn(wb(wxo(ph, ps), ch)), xor3(ph, wxo(ps, ch)), 3bitr3i(wb(wb(ph, ps), ch), wb(ph, wb(ps, ch)), wb(wn(wxo(ph, ps)), ch), wb(ph, wn(wxo(ps, ch))), biass(ph, ps, ch), bibi1i(wb(ph, ps), wn(wxo(ph, ps)), ch, xnor(ph, ps)), bibi2i(wb(ps, ch), wn(wxo(ps, ch)), ph, xnor(ps, ch))), nbbn(wxo(ph, ps), ch)), df_xor(wxo(ph, ps), ch), df_xor(ph, wxo(ps, ch)))
theorem excxor(ph: wff, ps: wff) -> Prf(wb(wxo(ph, ps), wo(wa(ph, wn(ps)), wa(wn(ph), ps)))) =
  3bitri(wxo(ph, ps), wn(wb(ph, ps)), wo(wa(ph, wn(ps)), wa(ps, wn(ph))), wo(wa(ph, wn(ps)), wa(wn(ph), ps)), df_xor(ph, ps), xor(ph, ps), orbi2i(wa(ps, wn(ph)), wa(wn(ph), ps), wa(ph, wn(ps)), ancom(ps, wn(ph))))
theorem xor2(ph: wff, ps: wff) -> Prf(wb(wxo(ph, ps), wa(wo(ph, ps), wn(wa(ph, ps))))) =
  bitri(wxo(ph, ps), wn(wb(ph, ps)), wa(wo(ph, ps), wn(wa(ph, ps))), df_xor(ph, ps), nbi2(ph, ps))
theorem xoror(ph: wff, ps: wff) -> Prf(wi(wxo(ph, ps), wo(ph, ps))) =
  simplbi(wxo(ph, ps), wo(ph, ps), wn(wa(ph, ps)), xor2(ph, ps))
theorem xornan(ph: wff, ps: wff) -> Prf(wi(wxo(ph, ps), wn(wa(ph, ps)))) =
  simprbi(wxo(ph, ps), wo(ph, ps), wn(wa(ph, ps)), xor2(ph, ps))
theorem xornan2(ph: wff, ps: wff) -> Prf(wi(wxo(ph, ps), wnan(ph, ps))) =
  sylibr(wxo(ph, ps), wn(wa(ph, ps)), wnan(ph, ps), xornan(ph, ps), df_nan(ph, ps))
theorem xorneg2(ph: wff, ps: wff) -> Prf(wb(wxo(ph, wn(ps)), wn(wxo(ph, ps)))) =
  3bitr2i(wxo(ph, wn(ps)), wn(wb(ph, wn(ps))), wb(ph, ps), wn(wxo(ph, ps)), df_xor(ph, wn(ps)), pm5.18(ph, ps), xnor(ph, ps))
theorem xorneg1(ph: wff, ps: wff) -> Prf(wb(wxo(wn(ph), ps), wn(wxo(ph, ps)))) =
  bitri(wxo(wn(ph), ps), wxo(ps, wn(ph)), wn(wxo(ph, ps)), xorcom(wn(ph), ps), xchbinx(wxo(ps, wn(ph)), wxo(ps, ph), wxo(ph, ps), xorneg2(ps, ph), xorcom(ps, ph)))
theorem xorneg(ph: wff, ps: wff) -> Prf(wb(wxo(wn(ph), wn(ps)), wxo(ph, ps))) =
  bitr4i(wxo(wn(ph), wn(ps)), wn(wxo(ph, wn(ps))), wxo(ph, ps), xorneg1(ph, wn(ps)), con2bii(wxo(ph, wn(ps)), wxo(ph, ps), xorneg2(ph, ps)))
theorem xorbi12i(ph: wff, ps: wff, ch: wff, th: wff, xorbi12_1: Prf(wb(ph, ps)), xorbi12_2: Prf(wb(ch, th))) -> Prf(wb(wxo(ph, ch), wxo(ps, th))) =
  bitr4i(wxo(ph, ch), wn(wb(ps, th)), wxo(ps, th), xchbinx(wxo(ph, ch), wb(ph, ch), wb(ps, th), df_xor(ph, ch), bibi12i(ph, ps, ch, th, xorbi12_1, xorbi12_2)), df_xor(ps, th))
theorem xorbi12d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, xor12d_1: Prf(wi(ph, wb(ps, ch))), xor12d_2: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(wxo(ps, th), wxo(ch, ta)))) =
  3bitr4g(ph, wn(wb(ps, th)), wn(wb(ch, ta)), wxo(ps, th), wxo(ch, ta), notbid(ph, wb(ps, th), wb(ch, ta), bibi12d(ph, ps, ch, th, ta, xor12d_1, xor12d_2)), df_xor(ps, th), df_xor(ch, ta))
theorem anxordi(ph: wff, ps: wff, ch: wff) -> Prf(wb(wa(ph, wxo(ps, ch)), wxo(wa(ph, ps), wa(ph, ch)))) =
  3bitr4i(wa(ph, wn(wb(ps, ch))), wn(wb(wa(ph, ps), wa(ph, ch))), wa(ph, wxo(ps, ch)), wxo(wa(ph, ps), wa(ph, ch)), xordi(ph, ps, ch), anbi2i(wxo(ps, ch), wn(wb(ps, ch)), ph, df_xor(ps, ch)), df_xor(wa(ph, ps), wa(ph, ch)))
theorem xorexmid(ph: wff) -> Prf(wxo(ph, wn(ph))) =
  mpbir(wxo(ph, wn(ph)), wn(wb(ph, wn(ph))), pm5.19(ph), df_xor(ph, wn(ph)))
symbol wnor(ph: wff, ps: wff) -> wff
symbol df_nor(ph: wff, ps: wff) -> Prf(wb(wnor(ph, ps), wn(wo(ph, ps))))
theorem norcom(ph: wff, ps: wff) -> Prf(wb(wnor(ph, ps), wnor(ps, ph))) =
  bitr4i(wnor(ph, ps), wn(wo(ps, ph)), wnor(ps, ph), xchbinx(wnor(ph, ps), wo(ph, ps), wo(ps, ph), df_nor(ph, ps), orcom(ph, ps)), df_nor(ps, ph))
theorem nornot(ph: wff) -> Prf(wb(wn(ph), wnor(ph, ph))) =
  bicomi(wnor(ph, ph), wn(ph), xchbinx(wnor(ph, ph), wo(ph, ph), ph, df_nor(ph, ph), oridm(ph)))
theorem noran(ph: wff, ps: wff) -> Prf(wb(wa(ph, ps), wnor(wnor(ph, ph), wnor(ps, ps)))) =
  bitr4i(wa(ph, ps), wn(wo(wnor(ph, ph), wnor(ps, ps))), wnor(wnor(ph, ph), wnor(ps, ps)), xchbinx(wa(ph, ps), wo(wn(ph), wn(ps)), wo(wnor(ph, ph), wnor(ps, ps)), anor(ph, ps), orbi12i(wn(ph), wnor(ph, ph), wn(ps), wnor(ps, ps), nornot(ph), nornot(ps))), df_nor(wnor(ph, ph), wnor(ps, ps)))
theorem noror(ph: wff, ps: wff) -> Prf(wb(wo(ph, ps), wnor(wnor(ph, ps), wnor(ph, ps)))) =
  bitri(wo(ph, ps), wn(wnor(ph, ps)), wnor(wnor(ph, ps), wnor(ph, ps)), con2bii(wnor(ph, ps), wo(ph, ps), df_nor(ph, ps)), nornot(wnor(ph, ps)))
theorem norasslem1(ph: wff, ps: wff, ch: wff) -> Prf(wb(wi(wo(ph, ps), ch), wo(wnor(ph, ps), ch))) =
  bitr4i(wi(wo(ph, ps), ch), wo(wn(wo(ph, ps)), ch), wo(wnor(ph, ps), ch), imor(wo(ph, ps), ch), orbi1i(wnor(ph, ps), wn(wo(ph, ps)), ch, df_nor(ph, ps)))
theorem norasslem2(ph: wff, ps: wff, ch: wff) -> Prf(wi(ph, wb(ps, wi(wo(ph, ch), ps)))) =
  orcs(ph, ch, wb(ps, wi(wo(ph, ch), ps)), biimt(wo(ph, ch), ps))
theorem norasslem3(ph: wff, ps: wff, ch: wff) -> Prf(wi(wn(ph), wb(wi(ps, ch), wi(wo(ph, ps), ch)))) =
  imbi1d(wn(ph), ps, wo(ph, ps), ch, biorf(ph, ps))
theorem norass(ph: wff, ps: wff, ch: wff) -> Prf(wb(wb(ph, ch), wb(wnor(wnor(ph, ps), ch), wnor(ph, wnor(ps, ch))))) =
  3bitr4i(wb(wo(wnor(ph, ps), ch), wo(ph, wnor(ps, ch))), wb(wn(wo(wnor(ph, ps), ch)), wn(wo(ph, wnor(ps, ch)))), wb(ph, ch), wb(wnor(wnor(ph, ps), ch), wnor(ph, wnor(ps, ch))), notbi(wo(wnor(ph, ps), ch), wo(ph, wnor(ps, ch))), 3bitr4i(wb(wi(wo(ps, ph), ch), wi(wo(ps, ch), ph)), wb(wo(wnor(ps, ph), ch), wo(wnor(ps, ch), ph)), wb(ph, ch), wb(wo(wnor(ph, ps), ch), wo(ph, wnor(ps, ch))), bibi12i(wi(wo(ps, ph), ch), wo(wnor(ps, ph), ch), wi(wo(ps, ch), ph), wo(wnor(ps, ch), ph), norasslem1(ps, ph, ch), norasslem1(ps, ch, ph)), pm2.61i(ps, wb(wb(ph, ch), wb(wi(wo(ps, ph), ch), wi(wo(ps, ch), ph))), bitrid(wb(ph, ch), wb(ch, ph), ps, wb(wi(wo(ps, ph), ch), wi(wo(ps, ch), ph)), bicom(ph, ch), bibi12d(ps, ch, wi(wo(ps, ph), ch), ph, wi(wo(ps, ch), ph), norasslem2(ps, ch, ph), norasslem2(ps, ph, ch))), bitrid(wb(ph, ch), wb(wi(ph, ch), wi(ch, ph)), wn(ps), wb(wi(wo(ps, ph), ch), wi(wo(ps, ch), ph)), impimprbi(ph, ch), bibi12d(wn(ps), wi(ph, ch), wi(wo(ps, ph), ch), wi(ch, ph), wi(wo(ps, ch), ph), norasslem3(ps, ph, ch), norasslem3(ps, ch, ph)))), bibi12i(wo(wnor(ph, ps), ch), wo(wnor(ps, ph), ch), wo(ph, wnor(ps, ch)), wo(wnor(ps, ch), ph), orbi1i(wnor(ph, ps), wnor(ps, ph), ch, norcom(ph, ps)), orcom(ph, wnor(ps, ch)))), bibi12i(wnor(wnor(ph, ps), ch), wn(wo(wnor(ph, ps), ch)), wnor(ph, wnor(ps, ch)), wn(wo(ph, wnor(ps, ch))), df_nor(wnor(ph, ps), ch), df_nor(ph, wnor(ps, ch))))
symbol setvar: Type
symbol some_setvar: setvar
symbol wal(ph: wff, x: setvar) -> wff
symbol class: Type
symbol some_class: class
symbol cv(x: setvar) -> class
symbol wceq(A: class, B: class) -> wff
symbol wtru: wff
theorem trujust(x: setvar, y: setvar) -> Prf(wb(wi(wal(wceq(cv(x), cv(x)), x), wal(wceq(cv(x), cv(x)), x)), wi(wal(wceq(cv(y), cv(y)), y), wal(wceq(cv(y), cv(y)), y)))) =
  monothetic(wal(wceq(cv(x), cv(x)), x), wal(wceq(cv(y), cv(y)), y))
symbol df_tru(x: setvar) -> Prf(wb(wtru, wi(wal(wceq(cv(x), cv(x)), x), wal(wceq(cv(x), cv(x)), x))))
theorem tru: Prf(wtru) =
  mpbir(wtru, wi(wal(wceq(cv(some_setvar), cv(some_setvar)), some_setvar), wal(wceq(cv(some_setvar), cv(some_setvar)), some_setvar)), id(wal(wceq(cv(some_setvar), cv(some_setvar)), some_setvar)), df_tru(some_setvar))
theorem dftru2(ph: wff) -> Prf(wb(wtru, wi(ph, ph))) =
  2th(wtru, wi(ph, ph), tru, id(ph))
theorem trut(ph: wff) -> Prf(wb(ph, wi(wtru, ph))) =
  a1bi(wtru, ph, tru)
theorem mptru(ph: wff, mptru_1: Prf(wi(wtru, ph))) -> Prf(ph) =
  ax_mp(wtru, ph, tru, mptru_1)
theorem tbtru(ph: wff) -> Prf(wb(ph, wb(ph, wtru))) =
  tbt(wtru, ph, tru)
theorem bitru(ph: wff, bitru_1: Prf(ph)) -> Prf(wb(ph, wtru)) =
  2th(ph, wtru, bitru_1, tru)
theorem trud(ph: wff) -> Prf(wi(ph, wtru)) =
  a1i(wtru, ph, tru)
theorem truan(ph: wff) -> Prf(wb(wa(wtru, ph), ph)) =
  bicomi(ph, wa(wtru, ph), biantrur(wtru, ph, tru))
symbol wfal: wff
symbol df_fal: Prf(wb(wfal, wn(wtru)))
theorem fal: Prf(wn(wfal)) =
  mtbir(wfal, wn(wtru), notnoti(wtru, tru), df_fal)
theorem nbfal(ph: wff) -> Prf(wb(wn(ph), wb(ph, wfal))) =
  nbn(wfal, ph, fal)
theorem bifal(ph: wff, bifal_1: Prf(wn(ph))) -> Prf(wb(ph, wfal)) =
  2false(ph, wfal, bifal_1, fal)
theorem falim(ph: wff) -> Prf(wi(wfal, ph)) =
  pm2.21i(wfal, ph, fal)
theorem falimd(ph: wff, ps: wff) -> Prf(wi(wa(ph, wfal), ps)) =
  adantl(wfal, ps, ph, falim(ps))
theorem dfnot(ph: wff) -> Prf(wb(wn(ph), wi(ph, wfal))) =
  ax_mp(wn(wfal), wb(wn(ph), wi(ph, wfal)), fal, mtt(wfal, ph))
theorem inegd(ph: wff, ps: wff, inegd_1: Prf(wi(wa(ph, ps), wfal))) -> Prf(wi(ph, wn(ps))) =
  sylibr(ph, wi(ps, wfal), wn(ps), ex(ph, ps, wfal, inegd_1), dfnot(ps))
theorem efald(ph: wff, ps: wff, efald_1: Prf(wi(wa(ph, wn(ps)), wfal))) -> Prf(wi(ph, ps)) =
  notnotrd(ph, ps, inegd(ph, wn(ps), efald_1))
theorem pm2.21fal(ph: wff, ps: wff, pm2_21fal_1: Prf(wi(ph, ps)), pm2_21fal_2: Prf(wi(ph, wn(ps)))) -> Prf(wi(ph, wfal)) =
  pm2.21dd(ph, ps, wfal, pm2_21fal_1, pm2_21fal_2)
theorem truimtru: Prf(wb(wi(wtru, wtru), wtru)) =
  bitru(wi(wtru, wtru), id(wtru))
theorem truimfal: Prf(wb(wi(wtru, wfal), wfal)) =
  bicomi(wfal, wi(wtru, wfal), trut(wfal))
theorem falimtru: Prf(wb(wi(wfal, wtru), wtru)) =
  bitru(wi(wfal, wtru), trud(wfal))
theorem falimfal: Prf(wb(wi(wfal, wfal), wtru)) =
  bitru(wi(wfal, wfal), id(wfal))
theorem nottru: Prf(wb(wn(wtru), wfal)) =
  bicomi(wfal, wn(wtru), df_fal)
theorem notfal: Prf(wb(wn(wfal), wtru)) =
  bitru(wn(wfal), fal)
theorem trubitru: Prf(wb(wb(wtru, wtru), wtru)) =
  bitru(wb(wtru, wtru), biid(wtru))
theorem falbitru: Prf(wb(wb(wfal, wtru), wfal)) =
  bicomi(wfal, wb(wfal, wtru), tbtru(wfal))
theorem trubifal: Prf(wb(wb(wtru, wfal), wfal)) =
  bitri(wb(wtru, wfal), wb(wfal, wtru), wfal, bicom(wtru, wfal), falbitru)
theorem falbifal: Prf(wb(wb(wfal, wfal), wtru)) =
  bitru(wb(wfal, wfal), biid(wfal))
theorem truantru: Prf(wb(wa(wtru, wtru), wtru)) =
  anidm(wtru)
theorem truanfal: Prf(wb(wa(wtru, wfal), wfal)) =
  truan(wfal)
theorem falantru: Prf(wb(wa(wfal, wtru), wfal)) =
  bifal(wa(wfal, wtru), intnanr(wfal, wtru, fal))
theorem falanfal: Prf(wb(wa(wfal, wfal), wfal)) =
  anidm(wfal)
theorem truortru: Prf(wb(wo(wtru, wtru), wtru)) =
  oridm(wtru)
theorem truorfal: Prf(wb(wo(wtru, wfal), wtru)) =
  bitru(wo(wtru, wfal), orci(wtru, wfal, tru))
theorem falortru: Prf(wb(wo(wfal, wtru), wtru)) =
  bitru(wo(wfal, wtru), olci(wtru, wfal, tru))
theorem falorfal: Prf(wb(wo(wfal, wfal), wfal)) =
  oridm(wfal)
theorem trunantru: Prf(wb(wnan(wtru, wtru), wfal)) =
  bitr3i(wnan(wtru, wtru), wn(wtru), wfal, nannot(wtru), nottru)
theorem trunanfal: Prf(wb(wnan(wtru, wfal), wtru)) =
  bitri(wnan(wtru, wfal), wn(wfal), wtru, xchbinx(wnan(wtru, wfal), wa(wtru, wfal), wfal, df_nan(wtru, wfal), truanfal), notfal)
theorem falnantru: Prf(wb(wnan(wfal, wtru), wtru)) =
  bitri(wnan(wfal, wtru), wnan(wtru, wfal), wtru, nancom(wfal, wtru), trunanfal)
theorem falnanfal: Prf(wb(wnan(wfal, wfal), wtru)) =
  bitr3i(wnan(wfal, wfal), wn(wfal), wtru, nannot(wfal), notfal)
theorem truxortru: Prf(wb(wxo(wtru, wtru), wfal)) =
  bitri(wxo(wtru, wtru), wn(wtru), wfal, xchbinx(wxo(wtru, wtru), wb(wtru, wtru), wtru, df_xor(wtru, wtru), trubitru), nottru)
theorem truxorfal: Prf(wb(wxo(wtru, wfal), wtru)) =
  bitri(wxo(wtru, wfal), wn(wfal), wtru, xchbinx(wxo(wtru, wfal), wb(wtru, wfal), wfal, df_xor(wtru, wfal), trubifal), notfal)
theorem falxortru: Prf(wb(wxo(wfal, wtru), wtru)) =
  bitri(wxo(wfal, wtru), wxo(wtru, wfal), wtru, xorcom(wfal, wtru), truxorfal)
theorem falxorfal: Prf(wb(wxo(wfal, wfal), wfal)) =
  bitri(wxo(wfal, wfal), wn(wtru), wfal, xchbinx(wxo(wfal, wfal), wb(wfal, wfal), wtru, df_xor(wfal, wfal), falbifal), nottru)
theorem trunortru: Prf(wb(wnor(wtru, wtru), wfal)) =
  bitr4i(wnor(wtru, wtru), wn(wtru), wfal, xchbinx(wnor(wtru, wtru), wo(wtru, wtru), wtru, df_nor(wtru, wtru), truortru), df_fal)
theorem trunorfal: Prf(wb(wnor(wtru, wfal), wfal)) =
  bitr4i(wnor(wtru, wfal), wn(wtru), wfal, xchbinx(wnor(wtru, wfal), wo(wtru, wfal), wtru, df_nor(wtru, wfal), truorfal), df_fal)
theorem falnortru: Prf(wb(wnor(wfal, wtru), wfal)) =
  bitri(wnor(wfal, wtru), wnor(wtru, wfal), wfal, norcom(wfal, wtru), trunorfal)
theorem falnorfal: Prf(wb(wnor(wfal, wfal), wtru)) =
