  luklem1(wi(wn(ph), wn(ps)), wi(wi(wi(wn(ph), ph), ph), wi(ps, ph)), wi(ps, ph), luklem2(wn(ph), ps, ph, ph), luklem4(ph, wi(ps, ph)))
theorem nic_dfim(ph: wff, ps: wff) -> Prf(wnan(wnan(wnan(ph, wnan(ps, ps)), wi(ph, ps)), wnan(wnan(wnan(ph, wnan(ps, ps)), wnan(ph, wnan(ps, ps))), wnan(wi(ph, ps), wi(ph, ps))))) =
  mpbi(wb(wnan(ph, wnan(ps, ps)), wi(ph, ps)), wnan(wnan(wnan(ph, wnan(ps, ps)), wi(ph, ps)), wnan(wnan(wnan(ph, wnan(ps, ps)), wnan(ph, wnan(ps, ps))), wnan(wi(ph, ps), wi(ph, ps)))), bicomi(wi(ph, ps), wnan(ph, wnan(ps, ps)), nanim(ph, ps)), nanbi(wnan(ph, wnan(ps, ps)), wi(ph, ps)))
theorem nic_dfneg(ph: wff) -> Prf(wnan(wnan(wnan(ph, ph), wn(ph)), wnan(wnan(wnan(ph, ph), wnan(ph, ph)), wnan(wn(ph), wn(ph))))) =
  mpbi(wb(wnan(ph, ph), wn(ph)), wnan(wnan(wnan(ph, ph), wn(ph)), wnan(wnan(wnan(ph, ph), wnan(ph, ph)), wnan(wn(ph), wn(ph)))), bicomi(wn(ph), wnan(ph, ph), nannot(ph)), nanbi(wnan(ph, ph), wn(ph)))
theorem nic_mp(ph: wff, ps: wff, ch: wff, nic_jmin: Prf(ph), nic_jmaj: Prf(wnan(ph, wnan(ch, ps)))) -> Prf(ps) =
  ax_mp(ph, ps, nic_jmin, simprd(ph, ch, ps, mpbi(wnan(ph, wnan(ch, ps)), wi(ph, wa(ch, ps)), nic_jmaj, nannan(ph, ch, ps))))
theorem nic_mpALT(ph: wff, ps: wff, ch: wff, nic_jmin: Prf(ph), nic_jmaj: Prf(wnan(ph, wnan(ch, ps)))) -> Prf(ps) =
  ax_mp(ph, ps, nic_jmin, simprd(ph, ch, ps, mpbir(wi(ph, wa(ch, ps)), wn(wa(ph, wn(wa(ch, ps)))), mpbi(wnan(ph, wnan(ch, ps)), wn(wa(ph, wn(wa(ch, ps)))), nic_jmaj, xchbinx(wnan(ph, wnan(ch, ps)), wa(ph, wnan(ch, ps)), wa(ph, wn(wa(ch, ps))), df_nan(ph, wnan(ch, ps)), anbi2i(wnan(ch, ps), wn(wa(ch, ps)), ph, df_nan(ch, ps)))), iman(ph, wa(ch, ps)))))
