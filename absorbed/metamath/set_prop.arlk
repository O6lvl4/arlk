theorem anbi1cd(ph: wff, ps: wff, ch: wff, th: wff, anbi1cd_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wa(th, ps), wa(ch, th)))) =
  biancomd(ph, wa(th, ps), ch, th, anbi2d(ph, ps, ch, th, anbi1cd_1))
theorem an2anr(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wb(wa(wa(ph, ps), wa(ch, th)), wa(wa(ps, ph), wa(th, ch)))) =
  anbi12i(wa(ph, ps), wa(ps, ph), wa(ch, th), wa(th, ch), ancom(ph, ps), ancom(ch, th))
theorem pm4.38(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wa(wb(ph, ch), wb(ps, th)), wb(wa(ph, ps), wa(ch, th)))) =
  anbi12d(wa(wb(ph, ch), wb(ps, th)), ph, ch, ps, th, simpl(wb(ph, ch), wb(ps, th)), simpr(wb(ph, ch), wb(ps, th)))
theorem bi2anan9(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, bi2an9_1: Prf(wi(ph, wb(ps, ch))), bi2an9_2: Prf(wi(th, wb(ta, et)))) -> Prf(wi(wa(ph, th), wb(wa(ps, ta), wa(ch, et)))) =
  syl2an(ph, wb(ps, ch), wb(ta, et), wb(wa(ps, ta), wa(ch, et)), th, bi2an9_1, bi2an9_2, pm4.38(ps, ta, ch, et))
theorem bi2anan9r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, bi2an9_1: Prf(wi(ph, wb(ps, ch))), bi2an9_2: Prf(wi(th, wb(ta, et)))) -> Prf(wi(wa(th, ph), wb(wa(ps, ta), wa(ch, et)))) =
  ancoms(ph, th, wb(wa(ps, ta), wa(ch, et)), bi2anan9(ph, ps, ch, th, ta, et, bi2an9_1, bi2an9_2))
theorem bi2bian9(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, bi2an9_1: Prf(wi(ph, wb(ps, ch))), bi2an9_2: Prf(wi(th, wb(ta, et)))) -> Prf(wi(wa(ph, th), wb(wb(ps, ta), wb(ch, et)))) =
  bibi12d(wa(ph, th), ps, ch, ta, et, adantr(ph, wb(ps, ch), th, bi2an9_1), adantl(th, wb(ta, et), ph, bi2an9_2))
theorem anbiim(ph: wff, ps: wff, ch: wff, th: wff, anbiim_1: Prf(wi(ph, wi(ch, th))), anbiim_2: Prf(wi(ps, wi(th, ch)))) -> Prf(wi(wa(ph, ps), wb(ch, th))) =
  impcom(ps, ph, wb(ch, th), impbid21d(ps, ph, ch, th, anbiim_1, anbiim_2))
theorem anbiimOLD(ph: wff, ps: wff, ch: wff, th: wff, anbiim_1: Prf(wi(ph, wi(ch, th))), anbiim_2: Prf(wi(ps, wi(th, ch)))) -> Prf(wi(wa(ph, ps), wb(ch, th))) =
  impbid(wa(ph, ps), ch, th, adantr(ph, wi(ch, th), ps, anbiim_1), adantl(ps, wi(th, ch), ph, anbiim_2))
theorem bianass(ph: wff, ps: wff, ch: wff, et: wff, bianass_1: Prf(wb(ph, wa(ps, ch)))) -> Prf(wb(wa(et, ph), wa(wa(et, ps), ch))) =
  bitr4i(wa(et, ph), wa(et, wa(ps, ch)), wa(wa(et, ps), ch), anbi2i(ph, wa(ps, ch), et, bianass_1), anass(et, ps, ch))
theorem bianassc(ph: wff, ps: wff, ch: wff, et: wff, bianass_1: Prf(wb(ph, wa(ps, ch)))) -> Prf(wb(wa(et, ph), wa(wa(ps, et), ch))) =
  bianbi(wa(et, ph), wa(et, ps), ch, wa(ps, et), bianass(ph, ps, ch, et, bianass_1), ancom(et, ps))
theorem an21(ph: wff, ps: wff, ch: wff) -> Prf(wb(wa(wa(ph, ps), ch), wa(ps, wa(ph, ch)))) =
  bicomi(wa(ps, wa(ph, ch)), wa(wa(ph, ps), ch), bianassc(wa(ph, ch), ph, ch, ps, biid(wa(ph, ch))))
