  mpbir(wnan(wnan(ph, wnan(ch, ps)), wnan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th))))), wi(wnan(ph, wnan(ch, ps)), wa(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th))))), jctil(wnan(ph, wnan(ch, ps)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th))), wnan(ta, wnan(ta, ta)), 3syl(wnan(ph, wnan(ch, ps)), wi(ph, wa(ch, ps)), wi(ph, ch), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th))), biimpi(wnan(ph, wnan(ch, ps)), wi(ph, wa(ch, ps)), nannan(ph, ch, ps)), imim2i(wa(ch, ps), ch, ph, simpl(ch, ps)), sylib(wi(ph, ch), wi(wnan(th, ch), wnan(ph, th)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th))), biimtrrid(wnan(th, ch), wi(th, wn(ch)), wi(ph, ch), wnan(ph, th), bitr4i(wi(th, wn(ch)), wn(wa(th, ch)), wnan(th, ch), imnan(th, ch), df_nan(th, ch)), imbitrrdi(wi(ph, ch), wi(th, wn(ch)), wi(th, wn(ph)), wnan(ph, th), imim2d(wi(ph, ch), wn(ch), wn(ph), th, con3(ph, ch)), 3bitr4ri(wi(ph, wn(th)), wn(wa(ph, th)), wi(th, wn(ph)), wnan(ph, th), imnan(ph, th), con2b(th, ph), df_nan(ph, th)))), nanim(wnan(th, ch), wnan(ph, th)))), mpbir(wnan(ta, wnan(ta, ta)), wi(ta, wa(ta, ta)), biimpi(ta, wa(ta, ta), pm4.24(ta)), nannan(ta, ta, ta))), nannan(wnan(ph, wnan(ch, ps)), wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th)))))
theorem nic_axALT(ph: wff, ps: wff, ch: wff, th: wff, ta: wff) -> Prf(wnan(wnan(ph, wnan(ch, ps)), wnan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th)))))) =
  mpbir(wnan(wnan(ph, wnan(ch, ps)), wnan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th))))), wn(wa(wnan(ph, wnan(ch, ps)), wnan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th)))))), mpbir(wn(wa(wnan(ph, wnan(ch, ps)), wnan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th)))))), wi(wi(ph, wa(ch, ps)), wa(wi(ta, wa(ta, ta)), wi(wi(th, wn(ch)), wi(th, wn(ph))))), jctil(wi(ph, wa(ch, ps)), wi(wi(th, wn(ch)), wi(th, wn(ph))), wi(ta, wa(ta, ta)), syl(wi(ph, wa(ch, ps)), wi(ph, ch), wi(wi(th, wn(ch)), wi(th, wn(ph))), imim2i(wa(ch, ps), ch, ph, simpl(ch, ps)), imim2d(wi(ph, ch), wn(ch), wn(ph), th, con3(ph, ch))), biimpri(wa(ta, ta), ta, anidm(ta))), bitr4i(wn(wa(wnan(ph, wnan(ch, ps)), wnan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th)))))), wn(wa(wi(ph, wa(ch, ps)), wn(wa(wi(ta, wa(ta, ta)), wi(wi(th, wn(ch)), wi(th, wn(ph))))))), wi(wi(ph, wa(ch, ps)), wa(wi(ta, wa(ta, ta)), wi(wi(th, wn(ch)), wi(th, wn(ph))))), notbii(wa(wnan(ph, wnan(ch, ps)), wnan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th))))), wa(wi(ph, wa(ch, ps)), wn(wa(wi(ta, wa(ta, ta)), wi(wi(th, wn(ch)), wi(th, wn(ph)))))), anbi12i(wnan(ph, wnan(ch, ps)), wi(ph, wa(ch, ps)), wnan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th)))), wn(wa(wi(ta, wa(ta, ta)), wi(wi(th, wn(ch)), wi(th, wn(ph))))), 3bitr4i(wn(wa(ph, wnan(ch, ps))), wn(wa(ph, wn(wa(ch, ps)))), wnan(ph, wnan(ch, ps)), wi(ph, wa(ch, ps)), notbii(wa(ph, wnan(ch, ps)), wa(ph, wn(wa(ch, ps))), anbi2i(wnan(ch, ps), wn(wa(ch, ps)), ph, df_nan(ch, ps))), df_nan(ph, wnan(ch, ps)), iman(ph, wa(ch, ps))), xchbinx(wnan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th)))), wa(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th)))), wa(wi(ta, wa(ta, ta)), wi(wi(th, wn(ch)), wi(th, wn(ph)))), df_nan(wnan(ta, wnan(ta, ta)), wnan(wnan(th, ch), wnan(wnan(