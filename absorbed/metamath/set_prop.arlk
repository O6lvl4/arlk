  mpd(ph, wo(ps, th), ch, jaod_3, jaod(ph, ps, ch, th, jaod_1, jaod_2))
theorem ori(ph: wff, ps: wff, ori_1: Prf(wo(ph, ps))) -> Prf(wi(wn(ph), ps)) =
