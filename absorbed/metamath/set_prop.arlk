  sylanl2(ch, ph, wa(ps, ch), th, ta, jctl(ch, ps, mpanlr1_1), mpanlr1_2)
theorem mpbirand(ph: wff, ps: wff, ch: wff, th: wff, mpbirand_1: Prf(wi(ph, ch)), mpbirand_2: Prf(wi(ph, wb(ps, wa(ch, th))))) -> Prf(wi(ph, wb(ps, th))) =
  bitr4d(ph, ps, wa(ch, th), th, mpbirand_2, biantrurd(ph, ch, th, mpbirand_1))
