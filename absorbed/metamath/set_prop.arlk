theorem imp44(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, imp4_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, ta)))))) -> Prf(wi(wa(ph, wa(wa(ps, ch), th)), ta)) =
