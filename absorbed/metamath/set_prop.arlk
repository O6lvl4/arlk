theorem exp4b(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, exp4b_1: Prf(wi(wa(ph, ps), wi(wa(ch, th), ta)))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, ta))))) =
  ex(ph, ps, wi(ch, wi(th, ta)), expd(wa(ph, ps), ch, th, ta, exp4b_1))
theorem exp4a(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, exp4a_1: Prf(wi(ph, wi(ps, wi(wa(ch, th), ta))))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, ta))))) =
  exp4b(ph, ps, ch, th, ta, imp(ph, ps, wi(wa(ch, th), ta), exp4a_1))
