theorem dfbi(ph: wff, ps: wff) -> Prf(wa(wi(wb(ph, ps), wa(wi(ph, ps), wi(ps, ph))), wi(wa(wi(ph, ps), wi(ps, ph)), wb(ph, ps)))) =
