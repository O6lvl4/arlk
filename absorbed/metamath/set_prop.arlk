theorem ifpbi123d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, ze: wff, ifpbi123d_1: Prf(wi(ph, wb(ps, ta))), ifpbi123d_2: Prf(wi(ph, wb(ch, et))), ifpbi123d_3: Prf(wi(ph, wb(th, ze)))) -> Prf(wi(ph, wb(wif(ps, ch, th), wif(ta, et, ze)))) =
