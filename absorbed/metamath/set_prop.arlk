theorem an13s(ph: wff, ps: wff, ch: wff, th: wff, an12s_1: Prf(wi(wa(ph, wa(ps, ch)), th))) -> Prf(wi(wa(ch, wa(ps, ph)), th)) =
  imp32(ch, ps, ph, th, com13(ph, ps, ch, th, exp32(ph, ps, ch, th, an12s_1)))
theorem an32s(ph: wff, ps: wff, ch: wff, th: wff, an32s_1: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(wa(wa(ph, ch), ps), th)) =
  sylbi(wa(wa(ph, ch), ps), wa(wa(ph, ps), ch), th, an32(ph, ch, ps), an32s_1)
theorem ancom1s(ph: wff, ps: wff, ch: wff, th: wff, an32s_1: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(wa(wa(ps, ph), ch), th)) =
