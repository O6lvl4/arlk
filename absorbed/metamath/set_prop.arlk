theorem anabss1(ph: wff, ps: wff, ch: wff, anabss1_1: Prf(wi(wa(wa(ph, ps), ph), ch))) -> Prf(wi(wa(ph, ps), ch)) =
  anabsan(ph, ps, ch, an32s(ph, ps, ph, ch, anabss1_1))
theorem anabss4(ph: wff, ps: wff, ch: wff, anabss4_1: Prf(wi(wa(wa(ps, ph), ps), ch))) -> Prf(wi(wa(ph, ps), ch)) =
  ancoms(ps, ph, ch, anabss1(ps, ph, ch, anabss4_1))
theorem anabss5(ph: wff, ps: wff, ch: wff, anabss5_1: Prf(wi(wa(ph, wa(ph, ps)), ch))) -> Prf(wi(wa(ph, ps), ch)) =
