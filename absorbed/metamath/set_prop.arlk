theorem anabsi5(ph: wff, ps: wff, ch: wff, anabsi5_1: Prf(wi(ph, wi(wa(ph, ps), ch)))) -> Prf(wi(wa(ph, ps), ch)) =
  mpcom(ph, wa(ph, ps), ch, simpl(ph, ps), anabsi5_1)
theorem anabsi6(ph: wff, ps: wff, ch: wff, anabsi6_1: Prf(wi(ph, wi(wa(ps, ph), ch)))) -> Prf(wi(wa(ph, ps), ch)) =
  anabsi5(ph, ps, ch, ancomsd(ph, ps, ph, ch, anabsi6_1))
theorem anabsi7(ph: wff, ps: wff, ch: wff, anabsi7_1: Prf(wi(ps, wi(wa(ph, ps), ch)))) -> Prf(wi(wa(ph, ps), ch)) =
  ancoms(ps, ph, ch, anabsi6(ps, ph, ch, anabsi7_1))
theorem anabsi8(ph: wff, ps: wff, ch: wff, anabsi8_1: Prf(wi(ps, wi(wa(ps, ph), ch)))) -> Prf(wi(wa(ph, ps), ch)) =
  ancoms(ps, ph, ch, anabsi5(ps, ph, ch, anabsi8_1))
theorem anabss7(ph: wff, ps: wff, ch: wff, anabss7_1: Prf(wi(wa(ps, wa(ph, ps)), ch))) -> Prf(wi(wa(ph, ps), ch)) =
  anabss4(ph, ps, ch, anassrs(ps, ph, ps, ch, anabss7_1))
theorem anabsan2(ph: wff, ps: wff, ch: wff, anabsan2_1: Prf(wi(wa(ph, wa(ps, ps)), ch))) -> Prf(wi(wa(ph, ps), ch)) =
  anabss7(ph, ps, ch, an12s(ph, ps, ps, ch, anabsan2_1))
theorem anabss3(ph: wff, ps: wff, ch: wff, anabss3_1: Prf(wi(wa(wa(ph, ps), ps), ch))) -> Prf(wi(wa(ph, ps), ch)) =
