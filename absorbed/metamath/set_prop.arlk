theorem orcs(ph: wff, ps: wff, ch: wff, orcs_1: Prf(wi(wo(ph, ps), ch))) -> Prf(wi(ph, ch)) =
  syl(ph, wo(ph, ps), ch, orc(ph, ps), orcs_1)
theorem olcs(ph: wff, ps: wff, ch: wff, olcs_1: Prf(wi(wo(ph, ps), ch))) -> Prf(wi(ps, ch)) =
  orcs(ps, ph, ch, orcoms(ph, ps, ch, olcs_1))
theorem olcnd(ph: wff, ps: wff, ch: wff, olcnd_1: Prf(wi(ph, wo(ps, ch))), olcnd_2: Prf(wi(ph, wn(ch)))) -> Prf(wi(ph, ps)) =
  mt3d(ph, ps, ch, olcnd_2, ord(ph, ps, ch, olcnd_1))
theorem orcnd(ph: wff, ps: wff, ch: wff, orcnd_1: Prf(wi(ph, wo(ps, ch))), orcnd_2: Prf(wi(ph, wn(ps)))) -> Prf(wi(ph, ch)) =
  olcnd(ph, ch, ps, orcomd(ph, ps, ch, orcnd_1), orcnd_2)
theorem mtord(ph: wff, ps: wff, ch: wff, th: wff, mtord_1: Prf(wi(ph, wn(ch))), mtord_2: Prf(wi(ph, wn(th))), mtord_3: Prf(wi(ph, wi(ps, wo(ch, th))))) -> Prf(wi(ph, wn(ps))) =
  mtod(ph, ps, th, mtord_2, syl6ci(ph, ps, wo(ch, th), wn(ch), th, mtord_3, mtord_1, pm2.53(ch, th)))
theorem pm3.2ni(ph: wff, ps: wff, pm3_2ni_1: Prf(wn(ph)), pm3_2ni_2: Prf(wn(ps))) -> Prf(wn(wo(ph, ps))) =
  mto(wo(ph, ps), ph, pm3_2ni_1, jaoi(ph, ph, ps, id(ph), pm2.21i(ps, ph, pm3_2ni_2)))
theorem pm2.45(ph: wff, ps: wff) -> Prf(wi(wn(wo(ph, ps)), wn(ph))) =
  con3i(ph, wo(ph, ps), orc(ph, ps))
theorem pm2.46(ph: wff, ps: wff) -> Prf(wi(wn(wo(ph, ps)), wn(ps))) =
  con3i(ps, wo(ph, ps), olc(ps, ph))
theorem pm2.47(ph: wff, ps: wff) -> Prf(wi(wn(wo(ph, ps)), wo(wn(ph), ps))) =
  orcd(wn(wo(ph, ps)), wn(ph), ps, pm2.45(ph, ps))
theorem pm2.48(ph: wff, ps: wff) -> Prf(wi(wn(wo(ph, ps)), wo(ph, wn(ps)))) =
  olcd(wn(wo(ph, ps)), wn(ps), ph, pm2.46(ph, ps))
theorem pm2.49(ph: wff, ps: wff) -> Prf(wi(wn(wo(ph, ps)), wo(wn(ph), wn(ps)))) =
  olcd(wn(wo(ph, ps)), wn(ps), wn(ph), pm2.46(ph, ps))
theorem norbi(ph: wff, ps: wff) -> Prf(wi(wn(wo(ph, ps)), wb(ph, ps))) =
  pm5.21ni(ph, wo(ph, ps), ps, orc(ph, ps), olc(ps, ph))
theorem nbior(ph: wff, ps: wff) -> Prf(wi(wn(wb(ph, ps)), wo(ph, ps))) =
  con1i(wo(ph, ps), wb(ph, ps), norbi(ph, ps))
theorem orel1(ph: wff, ps: wff) -> Prf(wi(wn(ph), wi(wo(ph, ps), ps))) =
  com12(wo(ph, ps), wn(ph), ps, pm2.53(ph, ps))
theorem pm2.25(ph: wff, ps: wff) -> Prf(wo(ph, wi(wo(ph, ps), ps))) =
  orri(ph, wi(wo(ph, ps), ps), orel1(ph, ps))
theorem orel2(ph: wff, ps: wff) -> Prf(wi(wn(ph), wi(wo(ps, ph), ps))) =
  jaod(wn(ph), ps, ps, ph, idd(wn(ph), ps), pm2.21(ph, ps))
theorem pm2.67_2(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wo(ph, ch), ps), wi(ph, ps))) =
  imim1i(ph, wo(ph, ch), ps, orc(ph, ch))
theorem pm2.67(ph: wff, ps: wff) -> Prf(wi(wi(wo(ph, ps), ps), wi(ph, ps))) =
  pm2.67_2(ph, ps, ps)
theorem curryax(ph: wff, ps: wff) -> Prf(wo(ph, wi(ph, ps))) =
  orri(ph, wi(ph, ps), pm2.21(ph, ps))
theorem exmid(ph: wff) -> Prf(wo(ph, wn(ph))) =
  orri(ph, wn(ph), id(wn(ph)))
theorem exmidd(ph: wff, ps: wff) -> Prf(wi(ph, wo(ps, wn(ps)))) =
  a1i(wo(ps, wn(ps)), ph, exmid(ps))
theorem pm2.1(ph: wff) -> Prf(wo(wn(ph), ph)) =
  imori(ph, ph, id(ph))
theorem pm2.13(ph: wff) -> Prf(wo(ph, wn(wn(wn(ph))))) =
  orri(ph, wn(wn(wn(ph))), notnot(wn(ph)))
theorem pm2.621(ph: wff, ps: wff) -> Prf(wi(wi(ph, ps), wi(wo(ph, ps), ps))) =
  jaod(wi(ph, ps), ph, ps, ps, id(wi(ph, ps)), idd(wi(ph, ps), ps))
theorem pm2.62(ph: wff, ps: wff) -> Prf(wi(wo(ph, ps), wi(wi(ph, ps), ps))) =
  com12(wi(ph, ps), wo(ph, ps), ps, pm2.621(ph, ps))
theorem pm2.68(ph: wff, ps: wff) -> Prf(wi(wi(wi(ph, ps), ps), wo(ph, ps))) =
  orrd(wi(wi(ph, ps), ps), ph, ps, jarl(ph, ps, ps))
theorem dfor2(ph: wff, ps: wff) -> Prf(wb(wo(ph, ps), wi(wi(ph, ps), ps))) =
  impbii(wo(ph, ps), wi(wi(ph, ps), ps), pm2.62(ph, ps), pm2.68(ph, ps))
theorem pm2.07(ph: wff) -> Prf(wi(ph, wo(ph, ph))) =
  olc(ph, ph)
theorem pm1.2(ph: wff) -> Prf(wi(wo(ph, ph), ph)) =
  jaoi(ph, ph, ph, id(ph), id(ph))
theorem oridm(ph: wff) -> Prf(wb(wo(ph, ph), ph)) =
  impbii(wo(ph, ph), ph, pm1.2(ph), pm2.07(ph))
theorem pm4.25(ph: wff) -> Prf(wb(ph, wo(ph, ph))) =
  bicomi(wo(ph, ph), ph, oridm(ph))
theorem pm2.4(ph: wff, ps: wff) -> Prf(wi(wo(ph, wo(ph, ps)), wo(ph, ps))) =
  jaoi(ph, wo(ph, ps), wo(ph, ps), orc(ph, ps), id(wo(ph, ps)))
theorem pm2.41(ph: wff, ps: wff) -> Prf(wi(wo(ps, wo(ph, ps)), wo(ph, ps))) =
  jaoi(ps, wo(ph, ps), wo(ph, ps), olc(ps, ph), id(wo(ph, ps)))
theorem orim12i(ph: wff, ps: wff, ch: wff, th: wff, orim12i_1: Prf(wi(ph, ps)), orim12i_2: Prf(wi(ch, th))) -> Prf(wi(wo(ph, ch), wo(ps, th))) =
  jaoi(ph, wo(ps, th), ch, orcd(ph, ps, th, orim12i_1), olcd(ch, th, ps, orim12i_2))
theorem orim1i(ph: wff, ps: wff, ch: wff, orim1i_1: Prf(wi(ph, ps))) -> Prf(wi(wo(ph, ch), wo(ps, ch))) =
  orim12i(ph, ps, ch, ch, orim1i_1, id(ch))
theorem orim2i(ph: wff, ps: wff, ch: wff, orim1i_1: Prf(wi(ph, ps))) -> Prf(wi(wo(ch, ph), wo(ch, ps))) =
  orim12i(ch, ch, ph, ps, id(ch), orim1i_1)
theorem orim12dALT(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, orim12dALT_1: Prf(wi(ph, wi(ps, ch))), orim12dALT_2: Prf(wi(ph, wi(th, ta)))) -> Prf(wi(ph, wi(wo(ps, th), wo(ch, ta)))) =
  syl56(wo(ps, th), wi(wn(ps), th), ph, wi(wn(ch), ta), wo(ch, ta), pm2.53(ps, th), imim12d(ph, wn(ch), wn(ps), th, ta, con3d(ph, ps, ch, orim12dALT_1), orim12dALT_2), pm2.54(ch, ta))
theorem orbi2i(ph: wff, ps: wff, ch: wff, orbi2i_1: Prf(wb(ph, ps))) -> Prf(wb(wo(ch, ph), wo(ch, ps))) =
  impbii(wo(ch, ph), wo(ch, ps), orim2i(ph, ps, ch, biimpi(ph, ps, orbi2i_1)), orim2i(ps, ph, ch, biimpri(ph, ps, orbi2i_1)))
theorem orbi1i(ph: wff, ps: wff, ch: wff, orbi2i_1: Prf(wb(ph, ps))) -> Prf(wb(wo(ph, ch), wo(ps, ch))) =
  3bitri(wo(ph, ch), wo(ch, ph), wo(ch, ps), wo(ps, ch), orcom(ph, ch), orbi2i(ph, ps, ch, orbi2i_1), orcom(ch, ps))
theorem orbi12i(ph: wff, ps: wff, ch: wff, th: wff, orbi12i_1: Prf(wb(ph, ps)), orbi12i_2: Prf(wb(ch, th))) -> Prf(wb(wo(ph, ch), wo(ps, th))) =
  bitri(wo(ph, ch), wo(ph, th), wo(ps, th), orbi2i(ch, th, ph, orbi12i_2), orbi1i(ph, ps, th, orbi12i_1))
theorem orbi2d(ph: wff, ps: wff, ch: wff, th: wff, bid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wo(th, ps), wo(th, ch)))) =
  3bitr4g(ph, wi(wn(th), ps), wi(wn(th), ch), wo(th, ps), wo(th, ch), imbi2d(ph, ps, ch, wn(th), bid_1), df_or(th, ps), df_or(th, ch))
theorem orbi1d(ph: wff, ps: wff, ch: wff, th: wff, bid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wo(ps, th), wo(ch, th)))) =
  3bitr4g(ph, wo(th, ps), wo(th, ch), wo(ps, th), wo(ch, th), orbi2d(ph, ps, ch, th, bid_1), orcom(ps, th), orcom(ch, th))
theorem orbi1(ph: wff, ps: wff, ch: wff) -> Prf(wi(wb(ph, ps), wb(wo(ph, ch), wo(ps, ch)))) =
  orbi1d(wb(ph, ps), ph, ps, ch, id(wb(ph, ps)))
theorem orbi12d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, bi12d_1: Prf(wi(ph, wb(ps, ch))), bi12d_2: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(wo(ps, th), wo(ch, ta)))) =
  bitrd(ph, wo(ps, th), wo(ch, th), wo(ch, ta), orbi1d(ph, ps, ch, th, bi12d_1), orbi2d(ph, th, ta, ch, bi12d_2))
theorem pm1.5(ph: wff, ps: wff, ch: wff) -> Prf(wi(wo(ph, wo(ps, ch)), wo(ps, wo(ph, ch)))) =
  jaoi(ph, wo(ps, wo(ph, ch)), wo(ps, ch), olcd(ph, wo(ph, ch), ps, orc(ph, ch)), orim2i(ch, wo(ph, ch), ps, olc(ch, ph)))
theorem or12(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(ph, wo(ps, ch)), wo(ps, wo(ph, ch)))) =
  impbii(wo(ph, wo(ps, ch)), wo(ps, wo(ph, ch)), pm1.5(ph, ps, ch), pm1.5(ps, ph, ch))
theorem orass(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(wo(ph, ps), ch), wo(ph, wo(ps, ch)))) =
  3bitri(wo(wo(ph, ps), ch), wo(ch, wo(ph, ps)), wo(ph, wo(ch, ps)), wo(ph, wo(ps, ch)), orcom(wo(ph, ps), ch), or12(ch, ph, ps), orbi2i(wo(ch, ps), wo(ps, ch), ph, orcom(ch, ps)))
theorem pm2.31(ph: wff, ps: wff, ch: wff) -> Prf(wi(wo(ph, wo(ps, ch)), wo(wo(ph, ps), ch))) =
  biimpri(wo(wo(ph, ps), ch), wo(ph, wo(ps, ch)), orass(ph, ps, ch))
theorem pm2.32(ph: wff, ps: wff, ch: wff) -> Prf(wi(wo(wo(ph, ps), ch), wo(ph, wo(ps, ch)))) =
  biimpi(wo(wo(ph, ps), ch), wo(ph, wo(ps, ch)), orass(ph, ps, ch))
theorem pm2.3(ph: wff, ps: wff, ch: wff) -> Prf(wi(wo(ph, wo(ps, ch)), wo(ph, wo(ch, ps)))) =
  orim2i(wo(ps, ch), wo(ch, ps), ph, pm1.4(ps, ch))
theorem or32(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(wo(ph, ps), ch), wo(wo(ph, ch), ps))) =
  3bitri(wo(wo(ph, ps), ch), wo(ph, wo(ps, ch)), wo(ps, wo(ph, ch)), wo(wo(ph, ch), ps), orass(ph, ps, ch), or12(ph, ps, ch), orcom(ps, wo(ph, ch)))
theorem or4(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wb(wo(wo(ph, ps), wo(ch, th)), wo(wo(ph, ch), wo(ps, th)))) =
  3bitr4i(wo(ph, wo(ps, wo(ch, th))), wo(ph, wo(ch, wo(ps, th))), wo(wo(ph, ps), wo(ch, th)), wo(wo(ph, ch), wo(ps, th)), orbi2i(wo(ps, wo(ch, th)), wo(ch, wo(ps, th)), ph, or12(ps, ch, th)), orass(ph, ps, wo(ch, th)), orass(ph, ch, wo(ps, th)))
theorem or42(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wb(wo(wo(ph, ps), wo(ch, th)), wo(wo(ph, ch), wo(th, ps)))) =
  bitri(wo(wo(ph, ps), wo(ch, th)), wo(wo(ph, ch), wo(ps, th)), wo(wo(ph, ch), wo(th, ps)), or4(ph, ps, ch, th), orbi2i(wo(ps, th), wo(th, ps), wo(ph, ch), orcom(ps, th)))
theorem orordi(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(ph, wo(ps, ch)), wo(wo(ph, ps), wo(ph, ch)))) =
  bitr3i(wo(ph, wo(ps, ch)), wo(wo(ph, ph), wo(ps, ch)), wo(wo(ph, ps), wo(ph, ch)), orbi1i(wo(ph, ph), ph, wo(ps, ch), oridm(ph)), or4(ph, ph, ps, ch))
theorem orordir(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(wo(ph, ps), ch), wo(wo(ph, ch), wo(ps, ch)))) =
  bitr3i(wo(wo(ph, ps), ch), wo(wo(ph, ps), wo(ch, ch)), wo(wo(ph, ch), wo(ps, ch)), orbi2i(wo(ch, ch), ch, wo(ph, ps), oridm(ch)), or4(ph, ps, ch, ch))
theorem orimdi(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(ph, wi(ps, ch)), wi(wo(ph, ps), wo(ph, ch)))) =
  3bitr4i(wi(wn(ph), wi(ps, ch)), wi(wi(wn(ph), ps), wi(wn(ph), ch)), wo(ph, wi(ps, ch)), wi(wo(ph, ps), wo(ph, ch)), imdi(wn(ph), ps, ch), df_or(ph, wi(ps, ch)), imbi12i(wo(ph, ps), wi(wn(ph), ps), wo(ph, ch), wi(wn(ph), ch), df_or(ph, ps), df_or(ph, ch)))
theorem pm2.76(ph: wff, ps: wff, ch: wff) -> Prf(wi(wo(ph, wi(ps, ch)), wi(wo(ph, ps), wo(ph, ch)))) =
  biimpi(wo(ph, wi(ps, ch)), wi(wo(ph, ps), wo(ph, ch)), orimdi(ph, ps, ch))
theorem pm2.85(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wo(ph, ps), wo(ph, ch)), wo(ph, wi(ps, ch)))) =
  biimpri(wo(ph, wi(ps, ch)), wi(wo(ph, ps), wo(ph, ch)), orimdi(ph, ps, ch))
theorem pm2.75(ph: wff, ps: wff, ch: wff) -> Prf(wi(wo(ph, ps), wi(wo(ph, wi(ps, ch)), wo(ph, ch)))) =
  com12(wo(ph, wi(ps, ch)), wo(ph, ps), wo(ph, ch), pm2.76(ph, ps, ch))
theorem pm4.78(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(wi(ph, ps), wi(ph, ch)), wi(ph, wo(ps, ch)))) =
  3bitr4ri(wo(wn(ph), wo(ps, ch)), wo(wo(wn(ph), ps), wo(wn(ph), ch)), wi(ph, wo(ps, ch)), wo(wi(ph, ps), wi(ph, ch)), orordi(wn(ph), ps, ch), imor(ph, wo(ps, ch)), orbi12i(wi(ph, ps), wo(wn(ph), ps), wi(ph, ch), wo(wn(ph), ch), imor(ph, ps), imor(ph, ch)))
theorem biort(ph: wff, ps: wff) -> Prf(wi(ph, wb(ph, wo(ph, ps)))) =
  2thd(ph, ph, wo(ph, ps), id(ph), orc(ph, ps))
theorem biorf(ph: wff, ps: wff) -> Prf(wi(wn(ph), wb(ps, wo(ph, ps)))) =
  impbid2(wn(ph), ps, wo(ph, ps), olc(ps, ph), orel1(ph, ps))
theorem biortn(ph: wff, ps: wff) -> Prf(wi(ph, wb(ps, wo(wn(ph), ps)))) =
  syl(ph, wn(wn(ph)), wb(ps, wo(wn(ph), ps)), notnot(ph), biorf(wn(ph), ps))
theorem biorfi(ph: wff, ps: wff, biorfi_1: Prf(wn(ph))) -> Prf(wb(ps, wo(ph, ps))) =
  ax_mp(wn(ph), wb(ps, wo(ph, ps)), biorfi_1, biorf(ph, ps))
theorem biorfri(ph: wff, ps: wff, biorfi_1: Prf(wn(ph))) -> Prf(wb(ps, wo(ps, ph))) =
  bitri(ps, wo(ph, ps), wo(ps, ph), biorfi(ph, ps, biorfi_1), orcom(ph, ps))
theorem pm2.26(ph: wff, ps: wff) -> Prf(wo(wn(ph), wi(wi(ph, ps), ps))) =
  imori(ph, wi(wi(ph, ps), ps), pm2.27(ph, ps))
theorem pm2.63(ph: wff, ps: wff) -> Prf(wi(wo(ph, ps), wi(wo(wn(ph), ps), ps))) =
  jaod(wo(ph, ps), wn(ph), ps, ps, pm2.53(ph, ps), idd(wo(ph, ps), ps))
theorem pm2.64(ph: wff, ps: wff) -> Prf(wi(wo(ph, ps), wi(wo(ph, wn(ps)), ph))) =
  com12(wo(ph, wn(ps)), wo(ph, ps), ph, jao1i(ph, wn(ps), wo(ph, ps), orel2(ps, ph)))
theorem pm2.42(ph: wff, ps: wff) -> Prf(wi(wo(wn(ph), wi(ph, ps)), wi(ph, ps))) =
  jaoi(wn(ph), wi(ph, ps), wi(ph, ps), pm2.21(ph, ps), id(wi(ph, ps)))
theorem pm5.11g(ph: wff, ps: wff, ch: wff) -> Prf(wo(wi(ph, ps), wi(wn(ph), ch))) =
  orri(wi(ph, ps), wi(wn(ph), ch), pm2.5g(ph, ps, ch))
theorem pm5.11(ph: wff, ps: wff) -> Prf(wo(wi(ph, ps), wi(wn(ph), ps))) =
  pm5.11g(ph, ps, ps)
theorem pm5.12(ph: wff, ps: wff) -> Prf(wo(wi(ph, ps), wi(ph, wn(ps)))) =
  orri(wi(ph, ps), wi(ph, wn(ps)), pm2.51(ph, ps))
theorem pm5.14(ph: wff, ps: wff, ch: wff) -> Prf(wo(wi(ph, ps), wi(ps, ch))) =
  orri(wi(ph, ps), wi(ps, ch), pm2.521g(ph, ps, ch))
theorem pm5.13(ph: wff, ps: wff) -> Prf(wo(wi(ph, ps), wi(ps, ph))) =
  pm5.14(ph, ps, ph)
theorem pm5.55(ph: wff, ps: wff) -> Prf(wo(wb(wo(ph, ps), ph), wb(wo(ph, ps), ps))) =
  orri(wb(wo(ph, ps), ph), wb(wo(ph, ps), ps), nsyl5(ph, wb(wo(ph, ps), ph), wb(wo(ph, ps), ps), bicomd(ph, ph, wo(ph, ps), biort(ph, ps)), bicomd(wn(ph), ps, wo(ph, ps), biorf(ph, ps))))
theorem pm4.72(ph: wff, ps: wff) -> Prf(wb(wi(ph, ps), wb(ps, wo(ph, ps)))) =
  impbii(wi(ph, ps), wb(ps, wo(ph, ps)), impbid2(wi(ph, ps), ps, wo(ph, ps), olc(ps, ph), pm2.621(ph, ps)), syl5(ph, wo(ph, ps), wb(ps, wo(ph, ps)), ps, orc(ph, ps), biimpr(ps, wo(ph, ps))))
theorem imimorb(ph: wff, ps: wff, ch: wff) -> Prf(wb(wi(wi(ps, ch), wi(ph, ch)), wi(ph, wo(ps, ch)))) =
  bitr4i(wi(wi(ps, ch), wi(ph, ch)), wi(ph, wi(wi(ps, ch), ch)), wi(ph, wo(ps, ch)), bi2.04(wi(ps, ch), ph, ch), imbi2i(wo(ps, ch), wi(wi(ps, ch), ch), ph, dfor2(ps, ch)))
theorem oibabs(ph: wff, ps: wff) -> Prf(wb(wi(wo(ph, ps), wb(ph, ps)), wb(ph, ps))) =
  impbii(wi(wo(ph, ps), wb(ph, ps)), wb(ph, ps), ja(wo(ph, ps), wb(ph, ps), wb(ph, ps), norbi(ph, ps), id(wb(ph, ps))), ax_1(wb(ph, ps), wo(ph, ps)))
theorem orbidi(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(ph, wb(ps, ch)), wb(wo(ph, ps), wo(ph, ch)))) =
  3bitr4i(wi(wn(ph), wb(ps, ch)), wb(wi(wn(ph), ps), wi(wn(ph), ch)), wo(ph, wb(ps, ch)), wb(wo(ph, ps), wo(ph, ch)), pm5.74(wn(ph), ps, ch), df_or(ph, wb(ps, ch)), bibi12i(wo(ph, ps), wi(wn(ph), ps), wo(ph, ch), wi(wn(ph), ch), df_or(ph, ps), df_or(ph, ch)))
theorem pm5.7(ph: wff, ps: wff, ch: wff) -> Prf(wb(wb(wo(ph, ch), wo(ps, ch)), wo(ch, wb(ph, ps)))) =
  bitr2i(wo(ch, wb(ph, ps)), wb(wo(ch, ph), wo(ch, ps)), wb(wo(ph, ch), wo(ps, ch)), orbidi(ch, ph, ps), bibi12i(wo(ch, ph), wo(ph, ch), wo(ch, ps), wo(ps, ch), orcom(ch, ph), orcom(ch, ps)))
theorem jaao(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, jaao_1: Prf(wi(ph, wi(ps, ch))), jaao_2: Prf(wi(th, wi(ta, ch)))) -> Prf(wi(wa(ph, th), wi(wo(ps, ta), ch))) =
  jaod(wa(ph, th), ps, ch, ta, adantr(ph, wi(ps, ch), th, jaao_1), adantl(th, wi(ta, ch), ph, jaao_2))
theorem jaoa(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, jaao_1: Prf(wi(ph, wi(ps, ch))), jaao_2: Prf(wi(th, wi(ta, ch)))) -> Prf(wi(wo(ph, th), wi(wa(ps, ta), ch))) =
  jaoi(ph, wi(wa(ps, ta), ch), th, adantrd(ph, ps, ch, ta, jaao_1), adantld(th, ta, ch, ps, jaao_2))
theorem jaoian(ph: wff, ps: wff, ch: wff, th: wff, jaoian_1: Prf(wi(wa(ph, ps), ch)), jaoian_2: Prf(wi(wa(th, ps), ch))) -> Prf(wi(wa(wo(ph, th), ps), ch)) =
  imp(wo(ph, th), ps, ch, jaoi(ph, wi(ps, ch), th, ex(ph, ps, ch, jaoian_1), ex(th, ps, ch, jaoian_2)))
theorem jaodan(ph: wff, ps: wff, ch: wff, th: wff, jaodan_1: Prf(wi(wa(ph, ps), ch)), jaodan_2: Prf(wi(wa(ph, th), ch))) -> Prf(wi(wa(ph, wo(ps, th)), ch)) =
  imp(ph, wo(ps, th), ch, jaod(ph, ps, ch, th, ex(ph, ps, ch, jaodan_1), ex(ph, th, ch, jaodan_2)))
theorem mpjaodan(ph: wff, ps: wff, ch: wff, th: wff, jaodan_1: Prf(wi(wa(ph, ps), ch)), jaodan_2: Prf(wi(wa(ph, th), ch)), jaodan_3: Prf(wi(ph, wo(ps, th)))) -> Prf(wi(ph, ch)) =
  mpdan(ph, wo(ps, th), ch, jaodan_3, jaodan(ph, ps, ch, th, jaodan_1, jaodan_2))
theorem pm3.44(ph: wff, ps: wff, ch: wff) -> Prf(wi(wa(wi(ps, ph), wi(ch, ph)), wi(wo(ps, ch), ph))) =
  jaao(wi(ps, ph), ps, ph, wi(ch, ph), ch, id(wi(ps, ph)), id(wi(ch, ph)))
theorem jao(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, ps), wi(wi(ch, ps), wi(wo(ph, ch), ps)))) =
  ex(wi(ph, ps), wi(ch, ps), wi(wo(ph, ch), ps), pm3.44(ps, ph, ch))
theorem jaob(ph: wff, ps: wff, ch: wff) -> Prf(wb(wi(wo(ph, ch), ps), wa(wi(ph, ps), wi(ch, ps)))) =
  impbii(wi(wo(ph, ch), ps), wa(wi(ph, ps), wi(ch, ps)), jca(wi(wo(ph, ch), ps), wi(ph, ps), wi(ch, ps), pm2.67_2(ph, ps, ch), imim1i(ch, wo(ph, ch), ps, olc(ch, ph))), pm3.44(ps, ph, ch))
theorem pm4.77(ph: wff, ps: wff, ch: wff) -> Prf(wb(wa(wi(ps, ph), wi(ch, ph)), wi(wo(ps, ch), ph))) =
  bicomi(wi(wo(ps, ch), ph), wa(wi(ps, ph), wi(ch, ph)), jaob(ps, ph, ch))
theorem pm3.48(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wa(wi(ph, ps), wi(ch, th)), wi(wo(ph, ch), wo(ps, th)))) =
  jaao(wi(ph, ps), ph, wo(ps, th), wi(ch, th), ch, imim2i(ps, wo(ps, th), ph, orc(ps, th)), imim2i(th, wo(ps, th), ch, olc(th, ps)))
theorem orim12d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, orim12d_1: Prf(wi(ph, wi(ps, ch))), orim12d_2: Prf(wi(ph, wi(th, ta)))) -> Prf(wi(ph, wi(wo(ps, th), wo(ch, ta)))) =
  syl2anc(ph, wi(ps, ch), wi(th, ta), wi(wo(ps, th), wo(ch, ta)), orim12d_1, orim12d_2, pm3.48(ps, ch, th, ta))
theorem orim12da(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, orim12da_1: Prf(wi(wa(ph, ps), th)), orim12da_2: Prf(wi(wa(ph, ch), ta)), orim12da_3: Prf(wi(ph, wo(ps, ch)))) -> Prf(wi(ph, wo(th, ta))) =
  mpd(ph, wo(ps, ch), wo(th, ta), orim12da_3, orim12d(ph, ps, th, ch, ta, ex(ph, ps, th, orim12da_1), ex(ph, ch, ta, orim12da_2)))
theorem orim1d(ph: wff, ps: wff, ch: wff, th: wff, orim1d_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, wi(wo(ps, th), wo(ch, th)))) =
  orim12d(ph, ps, ch, th, th, orim1d_1, idd(ph, th))
theorem orim2d(ph: wff, ps: wff, ch: wff, th: wff, orim1d_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, wi(wo(th, ps), wo(th, ch)))) =
  orim12d(ph, th, th, ps, ch, idd(ph, th), orim1d_1)
theorem orim2(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ps, ch), wi(wo(ph, ps), wo(ph, ch)))) =
  orim2d(wi(ps, ch), ps, ch, ph, id(wi(ps, ch)))
theorem pm2.38(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ps, ch), wi(wo(ps, ph), wo(ch, ph)))) =
  orim1d(wi(ps, ch), ps, ch, ph, id(wi(ps, ch)))
theorem pm2.36(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ps, ch), wi(wo(ph, ps), wo(ch, ph)))) =
  syl5(wo(ph, ps), wo(ps, ph), wi(ps, ch), wo(ch, ph), pm1.4(ph, ps), pm2.38(ph, ps, ch))
theorem pm2.37(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ps, ch), wi(wo(ps, ph), wo(ph, ch)))) =
  syl6(wi(ps, ch), wo(ps, ph), wo(ch, ph), wo(ph, ch), pm2.38(ph, ps, ch), pm1.4(ch, ph))
theorem pm2.81(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wi(ps, wi(ch, th)), wi(wo(ph, ps), wi(wo(ph, ch), wo(ph, th))))) =
  syl6(wi(ps, wi(ch, th)), wo(ph, ps), wo(ph, wi(ch, th)), wi(wo(ph, ch), wo(ph, th)), orim2(ph, ps, wi(ch, th)), pm2.76(ph, ch, th))
theorem pm2.8(ph: wff, ps: wff, ch: wff) -> Prf(wi(wo(ph, ps), wi(wo(wn(ps), ch), wo(ph, ch)))) =
  orim1d(wo(ph, ps), wn(ps), ph, ch, con1d(wo(ph, ps), ph, ps, pm2.53(ph, ps)))
theorem pm2.73(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, ps), wi(wo(wo(ph, ps), ch), wo(ps, ch)))) =
  orim1d(wi(ph, ps), wo(ph, ps), ps, ch, pm2.621(ph, ps))
theorem pm2.74(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ps, ph), wi(wo(wo(ph, ps), ch), wo(ph, ch)))) =
  orim1d(wi(ps, ph), wo(ph, ps), ph, ch, ja(ps, ph, wi(wo(ph, ps), ph), orel2(ps, ph), ax_1(ph, wo(ph, ps))))
theorem pm2.82(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wo(wo(ph, ps), ch), wi(wo(wo(ph, wn(ch)), th), wo(wo(ph, ps), th)))) =
  orim1d(wo(wo(ph, ps), ch), wo(ph, wn(ch)), wo(ph, ps), th, jao1i(wo(ph, ps), ch, wo(ph, wn(ch)), orim2d(ch, wn(ch), ps, ph, pm2.24(ch, ps))))
theorem pm4.39(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wa(wb(ph, ch), wb(ps, th)), wb(wo(ph, ps), wo(ch, th)))) =
  orbi12d(wa(wb(ph, ch), wb(ps, th)), ph, ch, ps, th, simpl(wb(ph, ch), wb(ps, th)), simpr(wb(ph, ch), wb(ps, th)))
theorem animorl(ph: wff, ps: wff, ch: wff) -> Prf(wi(wa(ph, ps), wo(ph, ch))) =
  orcd(wa(ph, ps), ph, ch, simpl(ph, ps))
theorem animorr(ph: wff, ps: wff, ch: wff) -> Prf(wi(wa(ph, ps), wo(ch, ps))) =
  olcd(wa(ph, ps), ps, ch, simpr(ph, ps))
theorem animorlr(ph: wff, ps: wff, ch: wff) -> Prf(wi(wa(ph, ps), wo(ch, ph))) =
  olcd(wa(ph, ps), ph, ch, simpl(ph, ps))
theorem animorrl(ph: wff, ps: wff, ch: wff) -> Prf(wi(wa(ph, ps), wo(ps, ch))) =
  orcd(wa(ph, ps), ps, ch, simpr(ph, ps))
theorem ianor(ph: wff, ps: wff) -> Prf(wb(wn(wa(ph, ps)), wo(wn(ph), wn(ps)))) =
  bitr3i(wn(wa(ph, ps)), wi(ph, wn(ps)), wo(wn(ph), wn(ps)), imnan(ph, ps), pm4.62(ph, ps))
theorem anor(ph: wff, ps: wff) -> Prf(wb(wa(ph, ps), wn(wo(wn(ph), wn(ps))))) =
