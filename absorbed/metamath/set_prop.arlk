theorem imp42(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, imp4_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, ta)))))) -> Prf(wi(wa(wa(ph, wa(ps, ch)), th), ta)) =
