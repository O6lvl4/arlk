theorem anandi(ph: wff, ps: wff, ch: wff) -> Prf(wb(wa(ph, wa(ps, ch)), wa(wa(ph, ps), wa(ph, ch)))) =
  bitr3i(wa(ph, wa(ps, ch)), wa(wa(ph, ph), wa(ps, ch)), wa(wa(ph, ps), wa(ph, ch)), anbi1i(wa(ph, ph), ph, wa(ps, ch), anidm(ph)), an4(ph, ph, ps, ch))
theorem anandir(ph: wff, ps: wff, ch: wff) -> Prf(wb(wa(wa(ph, ps), ch), wa(wa(ph, ch), wa(ps, ch)))) =
  bitr3i(wa(wa(ph, ps), ch), wa(wa(ph, ps), wa(ch, ch)), wa(wa(ph, ch), wa(ps, ch)), anbi2i(wa(ch, ch), ch, wa(ph, ps), anidm(ch)), an4(ph, ps, ch, ch))
theorem anandis(ph: wff, ps: wff, ch: wff, ta: wff, anandis_1: Prf(wi(wa(wa(ph, ps), wa(ph, ch)), ta))) -> Prf(wi(wa(ph, wa(ps, ch)), ta)) =
  anabsan(ph, wa(ps, ch), ta, an4s(ph, ps, ph, ch, ta, anandis_1))
theorem anandirs(ph: wff, ps: wff, ch: wff, ta: wff, anandirs_1: Prf(wi(wa(wa(ph, ch), wa(ps, ch)), ta))) -> Prf(wi(wa(wa(ph, ps), ch), ta)) =
  anabsan2(wa(ph, ps), ch, ta, an4s(ph, ch, ps, ch, ta, anandirs_1))
theorem sylanl1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, sylanl1_1: Prf(wi(ph, ps)), sylanl1_2: Prf(wi(wa(wa(ps, ch), th), ta))) -> Prf(wi(wa(wa(ph, ch), th), ta)) =
  sylan(wa(ph, ch), wa(ps, ch), th, ta, anim1i(ph, ps, ch, sylanl1_1), sylanl1_2)
theorem sylanl2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, sylanl2_1: Prf(wi(ph, ch)), sylanl2_2: Prf(wi(wa(wa(ps, ch), th), ta))) -> Prf(wi(wa(wa(ps, ph), th), ta)) =
  syldanl(ps, ph, ch, th, ta, adantl(ph, ch, ps, sylanl2_1), sylanl2_2)
theorem sylanr1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, sylanr1_1: Prf(wi(ph, ch)), sylanr1_2: Prf(wi(wa(ps, wa(ch, th)), ta))) -> Prf(wi(wa(ps, wa(ph, th)), ta)) =
  sylan2(wa(ph, th), ps, wa(ch, th), ta, anim1i(ph, ch, th, sylanr1_1), sylanr1_2)
theorem sylanr2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, sylanr2_1: Prf(wi(ph, th)), sylanr2_2: Prf(wi(wa(ps, wa(ch, th)), ta))) -> Prf(wi(wa(ps, wa(ch, ph)), ta)) =
  sylan2(wa(ch, ph), ps, wa(ch, th), ta, anim2i(ph, th, ch, sylanr2_1), sylanr2_2)
theorem syl6an(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl6an_1: Prf(wi(ph, ps)), syl6an_2: Prf(wi(ph, wi(ch, th))), syl6an_3: Prf(wi(wa(ps, th), ta))) -> Prf(wi(ph, wi(ch, ta))) =
  sylsyld(ph, ps, ch, th, ta, syl6an_1, syl6an_2, ex(ps, th, ta, syl6an_3))
theorem syl2an2r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl2an2r_1: Prf(wi(ph, ps)), syl2an2r_2: Prf(wi(wa(ph, ch), th)), syl2an2r_3: Prf(wi(wa(ps, th), ta))) -> Prf(wi(wa(ph, ch), ta)) =
  syldan(ph, ch, th, ta, syl2an2r_2, sylan(ph, ps, th, ta, syl2an2r_1, syl2an2r_3))
theorem syl2an2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl2an2_1: Prf(wi(ph, ps)), syl2an2_2: Prf(wi(wa(ch, ph), th)), syl2an2_3: Prf(wi(wa(ps, th), ta))) -> Prf(wi(wa(ch, ph), ta)) =
  syl2anc(wa(ch, ph), ps, th, ta, adantl(ph, ps, ch, syl2an2_1), syl2an2_2, syl2an2_3)
theorem mpdan(ph: wff, ps: wff, ch: wff, mpdan_1: Prf(wi(ph, ps)), mpdan_2: Prf(wi(wa(ph, ps), ch))) -> Prf(wi(ph, ch)) =
  syl2anc(ph, ph, ps, ch, id(ph), mpdan_1, mpdan_2)
theorem mpancom(ph: wff, ps: wff, ch: wff, mpancom_1: Prf(wi(ps, ph)), mpancom_2: Prf(wi(wa(ph, ps), ch))) -> Prf(wi(ps, ch)) =
  syl2anc(ps, ph, ps, ch, mpancom_1, id(ps), mpancom_2)
theorem mpidan(ph: wff, ps: wff, ch: wff, th: wff, mpidan_1: Prf(wi(ph, ch)), mpidan_2: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(wa(ph, ps), th)) =
  mpdan(wa(ph, ps), ch, th, adantr(ph, ch, ps, mpidan_1), mpidan_2)
theorem mpan(ph: wff, ps: wff, ch: wff, mpan_1: Prf(ph), mpan_2: Prf(wi(wa(ph, ps), ch))) -> Prf(wi(ps, ch)) =
  mpancom(ph, ps, ch, a1i(ph, ps, mpan_1), mpan_2)
theorem mpan2(ph: wff, ps: wff, ch: wff, mpan2_1: Prf(ps), mpan2_2: Prf(wi(wa(ph, ps), ch))) -> Prf(wi(ph, ch)) =
  mpdan(ph, ps, ch, a1i(ps, ph, mpan2_1), mpan2_2)
theorem mp2an(ph: wff, ps: wff, ch: wff, mp2an_1: Prf(ph), mp2an_2: Prf(ps), mp2an_3: Prf(wi(wa(ph, ps), ch))) -> Prf(ch) =
  ax_mp(ps, ch, mp2an_2, mpan(ph, ps, ch, mp2an_1, mp2an_3))
theorem mp4an(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, mp4an_1: Prf(ph), mp4an_2: Prf(ps), mp4an_3: Prf(ch), mp4an_4: Prf(th), mp4an_5: Prf(wi(wa(wa(ph, ps), wa(ch, th)), ta))) -> Prf(ta) =
  mp2an(wa(ph, ps), wa(ch, th), ta, pm3.2i(ph, ps, mp4an_1, mp4an_2), pm3.2i(ch, th, mp4an_3, mp4an_4), mp4an_5)
theorem mpan2d(ph: wff, ps: wff, ch: wff, th: wff, mpan2d_1: Prf(wi(ph, ch)), mpan2d_2: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(ph, wi(ps, th))) =
  mpid(ph, ps, ch, th, mpan2d_1, expd(ph, ps, ch, th, mpan2d_2))
theorem mpand(ph: wff, ps: wff, ch: wff, th: wff, mpand_1: Prf(wi(ph, ps)), mpand_2: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(ph, wi(ch, th))) =
  mpan2d(ph, ch, ps, th, mpand_1, ancomsd(ph, ps, ch, th, mpand_2))
theorem mpani(ph: wff, ps: wff, ch: wff, th: wff, mpani_1: Prf(ps), mpani_2: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(ph, wi(ch, th))) =
  mpand(ph, ps, ch, th, a1i(ps, ph, mpani_1), mpani_2)
theorem mpan2i(ph: wff, ps: wff, ch: wff, th: wff, mpan2i_1: Prf(ch), mpan2i_2: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(ph, wi(ps, th))) =
  mpan2d(ph, ps, ch, th, a1i(ch, ph, mpan2i_1), mpan2i_2)
theorem mp2ani(ph: wff, ps: wff, ch: wff, th: wff, mp2ani_1: Prf(ps), mp2ani_2: Prf(ch), mp2ani_3: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(ph, th)) =
  mpi(ph, ch, th, mp2ani_2, mpani(ph, ps, ch, th, mp2ani_1, mp2ani_3))
theorem mp2and(ph: wff, ps: wff, ch: wff, th: wff, mp2and_1: Prf(wi(ph, ps)), mp2and_2: Prf(wi(ph, ch)), mp2and_3: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(ph, th)) =
  mpd(ph, ch, th, mp2and_2, mpand(ph, ps, ch, th, mp2and_1, mp2and_3))
theorem mpanl1(ph: wff, ps: wff, ch: wff, th: wff, mpanl1_1: Prf(ph), mpanl1_2: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(wa(ps, ch), th)) =
  sylan(ps, wa(ph, ps), ch, th, jctl(ps, ph, mpanl1_1), mpanl1_2)
theorem mpanl2(ph: wff, ps: wff, ch: wff, th: wff, mpanl2_1: Prf(ps), mpanl2_2: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(wa(ph, ch), th)) =
  sylan(ph, wa(ph, ps), ch, th, jctr(ph, ps, mpanl2_1), mpanl2_2)
theorem mpanl12(ph: wff, ps: wff, ch: wff, th: wff, mpanl12_1: Prf(ph), mpanl12_2: Prf(ps), mpanl12_3: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(ch, th)) =
  mpan(ps, ch, th, mpanl12_2, mpanl1(ph, ps, ch, th, mpanl12_1, mpanl12_3))
