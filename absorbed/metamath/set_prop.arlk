theorem dedt(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, dedt_1: Prf(wi(wb(wif(ch, ph, ps), ph), wb(ta, th))), dedt_2: Prf(ta)) -> Prf(wi(ch, th)) =
