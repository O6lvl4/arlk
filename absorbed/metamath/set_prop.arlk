theorem 3adant1(ph: wff, ps: wff, ch: wff, th: wff, 3adant_1: Prf(wi(wa(ph, ps), ch))) -> Prf(wi(w3a(th, ph, ps), ch)) =
  3impa(th, ph, ps, ch, adantll(ph, ps, ch, th, 3adant_1))
theorem 3adant2(ph: wff, ps: wff, ch: wff, th: wff, 3adant_1: Prf(wi(wa(ph, ps), ch))) -> Prf(wi(w3a(ph, th, ps), ch)) =
  3impa(ph, th, ps, ch, adantlr(ph, ps, ch, th, 3adant_1))
theorem 3adant3(ph: wff, ps: wff, ch: wff, th: wff, 3adant_1: Prf(wi(wa(ph, ps), ch))) -> Prf(wi(w3a(ph, ps, th), ch)) =
  3impb(ph, ps, th, ch, adantrr(ph, ps, ch, th, 3adant_1))
theorem 3ad2ant1(ph: wff, ps: wff, ch: wff, th: wff, 3ad2ant_1: Prf(wi(ph, ch))) -> Prf(wi(w3a(ph, ps, th), ch)) =
  3adant2(ph, th, ch, ps, adantr(ph, ch, th, 3ad2ant_1))
theorem 3ad2ant2(ph: wff, ps: wff, ch: wff, th: wff, 3ad2ant_1: Prf(wi(ph, ch))) -> Prf(wi(w3a(ps, ph, th), ch)) =
  3adant1(ph, th, ch, ps, adantr(ph, ch, th, 3ad2ant_1))
theorem 3ad2ant3(ph: wff, ps: wff, ch: wff, th: wff, 3ad2ant_1: Prf(wi(ph, ch))) -> Prf(wi(w3a(ps, th, ph), ch)) =
  3adant1(th, ph, ch, ps, adantl(ph, ch, th, 3ad2ant_1))
theorem simp1(ph: wff, ps: wff, ch: wff) -> Prf(wi(w3a(ph, ps, ch), ph)) =
  3ad2ant1(ph, ps, ph, ch, id(ph))
theorem simp2(ph: wff, ps: wff, ch: wff) -> Prf(wi(w3a(ph, ps, ch), ps)) =
  3ad2ant2(ps, ph, ps, ch, id(ps))
theorem simp3(ph: wff, ps: wff, ch: wff) -> Prf(wi(w3a(ph, ps, ch), ch)) =
  3ad2ant3(ch, ph, ch, ps, id(ch))
theorem simp1i(ph: wff, ps: wff, ch: wff, 3simp1i_1: Prf(w3a(ph, ps, ch))) -> Prf(ph) =
  ax_mp(w3a(ph, ps, ch), ph, 3simp1i_1, simp1(ph, ps, ch))
theorem simp2i(ph: wff, ps: wff, ch: wff, 3simp1i_1: Prf(w3a(ph, ps, ch))) -> Prf(ps) =
  ax_mp(w3a(ph, ps, ch), ps, 3simp1i_1, simp2(ph, ps, ch))
theorem simp3i(ph: wff, ps: wff, ch: wff, 3simp1i_1: Prf(w3a(ph, ps, ch))) -> Prf(ch) =
  ax_mp(w3a(ph, ps, ch), ch, 3simp1i_1, simp3(ph, ps, ch))
theorem simp1d(ph: wff, ps: wff, ch: wff, th: wff, 3simp1d_1: Prf(wi(ph, w3a(ps, ch, th)))) -> Prf(wi(ph, ps)) =
  syl(ph, w3a(ps, ch, th), ps, 3simp1d_1, simp1(ps, ch, th))
theorem simp2d(ph: wff, ps: wff, ch: wff, th: wff, 3simp1d_1: Prf(wi(ph, w3a(ps, ch, th)))) -> Prf(wi(ph, ch)) =
  syl(ph, w3a(ps, ch, th), ch, 3simp1d_1, simp2(ps, ch, th))
theorem simp3d(ph: wff, ps: wff, ch: wff, th: wff, 3simp1d_1: Prf(wi(ph, w3a(ps, ch, th)))) -> Prf(wi(ph, th)) =
  syl(ph, w3a(ps, ch, th), th, 3simp1d_1, simp3(ps, ch, th))
theorem simp1bi(ph: wff, ps: wff, ch: wff, th: wff, 3simp1bi_1: Prf(wb(ph, w3a(ps, ch, th)))) -> Prf(wi(ph, ps)) =
  simp1d(ph, ps, ch, th, biimpi(ph, w3a(ps, ch, th), 3simp1bi_1))
theorem simp2bi(ph: wff, ps: wff, ch: wff, th: wff, 3simp1bi_1: Prf(wb(ph, w3a(ps, ch, th)))) -> Prf(wi(ph, ch)) =
  simp2d(ph, ps, ch, th, biimpi(ph, w3a(ps, ch, th), 3simp1bi_1))
theorem simp3bi(ph: wff, ps: wff, ch: wff, th: wff, 3simp1bi_1: Prf(wb(ph, w3a(ps, ch, th)))) -> Prf(wi(ph, th)) =
  simp3d(ph, ps, ch, th, biimpi(ph, w3a(ps, ch, th), 3simp1bi_1))
theorem 3simpa(ph: wff, ps: wff, ch: wff) -> Prf(wi(w3a(ph, ps, ch), wa(ph, ps))) =
  3adant3(ph, ps, wa(ph, ps), ch, id(wa(ph, ps)))
theorem 3simpb(ph: wff, ps: wff, ch: wff) -> Prf(wi(w3a(ph, ps, ch), wa(ph, ch))) =
  3adant2(ph, ch, wa(ph, ch), ps, id(wa(ph, ch)))
theorem 3simpc(ph: wff, ps: wff, ch: wff) -> Prf(wi(w3a(ph, ps, ch), wa(ps, ch))) =
  3adant1(ps, ch, wa(ps, ch), ph, id(wa(ps, ch)))
theorem 3anim123i(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, 3anim123i_1: Prf(wi(ph, ps)), 3anim123i_2: Prf(wi(ch, th)), 3anim123i_3: Prf(wi(ta, et))) -> Prf(wi(w3a(ph, ch, ta), w3a(ps, th, et))) =
  3jca(w3a(ph, ch, ta), ps, th, et, 3ad2ant1(ph, ch, ps, ta, 3anim123i_1), 3ad2ant2(ch, ph, th, ta, 3anim123i_2), 3ad2ant3(ta, ph, et, ch, 3anim123i_3))
theorem 3anim1i(ph: wff, ps: wff, ch: wff, th: wff, 3animi_1: Prf(wi(ph, ps))) -> Prf(wi(w3a(ph, ch, th), w3a(ps, ch, th))) =
  3anim123i(ph, ps, ch, ch, th, th, 3animi_1, id(ch), id(th))
theorem 3anim2i(ph: wff, ps: wff, ch: wff, th: wff, 3animi_1: Prf(wi(ph, ps))) -> Prf(wi(w3a(ch, ph, th), w3a(ch, ps, th))) =
  3anim123i(ch, ch, ph, ps, th, th, id(ch), 3animi_1, id(th))
theorem 3anim3i(ph: wff, ps: wff, ch: wff, th: wff, 3animi_1: Prf(wi(ph, ps))) -> Prf(wi(w3a(ch, th, ph), w3a(ch, th, ps))) =
  3anim123i(ch, ch, th, th, ph, ps, id(ch), id(th), 3animi_1)
theorem 3anbi123i(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, bi3_1: Prf(wb(ph, ps)), bi3_2: Prf(wb(ch, th)), bi3_3: Prf(wb(ta, et))) -> Prf(wb(w3a(ph, ch, ta), w3a(ps, th, et))) =
  3bitr4i(wa(wa(ph, ch), ta), wa(wa(ps, th), et), w3a(ph, ch, ta), w3a(ps, th, et), anbi12i(wa(ph, ch), wa(ps, th), ta, et, anbi12i(ph, ps, ch, th, bi3_1, bi3_2), bi3_3), df_3an(ph, ch, ta), df_3an(ps, th, et))
theorem 3orbi123i(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, bi3_1: Prf(wb(ph, ps)), bi3_2: Prf(wb(ch, th)), bi3_3: Prf(wb(ta, et))) -> Prf(wb(w3o(ph, ch, ta), w3o(ps, th, et))) =
  3bitr4i(wo(wo(ph, ch), ta), wo(wo(ps, th), et), w3o(ph, ch, ta), w3o(ps, th, et), orbi12i(wo(ph, ch), wo(ps, th), ta, et, orbi12i(ph, ps, ch, th, bi3_1, bi3_2), bi3_3), df_3or(ph, ch, ta), df_3or(ps, th, et))
theorem 3anbi1i(ph: wff, ps: wff, ch: wff, th: wff, 3anbi1i_1: Prf(wb(ph, ps))) -> Prf(wb(w3a(ph, ch, th), w3a(ps, ch, th))) =
  3anbi123i(ph, ps, ch, ch, th, th, 3anbi1i_1, biid(ch), biid(th))
theorem 3anbi2i(ph: wff, ps: wff, ch: wff, th: wff, 3anbi1i_1: Prf(wb(ph, ps))) -> Prf(wb(w3a(ch, ph, th), w3a(ch, ps, th))) =
  3anbi123i(ch, ch, ph, ps, th, th, biid(ch), 3anbi1i_1, biid(th))
theorem 3anbi3i(ph: wff, ps: wff, ch: wff, th: wff, 3anbi1i_1: Prf(wb(ph, ps))) -> Prf(wb(w3a(ch, th, ph), w3a(ch, th, ps))) =
  3anbi123i(ch, ch, th, th, ph, ps, biid(ch), biid(th), 3anbi1i_1)
theorem syl3an(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, ze: wff, syl3an_1: Prf(wi(ph, ps)), syl3an_2: Prf(wi(ch, th)), syl3an_3: Prf(wi(ta, et)), syl3an_4: Prf(wi(w3a(ps, th, et), ze))) -> Prf(wi(w3a(ph, ch, ta), ze)) =
  syl(w3a(ph, ch, ta), w3a(ps, th, et), ze, 3anim123i(ph, ps, ch, th, ta, et, syl3an_1, syl3an_2, syl3an_3), syl3an_4)
theorem syl3anb(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, ze: wff, syl3anb_1: Prf(wb(ph, ps)), syl3anb_2: Prf(wb(ch, th)), syl3anb_3: Prf(wb(ta, et)), syl3anb_4: Prf(wi(w3a(ps, th, et), ze))) -> Prf(wi(w3a(ph, ch, ta), ze)) =
  sylbi(w3a(ph, ch, ta), w3a(ps, th, et), ze, 3anbi123i(ph, ps, ch, th, ta, et, syl3anb_1, syl3anb_2, syl3anb_3), syl3anb_4)
theorem syl3anbr(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, ze: wff, syl3anbr_1: Prf(wb(ps, ph)), syl3anbr_2: Prf(wb(th, ch)), syl3anbr_3: Prf(wb(et, ta)), syl3anbr_4: Prf(wi(w3a(ps, th, et), ze))) -> Prf(wi(w3a(ph, ch, ta), ze)) =
  syl3anb(ph, ps, ch, th, ta, et, ze, bicomi(ps, ph, syl3anbr_1), bicomi(th, ch, syl3anbr_2), bicomi(et, ta, syl3anbr_3), syl3anbr_4)
theorem syl3an1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl3an1_1: Prf(wi(ph, ps)), syl3an1_2: Prf(wi(w3a(ps, ch, th), ta))) -> Prf(wi(w3a(ph, ch, th), ta)) =
  syl(w3a(ph, ch, th), w3a(ps, ch, th), ta, 3anim1i(ph, ps, ch, th, syl3an1_1), syl3an1_2)
theorem syl3an2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl3an2_1: Prf(wi(ph, ch)), syl3an2_2: Prf(wi(w3a(ps, ch, th), ta))) -> Prf(wi(w3a(ps, ph, th), ta)) =
  syl(w3a(ps, ph, th), w3a(ps, ch, th), ta, 3anim2i(ph, ch, ps, th, syl3an2_1), syl3an2_2)
theorem syl3an3(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl3an3_1: Prf(wi(ph, th)), syl3an3_2: Prf(wi(w3a(ps, ch, th), ta))) -> Prf(wi(w3a(ps, ch, ph), ta)) =
  syl(w3a(ps, ch, ph), w3a(ps, ch, th), ta, 3anim3i(ph, th, ps, ch, syl3an3_1), syl3an3_2)
theorem syl3an132(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, syl3an132_1: Prf(wi(ph, ps)), syl3an132_2: Prf(wi(wa(ch, th), ta)), syl3an132_3: Prf(wi(wa(ps, ta), et))) -> Prf(wi(w3a(ph, ch, th), et)) =
  3impb(ph, ch, th, et, syl2an(ph, ps, ta, et, wa(ch, th), syl3an132_1, syl3an132_2, syl3an132_3))
theorem 3adantl1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3adantl_1: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(wa(w3a(ta, ph, ps), ch), th)) =
  sylan(w3a(ta, ph, ps), wa(ph, ps), ch, th, 3simpc(ta, ph, ps), 3adantl_1)
theorem 3adantl2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3adantl_1: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(wa(w3a(ph, ta, ps), ch), th)) =
  sylan(w3a(ph, ta, ps), wa(ph, ps), ch, th, 3simpb(ph, ta, ps), 3adantl_1)
theorem 3adantl3(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3adantl_1: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(wa(w3a(ph, ps, ta), ch), th)) =
  sylan(w3a(ph, ps, ta), wa(ph, ps), ch, th, 3simpa(ph, ps, ta), 3adantl_1)
theorem 3adantr1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3adantr_1: Prf(wi(wa(ph, wa(ps, ch)), th))) -> Prf(wi(wa(ph, w3a(ta, ps, ch)), th)) =
  sylan2(w3a(ta, ps, ch), ph, wa(ps, ch), th, 3simpc(ta, ps, ch), 3adantr_1)
theorem 3adantr2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3adantr_1: Prf(wi(wa(ph, wa(ps, ch)), th))) -> Prf(wi(wa(ph, w3a(ps, ta, ch)), th)) =
  sylan2(w3a(ps, ta, ch), ph, wa(ps, ch), th, 3simpb(ps, ta, ch), 3adantr_1)
theorem 3adantr3(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3adantr_1: Prf(wi(wa(ph, wa(ps, ch)), th))) -> Prf(wi(wa(ph, w3a(ps, ch, ta)), th)) =
  sylan2(w3a(ps, ch, ta), ph, wa(ps, ch), th, 3simpa(ps, ch, ta), 3adantr_1)
theorem ad4ant123(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(wa(wa(wa(ph, ps), ch), ta), th)) =
  adantr(wa(wa(ph, ps), ch), th, ta, 3expa(ph, ps, ch, th, ad4ant3_1))
theorem ad4ant124(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(wa(wa(wa(ph, ps), ta), ch), th)) =
  adantlr(wa(ph, ps), ch, th, ta, 3expa(ph, ps, ch, th, ad4ant3_1))
theorem ad4ant134(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(wa(wa(wa(ph, ta), ps), ch), th)) =
  adantllr(ph, ps, ch, th, ta, 3expa(ph, ps, ch, th, ad4ant3_1))
theorem ad4ant234(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(wa(wa(wa(ta, ph), ps), ch), th)) =
  adantlll(ph, ps, ch, th, ta, 3expa(ph, ps, ch, th, ad4ant3_1))
theorem 3adant1l(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(w3a(wa(ta, ph), ps, ch), th)) =
  syl3an1(wa(ta, ph), ph, ps, ch, th, simpr(ta, ph), ad4ant3_1)
theorem 3adant1r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(w3a(wa(ph, ta), ps, ch), th)) =
  syl3an1(wa(ph, ta), ph, ps, ch, th, simpl(ph, ta), ad4ant3_1)
theorem 3adant2l(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(w3a(ph, wa(ta, ps), ch), th)) =
  syl3an2(wa(ta, ps), ph, ps, ch, th, simpr(ta, ps), ad4ant3_1)
theorem 3adant2r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(w3a(ph, wa(ps, ta), ch), th)) =
  syl3an2(wa(ps, ta), ph, ps, ch, th, simpl(ps, ta), ad4ant3_1)
theorem 3adant3l(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(w3a(ph, ps, wa(ta, ch)), th)) =
  syl3an3(wa(ta, ch), ph, ps, ch, th, simpr(ta, ch), ad4ant3_1)
theorem 3adant3r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(w3a(ph, ps, wa(ch, ta)), th)) =
  syl3an3(wa(ch, ta), ph, ps, ch, th, simpl(ch, ta), ad4ant3_1)
theorem 3adant3r1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(wa(ph, w3a(ta, ps, ch)), th)) =
  3adantr1(ph, ps, ch, th, ta, 3expb(ph, ps, ch, th, ad4ant3_1))
theorem 3adant3r2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(wa(ph, w3a(ps, ta, ch)), th)) =
  3adantr2(ph, ps, ch, th, ta, 3expb(ph, ps, ch, th, ad4ant3_1))
theorem 3adant3r3(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, ad4ant3_1: Prf(wi(w3a(ph, ps, ch), th))) -> Prf(wi(wa(ph, w3a(ps, ch, ta)), th)) =
  3adantr3(ph, ps, ch, th, ta, 3expb(ph, ps, ch, th, ad4ant3_1))
theorem 3ad2antl1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3ad2antl_1: Prf(wi(wa(ph, ch), th))) -> Prf(wi(wa(w3a(ph, ps, ta), ch), th)) =
  3adantl2(ph, ta, ch, th, ps, adantlr(ph, ch, th, ta, 3ad2antl_1))
theorem 3ad2antl2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3ad2antl_1: Prf(wi(wa(ph, ch), th))) -> Prf(wi(wa(w3a(ps, ph, ta), ch), th)) =
  3adantl1(ph, ta, ch, th, ps, adantlr(ph, ch, th, ta, 3ad2antl_1))
theorem 3ad2antl3(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3ad2antl_1: Prf(wi(wa(ph, ch), th))) -> Prf(wi(wa(w3a(ps, ta, ph), ch), th)) =
  3adantl1(ta, ph, ch, th, ps, adantll(ph, ch, th, ta, 3ad2antl_1))
theorem 3ad2antr1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3ad2antl_1: Prf(wi(wa(ph, ch), th))) -> Prf(wi(wa(ph, w3a(ch, ps, ta)), th)) =
  3adantr3(ph, ch, ps, th, ta, adantrr(ph, ch, th, ps, 3ad2antl_1))
theorem 3ad2antr2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3ad2antl_1: Prf(wi(wa(ph, ch), th))) -> Prf(wi(wa(ph, w3a(ps, ch, ta)), th)) =
  3adantr3(ph, ps, ch, th, ta, adantrl(ph, ch, th, ps, 3ad2antl_1))
theorem 3ad2antr3(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3ad2antl_1: Prf(wi(wa(ph, ch), th))) -> Prf(wi(wa(ph, w3a(ps, ta, ch)), th)) =
  3adantr1(ph, ta, ch, th, ps, adantrl(ph, ch, th, ta, 3ad2antl_1))
theorem simpl1(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wa(w3a(ph, ps, ch), th), ph)) =
  3ad2antl1(ph, ps, th, ph, ch, simpl(ph, th))
theorem simpl2(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wa(w3a(ph, ps, ch), th), ps)) =
  3ad2antl2(ps, ph, th, ps, ch, simpl(ps, th))
theorem simpl3(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wa(w3a(ph, ps, ch), th), ch)) =
  3ad2antl3(ch, ph, th, ch, ps, simpl(ch, th))
theorem simpr1(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wa(ph, w3a(ps, ch, th)), ps)) =
  3ad2antr1(ph, ch, ps, ps, th, simpr(ph, ps))
theorem simpr2(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wa(ph, w3a(ps, ch, th)), ch)) =
  3ad2antr2(ph, ps, ch, ch, th, simpr(ph, ch))
theorem simpr3(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wa(ph, w3a(ps, ch, th)), th)) =
  3ad2antr3(ph, ps, th, th, ch, simpr(ph, th))
theorem simp1l(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(w3a(wa(ph, ps), ch, th), ph)) =
  3ad2ant1(wa(ph, ps), ch, ph, th, simpl(ph, ps))
theorem simp1r(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(w3a(wa(ph, ps), ch, th), ps)) =
  3ad2ant1(wa(ph, ps), ch, ps, th, simpr(ph, ps))
theorem simp2l(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(w3a(ph, wa(ps, ch), th), ps)) =
