  expd(ph, ps, ch, wi(th, ta), expd(ph, wa(ps, ch), th, ta, exp4c_1))
theorem exp4d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, exp4d_1: Prf(wi(ph, wi(wa(ps, wa(ch, th)), ta)))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, ta))))) =
  exp4a(ph, ps, ch, th, ta, expd(ph, ps, wa(ch, th), ta, exp4d_1))
theorem exp41(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, exp41_1: Prf(wi(wa(wa(wa(ph, ps), ch), th), ta))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, ta))))) =
  exp31(ph, ps, ch, wi(th, ta), ex(wa(wa(ph, ps), ch), th, ta, exp41_1))
