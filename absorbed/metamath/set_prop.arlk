theorem 3jcad(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3jcad_1: Prf(wi(ph, wi(ps, ch))), 3jcad_2: Prf(wi(ph, wi(ps, th))), 3jcad_3: Prf(wi(ph, wi(ps, ta)))) -> Prf(wi(ph, wi(ps, w3a(ch, th, ta)))) =
