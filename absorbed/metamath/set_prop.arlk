  sylan2d(ps, ph, th, ch, ta, a1i(wi(ph, th), ps, sylan2i_1), sylan2i_2)
theorem syl2ani(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, syl2ani_1: Prf(wi(ph, ch)), syl2ani_2: Prf(wi(et, th)), syl2ani_3: Prf(wi(ps, wi(wa(ch, th), ta)))) -> Prf(wi(ps, wi(wa(ph, et), ta))) =
  sylani(ph, ps, ch, et, ta, syl2ani_1, sylan2i(et, ps, ch, th, ta, syl2ani_2, syl2ani_3))
theorem syl2and(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, syl2and_1: Prf(wi(ph, wi(ps, ch))), syl2and_2: Prf(wi(ph, wi(th, ta))), syl2and_3: Prf(wi(ph, wi(wa(ch, ta), et)))) -> Prf(wi(ph, wi(wa(ps, th), et))) =
  syland(ph, ps, ch, th, et, syl2and_1, sylan2d(ph, th, ta, ch, et, syl2and_2, syl2and_3))
theorem anim12d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, anim12d_1: Prf(wi(ph, wi(ps, ch))), anim12d_2: Prf(wi(ph, wi(th, ta)))) -> Prf(wi(ph, wi(wa(ps, th), wa(ch, ta)))) =
  syl2and(ph, ps, ch, th, ta, wa(ch, ta), anim12d_1, anim12d_2, idd(ph, wa(ch, ta)))
theorem anim12d1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, anim12d1_1: Prf(wi(ph, wi(ps, ch))), anim12d1_2: Prf(wi(th, ta))) -> Prf(wi(ph, wi(wa(ps, th), wa(ch, ta)))) =
  anim12d(ph, ps, ch, th, ta, anim12d1_1, a1i(wi(th, ta), ph, anim12d1_2))
theorem anim1d(ph: wff, ps: wff, ch: wff, th: wff, anim1d_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, wi(wa(ps, th), wa(ch, th)))) =
  anim12d(ph, ps, ch, th, th, anim1d_1, idd(ph, th))
theorem anim2d(ph: wff, ps: wff, ch: wff, th: wff, anim1d_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, wi(wa(th, ps), wa(th, ch)))) =
  anim12d(ph, th, th, ps, ch, idd(ph, th), anim1d_1)
theorem anim12i(ph: wff, ps: wff, ch: wff, th: wff, anim12i_1: Prf(wi(ph, ps)), anim12i_2: Prf(wi(ch, th))) -> Prf(wi(wa(ph, ch), wa(ps, th))) =
  syl2an(ph, ps, th, wa(ps, th), ch, anim12i_1, anim12i_2, id(wa(ps, th)))
theorem anim12ci(ph: wff, ps: wff, ch: wff, th: wff, anim12i_1: Prf(wi(ph, ps)), anim12i_2: Prf(wi(ch, th))) -> Prf(wi(wa(ph, ch), wa(th, ps))) =
  ancoms(ch, ph, wa(th, ps), anim12i(ch, th, ph, ps, anim12i_2, anim12i_1))
theorem anim1i(ph: wff, ps: wff, ch: wff, anim1i_1: Prf(wi(ph, ps))) -> Prf(wi(wa(ph, ch), wa(ps, ch))) =
  anim12i(ph, ps, ch, ch, anim1i_1, id(ch))
theorem anim1ci(ph: wff, ps: wff, ch: wff, anim1i_1: Prf(wi(ph, ps))) -> Prf(wi(wa(ph, ch), wa(ch, ps))) =
  anim12ci(ph, ps, ch, ch, anim1i_1, id(ch))
theorem anim2i(ph: wff, ps: wff, ch: wff, anim1i_1: Prf(wi(ph, ps))) -> Prf(wi(wa(ch, ph), wa(ch, ps))) =
  anim12i(ch, ch, ph, ps, id(ch), anim1i_1)
theorem anim12ii(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, anim12ii_1: Prf(wi(ph, wi(ps, ch))), anim12ii_2: Prf(wi(th, wi(ps, ta)))) -> Prf(wi(wa(ph, th), wi(ps, wa(ch, ta)))) =
  syl2an(ph, wi(ps, ch), wi(ps, ta), wi(ps, wa(ch, ta)), th, anim12ii_1, anim12ii_2, pm3.43(ps, ch, ta))
theorem anim12dan(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, anim12dan_1: Prf(wi(wa(ph, ps), ch)), anim12dan_2: Prf(wi(wa(ph, th), ta))) -> Prf(wi(wa(ph, wa(ps, th)), wa(ch, ta))) =
  imp(ph, wa(ps, th), wa(ch, ta), anim12d(ph, ps, ch, th, ta, ex(ph, ps, ch, anim12dan_1), ex(ph, th, ta, anim12dan_2)))
theorem im2anan9(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, im2an9_1: Prf(wi(ph, wi(ps, ch))), im2an9_2: Prf(wi(th, wi(ta, et)))) -> Prf(wi(wa(ph, th), wi(wa(ps, ta), wa(ch, et)))) =
  anim12ii(ph, wa(ps, ta), ch, th, et, adantrd(ph, ps, ch, ta, im2an9_1), adantld(th, ta, et, ps, im2an9_2))
theorem im2anan9r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, im2an9_1: Prf(wi(ph, wi(ps, ch))), im2an9_2: Prf(wi(th, wi(ta, et)))) -> Prf(wi(wa(th, ph), wi(wa(ps, ta), wa(ch, et)))) =
  ancoms(ph, th, wi(wa(ps, ta), wa(ch, et)), im2anan9(ph, ps, ch, th, ta, et, im2an9_1, im2an9_2))
theorem pm3.45(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, ps), wi(wa(ph, ch), wa(ps, ch)))) =
  anim1d(wi(ph, ps), ph, ps, ch, id(wi(ph, ps)))
theorem anbi2i(ph: wff, ps: wff, ch: wff, anbi_1: Prf(wb(ph, ps))) -> Prf(wb(wa(ch, ph), wa(ch, ps))) =
  pm5.32i(ch, ph, ps, a1i(wb(ph, ps), ch, anbi_1))
theorem anbi1i(ph: wff, ps: wff, ch: wff, anbi_1: Prf(wb(ph, ps))) -> Prf(wb(wa(ph, ch), wa(ps, ch))) =
  pm5.32ri(ch, ph, ps, a1i(wb(ph, ps), ch, anbi_1))
theorem anbi2ci(ph: wff, ps: wff, ch: wff, anbi_1: Prf(wb(ph, ps))) -> Prf(wb(wa(ph, ch), wa(ch, ps))) =
  biancomi(wa(ph, ch), ch, ps, anbi1i(ph, ps, ch, anbi_1))
theorem anbi1ci(ph: wff, ps: wff, ch: wff, anbi_1: Prf(wb(ph, ps))) -> Prf(wb(wa(ch, ph), wa(ps, ch))) =
  biancomi(wa(ch, ph), ps, ch, anbi2i(ph, ps, ch, anbi_1))
theorem bianbi(ph: wff, ps: wff, ch: wff, th: wff, bianbi_1: Prf(wb(ph, wa(ps, ch))), bianbi_2: Prf(wb(ps, th))) -> Prf(wb(ph, wa(th, ch))) =
  bitri(ph, wa(ps, ch), wa(th, ch), bianbi_1, anbi1i(ps, th, ch, bianbi_2))
theorem anbi12i(ph: wff, ps: wff, ch: wff, th: wff, anbi12_1: Prf(wb(ph, ps)), anbi12_2: Prf(wb(ch, th))) -> Prf(wb(wa(ph, ch), wa(ps, th))) =
  bianbi(wa(ph, ch), ph, th, ps, anbi2i(ch, th, ph, anbi12_2), anbi12_1)
theorem anbi12ci(ph: wff, ps: wff, ch: wff, th: wff, anbi12_1: Prf(wb(ph, ps)), anbi12_2: Prf(wb(ch, th))) -> Prf(wb(wa(ph, ch), wa(th, ps))) =
  biancomi(wa(ph, ch), th, ps, anbi12i(ph, ps, ch, th, anbi12_1, anbi12_2))
theorem anbi2d(ph: wff, ps: wff, ch: wff, th: wff, anbid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wa(th, ps), wa(th, ch)))) =
  pm5.32d(ph, th, ps, ch, a1d(ph, wb(ps, ch), th, anbid_1))
theorem anbi1d(ph: wff, ps: wff, ch: wff, th: wff, anbid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wa(ps, th), wa(ch, th)))) =
  pm5.32rd(ph, th, ps, ch, a1d(ph, wb(ps, ch), th, anbid_1))
theorem anbi12d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, anbi12d_1: Prf(wi(ph, wb(ps, ch))), anbi12d_2: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(wa(ps, th), wa(ch, ta)))) =
  bitrd(ph, wa(ps, th), wa(ch, th), wa(ch, ta), anbi1d(ph, ps, ch, th, anbi12d_1), anbi2d(ph, th, ta, ch, anbi12d_2))
