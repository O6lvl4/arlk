theorem ifpbi23d(ph: wff, ps: wff, ch: wff, th: wff, et: wff, ze: wff, ifpbi23d_1: Prf(wi(ph, wb(ch, et))), ifpbi23d_2: Prf(wi(ph, wb(th, ze)))) -> Prf(wi(ph, wb(wif(ps, ch, th), wif(ps, et, ze)))) =
