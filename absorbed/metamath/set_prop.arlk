  syl(ph, ps, wo(ps, ch), orcd_1, orc(ps, ch))
theorem olcd(ph: wff, ps: wff, ch: wff, orcd_1: Prf(wi(ph, ps))) -> Prf(wi(ph, wo(ch, ps))) =
