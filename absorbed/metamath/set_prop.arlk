  bitr4i(ph, wa(ps, ch), ch, mpbiran_2, biantrur(ps, ch, mpbiran_1))
theorem mpbiran2(ph: wff, ps: wff, ch: wff, mpbiran2_1: Prf(ch), mpbiran2_2: Prf(wb(ph, wa(ps, ch)))) -> Prf(wb(ph, ps)) =
  mpbiran(ph, ch, ps, mpbiran2_1, biancomi(ph, ch, ps, mpbiran2_2))
