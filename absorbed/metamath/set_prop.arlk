theorem elimh(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, elimh_1: Prf(wi(wb(wif(ch, ph, ps), ph), wb(ta, ch))), elimh_2: Prf(wi(wb(wif(ch, ph, ps), ps), wb(ta, th))), elimh_3: Prf(th)) -> Prf(ta) =
