theorem orsird(ph: wff, ps: wff, ch: wff, orsild_1: Prf(wi(ph, wn(wo(ps, ch))))) -> Prf(wi(ph, wn(ch))) =
  simprd(ph, wn(ps), wn(ch), sylib(ph, wn(wo(ps, ch)), wa(wn(ps), wn(ch)), orsild_1, ioran(ps, ch)))
theorem pm4.79(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(wi(ps, ph), wi(ch, ph)), wi(wa(ps, ch), ph))) =
  impbii(wo(wi(ps, ph), wi(ch, ph)), wi(wa(ps, ch), ph), jaoa(wi(ps, ph), ps, ph, wi(ch, ph), ch, id(wi(ps, ph)), id(wi(ch, ph))), orrd(wi(wa(ps, ch), ph), wi(ps, ph), wi(ch, ph), syl5(wn(wi(ps, ph)), ps, wi(wa(ps, ch), ph), wi(ch, ph), simplim(ps, ph), pm3.3(ps, ch, ph))))
theorem pm5.53(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wb(wi(wo(wo(ph, ps), ch), th), wa(wa(wi(ph, th), wi(ps, th)), wi(ch, th)))) =
  bianbi(wi(wo(wo(ph, ps), ch), th), wi(wo(ph, ps), th), wi(ch, th), wa(wi(ph, th), wi(ps, th)), jaob(wo(ph, ps), th, ch), jaob(ph, th, ps))
theorem ordi(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(ph, wa(ps, ch)), wa(wo(ph, ps), wo(ph, ch)))) =
  3bitr4i(wi(wn(ph), wa(ps, ch)), wa(wi(wn(ph), ps), wi(wn(ph), ch)), wo(ph, wa(ps, ch)), wa(wo(ph, ps), wo(ph, ch)), jcab(wn(ph), ps, ch), df_or(ph, wa(ps, ch)), anbi12i(wo(ph, ps), wi(wn(ph), ps), wo(ph, ch), wi(wn(ph), ch), df_or(ph, ps), df_or(ph, ch)))
theorem ordir(ph: wff, ps: wff, ch: wff) -> Prf(wb(wo(wa(ph, ps), ch), wa(wo(ph, ch), wo(ps, ch)))) =
  3bitr4i(wo(ch, wa(ph, ps)), wa(wo(ch, ph), wo(ch, ps)), wo(wa(ph, ps), ch), wa(wo(ph, ch), wo(ps, ch)), ordi(ch, ph, ps), orcom(wa(ph, ps), ch), anbi12i(wo(ph, ch), wo(ch, ph), wo(ps, ch), wo(ch, ps), orcom(ph, ch), orcom(ps, ch)))
theorem andi(ph: wff, ps: wff, ch: wff) -> Prf(wb(wa(ph, wo(ps, ch)), wo(wa(ph, ps), wa(ph, ch)))) =
  impbii(wa(ph, wo(ps, ch)), wo(wa(ph, ps), wa(ph, ch)), jaodan(ph, ps, wo(wa(ph, ps), wa(ph, ch)), ch, orc(wa(ph, ps), wa(ph, ch)), olc(wa(ph, ch), wa(ph, ps))), jaoi(wa(ph, ps), wa(ph, wo(ps, ch)), wa(ph, ch), anim2i(ps, wo(ps, ch), ph, orc(ps, ch)), anim2i(ch, wo(ps, ch), ph, olc(ch, ps))))
theorem andir(ph: wff, ps: wff, ch: wff) -> Prf(wb(wa(wo(ph, ps), ch), wo(wa(ph, ch), wa(ps, ch)))) =
  3bitr4i(wa(ch, wo(ph, ps)), wo(wa(ch, ph), wa(ch, ps)), wa(wo(ph, ps), ch), wo(wa(ph, ch), wa(ps, ch)), andi(ch, ph, ps), ancom(wo(ph, ps), ch), orbi12i(wa(ph, ch), wa(ch, ph), wa(ps, ch), wa(ch, ps), ancom(ph, ch), ancom(ps, ch)))
theorem orddi(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wb(wo(wa(ph, ps), wa(ch, th)), wa(wa(wo(ph, ch), wo(ph, th)), wa(wo(ps, ch), wo(ps, th))))) =
  bitri(wo(wa(ph, ps), wa(ch, th)), wa(wo(ph, wa(ch, th)), wo(ps, wa(ch, th))), wa(wa(wo(ph, ch), wo(ph, th)), wa(wo(ps, ch), wo(ps, th))), ordir(ph, ps, wa(ch, th)), anbi12i(wo(ph, wa(ch, th)), wa(wo(ph, ch), wo(ph, th)), wo(ps, wa(ch, th)), wa(wo(ps, ch), wo(ps, th)), ordi(ph, ch, th), ordi(ps, ch, th)))
theorem anddi(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wb(wa(wo(ph, ps), wo(ch, th)), wo(wo(wa(ph, ch), wa(ph, th)), wo(wa(ps, ch), wa(ps, th))))) =
  bitri(wa(wo(ph, ps), wo(ch, th)), wo(wa(ph, wo(ch, th)), wa(ps, wo(ch, th))), wo(wo(wa(ph, ch), wa(ph, th)), wo(wa(ps, ch), wa(ps, th))), andir(ph, ps, wo(ch, th)), orbi12i(wa(ph, wo(ch, th)), wo(wa(ph, ch), wa(ph, th)), wa(ps, wo(ch, th)), wo(wa(ps, ch), wa(ps, th)), andi(ph, ch, th), andi(ps, ch, th)))
theorem pm5.17(ph: wff, ps: wff) -> Prf(wb(wa(wo(ph, ps), wn(wa(ph, ps))), wb(ph, wn(ps)))) =
  3bitrri(wb(ph, wn(ps)), wb(wn(ps), ph), wa(wi(wn(ps), ph), wi(ph, wn(ps))), wa(wo(ph, ps), wn(wa(ph, ps))), bicom(ph, wn(ps)), dfbi2(wn(ps), ph), anbi12i(wi(wn(ps), ph), wo(ph, ps), wi(ph, wn(ps)), wn(wa(ph, ps)), bitr2i(wo(ph, ps), wo(ps, ph), wi(wn(ps), ph), orcom(ph, ps), df_or(ps, ph)), imnan(ph, ps)))
theorem pm5.15(ph: wff, ps: wff) -> Prf(wo(wb(ph, ps), wb(ph, wn(ps)))) =
  orri(wb(ph, ps), wb(ph, wn(ps)), biimpi(wn(wb(ph, ps)), wb(ph, wn(ps)), xor3(ph, ps)))
theorem pm5.16(ph: wff, ps: wff) -> Prf(wn(wa(wb(ph, ps), wb(ph, wn(ps))))) =
  mpbi(wi(wb(ph, ps), wn(wb(ph, wn(ps)))), wn(wa(wb(ph, ps), wb(ph, wn(ps)))), biimpi(wb(ph, ps), wn(wb(ph, wn(ps))), pm5.18(ph, ps)), imnan(wb(ph, ps), wb(ph, wn(ps))))
theorem xor(ph: wff, ps: wff) -> Prf(wb(wn(wb(ph, ps)), wo(wa(ph, wn(ps)), wa(ps, wn(ph))))) =
  con1bii(wo(wa(ph, wn(ps)), wa(ps, wn(ph))), wb(ph, ps), 3bitr4ri(wa(wi(ph, ps), wi(ps, ph)), wa(wn(wa(ph, wn(ps))), wn(wa(ps, wn(ph)))), wb(ph, ps), wn(wo(wa(ph, wn(ps)), wa(ps, wn(ph)))), anbi12i(wi(ph, ps), wn(wa(ph, wn(ps))), wi(ps, ph), wn(wa(ps, wn(ph))), iman(ph, ps), iman(ps, ph)), dfbi2(ph, ps), ioran(wa(ph, wn(ps)), wa(ps, wn(ph)))))
theorem nbi2(ph: wff, ps: wff) -> Prf(wb(wn(wb(ph, ps)), wa(wo(ph, ps), wn(wa(ph, ps))))) =
  bitr4i(wn(wb(ph, ps)), wb(ph, wn(ps)), wa(wo(ph, ps), wn(wa(ph, ps))), xor3(ph, ps), pm5.17(ph, ps))
theorem xordi(ph: wff, ps: wff, ch: wff) -> Prf(wb(wa(ph, wn(wb(ps, ch))), wn(wb(wa(ph, ps), wa(ph, ch))))) =
  xchbinx(wa(ph, wn(wb(ps, ch))), wi(ph, wb(ps, ch)), wb(wa(ph, ps), wa(ph, ch)), annim(ph, wb(ps, ch)), pm5.32(ph, ps, ch))
theorem pm5.54(ph: wff, ps: wff) -> Prf(wo(wb(wa(ph, ps), ph), wb(wa(ph, ps), ps))) =
  orri(wb(wa(ph, ps), ph), wb(wa(ph, ps), ps), pm5.21ni(wa(ph, ps), wb(wa(ph, ps), ph), ps, adantl(ps, wb(wa(ph, ps), ph), ph, bicomd(ps, ph, wa(ph, ps), iba(ps, ph))), bicomd(ps, ph, wa(ph, ps), iba(ps, ph))))
theorem pm5.62(ph: wff, ps: wff) -> Prf(wb(wo(wa(ph, ps), wn(ps)), wo(ph, wn(ps)))) =
  mpbiran2(wo(wa(ph, ps), wn(ps)), wo(ph, wn(ps)), wo(ps, wn(ps)), exmid(ps), ordir(ph, ps, wn(ps)))
theorem pm5.63(ph: wff, ps: wff) -> Prf(wb(wo(ph, ps), wo(ph, wa(wn(ph), ps)))) =
  bicomi(wo(ph, wa(wn(ph), ps)), wo(ph, ps), mpbiran(wo(ph, wa(wn(ph), ps)), wo(ph, wn(ph)), wo(ph, ps), exmid(ph), ordi(ph, wn(ph), ps)))
theorem niabn(ph: wff, ps: wff, ch: wff, niabn_1: Prf(ph)) -> Prf(wi(wn(ps), wb(wa(ch, ps), wn(ph)))) =
  pm5.21ni(wa(ch, ps), ps, wn(ph), simpr(ch, ps), pm2.24i(ph, ps, niabn_1))
theorem ninba(ph: wff, ps: wff, ch: wff, ninba_1: Prf(ph)) -> Prf(wi(wn(ps), wb(wn(ph), wa(ch, ps)))) =
  bicomd(wn(ps), wa(ch, ps), wn(ph), niabn(ph, ps, ch, ninba_1))
theorem pm4.43(ph: wff, ps: wff) -> Prf(wb(ph, wa(wo(ph, ps), wo(ph, wn(ps))))) =
