  exp4b(ph, ps, ch, th, ta, ex(wa(ph, ps), wa(ch, th), ta, exp43_1))
theorem exp44(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, exp44_1: Prf(wi(wa(ph, wa(wa(ps, ch), th)), ta))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, ta))))) =
  expd(ph, ps, ch, wi(th, ta), exp32(ph, wa(ps, ch), th, ta, exp44_1))
theorem exp45(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, exp45_1: Prf(wi(wa(ph, wa(ps, wa(ch, th))), ta))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, ta))))) =
  exp4a(ph, ps, ch, th, ta, exp32(ph, ps, wa(ch, th), ta, exp45_1))
theorem imp5d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, imp5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(wa(wa(ph, ps), ch), wi(wa(th, ta), et))) =
  impd(wa(wa(ph, ps), ch), th, ta, et, imp31(ph, ps, ch, wi(th, wi(ta, et)), imp5_1))
