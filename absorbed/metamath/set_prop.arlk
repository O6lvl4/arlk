  exp31(ph, ps, ch, wi(wa(th, ta), et), imp5d(ph, ps, ch, th, ta, et, imp5_1))
theorem imp5g(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, imp5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(wa(ph, ps), wi(wa(wa(ch, th), ta), et))) =
  impd(wa(ph, ps), wa(ch, th), ta, et, imp4b(ph, ps, ch, th, wi(ta, et), imp5_1))
theorem imp55(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, imp5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(wa(wa(ph, wa(ps, wa(ch, th))), ta), et)) =
  imp42(ph, ps, wa(ch, th), ta, et, imp4a(ph, ps, ch, th, wi(ta, et), imp5_1))
theorem imp511(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, imp5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(wa(ph, wa(wa(ps, wa(ch, th)), ta)), et)) =
  imp44(ph, ps, wa(ch, th), ta, et, imp4a(ph, ps, ch, th, wi(ta, et), imp5_1))
theorem exp5c(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, exp5c_1: Prf(wi(ph, wi(wa(ps, ch), wi(wa(th, ta), et))))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et)))))) =
  expd(ph, ps, ch, wi(th, wi(ta, et)), exp4a(ph, wa(ps, ch), th, ta, et, exp5c_1))
theorem exp5j(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, exp5j_1: Prf(wi(ph, wi(wa(wa(wa(ps, ch), th), ta), et)))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et)))))) =
  exp4c(ph, ps, ch, th, wi(ta, et), expd(ph, wa(wa(ps, ch), th), ta, et, exp5j_1))
theorem exp5l(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, exp5l_1: Prf(wi(ph, wi(wa(wa(ps, ch), wa(th, ta)), et)))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et)))))) =
  exp5c(ph, ps, ch, th, ta, et, expd(ph, wa(ps, ch), wa(th, ta), et, exp5l_1))
theorem exp53(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, exp53_1: Prf(wi(wa(wa(wa(ph, ps), wa(ch, th)), ta), et))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et)))))) =
  exp43(ph, ps, ch, th, wi(ta, et), ex(wa(wa(ph, ps), wa(ch, th)), ta, et, exp53_1))
theorem pm3.3(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wa(ph, ps), ch), wi(ph, wi(ps, ch)))) =
  expd(wi(wa(ph, ps), ch), ph, ps, ch, id(wi(wa(ph, ps), ch)))
theorem pm3.31(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, wi(ps, ch)), wi(wa(ph, ps), ch))) =
  impd(wi(ph, wi(ps, ch)), ph, ps, ch, id(wi(ph, wi(ps, ch))))
theorem impexp(ph: wff, ps: wff, ch: wff) -> Prf(wb(wi(wa(ph, ps), ch), wi(ph, wi(ps, ch)))) =
  impbii(wi(wa(ph, ps), ch), wi(ph, wi(ps, ch)), pm3.3(ph, ps, ch), pm3.31(ph, ps, ch))
theorem impancom(ph: wff, ps: wff, ch: wff, th: wff, impancom_1: Prf(wi(wa(ph, ps), wi(ch, th)))) -> Prf(wi(wa(ph, ch), wi(ps, th))) =
  imp(ph, ch, wi(ps, th), com23(ph, ps, ch, th, ex(ph, ps, wi(ch, th), impancom_1)))
theorem expdimp(ph: wff, ps: wff, ch: wff, th: wff, expdimp_1: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(wa(ph, ps), wi(ch, th))) =
  imp(ph, ps, wi(ch, th), expd(ph, ps, ch, th, expdimp_1))
theorem expimpd(ph: wff, ps: wff, ch: wff, th: wff, expimpd_1: Prf(wi(wa(ph, ps), wi(ch, th)))) -> Prf(wi(ph, wi(wa(ps, ch), th))) =
  impd(ph, ps, ch, th, ex(ph, ps, wi(ch, th), expimpd_1))
theorem impr(ph: wff, ps: wff, ch: wff, th: wff, impr_1: Prf(wi(wa(ph, ps), wi(ch, th)))) -> Prf(wi(wa(ph, wa(ps, ch)), th)) =
  imp32(ph, ps, ch, th, ex(ph, ps, wi(ch, th), impr_1))
theorem impl(ph: wff, ps: wff, ch: wff, th: wff, impl_1: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(wa(wa(ph, ps), ch), th)) =
  imp31(ph, ps, ch, th, expd(ph, ps, ch, th, impl_1))
theorem expr(ph: wff, ps: wff, ch: wff, th: wff, expr_1: Prf(wi(wa(ph, wa(ps, ch)), th))) -> Prf(wi(wa(ph, ps), wi(ch, th))) =
  imp(ph, ps, wi(ch, th), exp32(ph, ps, ch, th, expr_1))
theorem expl(ph: wff, ps: wff, ch: wff, th: wff, expl_1: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(ph, wi(wa(ps, ch), th))) =
