  jaoi(ph, wo(ps, ph), ps, olc(ph, ps), orc(ps, ph))
theorem orcom(ph: wff, ps: wff) -> Prf(wb(wo(ph, ps), wo(ps, ph))) =
  impbii(wo(ph, ps), wo(ps, ph), pm1.4(ph, ps), pm1.4(ps, ph))
theorem orcomd(ph: wff, ps: wff, ch: wff, orcomd_1: Prf(wi(ph, wo(ps, ch)))) -> Prf(wi(ph, wo(ch, ps))) =
