theorem syl8(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl8_1: Prf(wi(ph, wi(ps, wi(ch, th)))), syl8_2: Prf(wi(th, ta))) -> Prf(wi(ph, wi(ps, wi(ch, ta)))) =
  syl6d(ph, ps, ch, th, ta, syl8_1, a1i(wi(th, ta), ph, syl8_2))
theorem syl9(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl9_1: Prf(wi(ph, wi(ps, ch))), syl9_2: Prf(wi(th, wi(ch, ta)))) -> Prf(wi(ph, wi(th, wi(ps, ta)))) =
  syl5d(ph, ps, ch, th, ta, syl9_1, a1i(wi(th, wi(ch, ta)), ph, syl9_2))
theorem syl9r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl9r_1: Prf(wi(ph, wi(ps, ch))), syl9r_2: Prf(wi(th, wi(ch, ta)))) -> Prf(wi(th, wi(ph, wi(ps, ta)))) =
  com12(ph, th, wi(ps, ta), syl9(ph, ps, ch, th, ta, syl9r_1, syl9r_2))
theorem syl10(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, syl10_1: Prf(wi(ph, wi(ps, ch))), syl10_2: Prf(wi(ph, wi(ps, wi(th, ta)))), syl10_3: Prf(wi(ch, wi(ta, et)))) -> Prf(wi(ph, wi(ps, wi(th, et)))) =
  syldd(ph, ps, th, ta, et, syl10_2, syl6(ph, ps, ch, wi(ta, et), syl10_1, syl10_3))
theorem a1ddd(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, a1ddd_1: Prf(wi(ph, wi(ps, wi(ch, ta))))) -> Prf(wi(ph, wi(ps, wi(ch, wi(th, ta))))) =
  syl8(ph, ps, ch, ta, wi(th, ta), a1ddd_1, ax_1(ta, th))
theorem imim12d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, imim12d_1: Prf(wi(ph, wi(ps, ch))), imim12d_2: Prf(wi(ph, wi(th, ta)))) -> Prf(wi(ph, wi(wi(ch, th), wi(ps, ta)))) =
  syl5d(ph, ps, ch, wi(ch, th), ta, imim12d_1, imim2d(ph, th, ta, ch, imim12d_2))
theorem imim1d(ph: wff, ps: wff, ch: wff, th: wff, imim1d_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, wi(wi(ch, th), wi(ps, th)))) =
  imim12d(ph, ps, ch, th, th, imim1d_1, idd(ph, th))
theorem imim1(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch)))) =
  imim1d(wi(ph, ps), ph, ps, ch, id(wi(ph, ps)))
theorem pm2.83(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wi(ph, wi(ps, ch)), wi(wi(ph, wi(ch, th)), wi(ph, wi(ps, th))))) =
  imim3i(wi(ps, ch), wi(ch, th), wi(ps, th), ph, imim1(ps, ch, th))
theorem peirceroll(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wi(wi(ph, ps), ph), ph), wi(wi(wi(ph, ps), ch), wi(wi(ch, ph), ph)))) =
  syl9r(wi(wi(ph, ps), ch), wi(ch, ph), wi(wi(ph, ps), ph), wi(wi(wi(ph, ps), ph), ph), ph, imim1(wi(ph, ps), ch, ph), id(wi(wi(wi(ph, ps), ph), ph)))
theorem com23(ph: wff, ps: wff, ch: wff, th: wff, com3_1: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(ph, wi(ch, wi(ps, th)))) =
  syl9(ph, ps, wi(ch, th), ch, th, com3_1, pm2.27(ch, th))
theorem com3r(ph: wff, ps: wff, ch: wff, th: wff, com3_1: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(ch, wi(ph, wi(ps, th)))) =
  com12(ph, ch, wi(ps, th), com23(ph, ps, ch, th, com3_1))
theorem com13(ph: wff, ps: wff, ch: wff, th: wff, com3_1: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(ch, wi(ps, wi(ph, th)))) =
  com23(ch, ph, ps, th, com3r(ph, ps, ch, th, com3_1))
theorem com3l(ph: wff, ps: wff, ch: wff, th: wff, com3_1: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(ps, wi(ch, wi(ph, th)))) =
  com3r(ch, ph, ps, th, com3r(ph, ps, ch, th, com3_1))
theorem pm2.04(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, wi(ps, ch)), wi(ps, wi(ph, ch)))) =
  com23(wi(ph, wi(ps, ch)), ph, ps, ch, id(wi(ph, wi(ps, ch))))
theorem com34(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, com4_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, ta)))))) -> Prf(wi(ph, wi(ps, wi(th, wi(ch, ta))))) =
  syl6(ph, ps, wi(ch, wi(th, ta)), wi(th, wi(ch, ta)), com4_1, pm2.04(ch, th, ta))
theorem com4l(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, com4_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, ta)))))) -> Prf(wi(ps, wi(ch, wi(th, wi(ph, ta))))) =
  com34(ps, ch, ph, th, ta, com3l(ph, ps, ch, wi(th, ta), com4_1))
theorem com4t(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, com4_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, ta)))))) -> Prf(wi(ch, wi(th, wi(ph, wi(ps, ta))))) =
  com4l(ps, ch, th, ph, ta, com4l(ph, ps, ch, th, ta, com4_1))
theorem com4r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, com4_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, ta)))))) -> Prf(wi(th, wi(ph, wi(ps, wi(ch, ta))))) =
  com4l(ch, th, ph, ps, ta, com4t(ph, ps, ch, th, ta, com4_1))
theorem com24(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, com4_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, ta)))))) -> Prf(wi(ph, wi(th, wi(ch, wi(ps, ta))))) =
  com13(ch, th, ph, wi(ps, ta), com4t(ph, ps, ch, th, ta, com4_1))
theorem com14(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, com4_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, ta)))))) -> Prf(wi(th, wi(ps, wi(ch, wi(ph, ta))))) =
  com3r(ps, ch, th, wi(ph, ta), com4l(ph, ps, ch, th, ta, com4_1))
theorem com45(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, com5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(ph, wi(ps, wi(ch, wi(ta, wi(th, et)))))) =
  syl8(ph, ps, ch, wi(th, wi(ta, et)), wi(ta, wi(th, et)), com5_1, pm2.04(th, ta, et))
theorem com35(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, com5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(ph, wi(ps, wi(ta, wi(th, wi(ch, et)))))) =
  com34(ph, ps, th, ta, wi(ch, et), com45(ph, ps, th, ch, ta, et, com34(ph, ps, ch, th, wi(ta, et), com5_1)))
theorem com25(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, com5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(ph, wi(ta, wi(ch, wi(th, wi(ps, et)))))) =
  com24(ph, th, ch, ta, wi(ps, et), com45(ph, th, ch, ps, ta, et, com24(ph, ps, ch, th, wi(ta, et), com5_1)))
theorem com5l(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, com5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(ps, wi(ch, wi(th, wi(ta, wi(ph, et)))))) =
  com45(ps, ch, th, ph, ta, et, com4l(ph, ps, ch, th, wi(ta, et), com5_1))
theorem com15(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, com5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(ta, wi(ps, wi(ch, wi(th, wi(ph, et)))))) =
  com4r(ps, ch, th, ta, wi(ph, et), com5l(ph, ps, ch, th, ta, et, com5_1))
theorem com52l(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, com5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(ch, wi(th, wi(ta, wi(ph, wi(ps, et)))))) =
  com5l(ps, ch, th, ta, ph, et, com5l(ph, ps, ch, th, ta, et, com5_1))
theorem com52r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, com5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(th, wi(ta, wi(ph, wi(ps, wi(ch, et)))))) =
  com5l(ch, th, ta, ph, ps, et, com52l(ph, ps, ch, th, ta, et, com5_1))
theorem com5r(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, com5_1: Prf(wi(ph, wi(ps, wi(ch, wi(th, wi(ta, et))))))) -> Prf(wi(ta, wi(ph, wi(ps, wi(ch, wi(th, et)))))) =
  com52l(ch, th, ta, ph, ps, et, com52l(ph, ps, ch, th, ta, et, com5_1))
theorem imim12(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wi(ph, ps), wi(wi(ch, th), wi(wi(ps, ch), wi(ph, th))))) =
  syl9r(wi(ch, th), wi(ps, ch), wi(ps, th), wi(ph, ps), wi(ph, th), imim2(ch, th, ps), imim1(ph, ps, th))
theorem jarr(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wi(ph, ps), ch), wi(ps, ch))) =
  imim1i(ps, wi(ph, ps), ch, ax_1(ps, ph))
theorem jarri(ph: wff, ps: wff, ch: wff, jarri_1: Prf(wi(wi(ph, ps), ch))) -> Prf(wi(ps, ch)) =
  syl(ps, wi(ph, ps), ch, ax_1(ps, ph), jarri_1)
theorem pm2.86d(ph: wff, ps: wff, ch: wff, th: wff, pm2_86d_1: Prf(wi(ph, wi(wi(ps, ch), wi(ps, th))))) -> Prf(wi(ph, wi(ps, wi(ch, th)))) =
  com23(ph, ch, ps, th, syl5(ch, wi(ps, ch), ph, wi(ps, th), ax_1(ch, ps), pm2_86d_1))
theorem pm2.86(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wi(ph, ps), wi(ph, ch)), wi(ph, wi(ps, ch)))) =
  pm2.86d(wi(wi(ph, ps), wi(ph, ch)), ph, ps, ch, id(wi(wi(ph, ps), wi(ph, ch))))
theorem pm2.86i(ph: wff, ps: wff, ch: wff, pm2_86i_1: Prf(wi(wi(ph, ps), wi(ph, ch)))) -> Prf(wi(ph, wi(ps, ch))) =
  com12(ps, ph, ch, jarri(ph, ps, wi(ph, ch), pm2_86i_1))
theorem loolin(ph: wff, ps: wff) -> Prf(wi(wi(wi(ph, ps), wi(ps, ph)), wi(ps, ph))) =
  pm2.43d(wi(wi(ph, ps), wi(ps, ph)), ps, ph, jarr(ph, ps, wi(ps, ph)))
theorem loowoz(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wi(ph, ps), wi(ph, ch)), wi(wi(ps, ph), wi(ps, ch)))) =
  a2d(wi(wi(ph, ps), wi(ph, ch)), ps, ph, ch, jarr(ph, ps, wi(ph, ch)))
theorem con4(ph: wff, ps: wff) -> Prf(wi(wi(wn(ph), wn(ps)), wi(ps, ph))) =
  ax_3(ph, ps)
theorem con4i(ph: wff, ps: wff, con4i_1: Prf(wi(wn(ph), wn(ps)))) -> Prf(wi(ps, ph)) =
  ax_mp(wi(wn(ph), wn(ps)), wi(ps, ph), con4i_1, con4(ph, ps))
theorem con4d(ph: wff, ps: wff, ch: wff, con4d_1: Prf(wi(ph, wi(wn(ps), wn(ch))))) -> Prf(wi(ph, wi(ch, ps))) =
  syl(ph, wi(wn(ps), wn(ch)), wi(ch, ps), con4d_1, con4(ps, ch))
theorem mt4(ph: wff, ps: wff, mt4_1: Prf(ph), mt4_2: Prf(wi(wn(ps), wn(ph)))) -> Prf(ps) =
  ax_mp(ph, ps, mt4_1, con4i(ps, ph, mt4_2))
theorem mt4d(ph: wff, ps: wff, ch: wff, mt4d_1: Prf(wi(ph, ps)), mt4d_2: Prf(wi(ph, wi(wn(ch), wn(ps))))) -> Prf(wi(ph, ch)) =
  mpd(ph, ps, ch, mt4d_1, con4d(ph, ch, ps, mt4d_2))
theorem mt4i(ph: wff, ps: wff, ch: wff, mt4i_1: Prf(ch), mt4i_2: Prf(wi(ph, wi(wn(ps), wn(ch))))) -> Prf(wi(ph, ps)) =
  mt4d(ph, ch, ps, a1i(ch, ph, mt4i_1), mt4i_2)
theorem pm2.21i(ph: wff, ps: wff, pm2_21i_1: Prf(wn(ph))) -> Prf(wi(ph, ps)) =
  con4i(ps, ph, a1i(wn(ph), wn(ps), pm2_21i_1))
theorem pm2.24ii(ph: wff, ps: wff, pm2_24ii_1: Prf(ph), pm2_24ii_2: Prf(wn(ph))) -> Prf(ps) =
  ax_mp(ph, ps, pm2_24ii_1, pm2.21i(ph, ps, pm2_24ii_2))
theorem pm2.21d(ph: wff, ps: wff, ch: wff, pm2_21d_1: Prf(wi(ph, wn(ps)))) -> Prf(wi(ph, wi(ps, ch))) =
  con4d(ph, ch, ps, a1d(ph, wn(ps), wn(ch), pm2_21d_1))
theorem pm2.21ddALT(ph: wff, ps: wff, ch: wff, pm2_21ddALT_1: Prf(wi(ph, ps)), pm2_21ddALT_2: Prf(wi(ph, wn(ps)))) -> Prf(wi(ph, ch)) =
  mpd(ph, ps, ch, pm2_21ddALT_1, pm2.21d(ph, ps, ch, pm2_21ddALT_2))
theorem pm2.21(ph: wff, ps: wff) -> Prf(wi(wn(ph), wi(ph, ps))) =
  pm2.21d(wn(ph), ph, ps, id(wn(ph)))
theorem pm2.24(ph: wff, ps: wff) -> Prf(wi(ph, wi(wn(ph), ps))) =
  com12(wn(ph), ph, ps, pm2.21(ph, ps))
theorem jarl(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wi(ph, ps), ch), wi(wn(ph), ch))) =
  imim1i(wn(ph), wi(ph, ps), ch, pm2.21(ph, ps))
theorem jarli(ph: wff, ps: wff, ch: wff, jarli_1: Prf(wi(wi(ph, ps), ch))) -> Prf(wi(wn(ph), ch)) =
  syl(wn(ph), wi(ph, ps), ch, pm2.21(ph, ps), jarli_1)
theorem pm2.18d(ph: wff, ps: wff, pm2_18d_1: Prf(wi(ph, wi(wn(ps), ps)))) -> Prf(wi(ph, ps)) =
  mt4d(ph, ph, ps, id(ph), sylcom(ph, wn(ps), ps, wn(ph), pm2_18d_1, pm2.21(ps, wn(ph))))
theorem pm2.18(ph: wff) -> Prf(wi(wi(wn(ph), ph), ph)) =
  pm2.18d(wi(wn(ph), ph), ph, id(wi(wn(ph), ph)))
theorem pm2.18i(ph: wff, pm2_18i_1: Prf(wi(wn(ph), ph))) -> Prf(ph) =
  ax_mp(wi(wn(ph), ph), ph, pm2_18i_1, pm2.18(ph))
theorem notnotr(ph: wff) -> Prf(wi(wn(wn(ph)), ph)) =
  jarli(wn(ph), ph, ph, pm2.18(ph))
theorem notnotri(ph: wff, notnotri_1: Prf(wn(wn(ph)))) -> Prf(ph) =
  mt4(wn(wn(ph)), ph, notnotri_1, pm2.21i(wn(ph), wn(wn(wn(ph))), notnotri_1))
theorem notnotriALT(ph: wff, notnotri_1: Prf(wn(wn(ph)))) -> Prf(ph) =
  pm2.18i(ph, pm2.21i(wn(ph), ph, notnotri_1))
theorem notnotrd(ph: wff, ps: wff, notnotrd_1: Prf(wi(ph, wn(wn(ps))))) -> Prf(wi(ph, ps)) =
  syl(ph, wn(wn(ps)), ps, notnotrd_1, notnotr(ps))
theorem con2d(ph: wff, ps: wff, ch: wff, con2d_1: Prf(wi(ph, wi(ps, wn(ch))))) -> Prf(wi(ph, wi(ch, wn(ps)))) =
  con4d(ph, wn(ps), ch, syl5(wn(wn(ps)), ps, ph, wn(ch), notnotr(ps), con2d_1))
theorem con2(ph: wff, ps: wff) -> Prf(wi(wi(ph, wn(ps)), wi(ps, wn(ph)))) =
  con2d(wi(ph, wn(ps)), ph, ps, id(wi(ph, wn(ps))))
theorem mt2d(ph: wff, ps: wff, ch: wff, mt2d_1: Prf(wi(ph, ch)), mt2d_2: Prf(wi(ph, wi(ps, wn(ch))))) -> Prf(wi(ph, wn(ps))) =
  mpd(ph, ch, wn(ps), mt2d_1, con2d(ph, ps, ch, mt2d_2))
theorem mt2i(ph: wff, ps: wff, ch: wff, mt2i_1: Prf(ch), mt2i_2: Prf(wi(ph, wi(ps, wn(ch))))) -> Prf(wi(ph, wn(ps))) =
  mt2d(ph, ps, ch, a1i(ch, ph, mt2i_1), mt2i_2)
theorem nsyl3(ph: wff, ps: wff, ch: wff, nsyl3_1: Prf(wi(ph, wn(ps))), nsyl3_2: Prf(wi(ch, ps))) -> Prf(wi(ch, wn(ph))) =
  mt2d(ch, ph, ps, nsyl3_2, a1i(wi(ph, wn(ps)), ch, nsyl3_1))
theorem con2i(ph: wff, ps: wff, con2i_a: Prf(wi(ph, wn(ps)))) -> Prf(wi(ps, wn(ph))) =
  nsyl3(ph, ps, ps, con2i_a, id(ps))
theorem nsyl(ph: wff, ps: wff, ch: wff, nsyl_1: Prf(wi(ph, wn(ps))), nsyl_2: Prf(wi(ch, ps))) -> Prf(wi(ph, wn(ch))) =
  con2i(ch, ph, nsyl3(ph, ps, ch, nsyl_1, nsyl_2))
theorem nsyl2(ph: wff, ps: wff, ch: wff, nsyl2_1: Prf(wi(ph, wn(ps))), nsyl2_2: Prf(wi(wn(ch), ps))) -> Prf(wi(ph, ch)) =
  con4i(ch, ph, nsyl3(ph, ps, wn(ch), nsyl2_1, nsyl2_2))
theorem notnot(ph: wff) -> Prf(wi(ph, wn(wn(ph)))) =
  con2i(wn(ph), ph, id(wn(ph)))
theorem notnoti(ph: wff, notnoti_1: Prf(ph)) -> Prf(wn(wn(ph))) =
  ax_mp(ph, wn(wn(ph)), notnoti_1, notnot(ph))
theorem notnotd(ph: wff, ps: wff, notnotd_1: Prf(wi(ph, ps))) -> Prf(wi(ph, wn(wn(ps)))) =
  syl(ph, ps, wn(wn(ps)), notnotd_1, notnot(ps))
theorem con1d(ph: wff, ps: wff, ch: wff, con1d_1: Prf(wi(ph, wi(wn(ps), ch)))) -> Prf(wi(ph, wi(wn(ch), ps))) =
  con4d(ph, ps, wn(ch), syl6(ph, wn(ps), ch, wn(wn(ch)), con1d_1, notnot(ch)))
theorem con1(ph: wff, ps: wff) -> Prf(wi(wi(wn(ph), ps), wi(wn(ps), ph))) =
  con1d(wi(wn(ph), ps), ph, ps, id(wi(wn(ph), ps)))
theorem con1i(ph: wff, ps: wff, con1i_1: Prf(wi(wn(ph), ps))) -> Prf(wi(wn(ps), ph)) =
  nsyl2(wn(ps), ps, ph, id(wn(ps)), con1i_1)
theorem mt3d(ph: wff, ps: wff, ch: wff, mt3d_1: Prf(wi(ph, wn(ch))), mt3d_2: Prf(wi(ph, wi(wn(ps), ch)))) -> Prf(wi(ph, ps)) =
  mpd(ph, wn(ch), ps, mt3d_1, con1d(ph, ps, ch, mt3d_2))
theorem mt3i(ph: wff, ps: wff, ch: wff, mt3i_1: Prf(wn(ch)), mt3i_2: Prf(wi(ph, wi(wn(ps), ch)))) -> Prf(wi(ph, ps)) =
  mt3d(ph, ps, ch, a1i(wn(ch), ph, mt3i_1), mt3i_2)
theorem pm2.24i(ph: wff, ps: wff, pm2_24i_1: Prf(ph)) -> Prf(wi(wn(ph), ps)) =
  con1i(ps, ph, a1i(ph, wn(ps), pm2_24i_1))
theorem pm2.24d(ph: wff, ps: wff, ch: wff, pm2_24d_1: Prf(wi(ph, ps))) -> Prf(wi(ph, wi(wn(ps), ch))) =
  con1d(ph, ch, ps, a1d(ph, ps, wn(ch), pm2_24d_1))
theorem con3d(ph: wff, ps: wff, ch: wff, con3d_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, wi(wn(ch), wn(ps)))) =
  con1d(ph, wn(ps), ch, syl5(wn(wn(ps)), ps, ph, ch, notnotr(ps), con3d_1))
theorem con3(ph: wff, ps: wff) -> Prf(wi(wi(ph, ps), wi(wn(ps), wn(ph)))) =
  con3d(wi(ph, ps), ph, ps, id(wi(ph, ps)))
theorem con3i(ph: wff, ps: wff, con3i_a: Prf(wi(ph, ps))) -> Prf(wi(wn(ps), wn(ph))) =
  nsyl(wn(ps), ps, ph, id(wn(ps)), con3i_a)
theorem con3rr3(ph: wff, ps: wff, ch: wff, con3rr3_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(wn(ch), wi(ph, wn(ps)))) =
  com12(ph, wn(ch), wn(ps), con3d(ph, ps, ch, con3rr3_1))
theorem nsyld(ph: wff, ps: wff, ch: wff, ta: wff, nsyld_1: Prf(wi(ph, wi(ps, wn(ch)))), nsyld_2: Prf(wi(ph, wi(ta, ch)))) -> Prf(wi(ph, wi(ps, wn(ta)))) =
  syld(ph, ps, wn(ch), wn(ta), nsyld_1, con3d(ph, ta, ch, nsyld_2))
theorem nsyli(ph: wff, ps: wff, ch: wff, th: wff, nsyli_1: Prf(wi(ph, wi(ps, ch))), nsyli_2: Prf(wi(th, wn(ch)))) -> Prf(wi(ph, wi(th, wn(ps)))) =
  syl5(th, wn(ch), ph, wn(ps), nsyli_2, con3d(ph, ps, ch, nsyli_1))
theorem nsyl4(ph: wff, ps: wff, ch: wff, nsyl4_1: Prf(wi(ph, ps)), nsyl4_2: Prf(wi(wn(ph), ch))) -> Prf(wi(wn(ch), ps)) =
  syl(wn(ch), ph, ps, con1i(ph, ch, nsyl4_2), nsyl4_1)
theorem nsyl5(ph: wff, ps: wff, ch: wff, nsyl4_1: Prf(wi(ph, ps)), nsyl4_2: Prf(wi(wn(ph), ch))) -> Prf(wi(wn(ps), ch)) =
  con1i(ch, ps, nsyl4(ph, ps, ch, nsyl4_1, nsyl4_2))
theorem pm3.2im(ph: wff, ps: wff) -> Prf(wi(ph, wi(ps, wn(wi(ph, wn(ps)))))) =
  con2d(ph, wi(ph, wn(ps)), ps, pm2.27(ph, wn(ps)))
theorem jc(ph: wff, ps: wff, ch: wff, jc_1: Prf(wi(ph, ps)), jc_2: Prf(wi(ph, ch))) -> Prf(wi(ph, wn(wi(ps, wn(ch))))) =
  sylc(ph, ps, ch, wn(wi(ps, wn(ch))), jc_1, jc_2, pm3.2im(ps, ch))
theorem jcn(ph: wff, ps: wff) -> Prf(wi(ph, wi(wn(ps), wn(wi(ph, ps))))) =
  con3d(ph, wi(ph, ps), ps, pm2.27(ph, ps))
theorem jcnd(ph: wff, ps: wff, ch: wff, jcnd_1: Prf(wi(ph, ps)), jcnd_2: Prf(wi(ph, wn(ch)))) -> Prf(wi(ph, wn(wi(ps, ch)))) =
  sylc(ph, ps, wn(ch), wn(wi(ps, ch)), jcnd_1, jcnd_2, jcn(ps, ch))
theorem impi(ph: wff, ps: wff, ch: wff, impi_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(wn(wi(ph, wn(ps))), ch)) =
  con1i(ch, wi(ph, wn(ps)), con3rr3(ph, ps, ch, impi_1))
theorem expi(ph: wff, ps: wff, ch: wff, expi_1: Prf(wi(wn(wi(ph, wn(ps))), ch))) -> Prf(wi(ph, wi(ps, ch))) =
  syl6(ph, ps, wn(wi(ph, wn(ps))), ch, pm3.2im(ph, ps), expi_1)
theorem simprim(ph: wff, ps: wff) -> Prf(wi(wn(wi(ph, wn(ps))), ps)) =
  impi(ph, ps, ps, idd(ph, ps))
theorem simplim(ph: wff, ps: wff) -> Prf(wi(wn(wi(ph, ps)), ph)) =
  con1i(ph, wi(ph, ps), pm2.21(ph, ps))
theorem pm2.5g(ph: wff, ps: wff, ch: wff) -> Prf(wi(wn(wi(ph, ps)), wi(wn(ph), ch))) =
  pm2.24d(wn(wi(ph, ps)), ph, ch, simplim(ph, ps))
theorem pm2.5(ph: wff, ps: wff) -> Prf(wi(wn(wi(ph, ps)), wi(wn(ph), ps))) =
  pm2.5g(ph, ps, ps)
theorem conax1(ph: wff, ps: wff) -> Prf(wi(wn(wi(ph, ps)), wn(ps))) =
  con3i(ps, wi(ph, ps), ax_1(ps, ph))
theorem conax1k(ph: wff, ps: wff, ch: wff) -> Prf(wi(wn(wi(ph, ps)), wi(ch, wn(ps)))) =
  a1d(wn(wi(ph, ps)), wn(ps), ch, conax1(ph, ps))
theorem pm2.51(ph: wff, ps: wff) -> Prf(wi(wn(wi(ph, ps)), wi(ph, wn(ps)))) =
  conax1k(ph, ps, ph)
theorem pm2.52(ph: wff, ps: wff) -> Prf(wi(wn(wi(ph, ps)), wi(wn(ph), wn(ps)))) =
  conax1k(ph, ps, wn(ph))
theorem pm2.521g(ph: wff, ps: wff, ch: wff) -> Prf(wi(wn(wi(ph, ps)), wi(ps, ch))) =
  pm2.21d(wn(wi(ph, ps)), ps, ch, conax1(ph, ps))
theorem pm2.521g2(ph: wff, ps: wff, ch: wff) -> Prf(wi(wn(wi(ph, ps)), wi(ch, ph))) =
  a1d(wn(wi(ph, ps)), ph, ch, simplim(ph, ps))
theorem pm2.521(ph: wff, ps: wff) -> Prf(wi(wn(wi(ph, ps)), wi(ps, ph))) =
  pm2.521g(ph, ps, ph)
theorem expt(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wn(wi(ph, wn(ps))), ch), wi(ph, wi(ps, ch)))) =
  syl9r(ph, ps, wn(wi(ph, wn(ps))), wi(wn(wi(ph, wn(ps))), ch), ch, pm3.2im(ph, ps), id(wi(wn(wi(ph, wn(ps))), ch)))
theorem exptOLD(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(wn(wi(ph, wn(ps))), ch), wi(ph, wi(ps, ch)))) =
  com12(ph, wi(wn(wi(ph, wn(ps))), ch), wi(ps, ch), imim1d(ph, ps, wn(wi(ph, wn(ps))), ch, pm3.2im(ph, ps)))
theorem impt(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, wi(ps, ch)), wi(wn(wi(ph, wn(ps))), ch))) =
  mpdi(wi(ph, wi(ps, ch)), wn(wi(ph, wn(ps))), ps, ch, simprim(ph, ps), imim1i(wn(wi(ph, wn(ps))), ph, wi(ps, ch), simplim(ph, wn(ps))))
theorem pm2.61d(ph: wff, ps: wff, ch: wff, pm2_61d_1: Prf(wi(ph, wi(ps, ch))), pm2_61d_2: Prf(wi(ph, wi(wn(ps), ch)))) -> Prf(wi(ph, ch)) =
  pm2.18d(ph, ch, syld(ph, wn(ch), ps, ch, con1d(ph, ps, ch, pm2_61d_2), pm2_61d_1))
theorem pm2.61d1(ph: wff, ps: wff, ch: wff, pm2_61d1_1: Prf(wi(ph, wi(ps, ch))), pm2_61d1_2: Prf(wi(wn(ps), ch))) -> Prf(wi(ph, ch)) =
  pm2.61d(ph, ps, ch, pm2_61d1_1, a1i(wi(wn(ps), ch), ph, pm2_61d1_2))
theorem pm2.61d2(ph: wff, ps: wff, ch: wff, pm2_61d2_1: Prf(wi(ph, wi(wn(ps), ch))), pm2_61d2_2: Prf(wi(ps, ch))) -> Prf(wi(ph, ch)) =
  pm2.61d(ph, ps, ch, a1i(wi(ps, ch), ph, pm2_61d2_2), pm2_61d2_1)
theorem pm2.61i(ph: wff, ps: wff, pm2_61i_1: Prf(wi(ph, ps)), pm2_61i_2: Prf(wi(wn(ph), ps))) -> Prf(ps) =
  pm2.18i(ps, nsyl4(ph, ps, ps, pm2_61i_1, pm2_61i_2))
theorem pm2.61ii(ph: wff, ps: wff, ch: wff, pm2_61ii_1: Prf(wi(wn(ph), wi(wn(ps), ch))), pm2_61ii_2: Prf(wi(ph, ch)), pm2_61ii_3: Prf(wi(ps, ch))) -> Prf(ch) =
  pm2.61i(ph, ch, pm2_61ii_2, pm2.61d2(wn(ph), ps, ch, pm2_61ii_1, pm2_61ii_3))
theorem pm2.61nii(ph: wff, ps: wff, ch: wff, pm2_61nii_1: Prf(wi(ph, wi(ps, ch))), pm2_61nii_2: Prf(wi(wn(ph), ch)), pm2_61nii_3: Prf(wi(wn(ps), ch))) -> Prf(ch) =
  pm2.61i(ph, ch, pm2.61d1(ph, ps, ch, pm2_61nii_1, pm2_61nii_3), pm2_61nii_2)
theorem pm2.61iii(ph: wff, ps: wff, ch: wff, th: wff, pm2_61iii_1: Prf(wi(wn(ph), wi(wn(ps), wi(wn(ch), th)))), pm2_61iii_2: Prf(wi(ph, th)), pm2_61iii_3: Prf(wi(ps, th)), pm2_61iii_4: Prf(wi(ch, th))) -> Prf(th) =
  pm2.61i(ch, th, pm2_61iii_4, pm2.61ii(ph, ps, wi(wn(ch), th), pm2_61iii_1, a1d(ph, th, wn(ch), pm2_61iii_2), a1d(ps, th, wn(ch), pm2_61iii_3)))
theorem ja(ph: wff, ps: wff, ch: wff, ja_1: Prf(wi(wn(ph), ch)), ja_2: Prf(wi(ps, ch))) -> Prf(wi(wi(ph, ps), ch)) =
  pm2.61d1(wi(ph, ps), ph, ch, imim2i(ps, ch, ph, ja_2), ja_1)
theorem jad(ph: wff, ps: wff, ch: wff, th: wff, jad_1: Prf(wi(ph, wi(wn(ps), th))), jad_2: Prf(wi(ph, wi(ch, th)))) -> Prf(wi(ph, wi(wi(ps, ch), th))) =
  com12(wi(ps, ch), ph, th, ja(ps, ch, wi(ph, th), com12(ph, wn(ps), th, jad_1), com12(ph, ch, th, jad_2)))
theorem pm2.01(ph: wff) -> Prf(wi(wi(ph, wn(ph)), wn(ph))) =
  ja(ph, wn(ph), wn(ph), id(wn(ph)), id(wn(ph)))
theorem pm2.01i(ph: wff, pm2_01i_1: Prf(wi(ph, wn(ph)))) -> Prf(wn(ph)) =
  ax_mp(wi(ph, wn(ph)), wn(ph), pm2_01i_1, pm2.01(ph))
theorem pm2.01d(ph: wff, ps: wff, pm2_01d_1: Prf(wi(ph, wi(ps, wn(ps))))) -> Prf(wi(ph, wn(ps))) =
  pm2.61d1(ph, ps, wn(ps), pm2_01d_1, id(wn(ps)))
theorem pm2.6(ph: wff, ps: wff) -> Prf(wi(wi(wn(ph), ps), wi(wi(ph, ps), ps))) =
  jad(wi(wn(ph), ps), ph, ps, ps, id(wi(wn(ph), ps)), idd(wi(wn(ph), ps), ps))
theorem pm2.61(ph: wff, ps: wff) -> Prf(wi(wi(ph, ps), wi(wi(wn(ph), ps), ps))) =
  com12(wi(wn(ph), ps), wi(ph, ps), ps, pm2.6(ph, ps))
theorem pm2.65(ph: wff, ps: wff) -> Prf(wi(wi(ph, ps), wi(wi(ph, wn(ps)), wn(ph)))) =
  jad(wi(ph, ps), ph, wn(ps), wn(ph), idd(wi(ph, ps), wn(ph)), con3(ph, ps))
theorem pm2.65i(ph: wff, ps: wff, pm2_65i_1: Prf(wi(ph, ps)), pm2_65i_2: Prf(wi(ph, wn(ps)))) -> Prf(wn(ph)) =
  pm2.01i(ph, nsyl3(ph, ps, ph, pm2_65i_2, pm2_65i_1))
theorem pm2.65iOLD(ph: wff, ps: wff, pm2_65i_1: Prf(wi(ph, ps)), pm2_65i_2: Prf(wi(ph, wn(ps)))) -> Prf(wn(ph)) =
  pm2.61i(ps, wn(ph), con2i(ph, ps, pm2_65i_2), con3i(ph, ps, pm2_65i_1))
theorem pm2.21dd(ph: wff, ps: wff, ch: wff, pm2_21dd_1: Prf(wi(ph, ps)), pm2_21dd_2: Prf(wi(ph, wn(ps)))) -> Prf(wi(ph, ch)) =
  pm2.21i(ph, ch, pm2.65i(ph, ps, pm2_21dd_1, pm2_21dd_2))
theorem pm2.65d(ph: wff, ps: wff, ch: wff, pm2_65d_1: Prf(wi(ph, wi(ps, ch))), pm2_65d_2: Prf(wi(ph, wi(ps, wn(ch))))) -> Prf(wi(ph, wn(ps))) =
  pm2.01d(ph, ps, nsyld(ph, ps, ch, ps, pm2_65d_2, pm2_65d_1))
theorem mto(ph: wff, ps: wff, mto_1: Prf(wn(ps)), mto_2: Prf(wi(ph, ps))) -> Prf(wn(ph)) =
  pm2.65i(ph, ps, mto_2, a1i(wn(ps), ph, mto_1))
theorem mtod(ph: wff, ps: wff, ch: wff, mtod_1: Prf(wi(ph, wn(ch))), mtod_2: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, wn(ps))) =
  pm2.65d(ph, ps, ch, mtod_2, a1d(ph, wn(ch), ps, mtod_1))
theorem mtoi(ph: wff, ps: wff, ch: wff, mtoi_1: Prf(wn(ch)), mtoi_2: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(ph, wn(ps))) =
  mtod(ph, ps, ch, a1i(wn(ch), ph, mtoi_1), mtoi_2)
theorem mt2(ph: wff, ps: wff, mt2_1: Prf(ps), mt2_2: Prf(wi(ph, wn(ps)))) -> Prf(wn(ph)) =
  pm2.65i(ph, ps, a1i(ps, ph, mt2_1), mt2_2)
theorem mt3(ph: wff, ps: wff, mt3_1: Prf(wn(ps)), mt3_2: Prf(wi(wn(ph), ps))) -> Prf(ph) =
  notnotri(ph, mto(wn(ph), ps, mt3_1, mt3_2))
theorem peirce(ph: wff, ps: wff) -> Prf(wi(wi(wi(ph, ps), ph), ph)) =
  ja(wi(ph, ps), ph, ph, simplim(ph, ps), id(ph))
theorem looinv(ph: wff, ps: wff) -> Prf(wi(wi(wi(ph, ps), ps), wi(wi(ps, ph), ph))) =
