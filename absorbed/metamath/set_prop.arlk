theorem biimp(ph: wff, ps: wff) -> Prf(wi(wb(ph, ps), wi(ph, ps))) =
  syl(wb(ph, ps), wn(wi(wi(ph, ps), wn(wi(ps, ph)))), wi(ph, ps), ax_mp(wn(wi(wi(wb(ph, ps), wn(wi(wi(ph, ps), wn(wi(ps, ph))))), wn(wi(wn(wi(wi(ph, ps), wn(wi(ps, ph)))), wb(ph, ps))))), wi(wb(ph, ps), wn(wi(wi(ph, ps), wn(wi(ps, ph))))), df_bi(ph, ps), simplim(wi(wb(ph, ps), wn(wi(wi(ph, ps), wn(wi(ps, ph))))), wn(wi(wn(wi(wi(ph, ps), wn(wi(ps, ph)))), wb(ph, ps))))), simplim(wi(ph, ps), wn(wi(ps, ph))))
theorem biimpi(ph: wff, ps: wff, biimpi_1: Prf(wb(ph, ps))) -> Prf(wi(ph, ps)) =
  ax_mp(wb(ph, ps), wi(ph, ps), biimpi_1, biimp(ph, ps))
theorem sylbi(ph: wff, ps: wff, ch: wff, sylbi_1: Prf(wb(ph, ps)), sylbi_2: Prf(wi(ps, ch))) -> Prf(wi(ph, ch)) =
  syl(ph, ps, ch, biimpi(ph, ps, sylbi_1), sylbi_2)
theorem sylib(ph: wff, ps: wff, ch: wff, sylib_1: Prf(wi(ph, ps)), sylib_2: Prf(wb(ps, ch))) -> Prf(wi(ph, ch)) =
  syl(ph, ps, ch, sylib_1, biimpi(ps, ch, sylib_2))
theorem sylbb(ph: wff, ps: wff, ch: wff, sylbb_1: Prf(wb(ph, ps)), sylbb_2: Prf(wb(ps, ch))) -> Prf(wi(ph, ch)) =
  sylbi(ph, ps, ch, sylbb_1, biimpi(ps, ch, sylbb_2))
theorem biimpr(ph: wff, ps: wff) -> Prf(wi(wb(ph, ps), wi(ps, ph))) =
  sylbi(wb(ph, ps), wn(wi(wi(ph, ps), wn(wi(ps, ph)))), wi(ps, ph), dfbi1(ph, ps), simprim(wi(ph, ps), wi(ps, ph)))
theorem bicom1(ph: wff, ps: wff) -> Prf(wi(wb(ph, ps), wb(ps, ph))) =
  impbid(wb(ph, ps), ps, ph, biimpr(ph, ps), biimp(ph, ps))
theorem bicom(ph: wff, ps: wff) -> Prf(wb(wb(ph, ps), wb(ps, ph))) =
  impbii(wb(ph, ps), wb(ps, ph), bicom1(ph, ps), bicom1(ps, ph))
theorem bicomd(ph: wff, ps: wff, ch: wff, bicomd_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(ch, ps))) =
  sylib(ph, wb(ps, ch), wb(ch, ps), bicomd_1, bicom(ps, ch))
theorem bicomi(ph: wff, ps: wff, bicomi_1: Prf(wb(ph, ps))) -> Prf(wb(ps, ph)) =
  ax_mp(wb(ph, ps), wb(ps, ph), bicomi_1, bicom1(ph, ps))
theorem impbid1(ph: wff, ps: wff, ch: wff, impbid1_1: Prf(wi(ph, wi(ps, ch))), impbid1_2: Prf(wi(ch, ps))) -> Prf(wi(ph, wb(ps, ch))) =
  impbid(ph, ps, ch, impbid1_1, a1i(wi(ch, ps), ph, impbid1_2))
theorem impbid2(ph: wff, ps: wff, ch: wff, impbid2_1: Prf(wi(ps, ch)), impbid2_2: Prf(wi(ph, wi(ch, ps)))) -> Prf(wi(ph, wb(ps, ch))) =
  bicomd(ph, ch, ps, impbid1(ph, ch, ps, impbid2_2, impbid2_1))
theorem impcon4bid(ph: wff, ps: wff, ch: wff, impcon4bid_1: Prf(wi(ph, wi(ps, ch))), impcon4bid_2: Prf(wi(ph, wi(wn(ps), wn(ch))))) -> Prf(wi(ph, wb(ps, ch))) =
  impbid(ph, ps, ch, impcon4bid_1, con4d(ph, ps, ch, impcon4bid_2))
theorem biimpri(ph: wff, ps: wff, biimpri_1: Prf(wb(ph, ps))) -> Prf(wi(ps, ph)) =
  biimpi(ps, ph, bicomi(ph, ps, biimpri_1))
theorem biimpd(ph: wff, ps: wff, ch: wff, biimpd_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wi(ps, ch))) =
  syl(ph, wb(ps, ch), wi(ps, ch), biimpd_1, biimp(ps, ch))
theorem mpbi(ph: wff, ps: wff, mpbi_min: Prf(ph), mpbi_maj: Prf(wb(ph, ps))) -> Prf(ps) =
  ax_mp(ph, ps, mpbi_min, biimpi(ph, ps, mpbi_maj))
theorem mpbir(ph: wff, ps: wff, mpbir_min: Prf(ps), mpbir_maj: Prf(wb(ph, ps))) -> Prf(ph) =
  ax_mp(ps, ph, mpbir_min, biimpri(ph, ps, mpbir_maj))
theorem mpbid(ph: wff, ps: wff, ch: wff, mpbid_min: Prf(wi(ph, ps)), mpbid_maj: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, ch)) =
  mpd(ph, ps, ch, mpbid_min, biimpd(ph, ps, ch, mpbid_maj))
theorem mpbii(ph: wff, ps: wff, ch: wff, mpbii_min: Prf(ps), mpbii_maj: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, ch)) =
  mpbid(ph, ps, ch, a1i(ps, ph, mpbii_min), mpbii_maj)
theorem sylibr(ph: wff, ps: wff, ch: wff, sylibr_1: Prf(wi(ph, ps)), sylibr_2: Prf(wb(ch, ps))) -> Prf(wi(ph, ch)) =
  syl(ph, ps, ch, sylibr_1, biimpri(ch, ps, sylibr_2))
theorem sylbir(ph: wff, ps: wff, ch: wff, sylbir_1: Prf(wb(ps, ph)), sylbir_2: Prf(wi(ps, ch))) -> Prf(wi(ph, ch)) =
  syl(ph, ps, ch, biimpri(ps, ph, sylbir_1), sylbir_2)
theorem sylbbr(ph: wff, ps: wff, ch: wff, sylbbr_1: Prf(wb(ph, ps)), sylbbr_2: Prf(wb(ps, ch))) -> Prf(wi(ch, ph)) =
  sylibr(ch, ps, ph, biimpri(ps, ch, sylbbr_2), sylbbr_1)
theorem sylbb1(ph: wff, ps: wff, ch: wff, sylbb1_1: Prf(wb(ph, ps)), sylbb1_2: Prf(wb(ph, ch))) -> Prf(wi(ps, ch)) =
  sylib(ps, ph, ch, biimpri(ph, ps, sylbb1_1), sylbb1_2)
theorem sylbb2(ph: wff, ps: wff, ch: wff, sylbb2_1: Prf(wb(ph, ps)), sylbb2_2: Prf(wb(ch, ps))) -> Prf(wi(ph, ch)) =
  sylbi(ph, ps, ch, sylbb2_1, biimpri(ch, ps, sylbb2_2))
theorem sylibd(ph: wff, ps: wff, ch: wff, th: wff, sylibd_1: Prf(wi(ph, wi(ps, ch))), sylibd_2: Prf(wi(ph, wb(ch, th)))) -> Prf(wi(ph, wi(ps, th))) =
  syld(ph, ps, ch, th, sylibd_1, biimpd(ph, ch, th, sylibd_2))
theorem sylbid(ph: wff, ps: wff, ch: wff, th: wff, sylbid_1: Prf(wi(ph, wb(ps, ch))), sylbid_2: Prf(wi(ph, wi(ch, th)))) -> Prf(wi(ph, wi(ps, th))) =
  syld(ph, ps, ch, th, biimpd(ph, ps, ch, sylbid_1), sylbid_2)
theorem mpbidi(ph: wff, ps: wff, ch: wff, th: wff, mpbidi_min: Prf(wi(th, wi(ph, ps))), mpbidi_maj: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(th, wi(ph, ch))) =
  sylcom(th, ph, ps, ch, mpbidi_min, biimpd(ph, ps, ch, mpbidi_maj))
theorem biimtrid(ph: wff, ps: wff, ch: wff, th: wff, biimtrid_1: Prf(wb(ph, ps)), biimtrid_2: Prf(wi(ch, wi(ps, th)))) -> Prf(wi(ch, wi(ph, th))) =
  syl5(ph, ps, ch, th, biimpi(ph, ps, biimtrid_1), biimtrid_2)
theorem biimtrrid(ph: wff, ps: wff, ch: wff, th: wff, biimtrrid_1: Prf(wb(ps, ph)), biimtrrid_2: Prf(wi(ch, wi(ps, th)))) -> Prf(wi(ch, wi(ph, th))) =
  syl5(ph, ps, ch, th, biimpri(ps, ph, biimtrrid_1), biimtrrid_2)
theorem imbitrid(ph: wff, ps: wff, ch: wff, th: wff, imbitrid_1: Prf(wi(ph, ps)), imbitrid_2: Prf(wi(ch, wb(ps, th)))) -> Prf(wi(ch, wi(ph, th))) =
  syl5(ph, ps, ch, th, imbitrid_1, biimpd(ch, ps, th, imbitrid_2))
theorem syl5ibcom(ph: wff, ps: wff, ch: wff, th: wff, imbitrid_1: Prf(wi(ph, ps)), imbitrid_2: Prf(wi(ch, wb(ps, th)))) -> Prf(wi(ph, wi(ch, th))) =
  com12(ch, ph, th, imbitrid(ph, ps, ch, th, imbitrid_1, imbitrid_2))
theorem imbitrrid(ph: wff, ps: wff, ch: wff, th: wff, imbitrrid_1: Prf(wi(ph, th)), imbitrrid_2: Prf(wi(ch, wb(ps, th)))) -> Prf(wi(ch, wi(ph, ps))) =
  imbitrid(ph, th, ch, ps, imbitrrid_1, bicomd(ch, ps, th, imbitrrid_2))
theorem syl5ibrcom(ph: wff, ps: wff, ch: wff, th: wff, imbitrrid_1: Prf(wi(ph, th)), imbitrrid_2: Prf(wi(ch, wb(ps, th)))) -> Prf(wi(ph, wi(ch, ps))) =
  com12(ch, ph, ps, imbitrrid(ph, ps, ch, th, imbitrrid_1, imbitrrid_2))
theorem biimprd(ph: wff, ps: wff, ch: wff, biimprd_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wi(ch, ps))) =
  imbitrrid(ch, ps, ph, ch, id(ch), biimprd_1)
theorem biimpcd(ph: wff, ps: wff, ch: wff, biimpcd_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ps, wi(ph, ch))) =
  syl5ibcom(ps, ps, ph, ch, id(ps), biimpcd_1)
theorem biimprcd(ph: wff, ps: wff, ch: wff, biimpcd_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ch, wi(ph, ps))) =
  syl5ibrcom(ch, ps, ph, ch, id(ch), biimpcd_1)
theorem imbitrdi(ph: wff, ps: wff, ch: wff, th: wff, imbitrdi_1: Prf(wi(ph, wi(ps, ch))), imbitrdi_2: Prf(wb(ch, th))) -> Prf(wi(ph, wi(ps, th))) =
  syl6(ph, ps, ch, th, imbitrdi_1, biimpi(ch, th, imbitrdi_2))
theorem imbitrrdi(ph: wff, ps: wff, ch: wff, th: wff, imbitrrdi_1: Prf(wi(ph, wi(ps, ch))), imbitrrdi_2: Prf(wb(th, ch))) -> Prf(wi(ph, wi(ps, th))) =
  syl6(ph, ps, ch, th, imbitrrdi_1, biimpri(th, ch, imbitrrdi_2))
theorem biimtrdi(ph: wff, ps: wff, ch: wff, th: wff, biimtrdi_1: Prf(wi(ph, wb(ps, ch))), biimtrdi_2: Prf(wi(ch, th))) -> Prf(wi(ph, wi(ps, th))) =
  syl6(ph, ps, ch, th, biimpd(ph, ps, ch, biimtrdi_1), biimtrdi_2)
theorem biimtrrdi(ph: wff, ps: wff, ch: wff, th: wff, biimtrrdi_1: Prf(wi(ph, wb(ch, ps))), biimtrrdi_2: Prf(wi(ch, th))) -> Prf(wi(ph, wi(ps, th))) =
  syl6(ph, ps, ch, th, biimprd(ph, ch, ps, biimtrrdi_1), biimtrrdi_2)
theorem syl7bi(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl7bi_1: Prf(wb(ph, ps)), syl7bi_2: Prf(wi(ch, wi(th, wi(ps, ta))))) -> Prf(wi(ch, wi(th, wi(ph, ta)))) =
  syl7(ph, ps, ch, th, ta, biimpi(ph, ps, syl7bi_1), syl7bi_2)
theorem syl8ib(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl8ib_1: Prf(wi(ph, wi(ps, wi(ch, th)))), syl8ib_2: Prf(wb(th, ta))) -> Prf(wi(ph, wi(ps, wi(ch, ta)))) =
  syl8(ph, ps, ch, th, ta, syl8ib_1, biimpi(th, ta, syl8ib_2))
theorem mpbird(ph: wff, ps: wff, ch: wff, mpbird_min: Prf(wi(ph, ch)), mpbird_maj: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, ps)) =
  mpd(ph, ch, ps, mpbird_min, biimprd(ph, ps, ch, mpbird_maj))
theorem mpbiri(ph: wff, ps: wff, ch: wff, mpbiri_min: Prf(ch), mpbiri_maj: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, ps)) =
  mpbird(ph, ps, ch, a1i(ch, ph, mpbiri_min), mpbiri_maj)
theorem sylibrd(ph: wff, ps: wff, ch: wff, th: wff, sylibrd_1: Prf(wi(ph, wi(ps, ch))), sylibrd_2: Prf(wi(ph, wb(th, ch)))) -> Prf(wi(ph, wi(ps, th))) =
  syld(ph, ps, ch, th, sylibrd_1, biimprd(ph, th, ch, sylibrd_2))
theorem sylbird(ph: wff, ps: wff, ch: wff, th: wff, sylbird_1: Prf(wi(ph, wb(ch, ps))), sylbird_2: Prf(wi(ph, wi(ch, th)))) -> Prf(wi(ph, wi(ps, th))) =
  syld(ph, ps, ch, th, biimprd(ph, ch, ps, sylbird_1), sylbird_2)
theorem biid(ph: wff) -> Prf(wb(ph, ph)) =
  impbii(ph, ph, id(ph), id(ph))
theorem biidd(ph: wff, ps: wff) -> Prf(wi(ph, wb(ps, ps))) =
  a1i(wb(ps, ps), ph, biid(ps))
theorem pm5.1im(ph: wff, ps: wff) -> Prf(wi(ph, wi(ps, wb(ph, ps)))) =
  impbid21d(ph, ps, ph, ps, ax_1(ps, ph), ax_1(ph, ps))
theorem 2th(ph: wff, ps: wff, 2th_1: Prf(ph), 2th_2: Prf(ps)) -> Prf(wb(ph, ps)) =
  impbii(ph, ps, a1i(ps, ph, 2th_2), a1i(ph, ps, 2th_1))
theorem 2thd(ph: wff, ps: wff, ch: wff, 2thd_1: Prf(wi(ph, ps)), 2thd_2: Prf(wi(ph, ch))) -> Prf(wi(ph, wb(ps, ch))) =
  sylc(ph, ps, ch, wb(ps, ch), 2thd_1, 2thd_2, pm5.1im(ps, ch))
theorem monothetic(ph: wff, ps: wff) -> Prf(wb(wi(ph, ph), wi(ps, ps))) =
  2th(wi(ph, ph), wi(ps, ps), id(ph), id(ps))
theorem ibi(ph: wff, ps: wff, ibi_1: Prf(wi(ph, wb(ph, ps)))) -> Prf(wi(ph, ps)) =
  mpbid(ph, ph, ps, id(ph), ibi_1)
theorem ibir(ph: wff, ps: wff, ibir_1: Prf(wi(ph, wb(ps, ph)))) -> Prf(wi(ph, ps)) =
  ibi(ph, ps, bicomd(ph, ps, ph, ibir_1))
theorem ibd(ph: wff, ps: wff, ch: wff, ibd_1: Prf(wi(ph, wi(ps, wb(ps, ch))))) -> Prf(wi(ph, wi(ps, ch))) =
  syli(ps, ph, wb(ps, ch), ch, ibd_1, biimp(ps, ch))
theorem pm5.74(ph: wff, ps: wff, ch: wff) -> Prf(wb(wi(ph, wb(ps, ch)), wb(wi(ph, ps), wi(ph, ch)))) =
  impbii(wi(ph, wb(ps, ch)), wb(wi(ph, ps), wi(ph, ch)), impbid(wi(ph, wb(ps, ch)), wi(ph, ps), wi(ph, ch), imim3i(wb(ps, ch), ps, ch, ph, biimp(ps, ch)), imim3i(wb(ps, ch), ch, ps, ph, biimpr(ps, ch))), impbidd(wb(wi(ph, ps), wi(ph, ch)), ph, ps, ch, pm2.86d(wb(wi(ph, ps), wi(ph, ch)), ph, ps, ch, biimp(wi(ph, ps), wi(ph, ch))), pm2.86d(wb(wi(ph, ps), wi(ph, ch)), ph, ch, ps, biimpr(wi(ph, ps), wi(ph, ch)))))
theorem pm5.74i(ph: wff, ps: wff, ch: wff, pm5_74i_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wb(wi(ph, ps), wi(ph, ch))) =
  mpbi(wi(ph, wb(ps, ch)), wb(wi(ph, ps), wi(ph, ch)), pm5_74i_1, pm5.74(ph, ps, ch))
theorem pm5.74ri(ph: wff, ps: wff, ch: wff, pm5_74ri_1: Prf(wb(wi(ph, ps), wi(ph, ch)))) -> Prf(wi(ph, wb(ps, ch))) =
  mpbir(wi(ph, wb(ps, ch)), wb(wi(ph, ps), wi(ph, ch)), pm5_74ri_1, pm5.74(ph, ps, ch))
theorem pm5.74d(ph: wff, ps: wff, ch: wff, th: wff, pm5_74d_1: Prf(wi(ph, wi(ps, wb(ch, th))))) -> Prf(wi(ph, wb(wi(ps, ch), wi(ps, th)))) =
  sylib(ph, wi(ps, wb(ch, th)), wb(wi(ps, ch), wi(ps, th)), pm5_74d_1, pm5.74(ps, ch, th))
theorem pm5.74rd(ph: wff, ps: wff, ch: wff, th: wff, pm5_74rd_1: Prf(wi(ph, wb(wi(ps, ch), wi(ps, th))))) -> Prf(wi(ph, wi(ps, wb(ch, th)))) =
  sylibr(ph, wb(wi(ps, ch), wi(ps, th)), wi(ps, wb(ch, th)), pm5_74rd_1, pm5.74(ps, ch, th))
theorem bitri(ph: wff, ps: wff, ch: wff, bitri_1: Prf(wb(ph, ps)), bitri_2: Prf(wb(ps, ch))) -> Prf(wb(ph, ch)) =
  impbii(ph, ch, sylbb(ph, ps, ch, bitri_1, bitri_2), sylbbr(ph, ps, ch, bitri_1, bitri_2))
theorem bitr2i(ph: wff, ps: wff, ch: wff, bitr2i_1: Prf(wb(ph, ps)), bitr2i_2: Prf(wb(ps, ch))) -> Prf(wb(ch, ph)) =
  bicomi(ph, ch, bitri(ph, ps, ch, bitr2i_1, bitr2i_2))
theorem bitr3i(ph: wff, ps: wff, ch: wff, bitr3i_1: Prf(wb(ps, ph)), bitr3i_2: Prf(wb(ps, ch))) -> Prf(wb(ph, ch)) =
  bitri(ph, ps, ch, bicomi(ps, ph, bitr3i_1), bitr3i_2)
theorem bitr4i(ph: wff, ps: wff, ch: wff, bitr4i_1: Prf(wb(ph, ps)), bitr4i_2: Prf(wb(ch, ps))) -> Prf(wb(ph, ch)) =
  bitri(ph, ps, ch, bitr4i_1, bicomi(ch, ps, bitr4i_2))
theorem bitrd(ph: wff, ps: wff, ch: wff, th: wff, bitrd_1: Prf(wi(ph, wb(ps, ch))), bitrd_2: Prf(wi(ph, wb(ch, th)))) -> Prf(wi(ph, wb(ps, th))) =
  pm5.74ri(ph, ps, th, bitri(wi(ph, ps), wi(ph, ch), wi(ph, th), pm5.74i(ph, ps, ch, bitrd_1), pm5.74i(ph, ch, th, bitrd_2)))
theorem bitr2d(ph: wff, ps: wff, ch: wff, th: wff, bitr2d_1: Prf(wi(ph, wb(ps, ch))), bitr2d_2: Prf(wi(ph, wb(ch, th)))) -> Prf(wi(ph, wb(th, ps))) =
  bicomd(ph, ps, th, bitrd(ph, ps, ch, th, bitr2d_1, bitr2d_2))
theorem bitr3d(ph: wff, ps: wff, ch: wff, th: wff, bitr3d_1: Prf(wi(ph, wb(ps, ch))), bitr3d_2: Prf(wi(ph, wb(ps, th)))) -> Prf(wi(ph, wb(ch, th))) =
  bitrd(ph, ch, ps, th, bicomd(ph, ps, ch, bitr3d_1), bitr3d_2)
theorem bitr4d(ph: wff, ps: wff, ch: wff, th: wff, bitr4d_1: Prf(wi(ph, wb(ps, ch))), bitr4d_2: Prf(wi(ph, wb(th, ch)))) -> Prf(wi(ph, wb(ps, th))) =
  bitrd(ph, ps, ch, th, bitr4d_1, bicomd(ph, th, ch, bitr4d_2))
theorem bitrid(ph: wff, ps: wff, ch: wff, th: wff, bitrid_1: Prf(wb(ph, ps)), bitrid_2: Prf(wi(ch, wb(ps, th)))) -> Prf(wi(ch, wb(ph, th))) =
  bitrd(ch, ph, ps, th, a1i(wb(ph, ps), ch, bitrid_1), bitrid_2)
theorem bitr2id(ph: wff, ps: wff, ch: wff, th: wff, bitr2id_1: Prf(wb(ph, ps)), bitr2id_2: Prf(wi(ch, wb(ps, th)))) -> Prf(wi(ch, wb(th, ph))) =
  bicomd(ch, ph, th, bitrid(ph, ps, ch, th, bitr2id_1, bitr2id_2))
theorem bitr3id(ph: wff, ps: wff, ch: wff, th: wff, bitr3id_1: Prf(wb(ps, ph)), bitr3id_2: Prf(wi(ch, wb(ps, th)))) -> Prf(wi(ch, wb(ph, th))) =
  bitrid(ph, ps, ch, th, bicomi(ps, ph, bitr3id_1), bitr3id_2)
theorem bitr3di(ph: wff, ps: wff, ch: wff, th: wff, bitr3di_1: Prf(wi(ph, wb(ps, ch))), bitr3di_2: Prf(wb(ps, th))) -> Prf(wi(ph, wb(ch, th))) =
  bitr2id(th, ps, ph, ch, bicomi(ps, th, bitr3di_2), bitr3di_1)
theorem bitrdi(ph: wff, ps: wff, ch: wff, th: wff, bitrdi_1: Prf(wi(ph, wb(ps, ch))), bitrdi_2: Prf(wb(ch, th))) -> Prf(wi(ph, wb(ps, th))) =
  bitrd(ph, ps, ch, th, bitrdi_1, a1i(wb(ch, th), ph, bitrdi_2))
theorem bitr2di(ph: wff, ps: wff, ch: wff, th: wff, bitr2di_1: Prf(wi(ph, wb(ps, ch))), bitr2di_2: Prf(wb(ch, th))) -> Prf(wi(ph, wb(th, ps))) =
  bicomd(ph, ps, th, bitrdi(ph, ps, ch, th, bitr2di_1, bitr2di_2))
theorem bitr4di(ph: wff, ps: wff, ch: wff, th: wff, bitr4di_1: Prf(wi(ph, wb(ps, ch))), bitr4di_2: Prf(wb(th, ch))) -> Prf(wi(ph, wb(ps, th))) =
  bitrdi(ph, ps, ch, th, bitr4di_1, bicomi(th, ch, bitr4di_2))
theorem bitr4id(ph: wff, ps: wff, ch: wff, th: wff, bitr4id_2: Prf(wb(ps, ch)), bitr4id_1: Prf(wi(ph, wb(th, ch)))) -> Prf(wi(ph, wb(ps, th))) =
  bitr2di(ph, th, ch, ps, bitr4id_1, bicomi(ps, ch, bitr4id_2))
theorem 3imtr3i(ph: wff, ps: wff, ch: wff, th: wff, 3imtr3_1: Prf(wi(ph, ps)), 3imtr3_2: Prf(wb(ph, ch)), 3imtr3_3: Prf(wb(ps, th))) -> Prf(wi(ch, th)) =
  sylib(ch, ps, th, sylbir(ch, ph, ps, 3imtr3_2, 3imtr3_1), 3imtr3_3)
theorem 3imtr4i(ph: wff, ps: wff, ch: wff, th: wff, 3imtr4_1: Prf(wi(ph, ps)), 3imtr4_2: Prf(wb(ch, ph)), 3imtr4_3: Prf(wb(th, ps))) -> Prf(wi(ch, th)) =
  sylibr(ch, ps, th, sylbi(ch, ph, ps, 3imtr4_2, 3imtr4_1), 3imtr4_3)
theorem 3imtr3d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3imtr3d_1: Prf(wi(ph, wi(ps, ch))), 3imtr3d_2: Prf(wi(ph, wb(ps, th))), 3imtr3d_3: Prf(wi(ph, wb(ch, ta)))) -> Prf(wi(ph, wi(th, ta))) =
  sylbird(ph, th, ps, ta, 3imtr3d_2, sylibd(ph, ps, ch, ta, 3imtr3d_1, 3imtr3d_3))
theorem 3imtr4d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3imtr4d_1: Prf(wi(ph, wi(ps, ch))), 3imtr4d_2: Prf(wi(ph, wb(th, ps))), 3imtr4d_3: Prf(wi(ph, wb(ta, ch)))) -> Prf(wi(ph, wi(th, ta))) =
  sylbid(ph, th, ps, ta, 3imtr4d_2, sylibrd(ph, ps, ch, ta, 3imtr4d_1, 3imtr4d_3))
theorem 3imtr3g(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3imtr3g_1: Prf(wi(ph, wi(ps, ch))), 3imtr3g_2: Prf(wb(ps, th)), 3imtr3g_3: Prf(wb(ch, ta))) -> Prf(wi(ph, wi(th, ta))) =
  imbitrdi(ph, th, ch, ta, biimtrrid(th, ps, ph, ch, 3imtr3g_2, 3imtr3g_1), 3imtr3g_3)
theorem 3imtr4g(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3imtr4g_1: Prf(wi(ph, wi(ps, ch))), 3imtr4g_2: Prf(wb(th, ps)), 3imtr4g_3: Prf(wb(ta, ch))) -> Prf(wi(ph, wi(th, ta))) =
  imbitrrdi(ph, th, ch, ta, biimtrid(th, ps, ph, ch, 3imtr4g_2, 3imtr4g_1), 3imtr4g_3)
theorem 3bitri(ph: wff, ps: wff, ch: wff, th: wff, 3bitri_1: Prf(wb(ph, ps)), 3bitri_2: Prf(wb(ps, ch)), 3bitri_3: Prf(wb(ch, th))) -> Prf(wb(ph, th)) =
  bitri(ph, ps, th, 3bitri_1, bitri(ps, ch, th, 3bitri_2, 3bitri_3))
theorem 3bitrri(ph: wff, ps: wff, ch: wff, th: wff, 3bitri_1: Prf(wb(ph, ps)), 3bitri_2: Prf(wb(ps, ch)), 3bitri_3: Prf(wb(ch, th))) -> Prf(wb(th, ph)) =
  bitr3i(th, ch, ph, 3bitri_3, bitr2i(ph, ps, ch, 3bitri_1, 3bitri_2))
theorem 3bitr2i(ph: wff, ps: wff, ch: wff, th: wff, 3bitr2i_1: Prf(wb(ph, ps)), 3bitr2i_2: Prf(wb(ch, ps)), 3bitr2i_3: Prf(wb(ch, th))) -> Prf(wb(ph, th)) =
  bitri(ph, ch, th, bitr4i(ph, ps, ch, 3bitr2i_1, 3bitr2i_2), 3bitr2i_3)
theorem 3bitr2ri(ph: wff, ps: wff, ch: wff, th: wff, 3bitr2i_1: Prf(wb(ph, ps)), 3bitr2i_2: Prf(wb(ch, ps)), 3bitr2i_3: Prf(wb(ch, th))) -> Prf(wb(th, ph)) =
  bitr2i(ph, ch, th, bitr4i(ph, ps, ch, 3bitr2i_1, 3bitr2i_2), 3bitr2i_3)
theorem 3bitr3i(ph: wff, ps: wff, ch: wff, th: wff, 3bitr3i_1: Prf(wb(ph, ps)), 3bitr3i_2: Prf(wb(ph, ch)), 3bitr3i_3: Prf(wb(ps, th))) -> Prf(wb(ch, th)) =
  bitri(ch, ps, th, bitr3i(ch, ph, ps, 3bitr3i_2, 3bitr3i_1), 3bitr3i_3)
theorem 3bitr3ri(ph: wff, ps: wff, ch: wff, th: wff, 3bitr3i_1: Prf(wb(ph, ps)), 3bitr3i_2: Prf(wb(ph, ch)), 3bitr3i_3: Prf(wb(ps, th))) -> Prf(wb(th, ch)) =
  bitr3i(th, ps, ch, 3bitr3i_3, bitr3i(ps, ph, ch, 3bitr3i_1, 3bitr3i_2))
theorem 3bitr4i(ph: wff, ps: wff, ch: wff, th: wff, 3bitr4i_1: Prf(wb(ph, ps)), 3bitr4i_2: Prf(wb(ch, ph)), 3bitr4i_3: Prf(wb(th, ps))) -> Prf(wb(ch, th)) =
  bitri(ch, ph, th, 3bitr4i_2, bitr4i(ph, ps, th, 3bitr4i_1, 3bitr4i_3))
theorem 3bitr4ri(ph: wff, ps: wff, ch: wff, th: wff, 3bitr4i_1: Prf(wb(ph, ps)), 3bitr4i_2: Prf(wb(ch, ph)), 3bitr4i_3: Prf(wb(th, ps))) -> Prf(wb(th, ch)) =
  bitr2i(ch, ph, th, 3bitr4i_2, bitr4i(ph, ps, th, 3bitr4i_1, 3bitr4i_3))
theorem 3bitrd(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitrd_1: Prf(wi(ph, wb(ps, ch))), 3bitrd_2: Prf(wi(ph, wb(ch, th))), 3bitrd_3: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(ps, ta))) =
  bitrd(ph, ps, th, ta, bitrd(ph, ps, ch, th, 3bitrd_1, 3bitrd_2), 3bitrd_3)
theorem 3bitrrd(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitrd_1: Prf(wi(ph, wb(ps, ch))), 3bitrd_2: Prf(wi(ph, wb(ch, th))), 3bitrd_3: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(ta, ps))) =
  bitr3d(ph, th, ta, ps, 3bitrd_3, bitr2d(ph, ps, ch, th, 3bitrd_1, 3bitrd_2))
theorem 3bitr2d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitr2d_1: Prf(wi(ph, wb(ps, ch))), 3bitr2d_2: Prf(wi(ph, wb(th, ch))), 3bitr2d_3: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(ps, ta))) =
  bitrd(ph, ps, th, ta, bitr4d(ph, ps, ch, th, 3bitr2d_1, 3bitr2d_2), 3bitr2d_3)
theorem 3bitr2rd(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitr2d_1: Prf(wi(ph, wb(ps, ch))), 3bitr2d_2: Prf(wi(ph, wb(th, ch))), 3bitr2d_3: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(ta, ps))) =
  bitr2d(ph, ps, th, ta, bitr4d(ph, ps, ch, th, 3bitr2d_1, 3bitr2d_2), 3bitr2d_3)
theorem 3bitr3d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitr3d_1: Prf(wi(ph, wb(ps, ch))), 3bitr3d_2: Prf(wi(ph, wb(ps, th))), 3bitr3d_3: Prf(wi(ph, wb(ch, ta)))) -> Prf(wi(ph, wb(th, ta))) =
  bitrd(ph, th, ch, ta, bitr3d(ph, ps, th, ch, 3bitr3d_2, 3bitr3d_1), 3bitr3d_3)
theorem 3bitr3rd(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitr3d_1: Prf(wi(ph, wb(ps, ch))), 3bitr3d_2: Prf(wi(ph, wb(ps, th))), 3bitr3d_3: Prf(wi(ph, wb(ch, ta)))) -> Prf(wi(ph, wb(ta, th))) =
  bitr3d(ph, ch, ta, th, 3bitr3d_3, bitr3d(ph, ps, ch, th, 3bitr3d_1, 3bitr3d_2))
theorem 3bitr4d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitr4d_1: Prf(wi(ph, wb(ps, ch))), 3bitr4d_2: Prf(wi(ph, wb(th, ps))), 3bitr4d_3: Prf(wi(ph, wb(ta, ch)))) -> Prf(wi(ph, wb(th, ta))) =
  bitrd(ph, th, ps, ta, 3bitr4d_2, bitr4d(ph, ps, ch, ta, 3bitr4d_1, 3bitr4d_3))
theorem 3bitr4rd(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitr4d_1: Prf(wi(ph, wb(ps, ch))), 3bitr4d_2: Prf(wi(ph, wb(th, ps))), 3bitr4d_3: Prf(wi(ph, wb(ta, ch)))) -> Prf(wi(ph, wb(ta, th))) =
  bitr4d(ph, ta, ps, th, bitr4d(ph, ta, ch, ps, 3bitr4d_3, 3bitr4d_1), 3bitr4d_2)
theorem 3bitr3g(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitr3g_1: Prf(wi(ph, wb(ps, ch))), 3bitr3g_2: Prf(wb(ps, th)), 3bitr3g_3: Prf(wb(ch, ta))) -> Prf(wi(ph, wb(th, ta))) =
  bitrdi(ph, th, ch, ta, bitr3id(th, ps, ph, ch, 3bitr3g_2, 3bitr3g_1), 3bitr3g_3)
theorem 3bitr4g(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, 3bitr4g_1: Prf(wi(ph, wb(ps, ch))), 3bitr4g_2: Prf(wb(th, ps)), 3bitr4g_3: Prf(wb(ta, ch))) -> Prf(wi(ph, wb(th, ta))) =
  bitr4di(ph, th, ch, ta, bitrid(th, ps, ph, ch, 3bitr4g_2, 3bitr4g_1), 3bitr4g_3)
theorem notnotb(ph: wff) -> Prf(wb(ph, wn(wn(ph)))) =
  impbii(ph, wn(wn(ph)), notnot(ph), notnotr(ph))
theorem con34b(ph: wff, ps: wff) -> Prf(wb(wi(ph, ps), wi(wn(ps), wn(ph)))) =
  impbii(wi(ph, ps), wi(wn(ps), wn(ph)), con3(ph, ps), con4(ps, ph))
theorem con4bid(ph: wff, ps: wff, ch: wff, con4bid_1: Prf(wi(ph, wb(wn(ps), wn(ch))))) -> Prf(wi(ph, wb(ps, ch))) =
  impcon4bid(ph, ps, ch, con4d(ph, ch, ps, biimprd(ph, wn(ps), wn(ch), con4bid_1)), biimpd(ph, wn(ps), wn(ch), con4bid_1))
theorem notbid(ph: wff, ps: wff, ch: wff, notbid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wn(ps), wn(ch)))) =
  con4bid(ph, wn(ps), wn(ch), 3bitr3g(ph, ps, ch, wn(wn(ps)), wn(wn(ch)), notbid_1, notnotb(ps), notnotb(ch)))
theorem notbi(ph: wff, ps: wff) -> Prf(wb(wb(ph, ps), wb(wn(ph), wn(ps)))) =
  impbii(wb(ph, ps), wb(wn(ph), wn(ps)), notbid(wb(ph, ps), ph, ps, id(wb(ph, ps))), con4bid(wb(wn(ph), wn(ps)), ph, ps, id(wb(wn(ph), wn(ps)))))
theorem notbii(ph: wff, ps: wff, notbii_1: Prf(wb(ph, ps))) -> Prf(wb(wn(ph), wn(ps))) =
  mpbi(wb(ph, ps), wb(wn(ph), wn(ps)), notbii_1, notbi(ph, ps))
theorem con4bii(ph: wff, ps: wff, con4bii_1: Prf(wb(wn(ph), wn(ps)))) -> Prf(wb(ph, ps)) =
  mpbir(wb(ph, ps), wb(wn(ph), wn(ps)), con4bii_1, notbi(ph, ps))
theorem mtbi(ph: wff, ps: wff, mtbi_1: Prf(wn(ph)), mtbi_2: Prf(wb(ph, ps))) -> Prf(wn(ps)) =
  mto(ps, ph, mtbi_1, biimpri(ph, ps, mtbi_2))
theorem mtbir(ph: wff, ps: wff, mtbir_1: Prf(wn(ps)), mtbir_2: Prf(wb(ph, ps))) -> Prf(wn(ph)) =
  mtbi(ps, ph, mtbir_1, bicomi(ph, ps, mtbir_2))
theorem mtbid(ph: wff, ps: wff, ch: wff, mtbid_min: Prf(wi(ph, wn(ps))), mtbid_maj: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wn(ch))) =
  mtod(ph, ch, ps, mtbid_min, biimprd(ph, ps, ch, mtbid_maj))
theorem mtbird(ph: wff, ps: wff, ch: wff, mtbird_min: Prf(wi(ph, wn(ch))), mtbird_maj: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wn(ps))) =
  mtod(ph, ps, ch, mtbird_min, biimpd(ph, ps, ch, mtbird_maj))
theorem mtbii(ph: wff, ps: wff, ch: wff, mtbii_min: Prf(wn(ps)), mtbii_maj: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wn(ch))) =
  mtoi(ph, ch, ps, mtbii_min, biimprd(ph, ps, ch, mtbii_maj))
theorem mtbiri(ph: wff, ps: wff, ch: wff, mtbiri_min: Prf(wn(ch)), mtbiri_maj: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wn(ps))) =
  mtoi(ph, ps, ch, mtbiri_min, biimpd(ph, ps, ch, mtbiri_maj))
theorem sylnib(ph: wff, ps: wff, ch: wff, sylnib_1: Prf(wi(ph, wn(ps))), sylnib_2: Prf(wb(ps, ch))) -> Prf(wi(ph, wn(ch))) =
  nsyl(ph, ps, ch, sylnib_1, biimpri(ps, ch, sylnib_2))
theorem sylnibr(ph: wff, ps: wff, ch: wff, sylnibr_1: Prf(wi(ph, wn(ps))), sylnibr_2: Prf(wb(ch, ps))) -> Prf(wi(ph, wn(ch))) =
  sylnib(ph, ps, ch, sylnibr_1, bicomi(ch, ps, sylnibr_2))
theorem sylnbi(ph: wff, ps: wff, ch: wff, sylnbi_1: Prf(wb(ph, ps)), sylnbi_2: Prf(wi(wn(ps), ch))) -> Prf(wi(wn(ph), ch)) =
  sylbi(wn(ph), wn(ps), ch, notbii(ph, ps, sylnbi_1), sylnbi_2)
theorem sylnbir(ph: wff, ps: wff, ch: wff, sylnbir_1: Prf(wb(ps, ph)), sylnbir_2: Prf(wi(wn(ps), ch))) -> Prf(wi(wn(ph), ch)) =
  sylnbi(ph, ps, ch, bicomi(ps, ph, sylnbir_1), sylnbir_2)
theorem xchnxbi(ph: wff, ps: wff, ch: wff, xchnxbi_1: Prf(wb(wn(ph), ps)), xchnxbi_2: Prf(wb(ph, ch))) -> Prf(wb(wn(ch), ps)) =
  bitr3i(wn(ch), wn(ph), ps, notbii(ph, ch, xchnxbi_2), xchnxbi_1)
theorem xchnxbir(ph: wff, ps: wff, ch: wff, xchnxbir_1: Prf(wb(wn(ph), ps)), xchnxbir_2: Prf(wb(ch, ph))) -> Prf(wb(wn(ch), ps)) =
  xchnxbi(ph, ps, ch, xchnxbir_1, bicomi(ch, ph, xchnxbir_2))
theorem xchbinx(ph: wff, ps: wff, ch: wff, xchbinx_1: Prf(wb(ph, wn(ps))), xchbinx_2: Prf(wb(ps, ch))) -> Prf(wb(ph, wn(ch))) =
  bitri(ph, wn(ps), wn(ch), xchbinx_1, notbii(ps, ch, xchbinx_2))
theorem xchbinxr(ph: wff, ps: wff, ch: wff, xchbinxr_1: Prf(wb(ph, wn(ps))), xchbinxr_2: Prf(wb(ch, ps))) -> Prf(wb(ph, wn(ch))) =
  xchbinx(ph, ps, ch, xchbinxr_1, bicomi(ch, ps, xchbinxr_2))
theorem imbi2i(ph: wff, ps: wff, ch: wff, imbi2i_1: Prf(wb(ph, ps))) -> Prf(wb(wi(ch, ph), wi(ch, ps))) =
  pm5.74i(ch, ph, ps, a1i(wb(ph, ps), ch, imbi2i_1))
theorem bibi2i(ph: wff, ps: wff, ch: wff, bibi2i_1: Prf(wb(ph, ps))) -> Prf(wb(wb(ch, ph), wb(ch, ps))) =
  impbii(wb(ch, ph), wb(ch, ps), bitrdi(wb(ch, ph), ch, ph, ps, id(wb(ch, ph)), bibi2i_1), bitr4di(wb(ch, ps), ch, ps, ph, id(wb(ch, ps)), bibi2i_1))
theorem bibi1i(ph: wff, ps: wff, ch: wff, bibi2i_1: Prf(wb(ph, ps))) -> Prf(wb(wb(ph, ch), wb(ps, ch))) =
  3bitri(wb(ph, ch), wb(ch, ph), wb(ch, ps), wb(ps, ch), bicom(ph, ch), bibi2i(ph, ps, ch, bibi2i_1), bicom(ch, ps))
theorem bibi12i(ph: wff, ps: wff, ch: wff, th: wff, bibi2i_1: Prf(wb(ph, ps)), bibi12i_2: Prf(wb(ch, th))) -> Prf(wb(wb(ph, ch), wb(ps, th))) =
  bitri(wb(ph, ch), wb(ph, th), wb(ps, th), bibi2i(ch, th, ph, bibi12i_2), bibi1i(ph, ps, th, bibi2i_1))
theorem imbi2d(ph: wff, ps: wff, ch: wff, th: wff, imbid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wi(th, ps), wi(th, ch)))) =
  pm5.74d(ph, th, ps, ch, a1d(ph, wb(ps, ch), th, imbid_1))
theorem imbi1d(ph: wff, ps: wff, ch: wff, th: wff, imbid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wi(ps, th), wi(ch, th)))) =
  impbid(ph, wi(ps, th), wi(ch, th), imim1d(ph, ch, ps, th, biimprd(ph, ps, ch, imbid_1)), imim1d(ph, ps, ch, th, biimpd(ph, ps, ch, imbid_1)))
theorem bibi2d(ph: wff, ps: wff, ch: wff, th: wff, imbid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wb(th, ps), wb(th, ch)))) =
  pm5.74ri(ph, wb(th, ps), wb(th, ch), 3bitr4i(wb(wi(ph, th), wi(ph, ps)), wb(wi(ph, th), wi(ph, ch)), wi(ph, wb(th, ps)), wi(ph, wb(th, ch)), bibi2i(wi(ph, ps), wi(ph, ch), wi(ph, th), pm5.74i(ph, ps, ch, imbid_1)), pm5.74(ph, th, ps), pm5.74(ph, th, ch)))
theorem bibi1d(ph: wff, ps: wff, ch: wff, th: wff, imbid_1: Prf(wi(ph, wb(ps, ch)))) -> Prf(wi(ph, wb(wb(ps, th), wb(ch, th)))) =
  3bitr4g(ph, wb(th, ps), wb(th, ch), wb(ps, th), wb(ch, th), bibi2d(ph, ps, ch, th, imbid_1), bicom(ps, th), bicom(ch, th))
theorem imbi12d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, imbi12d_1: Prf(wi(ph, wb(ps, ch))), imbi12d_2: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(wi(ps, th), wi(ch, ta)))) =
  bitrd(ph, wi(ps, th), wi(ch, th), wi(ch, ta), imbi1d(ph, ps, ch, th, imbi12d_1), imbi2d(ph, th, ta, ch, imbi12d_2))
theorem bibi12d(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, imbi12d_1: Prf(wi(ph, wb(ps, ch))), imbi12d_2: Prf(wi(ph, wb(th, ta)))) -> Prf(wi(ph, wb(wb(ps, th), wb(ch, ta)))) =
  bitrd(ph, wb(ps, th), wb(ch, th), wb(ch, ta), bibi1d(ph, ps, ch, th, imbi12d_1), bibi2d(ph, th, ta, ch, imbi12d_2))
theorem imbi12(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wb(ph, ps), wi(wb(ch, th), wb(wi(ph, ch), wi(ps, th))))) =
  expi(wb(ph, ps), wb(ch, th), wb(wi(ph, ch), wi(ps, th)), imbi12d(wn(wi(wb(ph, ps), wn(wb(ch, th)))), ph, ps, ch, th, simplim(wb(ph, ps), wn(wb(ch, th))), simprim(wb(ph, ps), wb(ch, th))))
theorem imbi1(ph: wff, ps: wff, ch: wff) -> Prf(wi(wb(ph, ps), wb(wi(ph, ch), wi(ps, ch)))) =
  imbi1d(wb(ph, ps), ph, ps, ch, id(wb(ph, ps)))
theorem imbi2(ph: wff, ps: wff, ch: wff) -> Prf(wi(wb(ph, ps), wb(wi(ch, ph), wi(ch, ps)))) =
  imbi2d(wb(ph, ps), ph, ps, ch, id(wb(ph, ps)))
theorem imbi1i(ph: wff, ps: wff, ch: wff, imbi1i_1: Prf(wb(ph, ps))) -> Prf(wb(wi(ph, ch), wi(ps, ch))) =
  ax_mp(wb(ph, ps), wb(wi(ph, ch), wi(ps, ch)), imbi1i_1, imbi1(ph, ps, ch))
theorem imbi12i(ph: wff, ps: wff, ch: wff, th: wff, imbi12i_1: Prf(wb(ph, ps)), imbi12i_2: Prf(wb(ch, th))) -> Prf(wb(wi(ph, ch), wi(ps, th))) =
  mp2(wb(ph, ps), wb(ch, th), wb(wi(ph, ch), wi(ps, th)), imbi12i_1, imbi12i_2, imbi12(ph, ps, ch, th))
theorem bibi1(ph: wff, ps: wff, ch: wff) -> Prf(wi(wb(ph, ps), wb(wb(ph, ch), wb(ps, ch)))) =
  bibi1d(wb(ph, ps), ph, ps, ch, id(wb(ph, ps)))
theorem bitr3(ph: wff, ps: wff, ch: wff) -> Prf(wi(wb(ph, ps), wi(wb(ph, ch), wb(ps, ch)))) =
  biimpd(wb(ph, ps), wb(ph, ch), wb(ps, ch), bibi1(ph, ps, ch))
theorem con2bi(ph: wff, ps: wff) -> Prf(wb(wb(ph, wn(ps)), wb(ps, wn(ph)))) =
  3bitr2i(wb(ph, wn(ps)), wb(wn(ph), wn(wn(ps))), wb(wn(ph), ps), wb(ps, wn(ph)), notbi(ph, wn(ps)), bibi2i(ps, wn(wn(ps)), wn(ph), notnotb(ps)), bicom(wn(ph), ps))
theorem con2bid(ph: wff, ps: wff, ch: wff, con2bid_1: Prf(wi(ph, wb(ps, wn(ch))))) -> Prf(wi(ph, wb(ch, wn(ps)))) =
  sylibr(ph, wb(ps, wn(ch)), wb(ch, wn(ps)), con2bid_1, con2bi(ch, ps))
theorem con1bid(ph: wff, ps: wff, ch: wff, con1bid_1: Prf(wi(ph, wb(wn(ps), ch)))) -> Prf(wi(ph, wb(wn(ch), ps))) =
  bicomd(ph, ps, wn(ch), con2bid(ph, ch, ps, bicomd(ph, wn(ps), ch, con1bid_1)))
theorem con1bii(ph: wff, ps: wff, con1bii_1: Prf(wb(wn(ph), ps))) -> Prf(wb(wn(ps), ph)) =
  bicomi(ph, wn(ps), xchbinx(ph, wn(ph), ps, notnotb(ph), con1bii_1))
theorem con2bii(ph: wff, ps: wff, con2bii_1: Prf(wb(ph, wn(ps)))) -> Prf(wb(ps, wn(ph))) =
  xchbinxr(ps, wn(ps), ph, notnotb(ps), con2bii_1)
theorem con1b(ph: wff, ps: wff) -> Prf(wb(wi(wn(ph), ps), wi(wn(ps), ph))) =
  impbii(wi(wn(ph), ps), wi(wn(ps), ph), con1(ph, ps), con1(ps, ph))
theorem con2b(ph: wff, ps: wff) -> Prf(wb(wi(ph, wn(ps)), wi(ps, wn(ph)))) =
  impbii(wi(ph, wn(ps)), wi(ps, wn(ph)), con2(ph, ps), con2(ps, ph))
theorem biimt(ph: wff, ps: wff) -> Prf(wi(ph, wb(ps, wi(ph, ps)))) =
  impbid2(ph, ps, wi(ph, ps), ax_1(ps, ph), pm2.27(ph, ps))
theorem pm5.5(ph: wff, ps: wff) -> Prf(wi(ph, wb(wi(ph, ps), ps))) =
  bicomd(ph, ps, wi(ph, ps), biimt(ph, ps))
theorem a1bi(ph: wff, ps: wff, a1bi_1: Prf(ph)) -> Prf(wb(ps, wi(ph, ps))) =
  ax_mp(ph, wb(ps, wi(ph, ps)), a1bi_1, biimt(ph, ps))
theorem mt2bi(ph: wff, ps: wff, mt2bi_1: Prf(ph)) -> Prf(wb(wn(ps), wi(ps, wn(ph)))) =
  bitri(wn(ps), wi(ph, wn(ps)), wi(ps, wn(ph)), a1bi(ph, wn(ps), mt2bi_1), con2b(ph, ps))
theorem mtt(ph: wff, ps: wff) -> Prf(wi(wn(ph), wb(wn(ps), wi(ps, ph)))) =
  bitr4di(wn(ph), wn(ps), wi(wn(ph), wn(ps)), wi(ps, ph), biimt(wn(ph), wn(ps)), con34b(ps, ph))
theorem imnot(ph: wff, ps: wff) -> Prf(wi(wn(ps), wb(wi(ph, ps), wn(ph)))) =
  bicomd(wn(ps), wn(ph), wi(ph, ps), mtt(ps, ph))
theorem pm5.501(ph: wff, ps: wff) -> Prf(wi(ph, wb(ps, wb(ph, ps)))) =
  impbid(ph, ps, wb(ph, ps), pm5.1im(ph, ps), com12(wb(ph, ps), ph, ps, biimp(ph, ps)))
theorem ibib(ph: wff, ps: wff) -> Prf(wb(wi(ph, ps), wi(ph, wb(ph, ps)))) =
  pm5.74i(ph, ps, wb(ph, ps), pm5.501(ph, ps))
theorem ibibr(ph: wff, ps: wff) -> Prf(wb(wi(ph, ps), wi(ph, wb(ps, ph)))) =
  pm5.74i(ph, ps, wb(ps, ph), bitrdi(ph, ps, wb(ph, ps), wb(ps, ph), pm5.501(ph, ps), bicom(ph, ps)))
theorem tbt(ph: wff, ps: wff, tbt_1: Prf(ph)) -> Prf(wb(ps, wb(ps, ph))) =
  ax_mp(ph, wb(ps, wb(ps, ph)), tbt_1, pm5.74ri(ph, ps, wb(ps, ph), ibibr(ph, ps)))
theorem nbn2(ph: wff, ps: wff) -> Prf(wi(wn(ph), wb(wn(ps), wb(ph, ps)))) =
  bitr4di(wn(ph), wn(ps), wb(wn(ph), wn(ps)), wb(ph, ps), pm5.501(wn(ph), wn(ps)), notbi(ph, ps))
theorem bibif(ph: wff, ps: wff) -> Prf(wi(wn(ps), wb(wb(ph, ps), wn(ph)))) =
  bitr2di(wn(ps), wn(ph), wb(ps, ph), wb(ph, ps), nbn2(ps, ph), bicom(ps, ph))
theorem nbn(ph: wff, ps: wff, nbn_1: Prf(wn(ph))) -> Prf(wb(wn(ps), wb(ps, ph))) =
  bicomi(wb(ps, ph), wn(ps), ax_mp(wn(ph), wb(wb(ps, ph), wn(ps)), nbn_1, bibif(ps, ph)))
theorem nbn3(ph: wff, ps: wff, nbn3_1: Prf(ph)) -> Prf(wb(wn(ps), wb(ps, wn(ph)))) =
  nbn(wn(ph), ps, notnoti(ph, nbn3_1))
theorem pm5.21im(ph: wff, ps: wff) -> Prf(wi(wn(ph), wi(wn(ps), wb(ph, ps)))) =
  biimpd(wn(ph), wn(ps), wb(ph, ps), nbn2(ph, ps))
theorem 2false(ph: wff, ps: wff, 2false_1: Prf(wn(ph)), 2false_2: Prf(wn(ps))) -> Prf(wb(ph, ps)) =
  con4bii(ph, ps, 2th(wn(ph), wn(ps), 2false_1, 2false_2))
theorem 2falsed(ph: wff, ps: wff, ch: wff, 2falsed_1: Prf(wi(ph, wn(ps))), 2falsed_2: Prf(wi(ph, wn(ch)))) -> Prf(wi(ph, wb(ps, ch))) =
  con4bid(ph, ps, ch, 2thd(ph, wn(ps), wn(ch), 2falsed_1, 2falsed_2))
theorem pm5.21ni(ph: wff, ps: wff, ch: wff, pm5_21ni_1: Prf(wi(ph, ps)), pm5_21ni_2: Prf(wi(ch, ps))) -> Prf(wi(wn(ps), wb(ph, ch))) =
  2falsed(wn(ps), ph, ch, con3i(ph, ps, pm5_21ni_1), con3i(ch, ps, pm5_21ni_2))
theorem pm5.21nii(ph: wff, ps: wff, ch: wff, pm5_21ni_1: Prf(wi(ph, ps)), pm5_21ni_2: Prf(wi(ch, ps)), pm5_21nii_3: Prf(wi(ps, wb(ph, ch)))) -> Prf(wb(ph, ch)) =
  pm2.61i(ps, wb(ph, ch), pm5_21nii_3, pm5.21ni(ph, ps, ch, pm5_21ni_1, pm5_21ni_2))
theorem pm5.21ndd(ph: wff, ps: wff, ch: wff, th: wff, pm5_21ndd_1: Prf(wi(ph, wi(ch, ps))), pm5_21ndd_2: Prf(wi(ph, wi(th, ps))), pm5_21ndd_3: Prf(wi(ph, wi(ps, wb(ch, th))))) -> Prf(wi(ph, wb(ch, th))) =
  pm2.61d(ph, ps, wb(ch, th), pm5_21ndd_3, syl6c(ph, wn(ps), wn(ch), wn(th), wb(ch, th), con3d(ph, ch, ps, pm5_21ndd_1), con3d(ph, th, ps, pm5_21ndd_2), pm5.21im(ch, th)))
theorem bija(ph: wff, ps: wff, ch: wff, bija_1: Prf(wi(ph, wi(ps, ch))), bija_2: Prf(wi(wn(ph), wi(wn(ps), ch)))) -> Prf(wi(wb(ph, ps), ch)) =
  pm2.61d(wb(ph, ps), ps, ch, syli(ps, wb(ph, ps), ph, ch, biimpr(ph, ps), bija_1), syli(wn(ps), wb(ph, ps), wn(ph), ch, con3d(wb(ph, ps), ph, ps, biimp(ph, ps)), bija_2))
theorem pm5.18(ph: wff, ps: wff) -> Prf(wb(wb(ph, ps), wn(wb(ph, wn(ps))))) =
  pm2.61i(ph, wb(wb(ph, ps), wn(wb(ph, wn(ps)))), bitr2d(ph, wn(wb(ph, wn(ps))), ps, wb(ph, ps), con1bid(ph, ps, wb(ph, wn(ps)), pm5.501(ph, wn(ps))), pm5.501(ph, ps)), bitr2d(wn(ph), wn(wb(ph, wn(ps))), wn(ps), wb(ph, ps), con1bid(wn(ph), wn(ps), wb(ph, wn(ps)), nbn2(ph, wn(ps))), nbn2(ph, ps)))
theorem xor3(ph: wff, ps: wff) -> Prf(wb(wn(wb(ph, ps)), wb(ph, wn(ps)))) =
  bicomi(wb(ph, wn(ps)), wn(wb(ph, ps)), con2bii(wb(ph, ps), wb(ph, wn(ps)), pm5.18(ph, ps)))
theorem nbbn(ph: wff, ps: wff) -> Prf(wb(wb(wn(ph), ps), wn(wb(ph, ps)))) =
  xchbinxr(wb(wn(ph), ps), wb(wn(ph), wn(ps)), wb(ph, ps), pm5.18(wn(ph), ps), notbi(ph, ps))
theorem nbbnOLD(ph: wff, ps: wff) -> Prf(wb(wb(wn(ph), ps), wn(wb(ph, ps)))) =
  3bitrri(wn(wb(ph, ps)), wb(ph, wn(ps)), wb(ps, wn(ph)), wb(wn(ph), ps), xor3(ph, ps), con2bi(ph, ps), bicom(ps, wn(ph)))
theorem biass(ph: wff, ps: wff, ch: wff) -> Prf(wb(wb(wb(ph, ps), ch), wb(ph, wb(ps, ch)))) =
  pm2.61i(ph, wb(wb(wb(ph, ps), ch), wb(ph, wb(ps, ch))), bitr3d(ph, wb(ps, ch), wb(wb(ph, ps), ch), wb(ph, wb(ps, ch)), bibi1d(ph, ps, wb(ph, ps), ch, pm5.501(ph, ps)), pm5.501(ph, wb(ps, ch))), bitr3d(wn(ph), wn(wb(ps, ch)), wb(wb(ph, ps), ch), wb(ph, wb(ps, ch)), bitr3id(wn(wb(ps, ch)), wb(wn(ps), ch), wn(ph), wb(wb(ph, ps), ch), nbbn(ps, ch), bibi1d(wn(ph), wn(ps), wb(ph, ps), ch, nbn2(ph, ps))), nbn2(ph, wb(ps, ch))))
theorem birot(ph: wff, ps: wff, ch: wff) -> Prf(wb(wb(ph, wb(ps, ch)), wb(ps, wb(ch, ph)))) =
  bitri(wb(ph, wb(ps, ch)), wb(wb(ps, ch), ph), wb(ps, wb(ch, ph)), bicom(ph, wb(ps, ch)), biass(ps, ch, ph))
theorem biluk(ph: wff, ps: wff, ch: wff) -> Prf(wb(wb(ph, ps), wb(wb(ch, ps), wb(ph, ch)))) =
  bitr4i(wb(ph, ps), wb(ch, wb(ps, wb(ph, ch))), wb(wb(ch, ps), wb(ph, ch)), mpbi(wb(wb(wb(ph, ps), ch), wb(ps, wb(ph, ch))), wb(wb(ph, ps), wb(ch, wb(ps, wb(ph, ch)))), bitri(wb(wb(ph, ps), ch), wb(wb(ps, ph), ch), wb(ps, wb(ph, ch)), bibi1i(wb(ph, ps), wb(ps, ph), ch, bicom(ph, ps)), biass(ps, ph, ch)), biass(wb(ph, ps), ch, wb(ps, wb(ph, ch)))), biass(ch, ps, wb(ph, ch)))
theorem pm5.19(ph: wff) -> Prf(wn(wb(ph, wn(ph)))) =
  mpbi(wb(ph, ph), wn(wb(ph, wn(ph))), biid(ph), pm5.18(ph, ph))
theorem bi2.04(ph: wff, ps: wff, ch: wff) -> Prf(wb(wi(ph, wi(ps, ch)), wi(ps, wi(ph, ch)))) =
  impbii(wi(ph, wi(ps, ch)), wi(ps, wi(ph, ch)), pm2.04(ph, ps, ch), pm2.04(ps, ph, ch))
theorem pm5.4(ph: wff, ps: wff) -> Prf(wb(wi(ph, wi(ph, ps)), wi(ph, ps))) =
  pm5.74i(ph, wi(ph, ps), ps, pm5.5(ph, ps))
theorem imdi(ph: wff, ps: wff, ch: wff) -> Prf(wb(wi(ph, wi(ps, ch)), wi(wi(ph, ps), wi(ph, ch)))) =
  impbii(wi(ph, wi(ps, ch)), wi(wi(ph, ps), wi(ph, ch)), ax_2(ph, ps, ch), pm2.86(ph, ps, ch))
theorem pm5.41(ph: wff, ps: wff, ch: wff) -> Prf(wb(wi(wi(ph, ps), wi(ph, ch)), wi(ph, wi(ps, ch)))) =
  bicomi(wi(ph, wi(ps, ch)), wi(wi(ph, ps), wi(ph, ch)), imdi(ph, ps, ch))
theorem imbibi(ph: wff, ps: wff, ch: wff) -> Prf(wi(wb(wi(ph, ps), ch), wi(ph, wb(ps, ch)))) =
  syl11(wb(wi(ph, ps), ps), wb(wi(ph, ps), ch), wb(ps, ch), ph, bitr3(wi(ph, ps), ps, ch), pm5.5(ph, ps))
theorem imbibiOLD(ph: wff, ps: wff, ch: wff) -> Prf(wi(wb(wi(ph, ps), ch), wi(ph, wb(ps, ch)))) =
  pm5.74rd(wb(wi(ph, ps), ch), ph, ps, ch, bitr3id(wi(ph, ps), wi(ph, wi(ph, ps)), wb(wi(ph, ps), ch), wi(ph, ch), pm5.4(ph, ps), imbi2(wi(ph, ps), ch, ph)))
theorem pm4.8(ph: wff) -> Prf(wb(wi(ph, wn(ph)), wn(ph))) =
  impbii(wi(ph, wn(ph)), wn(ph), pm2.01(ph), ax_1(wn(ph), ph))
theorem pm4.81(ph: wff) -> Prf(wb(wi(wn(ph), ph), ph)) =
  impbii(wi(wn(ph), ph), ph, pm2.18(ph), pm2.24(ph, ph))
theorem imim21b(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wi(wi(ps, ph), wb(wi(wi(ph, ch), wi(ps, th)), wi(ps, wi(ch, th))))) =
  bitrid(wi(wi(ph, ch), wi(ps, th)), wi(ps, wi(wi(ph, ch), th)), wi(ps, ph), wi(ps, wi(ch, th)), bi2.04(wi(ph, ch), ps, th), pm5.74d(wi(ps, ph), ps, wi(wi(ph, ch), th), wi(ch, th), imim2i(ph, wb(wi(wi(ph, ch), th), wi(ch, th)), ps, imbi1d(ph, wi(ph, ch), ch, th, pm5.5(ph, ch)))))
symbol wa(ph: wff, ps: wff) -> wff
symbol df_an(ph: wff, ps: wff) -> Prf(wb(wa(ph, ps), wn(wi(ph, wn(ps)))))
theorem pm4.63(ph: wff, ps: wff) -> Prf(wb(wn(wi(ph, wn(ps))), wa(ph, ps))) =
  bicomi(wa(ph, ps), wn(wi(ph, wn(ps))), df_an(ph, ps))
theorem pm4.67(ph: wff, ps: wff) -> Prf(wb(wn(wi(wn(ph), wn(ps))), wa(wn(ph), ps))) =
  pm4.63(wn(ph), ps)
theorem imnan(ph: wff, ps: wff) -> Prf(wb(wi(ph, wn(ps)), wn(wa(ph, ps)))) =
  con2bii(wa(ph, ps), wi(ph, wn(ps)), df_an(ph, ps))
theorem imnani(ph: wff, ps: wff, imnani_1: Prf(wn(wa(ph, ps)))) -> Prf(wi(ph, wn(ps))) =
  mpbir(wi(ph, wn(ps)), wn(wa(ph, ps)), imnani_1, imnan(ph, ps))
theorem iman(ph: wff, ps: wff) -> Prf(wb(wi(ph, ps), wn(wa(ph, wn(ps))))) =
  bitri(wi(ph, ps), wi(ph, wn(wn(ps))), wn(wa(ph, wn(ps))), imbi2i(ps, wn(wn(ps)), ph, notnotb(ps)), imnan(ph, wn(ps)))
theorem pm3.24(ph: wff) -> Prf(wn(wa(ph, wn(ph)))) =
  mpbi(wi(ph, ph), wn(wa(ph, wn(ph))), id(ph), iman(ph, ph))
theorem annim(ph: wff, ps: wff) -> Prf(wb(wa(ph, wn(ps)), wn(wi(ph, ps)))) =
  con2bii(wi(ph, ps), wa(ph, wn(ps)), iman(ph, ps))
theorem pm4.61(ph: wff, ps: wff) -> Prf(wb(wn(wi(ph, ps)), wa(ph, wn(ps)))) =
  bicomi(wa(ph, wn(ps)), wn(wi(ph, ps)), annim(ph, ps))
theorem pm4.65(ph: wff, ps: wff) -> Prf(wb(wn(wi(wn(ph), ps)), wa(wn(ph), wn(ps)))) =
  pm4.61(wn(ph), ps)
theorem imp(ph: wff, ps: wff, ch: wff, imp_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(wa(ph, ps), ch)) =
  sylbi(wa(ph, ps), wn(wi(ph, wn(ps))), ch, df_an(ph, ps), impi(ph, ps, ch, imp_1))
theorem impcom(ph: wff, ps: wff, ch: wff, imp_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(wa(ps, ph), ch)) =
  imp(ps, ph, ch, com12(ph, ps, ch, imp_1))
theorem con3dimp(ph: wff, ps: wff, ch: wff, con3dimp_1: Prf(wi(ph, wi(ps, ch)))) -> Prf(wi(wa(ph, wn(ch)), wn(ps))) =
  imp(ph, wn(ch), wn(ps), con3d(ph, ps, ch, con3dimp_1))
theorem mpnanrd(ph: wff, ps: wff, ch: wff, mpnanrd_1: Prf(wi(ph, ps)), mpnanrd_2: Prf(wi(ph, wn(wa(ps, ch))))) -> Prf(wi(ph, wn(ch))) =
  mpd(ph, ps, wn(ch), mpnanrd_1, sylibr(ph, wn(wa(ps, ch)), wi(ps, wn(ch)), mpnanrd_2, imnan(ps, ch)))
theorem impd(ph: wff, ps: wff, ch: wff, th: wff, impd_1: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(ph, wi(wa(ps, ch), th))) =
  com12(wa(ps, ch), ph, th, imp(ps, ch, wi(ph, th), com3l(ph, ps, ch, th, impd_1)))
theorem impcomd(ph: wff, ps: wff, ch: wff, th: wff, impd_1: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(ph, wi(wa(ch, ps), th))) =
  impd(ph, ch, ps, th, com23(ph, ps, ch, th, impd_1))
theorem ex(ph: wff, ps: wff, ch: wff, ex_1: Prf(wi(wa(ph, ps), ch))) -> Prf(wi(ph, wi(ps, ch))) =
  expi(ph, ps, ch, sylbir(wn(wi(ph, wn(ps))), wa(ph, ps), ch, df_an(ph, ps), ex_1))
theorem expcom(ph: wff, ps: wff, ch: wff, ex_1: Prf(wi(wa(ph, ps), ch))) -> Prf(wi(ps, wi(ph, ch))) =
