theorem expcomd(ph: wff, ps: wff, ch: wff, th: wff, expcomd_1: Prf(wi(ph, wi(wa(ps, ch), th)))) -> Prf(wi(ph, wi(ch, wi(ps, th)))) =
  com23(ph, ps, ch, th, expd(ph, ps, ch, th, expcomd_1))
theorem imp31(ph: wff, ps: wff, ch: wff, th: wff, imp31_1: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(wa(wa(ph, ps), ch), th)) =
  imp(wa(ph, ps), ch, th, imp(ph, ps, wi(ch, th), imp31_1))
theorem imp32(ph: wff, ps: wff, ch: wff, th: wff, imp31_1: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(wa(ph, wa(ps, ch)), th)) =
  imp(ph, wa(ps, ch), th, impd(ph, ps, ch, th, imp31_1))
theorem exp31(ph: wff, ps: wff, ch: wff, th: wff, exp31_1: Prf(wi(wa(wa(ph, ps), ch), th))) -> Prf(wi(ph, wi(ps, wi(ch, th)))) =
