theorem mp2d(ph: wff, ps: wff, ch: wff, th: wff, mp2d_1: Prf(wi(ph, ps)), mp2d_2: Prf(wi(ph, ch)), mp2d_3: Prf(wi(ph, wi(ps, wi(ch, th))))) -> Prf(wi(ph, th)) =
