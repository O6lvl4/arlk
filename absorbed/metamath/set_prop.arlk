theorem nic_imp(ph: wff, ps: wff, ch: wff, th: wff, nic_imp_1: Prf(wnan(ph, wnan(ch, ps)))) -> Prf(wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th)))) =
  nic_mp(wnan(ph, wnan(ch, ps)), wnan(wnan(th, ch), wnan(wnan(ph, th), wnan(ph, th))), wnan(ph, wnan(ph, ph)), nic_imp_1, nic_ax(ph, ps, ch, th, ph))
theorem nic_idlem1(ph: wff, ps: wff, ch: wff, th: wff, ta: wff) -> Prf(wnan(wnan(th, wnan(ta, wnan(ta, ta))), wnan(wnan(wnan(ph, wnan(ch, ps)), th), wnan(wnan(ph, wnan(ch, ps)), th)))) =
  nic_imp(wnan(ph, wnan(ch, ps)), wnan(wnan(ph, ch), wnan(wnan(ph, ph), wnan(ph, ph))), wnan(ta, wnan(ta, ta)), th, nic_ax(ph, ps, ch, ph, ta))
theorem nic_idlem2(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, et: wff, nic_idlem2_1: Prf(wnan(et, wnan(wnan(ph, wnan(ch, ps)), th)))) -> Prf(wnan(wnan(th, wnan(ta, wnan(ta, ta))), et)) =
  nic_mp(wnan(et, wnan(wnan(ph, wnan(ch, ps)), th)), wnan(wnan(th, wnan(ta, wnan(ta, ta))), et), wnan(wnan(th, wnan(ta, wnan(ta, ta))), et), nic_idlem2_1, nic_imp(wnan(th, wnan(ta, wnan(ta, ta))), wnan(wnan(ph, wnan(ch, ps)), th), wnan(wnan(ph, wnan(ch, ps)), th), et, nic_imp(wnan(ph, wnan(ch, ps)), wnan(wnan(ph, ch), wnan(wnan(ph, ph), wnan(ph, ph))), wnan(ta, wnan(ta, ta)), th, nic_ax(ph, ps, ch, ph, ta))))
theorem nic_id(ta: wff) -> Prf(wnan(ta, wnan(ta, ta))) =
  nic_mp(wnan(wnan(wnan(wnan(ta, ta), wnan(wnan(ta, ta), wnan(ta, ta))), wnan(ta, wnan(ta, ta))), wnan(ta, wnan(ta, ta))), wnan(ta, wnan(ta, ta)), wnan(ta, wnan(ta, ta)), nic_idlem2(ta, ta, ta, wnan(wnan(ta, ta), wnan(wnan(ta, ta), wnan(ta, ta))), ta, wnan(ta, wnan(ta, ta)), nic_ax(ta, ta, ta, ta, ta)), nic_idlem2(wnan(wnan(ta, ta), wnan(wnan(ta, ta), wnan(ta, ta))), wnan(ta, ta), ta, wnan(wnan(wnan(ta, ta), wnan(wnan(ta, ta), wnan(ta, ta))), wnan(ta, wnan(ta, ta))), ta, wnan(wnan(ta, wnan(ta, ta)), wnan(ta, wnan(ta, ta))), nic_idlem1(wnan(ta, ta), wnan(ta, ta), wnan(ta, ta), wnan(ta, wnan(ta, ta)), ta)))
theorem nic_swap(ph: wff, th: wff) -> Prf(wnan(wnan(th, ph), wnan(wnan(ph, th), wnan(ph, th)))) =
  nic_mp(wnan(ph, wnan(ph, ph)), wnan(wnan(th, ph), wnan(wnan(ph, th), wnan(ph, th))), wnan(ph, wnan(ph, ph)), nic_id(ph), nic_ax(ph, ph, ph, th, ph))
theorem nic_isw1(ph: wff, th: wff, nic_isw1_1: Prf(wnan(th, ph))) -> Prf(wnan(ph, th)) =
  nic_mp(wnan(th, ph), wnan(ph, th), wnan(ph, th), nic_isw1_1, nic_swap(ph, th))
theorem nic_isw2(ph: wff, ps: wff, th: wff, nic_isw2_1: Prf(wnan(ps, wnan(th, ph)))) -> Prf(wnan(ps, wnan(ph, th))) =
  nic_isw1(ps, wnan(ph, th), nic_mp(wnan(ps, wnan(th, ph)), wnan(wnan(ph, th), ps), wnan(wnan(ph, th), ps), nic_isw2_1, nic_imp(wnan(ph, th), wnan(th, ph), wnan(th, ph), ps, nic_swap(th, ph))))
theorem nic_iimp1(ph: wff, ps: wff, ch: wff, th: wff, nic_iimp1_1: Prf(wnan(ph, wnan(ch, ps))), nic_iimp1_2: Prf(wnan(th, ch))) -> Prf(wnan(th, ph)) =
  nic_isw1(th, ph, nic_mp(wnan(th, ch), wnan(ph, th), wnan(ph, th), nic_iimp1_2, nic_imp(ph, ps, ch, th, nic_iimp1_1)))
theorem nic_iimp2(ph: wff, ps: wff, ch: wff, th: wff, nic_iimp2_1: Prf(wnan(wnan(ph, ps), wnan(ch, ch))), nic_iimp2_2: Prf(wnan(th, ph))) -> Prf(wnan(th, wnan(ch, ch))) =
  nic_iimp1(wnan(ch, ch), ps, ph, th, nic_isw1(wnan(ch, ch), wnan(ph, ps), nic_iimp2_1), nic_iimp2_2)
theorem nic_idel(ph: wff, ps: wff, ch: wff, nic_idel_1: Prf(wnan(ph, wnan(ch, ps)))) -> Prf(wnan(ph, wnan(ch, ch))) =
  nic_mp(wnan(wnan(ch, ch), ch), wnan(ph, wnan(ch, ch)), wnan(ph, wnan(ch, ch)), nic_isw1(wnan(ch, ch), ch, nic_id(ch)), nic_imp(ph, ps, ch, wnan(ch, ch), nic_idel_1))
theorem nic_ich(ph: wff, ps: wff, ch: wff, nic_ich_1: Prf(wnan(ph, wnan(ps, ps))), nic_ich_2: Prf(wnan(ps, wnan(ch, ch)))) -> Prf(wnan(ph, wnan(ch, ch))) =
  nic_mp(wnan(wnan(ch, ch), ps), wnan(ph, wnan(ch, ch)), wnan(ph, wnan(ch, ch)), nic_isw1(wnan(ch, ch), ps, nic_ich_2), nic_imp(ph, ps, ps, wnan(ch, ch), nic_ich_1))
theorem nic_idbl(ph: wff, ps: wff, nic_idbl_1: Prf(wnan(ph, wnan(ps, ps)))) -> Prf(wnan(wnan(ps, ps), wnan(wnan(ph, ph), wnan(ph, ph)))) =
  nic_ich(wnan(ps, ps), wnan(ph, ps), wnan(ph, ph), nic_imp(ph, ps, ps, ps, nic_idbl_1), nic_imp(ph, ps, ps, ph, nic_idbl_1))
theorem nic_bijust(ta: wff) -> Prf(wnan(wnan(ta, ta), wnan(wnan(ta, ta), wnan(ta, ta)))) =
  nic_swap(ta, ta)
theorem nic_bi1(ph: wff, ps: wff, nic_bi1_1: Prf(wnan(wnan(ph, ps), wnan(wnan(ph, ph), wnan(ps, ps))))) -> Prf(wnan(ph, wnan(ps, ps))) =
  nic_idel(ph, ph, ps, nic_isw2(ps, ph, ph, nic_iimp1(wnan(ph, ps), wnan(ps, ps), wnan(ph, ph), ph, nic_bi1_1, nic_id(ph))))
theorem nic_bi2(ph: wff, ps: wff, nic_bi2_1: Prf(wnan(wnan(ph, ps), wnan(wnan(ph, ph), wnan(ps, ps))))) -> Prf(wnan(ps, wnan(ph, ph))) =
  nic_idel(ps, ps, ph, nic_iimp1(wnan(ph, ps), wnan(ph, ph), wnan(ps, ps), ps, nic_isw2(wnan(ps, ps), wnan(ph, ps), wnan(ph, ph), nic_bi2_1), nic_id(ps)))
theorem nic_stdmp(ph: wff, ps: wff, nic_smin: Prf(ph), nic_smaj: Prf(wi(ph, ps))) -> Prf(ps) =
  nic_mp(ph, ps, ps, nic_smin, nic_mp(wi(ph, ps), wnan(ph, wnan(ps, ps)), wnan(ph, wnan(ps, ps)), nic_smaj, nic_bi2(wnan(ph, wnan(ps, ps)), wi(ph, ps), nic_dfim(ph, ps))))
theorem nic_luk1(ph: wff, ps: wff, ch: wff) -> Prf(wi(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch)))) =
  nic_mp(wnan(wi(ph, ps), wnan(wi(wi(ps, ch), wi(ph, ch)), wi(wi(ps, ch), wi(ph, ch)))), wi(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch))), wi(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch))), nic_ich(wi(ph, ps), wnan(ph, wnan(ps, ps)), wi(wi(ps, ch), wi(ph, ch)), nic_bi2(wnan(ph, wnan(ps, ps)), wi(ph, ps), nic_dfim(ph, ps)), nic_ich(wnan(ph, wnan(ps, ps)), wnan(wi(ps, ch), wnan(wi(ph, ch), wi(ph, ch))), wi(wi(ps, ch), wi(ph, ch)), nic_ich(wnan(ph, wnan(ps, ps)), wnan(wnan(wnan(ch, ch), ps), wnan(wnan(ph, wnan(ch, ch)), wnan(ph, wnan(ch, ch)))), wnan(wi(ps, ch), wnan(wi(ph, ch), wi(ph, ch))), nic_idel(wnan(ph, wnan(ps, ps)), wnan(ph, wnan(ph, ph)), wnan(wnan(wnan(ch, ch), ps), wnan(wnan(ph, wnan(ch, ch)), wnan(ph, wnan(ch, ch)))), nic_isw2(wnan(wnan(wnan(ch, ch), ps), wnan(wnan(ph, wnan(ch, ch)), wnan(ph, wnan(ch, ch)))), wnan(ph, wnan(ps, ps)), wnan(ph, wnan(ph, ph)), nic_ax(ph, ps, ps, wnan(ch, ch), ph))), nic_ich(wnan(wnan(wnan(ch, ch), ps), wnan(wnan(ph, wnan(ch, ch)), wnan(ph, wnan(ch, ch)))), wnan(wnan(wi(ph, ch), wi(ph, ch)), wnan(wnan(ch, ch), ps)), wnan(wi(ps, ch), wnan(wi(ph, ch), wi(ph, ch))), nic_imp(wnan(wi(ph, ch), wi(ph, ch)), wnan(wnan(ph, wnan(ch, ch)), wnan(ph, wnan(ch, ch))), wnan(wnan(ph, wnan(ch, ch)), wnan(ph, wnan(ch, ch))), wnan(wnan(ch, ch), ps), nic_idbl(wnan(ph, wnan(ch, ch)), wi(ph, ch), nic_bi1(wnan(ph, wnan(ch, ch)), wi(ph, ch), nic_dfim(ph, ch)))), nic_imp(wi(ps, ch), wnan(wnan(ch, ch), ps), wnan(wnan(ch, ch), ps), wnan(wi(ph, ch), wi(ph, ch)), nic_ich(wi(ps, ch), wnan(ps, wnan(ch, ch)), wnan(wnan(ch, ch), ps), nic_bi2(wnan(ps, wnan(ch, ch)), wi(ps, ch), nic_dfim(ps, ch)), nic_swap(wnan(ch, ch), ps))))), nic_bi1(wnan(wi(ps, ch), wnan(wi(ph, ch), wi(ph, ch))), wi(wi(ps, ch), wi(ph, ch)), nic_dfim(wi(ps, ch), wi(ph, ch))))), nic_bi1(wnan(wi(ph, ps), wnan(wi(wi(ps, ch), wi(ph, ch)), wi(wi(ps, ch), wi(ph, ch)))), wi(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch))), nic_dfim(wi(ph, ps), wi(wi(ps, ch), wi(ph, ch)))))
theorem nic_luk2(ph: wff) -> Prf(wi(wi(wn(ph), ph), ph)) =
  nic_mp(wnan(wi(wn(ph), ph), wnan(ph, ph)), wi(wi(wn(ph), ph), ph), wi(wi(wn(ph), ph), ph), nic_isw1(wi(wn(ph), ph), wnan(ph, ph), nic_iimp1(wi(wn(ph), ph), wnan(wn(ph), wnan(ph, ph)), wnan(wn(ph), wnan(ph, ph)), wnan(ph, ph), nic_bi2(wnan(wn(ph), wnan(ph, ph)), wi(wn(ph), ph), nic_dfim(wn(ph), ph)), nic_isw2(wn(ph), wnan(ph, ph), wnan(ph, ph), nic_iimp1(wnan(wnan(ph, ph), wn(ph)), wnan(wn(ph), wn(ph)), wnan(wnan(ph, ph), wnan(ph, ph)), wnan(ph, ph), nic_dfneg(ph), nic_id(wnan(ph, ph)))))), nic_bi1(wnan(wi(wn(ph), ph), wnan(ph, ph)), wi(wi(wn(ph), ph), ph), nic_dfim(wi(wn(ph), ph), ph)))
