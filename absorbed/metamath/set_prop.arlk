  3bitr4i(wo(wa(ph, ps), wn(wi(ch, ph))), wo(wn(wi(ch, ph)), wa(ph, ps)), wif(ph, ps, ch), wi(wi(ch, ph), wa(ph, ps)), orcom(wa(ph, ps), wn(wi(ch, ph))), dfifp6(ph, ps, ch), imor(wi(ch, ph), wa(ph, ps)))
