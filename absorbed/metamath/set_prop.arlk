theorem an4s(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, an4s_1: Prf(wi(wa(wa(ph, ps), wa(ch, th)), ta))) -> Prf(wi(wa(wa(ph, ch), wa(ps, th)), ta)) =
