theorem jaod(ph: wff, ps: wff, ch: wff, th: wff, jaod_1: Prf(wi(ph, wi(ps, ch))), jaod_2: Prf(wi(ph, wi(th, ch)))) -> Prf(wi(ph, wi(wo(ps, th), ch))) =
