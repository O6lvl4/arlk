theorem anass1rs(ph: wff, ps: wff, ch: wff, th: wff, anass1rs_1: Prf(wi(wa(ph, wa(ps, ch)), th))) -> Prf(wi(wa(wa(ph, ch), ps), th)) =
  an32s(ph, ps, ch, th, anassrs(ph, ps, ch, th, anass1rs_1))
theorem an4(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wb(wa(wa(ph, ps), wa(ch, th)), wa(wa(ph, ch), wa(ps, th)))) =
  bitri(wa(wa(ph, ps), wa(ch, th)), wa(ph, wa(ps, wa(ch, th))), wa(wa(ph, ch), wa(ps, th)), anass(ph, ps, wa(ch, th)), bianass(wa(ps, wa(ch, th)), ch, wa(ps, th), ph, an12(ps, ch, th)))
theorem an42(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wb(wa(wa(ph, ps), wa(ch, th)), wa(wa(ph, ch), wa(th, ps)))) =
  bitri(wa(wa(ph, ps), wa(ch, th)), wa(wa(ph, ch), wa(ps, th)), wa(wa(ph, ch), wa(th, ps)), an4(ph, ps, ch, th), anbi2i(wa(ps, th), wa(th, ps), wa(ph, ch), ancom(ps, th)))
theorem an43(ph: wff, ps: wff, ch: wff, th: wff) -> Prf(wb(wa(wa(ph, ps), wa(ch, th)), wa(wa(ph, th), wa(ps, ch)))) =
  bicomi(wa(wa(ph, th), wa(ps, ch)), wa(wa(ph, ps), wa(ch, th)), an42(ph, th, ps, ch))
