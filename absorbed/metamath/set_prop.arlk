theorem an31(ph: wff, ps: wff, ch: wff) -> Prf(wb(wa(wa(ph, ps), ch), wa(wa(ch, ps), ph))) =
  3bitr4i(wa(ph, wa(ps, ch)), wa(ch, wa(ps, ph)), wa(wa(ph, ps), ch), wa(wa(ch, ps), ph), an13(ph, ps, ch), anass(ph, ps, ch), anass(ch, ps, ph))
theorem an12s(ph: wff, ps: wff, ch: wff, th: wff, an12s_1: Prf(wi(wa(ph, wa(ps, ch)), th))) -> Prf(wi(wa(ps, wa(ph, ch)), th)) =
  sylbi(wa(ps, wa(ph, ch)), wa(ph, wa(ps, ch)), th, an12(ps, ph, ch), an12s_1)
theorem ancom2s(ph: wff, ps: wff, ch: wff, th: wff, an12s_1: Prf(wi(wa(ph, wa(ps, ch)), th))) -> Prf(wi(wa(ph, wa(ch, ps)), th)) =
