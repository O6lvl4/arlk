theorem syl2im(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl2im_1: Prf(wi(ph, ps)), syl2im_2: Prf(wi(ch, th)), syl2im_3: Prf(wi(ps, wi(th, ta)))) -> Prf(wi(ph, wi(ch, ta))) =
