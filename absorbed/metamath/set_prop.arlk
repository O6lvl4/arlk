theorem syl56(ph: wff, ps: wff, ch: wff, th: wff, ta: wff, syl56_1: Prf(wi(ph, ps)), syl56_2: Prf(wi(ch, wi(ps, th))), syl56_3: Prf(wi(th, ta))) -> Prf(wi(ch, wi(ph, ta))) =
