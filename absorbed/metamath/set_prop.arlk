  sylan2(ps, ph, wa(ps, ch), th, jctr(ps, ch, mpanr2_1), mpanr2_2)
theorem mpanr12(ph: wff, ps: wff, ch: wff, th: wff, mpanr12_1: Prf(ps), mpanr12_2: Prf(ch), mpanr12_3: Prf(wi(wa(ph, wa(ps, ch)), th))) -> Prf(wi(ph, th)) =
  mpan2(ph, ch, th, mpanr12_2, mpanr1(ph, ps, ch, th, mpanr12_1, mpanr12_3))
