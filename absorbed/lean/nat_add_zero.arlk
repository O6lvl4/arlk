-- Absorbed from Lean 4 by `arlk absorb`: Nat.add_zero and everything it uses.
-- Check it with `arlk check`; Lean is not needed and not trusted.
-- Lean's type theory, written in Arlk.
--
-- Lean has a tower of universes: Sort 0 (Prop), Sort 1 (Type), Sort 2, ...
-- Here a universe level is a value of `Lvl`. The types living in universe
-- `l` are values of `Univ l`, and `El l A` turns such a value into an
-- Arlk type. Lean's function types are values too: `pi a b A B` is
-- `(x : A) -> B x`, and a rule unfolds it into an Arlk function type.
room lean.

symbol Lvl : Type.
symbol lz : Lvl.
symbol ls : Lvl -> Lvl.

symbol max : Lvl -> Lvl -> Lvl.
rule [m : Lvl] max lz m --> m.
rule [n : Lvl] max (ls n) lz --> ls n.
rule [n : Lvl, m : Lvl] max (ls n) (ls m) --> ls (max n m).

-- The level of a function type from universe a into universe b: 0 when
-- b is 0 (a function into Prop is a proposition), max a b otherwise.
symbol imax : Lvl -> Lvl -> Lvl.
rule [n : Lvl] imax n lz --> lz.
rule [n : Lvl, m : Lvl] imax n (ls m) --> max n (ls m).

symbol Univ : Lvl -> Type.
symbol El : (l : Lvl) -> Univ l -> Type.

symbol sort : (l : Lvl) -> Univ (ls l).
rule [l : Lvl] El {ls l} (sort l) --> Univ l.

symbol pi : (a : Lvl) -> (b : Lvl) -> (A : Univ a) -> (El a A -> Univ b) -> Univ (imax a b).
rule [a : Lvl, b : Lvl, A : Univ a, B : El a A -> Univ b]
  El {imax a b} (pi a b A B) --> (x : El a A) -> El b (B x).

-- Lean's Prop is proof-irrelevant: two proofs of the same proposition
-- are the same value.
irrelevant [P : Univ lz] El lz P.
def l0 : Lvl := lz.
def l1 : Lvl := ls l0.
def l2 : Lvl := ls l1.
def l3 : Lvl := ls l2.
def l4 : Lvl := ls l3.
def l5 : Lvl := ls l4.
def l6 : Lvl := ls l5.
def l7 : Lvl := ls l6.
def l8 : Lvl := ls l7.
def l9 : Lvl := ls l8.

room Init uses lean.

