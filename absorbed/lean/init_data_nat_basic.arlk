def Not :
  lean.El lean.l1 (lean.pi lean.l1 lean.l1 (lean.sort lean.l0) (fun (a : lean.El lean.l1 (lean.sort lean.l0)) => lean.sort lean.l0)) :=
  fun (a : lean.El lean.l1 (lean.sort lean.l0)) => lean.pi lean.l0 lean.l0 a (fun (a' : lean.El lean.l0 a) => False).
