rule [α : lean.El lean.l2 (lean.sort lean.l1), lt : lean.El lean.l1 (lean.pi lean.l1 lean.l1 α (fun (a : lean.El lean.l1 α) => lean.pi lean.l1 lean.l1 α (fun (a' : lean.El lean.l1 α) => lean.sort lean.l0)))]
