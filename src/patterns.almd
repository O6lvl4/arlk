// Pattern matching, compiled to recursors.
//
//   def add(m: Nat, n: Nat) -> Nat = match n {
//     Nat.zero => m,
//     Nat.succ(k) => Nat.succ(add(m, k)),
//   }
//
// becomes
//
//   def add(m: Nat, n: Nat) -> Nat =
//     Nat.rec((n: _) => Nat,
//             m,
//             (k: _, ih_k: _) => Nat.succ(ih_k),
//             n)
//
// The match is a definition's whole body, on one of its parameters. A
// recursive call must pass, in that position, an argument the arm took
// apart (k above): that is structural recursion, so the definition always
// terminates, and the call becomes the induction hypothesis for k.
// Parameters before the matched one stay fixed in recursive calls;
// parameters after it may change, and are passed along through the
// motive. Theorems are proved by induction the same way.
//
// Arms may nest patterns (`succ(succ(n)) => ...`), and an arm's body may
// itself be a `match` on any variable in scope. Both become case splits by
// the inner type's recursor, with the arm's own type (the definition's, at
// the constructor the arm took apart) as the motive; the arms are tried in
// order, and `_` or a name matches anything. Recursion stays structural:
// only the fields the outer match took apart have induction hypotheses.
//
// The matched parameter may belong to an indexed family (`v: Vec(A, n)`)
// when its indices are parameters before it: the motive abstracts them,
// and a recursive call may pass the field's own index there.
//
// Its indices may also be constructor patterns over such parameters
// (`h: Le(succ(m), succ(n))`, Agda's unification by cases). The motive
// inverts them (small inversion): by cases on each index, it is the
// definition's type where the pattern's constructors are, with the
// pattern's parameters taken from the constructor's fields, and `R -> R`
// anywhere else. A constructor whose indices clash with the patterns gets
// the identity as its arm, so its arm is left out (Agda's absurd pattern;
// `match h { }` when every constructor clashes). Inner matches on a later
// parameter of an indexed family work the same way.
//
// The result still has holes (`_`) for binder types; the elaborator fills
// them from the recursor's type, and the kernel checks the outcome, so
// nothing here is trusted.

import self.syntax.{Raw, Arm, Sub}

// What the compiler needs to know about a matched type: its recursor, how
// many indices it has, and for each constructor its full name, its number
// of arguments, which of them are recursive, and the inductive type (if
// any) each argument belongs to, for matches on it.
// `kinds`: per argument, which definition of a nested group recursion on
// it goes to (0 the type's own, k its k-th nested occurrence, -1 none).
// `idx`: the constructor's indices, over `%p<i>` (the type's parameters)
// and `%f<j>` (its own fields).
type Ctor = { name: String, nargs: Int, recs: List[Int], heads: List[String], kinds: List[Int], idx: List[Raw] }
type Target = { rec: String, indices: Int, ctors: List[Ctor] }

type Def = { name: String, implicits: Int, params: List[(String, Raw)], ret: Raw }

// The compilation state: the definition, the matched parameter's position,
// the names of its index parameters, the fields the top-level match took
// apart with their induction hypotheses, a way to find the type behind a
// name, and the types (heads) of the variables in scope.
type Comp = {
  d: Def,
  k: Int,
  index_params: List[String],
  vars: List[String],
  ihs: List[(Int, String)],
  heads: List[(String, String)],
  // In a group over a nested type: this definition's kind, the others'
  // names and kinds, and the kinds of the fields the top-level match took
  // apart (a call to a sibling on a field of its kind is recursion).
  kind: Int,
  siblings: List[(String, Int)],
  fkinds: List[Int],
  // The parameters after the matched one, with their types as refined so
  // far: an inner split generalises them too, so their types follow it.
  others: List[(String, Raw)],
}

local fn raw_apply(h: Raw, args: List[Raw]) -> Raw = list.fold(args, h, (acc, a) => RApp(acc, a))

local fn raw_spine(r: Raw) -> (Raw, List[Raw]) = {
  // A loop, not `spine_acc(f, [a] + args)`: on the native test build that
  // form passes boxed payloads where values are expected (see the README's
  // Almide issues).
  var head = r
  var rev: List[Raw] = []
  var going = true
  while going {
    match head {
      RApp(f, a) => {
        list.push(rev, a)
        head = f
      },
      _ => {
        going = false
      },
    }
  }
  (head, list.reverse(rev))
}

local fn hole() -> Raw = RName("_")

local fn lams(xs: List[String], body: Raw) -> Raw =
  list.fold(list.reverse(xs), body, (acc, x) => RLam(x, hole(), acc))

local fn pis(bs: List[(String, Raw)], body: Raw) -> Raw =
  list.fold(list.reverse(bs), body, (acc, (x, ty)) => RPi(x, ty, acc))

local fn fresh(x: String, taken: List[String]) -> String =
  if list.contains(taken, x) then fresh(x + "'", taken) else x

local fn sub_names(s: Sub) -> List[String] = match s {
  SName(x) => [x],
  SCon(c, ss) => [c] + (ss |> list.flat_map((t) => sub_names(t))),
}

// Every name written in r (binders and references), to keep generated
// names apart from them.
local fn names_in(r: Raw) -> List[String] = match r {
  RName(x) => [x],
  RApp(f, a) => names_in(f) + names_in(a),
  RLam(x, ty, b) => [x] + names_in(ty) + names_in(b),
  RPi(x, ty, b) => [x] + names_in(ty) + names_in(b),
  RBracket(b) => names_in(b),
  RMatch(s, arms) => names_in(s) + (arms |> list.flat_map((a) => (a.subs |> list.flat_map((t) => sub_names(t))) + names_in(a.body))),
  _ => [],
}

// r with the name x replaced by `by` where it refers to the outer x (not
// under a binder that rebinds it). `by` is a fresh name or a term over
// names that r does not bind, so nothing is captured.
local fn replace(r: Raw, x: String, by: Raw) -> Raw = match r {
  RName(y) => if y == x then by else r,
  RApp(f, a) => RApp(replace(f, x, by), replace(a, x, by)),
  RLam(y, ty, b) => RLam(y, replace(ty, x, by), if y == x then b else replace(b, x, by)),
  RPi(y, ty, b) => RPi(y, replace(ty, x, by), if y == x then b else replace(b, x, by)),
  RBracket(b) => RBracket(replace(b, x, by)),
  RMatch(s, arms) => RMatch(replace(s, x, by), arms |> list.map((a) =>
    if list.any(a.subs, (t) => list.contains(sub_names(t), x)) then a else { ...a, body: replace(a.body, x, by) })),
  other => other,
}

// r with each occurrence of the expression e replaced by `by` (a fresh
// name), as Agda's `with` and Lean's `generalize` abstract it; not under a
// binder that rebinds a name e mentions.
local fn abstract_expr(r: Raw, e: Raw, mentions: List[String], by: Raw) -> Raw =
  if r == e then by
  else match r {
    RApp(f, a) => RApp(abstract_expr(f, e, mentions, by), abstract_expr(a, e, mentions, by)),
    RLam(y, ty, b) => RLam(y, abstract_expr(ty, e, mentions, by), if list.contains(mentions, y) then b else abstract_expr(b, e, mentions, by)),
    RPi(y, ty, b) => RPi(y, abstract_expr(ty, e, mentions, by), if list.contains(mentions, y) then b else abstract_expr(b, e, mentions, by)),
    RBracket(b) => RBracket(abstract_expr(b, e, mentions, by)),
    other => other,
  }

// The constructor a name in an arm stands for: `succ` or `Nat.succ` both
// name Nat.succ when Nat is matched.
local fn ctor_of(t: Target, c: String) -> Ctor? =
  list.find(t.ctors, (ci) => ci.name == c or string.ends_with(ci.name, "." + c))

// ── The top-level match ─────────────────────────────────────────────

// `match x { ... }` as the body of `d`. `look` finds the type a name (a
// type's own name, or one written in a parameter's type) stands for.
fn compile(d: Def, scrut: String, arms: List[Arm], t: Target, look: (String) -> Target?) -> Raw! =
  compile_in(d, scrut, arms, t, look, 0, [])

fn compile_in(d: Def, scrut: String, arms: List[Arm], t: Target, look: (String) -> Target?, kind: Int, siblings: List[(String, Int)]) -> Raw! = {
  let pnames = d.params |> list.map(((x, _)) => x)
  let k = match list.index_of(pnames, scrut) {
    some(i) => ok(i),
    none => err("match on ${scrut}: only a parameter of ${d.name} can be matched"),
  }!
  guard k >= d.implicits else err("match on ${scrut}: an implicit parameter cannot be matched")
  for a in arms {
    guard a.ctor == "_" or ctor_of(t, a.ctor) != none else err("${a.ctor} is not a constructor of ${scrut}'s type")
  }
  let named = arms |> list.filter((a) => a.ctor != "_" and list.all(a.subs, (s) => match s {
    SName(_) => true,
    SCon(_, _) => false,
  })) |> list.map((a) => a.ctor)
  guard list.len(list.unique(named)) == list.len(named) else err("a constructor has two arms in the match on ${scrut}")
  let others = list.drop(d.params, k + 1)
  let other_names = others |> list.map(((x, _)) => x)
  // An indexed family: its indices must be parameters before the matched one.
  let (_, targs) = raw_spine(match list.get(d.params, k) {
    some((_, ty)) => ty,
    none => RType,
  })
  let idx_args = list.drop(targs, list.len(targs) - t.indices)
  let before = list.take(pnames, k)
  let taken0 = pnames + (arms |> list.flat_map((a) => names_in(a.body) + (a.subs |> list.flat_map((s) => sub_names(s)))))
  // An index is either a distinct parameter before the matched one (the
  // motive abstracts it) or a pattern: constructors applied to further
  // parameters (`Le(succ(m), succ(n))`). The motive inverts a pattern by
  // cases on its own variable: at the pattern's constructors it is the
  // definition's type, with the pattern's parameters taken from the
  // constructor's fields; anywhere else it is `R -> R`, so an arm for a
  // constructor whose indices clash with the pattern is the identity
  // (Agda's absurd pattern, written by leaving the arm out).
  let simple = list.all(idx_args, (a) => match a {
    RName(x) => list.contains(before, x),
    _ => false,
  }) and list.len(list.unique(idx_args |> list.map((a) => raw_key(a)))) == list.len(idx_args)
  var index_params: List[String] = []
  var inverted: List[(String, Raw)] = []
  var pvars: List[String] = []
  for (j, a) in list.enumerate(idx_args) {
    if simple then list.push(index_params, index_param(a, before, index_params, scrut)!)
    else {
      let v = fresh("i" + int.to_string(j + 1), taken0 + index_params)
      list.push(index_params, v)
      list.push(inverted, (v, a))
      for x in pattern_vars(a, before, look) {
        guard not list.contains(pvars, x) else err("match on ${scrut}: ${x} occurs twice in its type's indices (non-linear index patterns are not supported)")
        list.push(pvars, x)
      }
    }
  }
  let whole = pis(others, d.ret)
  let motive = lams(index_params, RLam(scrut, hole(), invert(inverted, whole, whole, before, look, taken0 + index_params)!))
  // Each arm is a row with one column, the matched parameter.
  let rows = arms |> list.map((a) => (if a.ctor == "_" then [SName("_")] else [SCon(a.ctor, a.subs)], a.body))
  let cx = Comp { d: d, k: k, index_params: index_params, vars: [], ihs: [], heads: [], kind: kind, siblings: siblings, fkinds: [], others: [] }
  var minors: List[Raw] = []
  for ci in t.ctors {
    let taken = pnames + other_names + (arms |> list.flat_map((a) => names_in(a.body) + (a.subs |> list.flat_map((s) => sub_names(s)))))
    let named = field_names(rows, 0, ci, taken)
    // Against index patterns: the constructor's fields that the patterns'
    // parameters meet take those parameters' names (unless the arm names
    // them), so the arm reads as written; a clash makes the arm absurd.
    let (fields, clash) = if list.is_empty(inverted) then (named, false) else unify_indices(idx_args, ci, named, rows, targs, list.len(targs) - t.indices, pvars, look, scrut)!
    var ihs: List[(Int, String)] = []
    for i in ci.recs {
      let v = list.get(fields, i) ?? ""
      list.push(ihs, (i, fresh("ih_" + v, taken + fields + (ihs |> list.map(((_, n)) => n)))))
    }
    let rows2 = specialise(rows, 0, ci, fields, scrut, t)!
    if clash then {
      guard list.all(arms, (a) => a.ctor == "_" or ctor_of(t, a.ctor) != some(ci)) else err("the arm for ${ci.name} in the match on ${scrut} is impossible: its indices clash with ${scrut}'s; leave it out")
      list.push(minors, lams(fields + (ihs |> list.map(((_, n)) => n)), RLam("absurd", hole(), RName("absurd"))))
    } else {
    guard not list.is_empty(rows2) else err("the match on ${scrut} has no arm for ${ci.name}")
    let built = raw_apply(RName(ci.name), fields |> list.map((f) => RName(f)))
    let others2 = others |> list.map(((x, ty)) => (x, if t.indices == 0 then replace(ty, scrut, built) else ty))
    let cx2 = { ...cx, vars: fields, ihs: ihs, heads: list.zip(fields, ci.heads), fkinds: ci.kinds, others: others2 }
    // The arm's type is the definition's at this constructor; an inner
    // match takes its motive from it (#19). For an indexed family the
    // constructor's indices are not written here, so its type stays as
    // declared.
    let ret = if t.indices == 0 then replace(d.ret, scrut, raw_apply(RName(ci.name), fields |> list.map((f) => RName(f)))) else d.ret
    let body = matrix(cx2, fields, rows2, look, ret)!
    list.push(minors, lams(fields + (ihs |> list.map(((_, n)) => n)) + other_names, body))
    }
  }
  let call = raw_apply(RName(t.rec), [motive] + minors + idx_args + [RName(scrut)])
  ok(raw_apply(call, other_names |> list.map((x) => RName(x))))
}

local fn codomain(r: Raw) -> Raw = match r {
  RPi(_, _, b) => codomain(b),
  other => other,
}

// ── Index patterns ──────────────────────────────────────────────────

local fn raw_key(r: Raw) -> String = match r {
  RName(x) => x,
  RApp(f, a) => raw_key(f) + "(" + raw_key(a) + ")",
  RExplicit(x, _) => x,
  RInst(x, _) => x,
  _ => "?",
}

local fn raw_head_name(r: Raw) -> String = {
  let (h, _) = raw_spine(r)
  match h {
    RName(x) => x,
    RExplicit(x, _) => x,
    RInst(x, _) => x,
    _ => "",
  }
}

// The constructor a pattern's head names, with the type it builds.
local fn pattern_ctor(r: Raw, look: (String) -> Target?) -> (Target, Ctor)? = {
  let name = raw_head_name(r)
  if name == "" then none else match look("#" + name) {
    some(t) => match ctor_of(t, name) {
      some(c) => some((t, c)),
      none => match list.find(t.ctors, (c) => c.name == name) {
        some(c) => some((t, c)),
        none => none,
      },
    },
    none => none,
  }
}

// The parameters an index pattern binds.
local fn pattern_vars(r: Raw, before: List[String], look: (String) -> Target?) -> List[String] = match pattern_ctor(r, look) {
  some(_) => {
    let (_, args) = raw_spine(r)
    args |> list.flat_map((a) => pattern_vars(a, before, look))
  },
  none => match r {
    RName(x) => if list.contains(before, x) then [x] else [],
    _ => [],
  },
}

// The motive's body under index patterns: `pats` pairs each pattern with
// the variable the motive binds for it; `whole` is the definition's type
// after the matched parameter, `r` that type with the parameters solved so
// far.
local fn invert(pats: List[(String, Raw)], r: Raw, whole: Raw, before: List[String], look: (String) -> Target?, taken: List[String]) -> Raw! = match pats {
  [] => ok(r),
  [(v, a), ..rest] => match pattern_ctor(a, look) {
    some((ty, cj)) => {
      guard ty.indices == 0 else err("an index pattern's constructor ${cj.name} belongs to an indexed family, which is not supported")
      let (_, args) = raw_spine(a)
      guard list.len(args) == cj.nargs else err("${cj.name} in an index pattern takes ${int.to_string(cj.nargs)} arguments")
      var minors: List[Raw] = []
      for c in ty.ctors {
        var fs: List[String] = []
        for _ in list.range(0, c.nargs) {
          list.push(fs, fresh("v" + int.to_string(list.len(fs) + 1), taken + fs))
        }
        var ihs: List[String] = []
        for _ in c.recs {
          list.push(ihs, fresh("w", taken + fs + ihs))
        }
        let taken2 = taken + fs + ihs
        // Breadth first: every index's outermost constructor is looked at
        // before any argument, so a clash anywhere at that depth makes
        // the type `R -> R` without waiting on a deeper variable.
        let body = if c.name == cj.name then invert(rest + list.zip(fs, args), r, whole, before, look, taken2)! else RPi("_", whole, whole)
        list.push(minors, lams(fs + ihs, body))
      }
      let motive = RLam("_", hole(), RApp(RSort, RName("_")))
      ok(raw_apply(RName(ty.rec), [motive] + minors + [RName(v)]))
    },
    none => match a {
      RName(x) => if list.contains(before, x) then
        invert(rest |> list.map(((w, p)) => (w, replace(p, x, RName(v)))), replace(r, x, RName(v)), whole, before, look, taken)
        else err("index pattern ${x}: write a parameter before the matched one, or a constructor"),
      _ => err("an index must be a parameter before the matched one or a constructor applied to such parameters"),
    },
  },
}

// A constructor against the index patterns: its fields (renamed after the
// parameters they meet, where the arm does not name them) and whether its
// indices clash with the patterns.
local fn unify_indices(idx_args: List[Raw], ci: Ctor, named: List[String], rows: List[(List[Sub], Raw)], targs: List[Raw], np: Int, pvars: List[String], look: (String) -> Target?, scrut: String) -> (List[String], Bool)! = {
  var cidx: List[Raw] = []
  for c in ci.idx {
    var r = c
    for (i, a) in list.enumerate(list.take(targs, np)) {
      r = replace(r, "%p" + int.to_string(i), a)
    }
    for (j, f) in list.enumerate(named) {
      r = replace(r, "%f" + int.to_string(j), RName("%f" + int.to_string(j)))
    }
    list.push(cidx, r)
  }
  var renames: List[(Int, String)] = []
  var clash = false
  var problem = ""
  var queue: List[(Raw, Raw)] = list.zip(idx_args, cidx)
  while not list.is_empty(queue) and clash == false and problem == "" {
    let (a, c) = list.first(queue) ?? (RType, RType)
    queue = list.drop(queue, 1)
    match pattern_ctor(a, look) {
      some((_, ca)) => {
        let cn = raw_head_name(c)
        if string.starts_with(cn, "%f") or cn == "" then {
          problem = "match on ${scrut}: ${ci.name}'s index is a variable where ${scrut}'s is a constructor, so the indices cannot be unified by cases"
        } else match pattern_ctor(c, look) {
          some((_, cc)) => if cc.name != ca.name then {
            clash = true
          } else {
            let (_, aargs) = raw_spine(a)
            let (_, cargs) = raw_spine(c)
            queue = queue + list.zip(aargs, cargs)
          },
          none => {
            problem = "match on ${scrut}: ${ci.name}'s index ${raw_key(c)} is not a constructor pattern"
          },
        }
      },
      none => match (a, c) {
        (RName(x), RName(f)) => if list.contains(pvars, x) and string.starts_with(f, "%f") then {
          match int.parse(string.drop(f, 2)) {
            ok(j) => list.push(renames, (j, x)),
            err(_) => (),
          }
        } else (),
        _ => (),
      },
    }
  }
  guard problem == "" else err(problem)
  var fields: List[String] = []
  for (j, f) in list.enumerate(named) {
    let auto = string.starts_with(f, "_")
    let to = match list.find(renames, ((i, _)) => i == j) {
      some((_, x)) => if auto and not list.contains(fields, x) then x else f,
      none => f,
    }
    list.push(fields, to)
  }
  ok((fields, clash))
}

local fn index_param(a: Raw, before: List[String], seen: List[String], scrut: String) -> String! = {
  let x = match a {
    RName(n) => n,
    _ => "",
  }
  guard x != "" and list.contains(before, x) and not list.contains(seen, x) else err("match on ${scrut}: its type's indices must be distinct parameters before it (Agda-style unification of indices is not supported yet)")
  ok(x)
}

// Names for a constructor's fields: the name the first arm for it gives,
// when it is a plain name, so recursive calls read as written.
local fn field_names(rows: List[(List[Sub], Raw)], col: Int, ci: Ctor, taken: List[String]) -> List[String] = {
  // Sub-patterns are fetched first and matched on their own, not as
  // `some(SCon(c, ss))`: almide/almide#3421.
  let first = list.find(rows, ((subs, _)) => match sub_at(subs, col) {
    SCon(c, ss) => (c == ci.name or string.ends_with(ci.name, "." + c)) and list.len(ss) == ci.nargs,
    SName(_) => false,
  })
  let given_subs = match first {
    some((subs, _)) => match sub_at(subs, col) {
      SCon(_, ss) => ss,
      SName(_) => [],
    },
    none => [],
  }
  var out: List[String] = []
  var i = 0
  while i < ci.nargs {
    let given = match sub_at(given_subs, i) {
      SName(x) => if x == "_" then "" else x,
      SCon(_, _) => "",
    }
    let base = if given == "" then "_" + int.to_string(i + 1) else given
    let n = if given != "" and not list.contains(out, given) then given else fresh(base, taken + out)
    list.push(out, n)
    i = i + 1
  }
  out
}

local fn sub_at(subs: List[Sub], i: Int) -> Sub = list.get(subs, i) ?? SName("_")

// The rows that can match constructor ci in column col, with that column
// replaced by ci's fields. A name in the column matches anything: it stands
// for the matched variable itself.
local fn specialise(rows: List[(List[Sub], Raw)], col: Int, ci: Ctor, fields: List[String], v: String, t: Target) -> List[(List[Sub], Raw)]! = {
  var out: List[(List[Sub], Raw)] = []
  for (subs, body) in rows {
    let before = list.take(subs, col)
    let after = list.drop(subs, col + 1)
    guard col < list.len(subs) else err("a pattern has too few parts")
    match sub_at(subs, col) {
      SCon(c, ss) => match ctor_of(t, c) {
        some(cj) => if cj.name == ci.name then {
          guard list.len(ss) == ci.nargs else err("${ci.name} takes ${int.to_string(ci.nargs)} arguments, the pattern gives ${int.to_string(list.len(ss))}")
          list.push(out, (before + ss + after, body))
        } else (),
        none => {
          guard list.is_empty(ss) else err("${c} is not a constructor of ${v}'s type")
          // A plain name that is not a constructor: a variable.
          list.push(out, (before + (fields |> list.map((_) => SName("_"))) + after, if c == "_" or c == v then body else replace(body, c, RName(v))))
        },
      },
      SName(x) => match (if x == "_" then none else ctor_of(t, x)) {
        some(cj) => if cj.name == ci.name then {
          guard ci.nargs == 0 else err("${ci.name} takes ${int.to_string(ci.nargs)} arguments, the pattern gives none")
          list.push(out, (before + after, body))
        } else (),
        none => list.push(out, (before + (fields |> list.map((_) => SName("_"))) + after, if x == "_" or x == v then body else replace(body, x, RName(v)))),
      },
    }
  }
  ok(out)
}

// Rows over columns (variables in scope): the first row decides, unless
// one of its patterns is a constructor, which splits that column.
local fn matrix(cx: Comp, cols: List[String], rows: List[(List[Sub], Raw)], look: (String) -> Target?, ret: Raw) -> Raw! = {
  let (subs, body) = match list.first(rows) {
    some(r) => ok(r),
    none => err("a match is missing a case"),
  }!
  // A column whose pattern is a constructor (a name counts when the
  // column's type has a constructor of that name).
  var split: Int = -1
  var i = 0
  for s in subs {
    if split < 0 then match s {
      SCon(_, _) => {
        split = i
      },
      SName(x) => if x != "_" and is_ctor_name(cx, list.get(cols, i) ?? "", x, look) then {
        split = i
      } else (),
    } else ()
    i = i + 1
  }
  if split < 0 then {
    // Every pattern is a variable: name the columns, and go on with the body.
    var b = body
    for (s, col) in list.zip(subs, cols) {
      match s {
        SName(x) => if x != "_" and x != col then {
          b = replace(b, x, RName(col))
        } else (),
        SCon(_, _) => (),
      }
    }
    arm_body(cx, b, look, ret)
  } else split_on(cx, cols, rows, split, look, ret)
}

local fn head_of(cx: Comp, v: String) -> String = match list.find(cx.heads, ((x, _)) => x == v) {
  some((_, h)) => h,
  none => match list.find(cx.d.params, ((x, _)) => x == v) {
    some((_, ty)) => {
      let (h, _) = raw_spine(ty)
      match h {
        RName(n) => n,
        RInst(n, _) => n,
        RExplicit(n, _) => n,
        _ => "",
      }
    },
    none => "",
  },
}

local fn is_ctor_name(cx: Comp, v: String, x: String, look: (String) -> Target?) -> Bool = match look(head_of(cx, v)) {
  some(t) => ctor_of(t, x) != none,
  none => false,
}

// Split column `col` by its type's recursor; the arms' type, with the
// column at each constructor, is the motive.
local fn split_on(cx: Comp, cols: List[String], rows: List[(List[Sub], Raw)], col: Int, look: (String) -> Target?, ret: Raw) -> Raw! = {
  let v = list.get(cols, col) ?? ""
  let t = match look(head_of(cx, v)) {
    some(x) => ok(x),
    none => err("cannot match on ${v}: its type is not an inductive type"),
  }!
  // An indexed family: the indices are read from v's type, which is known
  // when v is a parameter after the matched one (its type refined so far).
  let vty = match list.find(cx.others, ((x, _)) => x == v) {
    some((_, ty)) => some(ty),
    none => none,
  }
  guard t.indices == 0 or vty != none else err("an inner match on ${v}, of an indexed family, is supported only on a parameter after the matched one")
  let (_, vargs) = raw_spine(vty ?? RType)
  let idx_args = if t.indices == 0 then [] else list.drop(vargs, list.len(vargs) - t.indices)
  let taken = cols + names_in(ret) + (rows |> list.flat_map(((subs, b)) => names_in(b) + (subs |> list.flat_map((s) => sub_names(s))))) + (cx.d.params |> list.map(((x, _)) => x)) + cx.vars + (cx.ihs |> list.map(((_, n)) => n))
  let gen = cx.others |> list.filter(((x, ty)) => x != v and list.contains(names_in(ty), v))
  // Index patterns, inverted by the motive as at the top level; any
  // variable in scope may occur in them.
  let scope = (cx.d.params |> list.map(((x, _)) => x)) + cx.vars + cols
  var index_vars: List[String] = []
  var inverted: List[(String, Raw)] = []
  var pvars: List[String] = []
  for (j, a) in list.enumerate(idx_args) {
    let w = fresh("i" + int.to_string(j + 1), taken + index_vars)
    list.push(index_vars, w)
    list.push(inverted, (w, a))
    for x in pattern_vars(a, scope, look) {
      guard not list.contains(pvars, x) else err("match on ${v}: ${x} occurs twice in its type's indices (non-linear index patterns are not supported)")
      list.push(pvars, x)
    }
  }
  let whole = pis(gen, ret)
  let motive = if t.indices == 0 then RLam(v, hole(), whole)
    else lams(index_vars, RLam(v, hole(), invert(inverted, whole, whole, scope, look, taken + index_vars)!))
  var minors: List[Raw] = []
  for ci in t.ctors {
    let named = field_names(rows, col, ci, taken)
    let (fields, clash) = if t.indices == 0 then (named, false) else unify_indices(idx_args, ci, named, rows, vargs, list.len(vargs) - t.indices, pvars, look, v)!
    let rows2 = specialise(rows, col, ci, fields, v, t)!
    if clash then {
      guard not list.any(rows, ((subs, _)) => match sub_at(subs, col) {
        SCon(c, _) => match ctor_of(t, c) {
          some(cj) => cj.name == ci.name,
          none => false,
        },
        SName(_) => false,
      }) else err("the arm for ${ci.name} in the match on ${v} is impossible: its indices clash with ${v}'s; leave it out")
      var unused0: List[String] = []
      for _ in ci.recs {
        list.push(unused0, fresh("_ih", taken + fields + unused0))
      }
      list.push(minors, lams(fields + unused0, RLam("absurd", hole(), RName("absurd"))))
    } else {
    guard not list.is_empty(rows2) else err("the match on ${v} has no arm for ${ci.name}")
    // Induction hypotheses of an inner split are not recursion on the
    // definition: they are bound and left unused.
    var unused: List[String] = []
    for _ in ci.recs {
      list.push(unused, fresh("_ih", taken + fields + unused))
    }
    let cols2 = list.take(cols, col) + fields + list.drop(cols, col + 1)
    let built = raw_apply(RName(ci.name), fields |> list.map((f) => RName(f)))
    let others2 = cx.others |> list.map(((x, ty)) => (x, if list.any(gen, ((g, _)) => g == x) then replace(ty, v, built) else ty))
    let cx2 = { ...cx, heads: cx.heads + list.zip(fields, ci.heads), others: others2 }
    let ret2 = replace(ret, v, built)
    let body = matrix(cx2, cols2, rows2, look, ret2)!
    list.push(minors, lams(fields + unused + (gen |> list.map(((x, _)) => x)), body))
    }
  }
  // The parameters after the matched one whose types mention v are
  // generalised (and passed back in), so the split refines their types.
  let call = raw_apply(RName(t.rec), [motive] + minors + idx_args + [RName(v)])
  ok(raw_apply(call, gen |> list.map(((x, _)) => RName(x))))
}

// An arm's body: itself a match on a variable in scope, or a term whose
// recursive calls become induction hypotheses.
local fn arm_body(cx: Comp, body: Raw, look: (String) -> Target?, ret: Raw) -> Raw! = match body {
  RMatch(RName(v), arms) => if list.is_empty(arms) then {
    // `match v { }`: every constructor is impossible. (Tested here, not
    // by an `[]` pattern nested in the variant: almide/almide#3413.)
    split_on(cx, [v], [], 0, look, ret)
  } else {
    let rows = arms |> list.map((a) => (if a.ctor == "_" then [SName("_")] else [SCon(a.ctor, a.subs)], a.body))
    matrix(cx, [v], rows, look, ret)
  },
  // `match f(a) { ... }`: on a value computed here, named by a fresh
  // variable. Its type is found from the head function's result type
  // (`look("=f")`). Where the result type mentions f(a), it is abstracted
  // (Agda's `with`), so each arm's goal has its constructor in its place.
  RMatch(e, arms) => {
    let (h, _) = raw_spine(e)
    let fname = match h {
      RName(n) => n,
      RInst(n, _) => n,
      RExplicit(n, _) => n,
      _ => "",
    }
    guard fname != "" else err("match on an expression: write a call (`match f(x) { ... }`) or a variable")
    let taken = names_in(e) + names_in(ret) + (arms |> list.flat_map((a) => names_in(a.body) + (a.subs |> list.flat_map((s) => sub_names(s))))) + (cx.d.params |> list.map(((x, _)) => x)) + cx.vars
    let v = fresh("value", taken)
    let rows = arms |> list.map((a) => (if a.ctor == "_" then [SName("_")] else [SCon(a.ctor, a.subs)], a.body))
    // A call of a parameter (`p(x)` for `p: A -> Bool`): its type is the
    // one its declared type ends in.
    let head = match list.find(cx.d.params, ((x, _)) => x == fname) {
      some((_, ty)) => raw_head_name(codomain(ty)),
      none => "=" + fname,
    }
    let cx2 = { ...cx, heads: cx.heads + [(v, head)] }
    let inner = matrix(cx2, [v], rows, look, abstract_expr(ret, e, names_in(e), RName(v)))!
    ok(RApp(RLam(v, hole(), inner), recursive_calls(cx, e)!))
  },
  _ => recursive_calls(cx, body),
}

// A definition whose body is a match on an expression (no recursion).
fn compile_on(d: Def, body: Raw, look: (String) -> Target?) -> Raw! =
  arm_body(Comp { d: d, k: -1, index_params: [], vars: [], ihs: [], heads: [], kind: 0, siblings: [], fkinds: [], others: [] }, body, look, d.ret)

// Replace each recursive call `d(..., v, others...)`, where v is a
// recursive argument the arm bound, by its induction hypothesis applied to
// the others. Anything else that calls d is not structural recursion.
local fn recursive_calls(cx: Comp, r: Raw) -> Raw! = {
  let (h, args) = raw_spine(r)
  match h {
    RName(f) =>
      if f == cx.d.name then call_to_ih(cx, f, cx.kind, args)
      else if list.any(cx.siblings, ((g, _)) => g == f) then call_to_ih(cx, f, match list.find(cx.siblings, ((g, _)) => g == f) {
        some((_, kd)) => kd,
        none => -1,
      }, args)
      else {
        var out: List[Raw] = []
        for a in args {
          list.push(out, recursive_calls(cx, a)!)
        }
        ok(raw_apply(h, out))
      },
    _ => match r {
      RApp(f, a) => ok(RApp(recursive_calls(cx, f)!, recursive_calls(cx, a)!)),
      RLam(x, ty, b) => ok(RLam(x, recursive_calls(cx, ty)!, recursive_calls(cx, b)!)),
      RPi(x, ty, b) => ok(RPi(x, recursive_calls(cx, ty)!, recursive_calls(cx, b)!)),
      RMatch(_, _) => err("a match must be a definition's body, or an arm's body"),
      other => ok(other),
    },
  }
}

local fn call_to_ih(cx: Comp, f: String, kind: Int, args: List[Raw]) -> Raw! = {
  let d = cx.d
  // Recursive calls leave the implicit parameters out, like any call.
  let explicit = list.len(d.params) - d.implicits
  guard list.len(args) == explicit else err("the recursive call to ${d.name} must pass all ${int.to_string(explicit)} arguments")
  let pos = cx.k - d.implicits
  // Parameters before the matched one are fixed, apart from the indices
  // of its type (the field's own indices go there).
  for (i, a) in list.enumerate(list.take(args, pos)) {
    let (p, _) = list.get(d.params, d.implicits + i) ?? ("", RType)
    guard a == RName(p) or list.contains(cx.index_params, p) else err("in a recursive call to ${d.name}, ${p} must be passed unchanged (it comes before the matched parameter)")
  }
  let arg = list.get(args, pos) ?? RType
  let ih = match arg {
    RName(v) => match list.index_of(cx.vars, v) {
      some(i) => match list.find(cx.ihs, ((j, _)) => j == i) {
        some((_, n)) => if (list.get(cx.fkinds, i) ?? 0) == kind then some(n) else none,
        none => none,
      },
      none => none,
    },
    _ => none,
  }
  match ih {
    some(n) => {
      var rest: List[Raw] = []
      for a in list.drop(args, pos + 1) {
        list.push(rest, recursive_calls(cx, a)!)
      }
      ok(raw_apply(RName(n), rest))
    },
    none => err("${f} is called recursively on something that is not a smaller part of the matched value of its type (structural recursion only, on the fields the definition's match takes apart)"),
  }
}
