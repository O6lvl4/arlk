// arlk absorb-mm: a Metamath database (set.mm) as Arlk source.
//
// Metamath has typecodes and substitution; Arlk has types and functions.
//   - a typecode (wff, setvar, class) becomes a type,
//   - `|- φ` becomes the type `Prf(φ)`,
//   - a syntax axiom (`wi $a wff ( ph -> ps )`) becomes a constructor
//     symbol `wi(ph: wff, ps: wff) -> wff`,
//   - a logical axiom becomes a symbol whose arguments are its hypotheses,
//   - a theorem becomes a function whose body is its proof, read back from
//     Metamath's stack machine (normal and compressed proofs),
//   - a distinct-variable condition `$d x ph` becomes a parameter of type
//     `Apart_setvar_wff(x, ph)`, which every use has to prove (see below).
//
// Math strings are parsed with the database's own syntax axioms. Nothing
// here is trusted: the kernel re-checks every proof.

type Hyp = { name: String, essential: Bool, tc: String, toks: List[String] }

// A syntax axiom used as a grammar rule: its template, the typecode of each
// variable slot, and the slots in argument order.
type Syn = { name: String, toks: List[String], slots: Map[String, String], order: List[String] }

// What a proof needs to know to use an assertion: its mandatory hypotheses
// (`params`: the binder of a floating one, "" for an essential one), its
// typecode, the distinct pairs it demands (positions in `params`), and for
// a syntax theorem, what it abbreviates.
type Assertion = { name: String, tc: String, params: List[String], dv: List[(Int, Int)], body: MExpr? }

// A syntax axiom, as distinct-variable obligations need it.
type Ctor = { name: String, tc: String, slots: List[(String, String)] }

// The provable typecode, and the syntax typecode its statements are parsed as.
// `${` opens a scope; spelled in two parts because `${` in a string
// literal starts an interpolation.
let SCOPE_OPEN = "$" + "{"

let PROVABLE = "|-"
let STATEMENT = "wff"

let KEYWORDS = ["room", "uses", "symbol", "def", "theorem", "rule", "where", "irrelevant", "check", "eval", "axioms", "Type", "Sort", "type", "match", "view", "translate", "let", "search", "Prf"]

// ── Names ───────────────────────────────────────────────────────────

local fn plain(c: String) -> Bool = string.is_alphanumeric(c) or c == "_" or c == "'"

// A label as an Arlk constant: `ax-mp` is `ax_mp`, `pm2.43` stays.
fn label_name(label: String) -> String = {
  let cs = string.chars(label) |> list.map((c) => if plain(c) or c == "." then c else "_")
  let s = list.join(cs, "")
  if list.contains(KEYWORDS, s) then s + "'" else s
}

// A hypothesis label or typecode as an Arlk binder: `a1i.1` is `a1i_1`.
fn binder_name(x: String) -> String = {
  let s = list.join(string.chars(x) |> list.map((c) => if plain(c) then c else "_"), "")
  if list.contains(KEYWORDS, s) then s + "'" else s
}

local fn char_name(c: String) -> String = match c {
  "." => "dot", "+" => "plus", "-" => "minus", "*" => "star", "/" => "slash", "\\" => "bslash",
  "^" => "hat", "~" => "tilde", "|" => "bar", "<" => "lt", ">" => "gt", "=" => "eq",
  "(" => "lp", ")" => "rp", "\"" => "dq", "," => "comma", "_" => "us", "0" => "0", "1" => "1",
  _ => "u" + int.to_string(string.codepoint(c) ?? 0),
}

// A variable token as an Arlk binder. set.mm's class variables include
// `.+`, `.x.` and `~`, so symbols are spelled out (`.+` is `op_dot_plus`)
// rather than flattened to `_`, which made different variables collide.
fn var_name(x: String) -> String =
  if list.all(string.chars(x), (c) => plain(c)) then binder_name(x)
  else {
    let parts = string.chars(x) |> list.map((c) => if plain(c) and c != "_" then c else "_" + char_name(c))
    let s = list.join(parts, "")
    if string.starts_with(s, "_") then "op" + s else s
  }

local fn call(f: String, args: List[String]) -> String =
  if list.is_empty(args) then f else f + "(" + list.join(args, ", ") + ")"

// ── Tokens ──────────────────────────────────────────────────────────

local fn at(ts: List[String], i: Int) -> String = list.get(ts, i) ?? ""

// Whitespace-separated tokens, comments dropped.
fn tokens(src: String) -> List[String] = {
  let flat = string.replace(string.replace(string.replace(src, "\n", " "), "\t", " "), "\r", " ")
  var out: List[String] = []
  var in_comment = false
  for w in string.split(flat, " ") {
    if w == "" then ()
    else if in_comment then {
      if w == "$)" then {
        in_comment = false
      } else ()
    } else if w == "$(" then {
      in_comment = true
    } else list.push(out, w)
  }
  out
}

// The database up to the end of the statement labelled `upto`.
// The database up to the end of the statement labelled `upto` (all of it
// when upto is "").
local fn prefix(src: String, upto: String) -> String! = if upto == "" then ok(src) else {
  let start = match string.index_of(src, " " + upto + " $p ") {
    some(i) => i,
    none => match string.index_of(src, " " + upto + " $a ") {
      some(i) => i,
      none => -1,
    },
  }
  guard start >= 0 else err("no statement labelled ${upto}")
  let rest = string.drop(src, start)
  let stop = string.index_of(rest, " $.") ?? string.len(rest)
  ok(string.take(src, start + stop + 3))
}

local fn copy(ts: List[String], i: Int, j: Int) -> List[String] = {
  var out: List[String] = []
  var k = i
  while k < j {
    list.push(out, at(ts, k))
    k = k + 1
  }
  out
}

local fn find(ts: List[String], i: Int, t: String) -> Int =
  if i >= list.len(ts) or at(ts, i) == t then i else find(ts, i + 1, t)

// ── Parsing math strings ────────────────────────────────────────────

// Every parse of `tc` starting at `pos`: (tree, end). Memoised per
// (typecode, position); a typecode that reaches itself at the same position
// finds nothing, which is enough because set.mm's grammar is not
// left-recursive within a typecode.
local fn parse_tc(g: Map[String, List[Syn]], toks: List[String], vars: Map[String, String], names: Map[String, String], tc: String, pos: Int, mut memo: Map[String, List[(String, Int)]]) -> List[(String, Int)] = {
  let key = tc + " " + int.to_string(pos)
  match map.get(memo, key) {
    some(r) => r,
    none => {
      map.insert(memo, key, [])
      var found: List[(String, Int)] = []
      let t = at(toks, pos)
      if map.get(vars, t) == some(tc) then list.push(found, (match map.get(names, t) {
        some(nm) => nm,
        none => t,
      }, pos + 1)) else ()
      for rule in map.get(g, tc) ?? [] {
        for (binds, end) in match_rule(g, toks, vars, names, rule, 0, pos, [:], memo) {
          let args = rule.order |> list.map((v) => map.get(binds, v) ?? "?")
          list.push(found, (call(rule.name, args), end))
        }
      }
      map.insert(memo, key, found)
      found
    },
  }
}

local fn match_rule(g: Map[String, List[Syn]], toks: List[String], vars: Map[String, String], names: Map[String, String], rule: Syn, k: Int, pos: Int, binds: Map[String, String], mut memo: Map[String, List[(String, Int)]]) -> List[(Map[String, String], Int)] =
  if k >= list.len(rule.toks) then [(binds, pos)]
  else {
    let t = at(rule.toks, k)
    match map.get(rule.slots, t) {
      some(stc) => {
        var res: List[(Map[String, String], Int)] = []
        for (tree, end) in parse_tc(g, toks, vars, names, stc, pos, memo) {
          for r in match_rule(g, toks, vars, names, rule, k + 1, end, map.set(binds, t, tree), memo) {
            list.push(res, r)
          }
        }
        res
      },
      none => if at(toks, pos) == t then match_rule(g, toks, vars, names, rule, k + 1, pos + 1, binds, memo) else [],
    }
  }

fn parse_math(g: Map[String, List[Syn]], vars: Map[String, String], names: Map[String, String], tc: String, toks: List[String]) -> String! = {
  var memo: Map[String, List[(String, Int)]] = [:]
  let whole = parse_tc(g, toks, vars, names, tc, 0, memo) |> list.filter(((_, end)) => end == list.len(toks))
  match list.first(whole) {
    some((tree, _)) => ok(tree),
    none => err("cannot parse `${list.join(toks, " ")}` as ${tc}"),
  }
}

// ── Distinct variables ──────────────────────────────────────────────
//
// `Apart_T_U(a, b)` says that the expressions a and b share no variable.
// Metamath checks `$d x ph` at every use by looking at the substituted
// expressions; here the use has to prove `Apart_setvar_wff(σx, σph)`, and
// the proof is built from facts that are true of syntax:
//   - `apart_T_k`: a is apart from k(e1, ..., en) if it is apart from each ei,
//     one per typecode T and syntax constructor k,
//   - `apart_sym_T_U`: apartness is symmetric,
//   - the theorem's own `$d` parameters for pairs of its variables,
//   - `fresh_D`: a dummy variable can be chosen apart from any given
//     expressions (`ApartAll_D(d, l)` for a list `l: Vars`), because there
//     are always more variables.
// Nothing gives `Apart(x, x)`, so a use that would identify two variables
// that must stay distinct has no proof, and the kernel rejects it.

local fn dv_typecode(t: String, known: List[String]) -> List[String] = {
  var out: List[String] = ["symbol vcons_${t}(e: ${t}, rest: Vars) -> Vars"]
  for u in known + [t] {
    list.push(out, "symbol Apart_${t}_${u}(a: ${t}, b: ${u}) -> Type")
    if u != t then list.push(out, "symbol Apart_${u}_${t}(a: ${u}, b: ${t}) -> Type") else ()
  }
  for u in known + [t] {
    list.push(out, "symbol apart_sym_${t}_${u}(a: ${t}, b: ${u}, h: Apart_${u}_${t}(b, a)) -> Apart_${t}_${u}(a, b)")
    if u != t then list.push(out, "symbol apart_sym_${u}_${t}(a: ${u}, b: ${t}, h: Apart_${t}_${u}(b, a)) -> Apart_${u}_${t}(a, b)") else ()
  }
  list.push(out, "symbol ApartAll_${t}(d: ${t}, l: Vars) -> Type")
  list.push(out, "symbol fresh_${t}(l: Vars, C: ${STATEMENT}, k: (d: ${t}, h: ApartAll_${t}(d, l)) -> Prf(C)) -> Prf(C)")
  for u in known + [t] {
    for (d, e) in (if u == t then [(t, t)] else [(t, u), (u, t)]) {
      list.push(out, "symbol apart_head_${d}_${e}(d: ${d}, e: ${e}, l: Vars, h: ApartAll_${d}(d, vcons_${e}(e, l))) -> Apart_${d}_${e}(d, e)")
      list.push(out, "symbol apart_tail_${d}_${e}(d: ${d}, e: ${e}, l: Vars, h: ApartAll_${d}(d, vcons_${e}(e, l))) -> ApartAll_${d}(d, l)")
    }
  }
  out
}

local fn dv_ctor(t: String, k: Ctor) -> String = {
  let names = k.slots |> list.map(((x, _)) => x)
  let a = prime_until_free("a", names)
  let ss = k.slots |> list.map(((x, u)) => "${x}: ${u}")
  var hs: List[String] = []
  for (x, u) in k.slots {
    let h = prime_until_free("h" + int.to_string(list.len(hs) + 1), names)
    list.push(hs, "${h}: Apart_${t}_${u}(${a}, ${x})")
  }
  let params = list.join(["${a}: ${t}"] + ss + hs, ", ")
  "symbol apart_${t}_${k.name}(${params}) -> Apart_${t}_${k.tc}(${a}, ${call(k.name, names)})"
}

local fn prime_until_free(x: String, taken: List[String]) -> String =
  if list.contains(taken, x) then prime_until_free(x + "'", taken) else x

// ── Proofs ──────────────────────────────────────────────────────────

// A proof stack entry. Syntax stays structured, because distinct-variable
// obligations are proved by walking it; a proof is just its text.
type MExpr =
  | MVar(String, String)
  | MNode(String, String, List[MExpr])
  | MProof(String)

local fn render(e: MExpr) -> String = match e {
  MVar(x, _) => x,
  MNode(k, _, args) => call(k, args |> list.map((a) => render(a))),
  MProof(p) => p,
}

local fn tc_of(e: MExpr) -> String = match e {
  MVar(_, t) => t,
  MNode(_, t, _) => t,
  MProof(_) => PROVABLE,
}

local fn subst(e: MExpr, params: List[String], args: List[MExpr]) -> MExpr = match e {
  MVar(x, t) => match list.index_of(params, x) {
    some(i) => list.get(args, i) ?? e,
    none => e,
  },
  MNode(k, t, xs) => MNode(k, t, xs |> list.map((x) => subst(x, params, args))),
  MProof(_) => e,
}

// (Not `Ctx`: kernel.almd has one, almide/almide#3401.)
// What a proof step refers to: a hypothesis in scope (by its binder), or
// an assertion applied to the top of the stack.
type Proving = {
  label: String,
  hyps: Map[String, Hyp],
  asserts: Map[String, Assertion],
  mandatory: List[String],
  // The binder each dummy variable (by hypothesis label) stands for.
  dummies: Map[String, String],
  // Proofs of Apart(u, v) for pairs of variables, keyed "u v".
  facts: Map[String, String],
}

// A proof that a and b are apart, from the facts about variables.
local fn apart(c: Proving, a: MExpr, b: MExpr) -> String! = match b {
  MNode(k, _, args) => {
    var subs: List[String] = []
    for x in args {
      list.push(subs, apart(c, a, x)!)
    }
    ok(call("apart_${binder_name(tc_of(a))}_${k}", [render(a)] + (args |> list.map((x) => render(x))) + subs))
  },
  MVar(v, u) => match a {
    MNode(_, t, _) => {
      // Swapped through fresh names: almide/almide#3402.
      let left = b
      let right = a
      ok(call("apart_sym_${binder_name(t)}_${binder_name(u)}", [render(a), v, apart(c, left, right)!]))
    },
    MVar(w, t) => match map.get(c.facts, w + " " + v) {
      some(p) => ok(p),
      none => match map.get(c.facts, v + " " + w) {
        some(p) => ok(call("apart_sym_${binder_name(t)}_${binder_name(u)}", [w, v, p])),
        none => err("${c.label}: needs ${w} and ${v} to be distinct, which is not assumed"),
      },
    },
    MProof(_) => err("${c.label}: a proof where an expression was expected"),
  },
  MProof(_) => err("${c.label}: a proof where an expression was expected"),
}

local fn step(c: Proving, stack: List[MExpr], label: String) -> List[MExpr]! =
  match map.get(c.hyps, label) {
    some(h) =>
      if list.contains(c.mandatory, label) then ok(stack + [if h.essential then MProof(h.name) else MVar(h.name, h.tc)])
      else match map.get(c.dummies, label) {
        some(s) => ok(stack + [MVar(s, h.tc)]),
        none => err("${c.label}: hypothesis ${label} is not available here"),
      },
    none => match map.get(c.asserts, label) {
      some(a) => {
        let k = list.len(a.params)
        let n = list.len(stack)
        guard n >= k else err("${c.label}: proof stack underflow at ${label}")
        let args = list.drop(stack, n - k)
        let rest = list.take(stack, n - k)
        if a.tc != PROVABLE then match a.body {
          some(b) => ok(rest + [subst(b, a.params, args)]),
          none => ok(rest + [MNode(a.name, a.tc, args)]),
        } else {
          var obligations: List[String] = []
          for (i, j) in a.dv {
            list.push(obligations, apart(c, list.get(args, i) ?? MProof(""), list.get(args, j) ?? MProof(""))!)
          }
          ok(rest + [MProof(call(a.name, (args |> list.map((x) => render(x))) + obligations))])
        }
      },
      none => err("${c.label}: unknown label ${label} in a proof"),
    },
  }

// The labels a proof mentions.
local fn proof_labels(proof: List[String]) -> List[String] =
  if at(proof, 0) == "(" then copy(proof, 1, find(proof, 1, ")")) else proof

fn proof_term(c: Proving, proof: List[String]) -> MExpr! = {
  var stack: List[MExpr] = []
  if at(proof, 0) == "(" then {
    let close = find(proof, 1, ")")
    let labels = copy(proof, 1, close)
    let code = list.join(copy(proof, close + 1, list.len(proof)), "")
    let m = list.len(c.mandatory)
    let l = list.len(labels)
    var saved: List[MExpr] = []
    var acc = 0
    for ch in string.chars(code) {
      let cp = string.codepoint(ch) ?? 0
      if cp >= 65 and cp <= 84 then {
        let num = acc * 20 + (cp - 65) + 1
        acc = 0
        if num <= m then {
          stack = step(c, stack, list.get(c.mandatory, num - 1) ?? "")!
        } else if num <= m + l then {
          stack = step(c, stack, list.get(labels, num - m - 1) ?? "")!
        } else {
          let s = list.get(saved, num - m - l - 1)
          guard s != none else err("${c.label}: bad back-reference in a compressed proof")
          stack = stack + [s ?? MProof("")]
        }
      } else if cp >= 85 and cp <= 89 then {
        acc = acc * 5 + (cp - 84)
      } else if ch == "Z" then {
        list.push(saved, list.last(stack) ?? MProof(""))
      } else {
        guard false else err("${c.label}: incomplete proof (`${ch}`)")
      }
    }
  } else {
    for label in proof {
      guard label != "?" else err("${c.label}: incomplete proof")
      stack = step(c, stack, label)!
    }
  }
  match stack {
    [t] => ok(t),
    _ => err("${c.label}: the proof leaves ${int.to_string(list.len(stack))} terms on the stack"),
  }
}

// ── Statements ──────────────────────────────────────────────────────

local fn type_of(g: Map[String, List[Syn]], vars: Map[String, String], names: Map[String, String], tc: String, toks: List[String]) -> String! =
  if tc == PROVABLE then ok("Prf(" + parse_math(g, vars, names, STATEMENT, toks)! + ")")
  else if list.len(toks) == 1 and map.get(vars, at(toks, 0)) != none then ok(binder_name(tc))
  else err("a hypothesis of typecode ${tc} is not supported")

local fn pair_key(a: String, b: String) -> String = a + " " + b

local fn empty_hyp() -> Hyp = Hyp { name: "", essential: false, tc: "", toks: [] }

// A binder name no hypothesis in scope already has.
local fn unique_name(hyps: Map[String, Hyp], active: List[String], base: String) -> String = {
  var name = base
  while list.any(active, (h) => (map.get(hyps, h) ?? empty_hyp()).name == name) {
    name = name + "'"
  }
  name
}

fn absorb_mm(src: String, upto: String) -> String! = {
  let ts = tokens(prefix(src, upto)!)
  let n = list.len(ts)
  var hyps: Map[String, Hyp] = [:]
  var active: List[String] = []
  var dvs: List[(String, String)] = []
  var scopes: List[(Int, Int)] = []
  var asserts: Map[String, Assertion] = [:]
  var grammar: Map[String, List[Syn]] = [:]
  var ctors: List[Ctor] = []
  var taken: Map[String, Bool] = [:]
  var typecodes: List[String] = []
  var dv_on = false
  var out: List[String] = []
  var count = 0
  var last_theorem = ""
  var i = 0
  while i < n {
    let t = at(ts, i)
    if t == SCOPE_OPEN then {
      list.push(scopes, (list.len(active), list.len(dvs)))
      i = i + 1
    } else if t == "$}" then {
      let (ka, kd) = list.last(scopes) ?? (0, 0)
      active = list.take(active, ka)
      dvs = list.take(dvs, kd)
      scopes = list.take(scopes, list.len(scopes) - 1)
      i = i + 1
    } else if t == "$c" or t == "$v" then {
      i = find(ts, i, "$.") + 1
    } else if t == "$d" then {
      let stop = find(ts, i + 1, "$.")
      let vs = copy(ts, i + 1, stop)
      for (a, x) in list.enumerate(vs) {
        for y in list.drop(vs, a + 1) {
          list.push(dvs, (x, y))
        }
      }
      if dv_on then () else {
        dv_on = true
        list.push(out, "symbol Vars: Type")
        list.push(out, "symbol vnil: Vars")
        var known: List[String] = []
        for code in typecodes {
          for line in dv_typecode(binder_name(code), known) {
            list.push(out, line)
          }
          list.push(known, binder_name(code))
        }
        for k in ctors {
          for code in typecodes {
            list.push(out, dv_ctor(binder_name(code), k))
          }
        }
      }
      i = stop + 1
    } else {
      let label = t
      let kw = at(ts, i + 1)
      let stop = find(ts, i + 2, "$.")
      let body = copy(ts, i + 2, stop)
      let tc = at(body, 0)
      i = stop + 1
      // A typecode becomes a type the first time a variable or a syntax axiom has it.
      if (kw == "$f" or (kw == "$a" and tc != PROVABLE)) and not list.contains(typecodes, tc) then {
        let code = binder_name(tc)
        list.push(out, "symbol ${code}: Type")
        // Metamath assumes every typecode has variables; a dummy variable
        // with nothing else to stand in for it uses this one.
        list.push(out, "symbol some_${code}: ${code}")
        if tc == STATEMENT then list.push(out, "symbol Prf(p: ${STATEMENT}) -> Type") else ()
        if dv_on then {
          for line in dv_typecode(code, typecodes |> list.map((x) => binder_name(x))) {
            list.push(out, line)
          }
          for k in ctors {
            list.push(out, dv_ctor(code, k))
          }
        } else ()
        list.push(typecodes, tc)
      } else ()
      if kw == "$f" then {
        let v = at(body, 1)
        map.insert(hyps, label, Hyp { name: unique_name(hyps, active, var_name(v)), essential: false, tc: tc, toks: [v] })
        list.push(active, label)
      } else if kw == "$e" then {
        map.insert(hyps, label, Hyp { name: unique_name(hyps, active, binder_name(label)), essential: true, tc: tc, toks: list.drop(body, 1) })
        list.push(active, label)
      } else if kw == "$a" or kw == "$p" then {
        let eq = find(body, 0, "$=")
        let stmt = copy(body, 1, eq)
        // Variables in scope, and the ones this assertion mentions.
        var vars: Map[String, String] = [:]
        var names: Map[String, String] = [:]
        var floating: Map[String, String] = [:]
        for h in active {
          let hy = map.get(hyps, h) ?? empty_hyp()
          if hy.essential then () else {
            map.insert(vars, at(hy.toks, 0), hy.tc)
            map.insert(names, at(hy.toks, 0), hy.name)
            map.insert(floating, at(hy.toks, 0), h)
          }
        }
        var mentioned: Map[String, Bool] = [:]
        for x in stmt {
          map.insert(mentioned, x, true)
        }
        for h in active {
          let hy = map.get(hyps, h) ?? empty_hyp()
          if hy.essential then {
            for x in hy.toks {
              map.insert(mentioned, x, true)
            }
          } else ()
        }
        let mandatory = active |> list.filter((h) => {
          let hy = map.get(hyps, h) ?? empty_hyp()
          hy.essential or map.contains(mentioned, at(hy.toks, 0))
        })
        let mvars = mandatory |> list.map((h) => {
          let hy = map.get(hyps, h) ?? empty_hyp()
          if hy.essential then "" else at(hy.toks, 0)
        })
        // Parameters, each typed by the ones before it, then one per
        // distinct pair of mandatory variables.
        var params: List[String] = []
        for h in mandatory {
          let hy = map.get(hyps, h) ?? empty_hyp()
          let ty = if hy.essential then type_of(grammar, vars, names, hy.tc, hy.toks)! else binder_name(hy.tc)
          list.push(params, "${hy.name}: ${ty}")
        }
        var dv: List[(Int, Int)] = []
        var facts: Map[String, String] = [:]
        for (x, y) in dvs {
          match (list.index_of(mvars, x), list.index_of(mvars, y)) {
            (some(a), some(b)) => {
              let (p, q) = if a < b then (a, b) else (b, a)
              if p != q and not list.contains(dv, (p, q)) then {
                list.push(dv, (p, q))
                let bp = map.get(names, at(mvars, p)) ?? ""
                let bq = map.get(names, at(mvars, q)) ?? ""
                let tp = binder_name(map.get(vars, at(mvars, p)) ?? "")
                let tq = binder_name(map.get(vars, at(mvars, q)) ?? "")
                list.push(params, "dv_${bp}_${bq}: Apart_${tp}_${tq}(${bp}, ${bq})")
                map.insert(facts, pair_key(bp, bq), "dv_${bp}_${bq}")
              } else ()
            },
            _ => (),
          }
        }
        var name = label_name(label)
        while map.contains(taken, name) {
          name = name + "'"
        }
        map.insert(taken, name, true)
        let result = if tc == PROVABLE then type_of(grammar, vars, names, tc, stmt)! else binder_name(tc)
        let sig = if list.is_empty(params) then "${name}: ${result}" else "${name}(${list.join(params, ", ")}) -> ${result}"
        let pnames = mandatory |> list.map((h) => {
          let hy = map.get(hyps, h) ?? empty_hyp()
          if hy.essential then "" else hy.name
        })
        var abbreviates: MExpr? = none
        if kw == "$a" then {
          list.push(out, "symbol " + sig)
          if tc != PROVABLE then {
            // A syntax axiom: a grammar rule, and a constructor.
            var slots: Map[String, String] = [:]
            var order: List[String] = []
            var cslots: List[(String, String)] = []
            for h in mandatory {
              let hy = map.get(hyps, h) ?? empty_hyp()
              map.insert(slots, at(hy.toks, 0), hy.tc)
              list.push(order, at(hy.toks, 0))
              list.push(cslots, (hy.name, binder_name(hy.tc)))
            }
            let rule = Syn { name: name, toks: stmt, slots: slots, order: order }
            map.insert(grammar, tc, (map.get(grammar, tc) ?? []) + [rule])
            let k = Ctor { name: name, tc: binder_name(tc), slots: cslots }
            list.push(ctors, k)
            if dv_on then {
              for code in typecodes {
                list.push(out, dv_ctor(binder_name(code), k))
              }
            } else ()
          } else ()
        } else {
          let proof_toks = copy(body, eq + 1, list.len(body))
          // Dummy variables: the floating hypotheses the proof uses that
          // the statement does not have.
          var used: Map[String, Bool] = [:]
          for l in proof_labels(proof_toks) {
            map.insert(used, l, true)
          }
          let dummy_hyps = active |> list.filter((h) => map.contains(used, h) and not list.contains(mandatory, h)
            and not (map.get(hyps, h) ?? empty_hyp()).essential)
          let dummy_vars = dummy_hyps |> list.map((h) => at((map.get(hyps, h) ?? empty_hyp()).toks, 0))
          let constrained = (x: String) => list.any(dvs, ((a, b)) =>
            (a == x and (list.contains(mvars, b) or list.contains(dummy_vars, b)))
              or (b == x and (list.contains(mvars, a) or list.contains(dummy_vars, a))))
          var dummies: Map[String, String] = [:]
          // A dummy with no distinctness to respect stands in for a mandatory
          // variable of its typecode (or the typecode's witness).
          for h in dummy_hyps {
            let hy = map.get(hyps, h) ?? empty_hyp()
            if constrained(at(hy.toks, 0)) then map.insert(dummies, h, hy.name) else {
              let same = mandatory |> list.filter((m) => {
                let mh = map.get(hyps, m) ?? empty_hyp()
                not mh.essential and mh.tc == hy.tc
              })
              match list.first(same) {
                some(m) => map.insert(dummies, h, (map.get(hyps, m) ?? empty_hyp()).name),
                none => map.insert(dummies, h, "some_" + binder_name(hy.tc)),
              }
            }
          }
          // The others are chosen fresh, apart from the variables they must
          // avoid; the facts about them come from that choice.
          var opens: List[String] = []
          var fresh_before: List[String] = []
          for h in dummy_hyps {
            let hy = map.get(hyps, h) ?? empty_hyp()
            let d = at(hy.toks, 0)
            if constrained(d) then {
              let avoid = (mvars + fresh_before) |> list.filter((w) => w != "" and (list.contains(dvs, (d, w)) or list.contains(dvs, (w, d))))
              let bd = hy.name
              let td = binder_name(hy.tc)
              let elems = avoid |> list.map((w) => (map.get(names, w) ?? w, binder_name(map.get(vars, w) ?? "")))
              var lists: List[String] = []
              var acc_list = "vnil"
              for (bw, tw) in list.reverse(elems) {
                acc_list = "vcons_${tw}(${bw}, ${acc_list})"
                list.push(lists, acc_list)
              }
              // lists, innermost first; tails[k] is the list after the first k elements.
              let tails = list.reverse(lists) + ["vnil"]
              var cur = "h_" + bd
              var k = 0
              for (bw, tw) in elems {
                k = k + 1
                let rest = at(tails, k)
                map.insert(facts, pair_key(bd, bw), "apart_head_${td}_${tw}(${bd}, ${bw}, ${rest}, ${cur})")
                cur = "apart_tail_${td}_${tw}(${bd}, ${bw}, ${rest}, ${cur})"
              }
              list.push(opens, "fresh_${td}(${at(tails, 0)}, ${string.drop(string.drop_end(result, 1), 4)}, (${bd}: ${td}, h_${bd}: ApartAll_${td}(${bd}, ${at(tails, 0)})) =>")
              list.push(fresh_before, d)
            } else ()
          }
          let ctx = Proving { label: label, hyps: hyps, asserts: asserts, mandatory: mandatory, dummies: dummies, facts: facts }
          let proof = proof_term(ctx, proof_toks)!
          if tc == PROVABLE then {
            let closes = list.join(list.repeat(")", list.len(opens)), "")
            let opened = list.join(opens |> list.map((o) => o + "\n    "), "")
            list.push(out, "theorem ${sig} =\n  ${opened}${render(proof)}${closes}")
            count = count + 1
            last_theorem = name
          } else {
            list.push(out, "def ${sig} =\n  ${render(proof)}")
            abbreviates = some(proof)
          }
        }
        map.insert(asserts, label, Assertion { name: name, tc: tc, params: pnames, dv: dv, body: abbreviates })
        if label == upto then {
          i = n
        } else ()
      } else {
        guard false else err("unexpected `${kw}` after ${label}")
      }
    }
  }
  let scope = if upto == "" then "the whole database" else "the database up to ${upto}"
  let header = """
    // Absorbed from Metamath by `arlk absorb-mm`: ${scope}
    // (${int.to_string(count)} theorems). Check it with `arlk check <this file>`;
    // no Metamath verifier is needed. The check is relative to the axioms and
    // syntax facts below (see `axioms`).
    """
  let last = if upto == "" then last_theorem else label_name(upto)
  let footer = if last == "" then [] else ["", "axioms ${last}"]
  ok(list.join([header, "room setmm", ""] + out + footer, "\n") + "\n")
}

test "labels and binders" {
  assert_eq(label_name("ax-mp"), "ax_mp")
  assert_eq(label_name("pm2.43"), "pm2.43")
  assert_eq(binder_name("a1i.1"), "a1i_1")
  assert_eq(var_name("ph"), "ph")
  assert_eq(var_name(".+"), "op_dot_plus")
  assert(var_name("~") != var_name(".+"))
  assert(var_name(".+b") != var_name(".+^"))
}

test "a tiny database with a compressed proof" {
  let db = string.replace(string.replace("""
    $c ( ) -> wff |- $.
    $v ph ps $.
    wph $f wff ph $.
    wps $f wff ps $.
    wi $a wff ( ph -> ps ) $.
    OPEN
      min $e |- ph $.
      maj $e |- ( ph -> ps ) $.
      ax-mp $a |- ps $.
    CLOSE
    ax-1 $a |- ( ph -> ( ps -> ph ) ) $.
    OPEN
      a1i.1 $e |- ph $.
      a1i $p |- ( ps -> ph ) $=
        ( wi ax-1 ax-mp ) ABADCABEF $.
    CLOSE
    """, "OPEN", "$" + "{"), "CLOSE", "$" + "}")
  let text = absorb_mm(db, "a1i")
  assert(string.contains(text ?? "", "theorem a1i(ph: wff, ps: wff, a1i_1: Prf(ph)) -> Prf(wi(ps, ph)) ="))
  assert(string.contains(text ?? "", "symbol ax_mp(ph: wff, ps: wff, min: Prf(ph), maj: Prf(wi(ph, ps))) -> Prf(ps)"))
}
