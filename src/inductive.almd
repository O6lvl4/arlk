// Inductive types: the declarations a `type` stands for.
//
//   type Nat: Type =
//     | zero
//     | succ(n: Nat)
//
// becomes the type former `Nat`, the constructors `Nat.zero` and
// `Nat.succ`, the recursor `Nat.rec` (Lean's, which is also Rocq's and
// Agda's eliminator), and one computation rule per constructor:
//
//   symbol Nat.rec[v](motive: (t: Nat) -> Sort(v), zero: motive(Nat.zero),
//                     succ: (n: Nat, ih_n: motive(n)) -> motive(Nat.succ(n)),
//                     t: Nat) -> motive(t)
//   rule Nat.rec[v](motive, zero, succ, Nat.zero) = zero  where ...
//   rule Nat.rec[v](motive, zero, succ, Nat.succ(n)) = succ(n, Nat.rec[v](motive, zero, succ, n))  where ...
//
// Everything here is ordinary Arlk syntax, and the kernel checks each
// generated declaration like any other: a rule that does not preserve
// types is rejected. What retyping cannot see is whether the type itself
// is admissible (strict positivity, universe levels, which universes it
// may eliminate into) and whether this file emitted the intended
// recursor schema: `admissible` in checker.almd decides the first before
// anything is added (and passes the outcome in as a `Plan`), and the
// second rests on this file. Both are part of the trusted base; see
// docs/TRUST.md.

import self.syntax.{Raw, Decl, Inductive, Constructor, Sig, Arm, Sub}

// `large`: the motive may land in any universe (else only in Prop).
// `k`: a proposition with one constructor and no arguments (like Eq):
// any proof of the right instance computes like the constructor.
type Plan = { large: Bool, k: Bool }

// ── Raw helpers ─────────────────────────────────────────────────────

fn raw_apply(h: Raw, args: List[Raw]) -> Raw = list.fold(args, h, (acc, a) => RApp(acc, a))

local fn pis(bs: List[(String, Raw)], body: Raw) -> Raw =
  list.fold(list.reverse(bs), body, (acc, (x, ty)) => RPi(x, ty, acc))

local fn lams(bs: List[(String, Raw)], body: Raw) -> Raw =
  list.fold(list.reverse(bs), body, (acc, (x, ty)) => RLam(x, ty, acc))

fn raw_spine(r: Raw) -> (Raw, List[Raw]) = {
  // A loop, not `spine_acc(f, [a] + args)`: on the native test build that
  // form passes boxed payloads where values are expected (see the README's
  // Almide issues).
  var head = r
  var rev: List[Raw] = []
  var going = true
  while going {
    match head {
      RApp(f, a) => {
        list.push(rev, a)
        head = f
      },
      _ => {
        going = false
      },
    }
  }
  (head, list.reverse(rev))
}

local fn names(bs: List[(String, Raw)]) -> List[Raw] = bs |> list.map(((x, _)) => RName(x))

// The name with primes until it is not taken.
fn fresh(x: String, taken: List[String]) -> String =
  if list.contains(taken, x) then fresh(x + "'", taken) else x

// A constant of the declaration at its own universe parameters, with every
// argument explicit (the generated code passes the parameters itself).
local fn at_levels(ind: Inductive, name: String) -> Raw = RExplicit(name, ind.levels |> list.map((l) => RName(l)))

fn ctor_name(ind: Inductive, c: Constructor) -> String = ind.name + "." + c.name

fn rec_name(ind: Inductive) -> String = ind.name + ".rec"

// Is the head of r the type being declared?
fn is_self(ind: Inductive, r: Raw) -> Bool = {
  let (h, _) = raw_spine(r)
  match h {
    RName(x) => x == ind.name,
    RInst(x, _) => x == ind.name,
    RExplicit(x, _) => x == ind.name,
    _ => false,
  }
}

// The indices of a type: the binders of its arity before the sort.
// Unnamed ones get names.
fn indices(arity: Raw) -> List[(String, Raw)] = idx_acc(arity, [])

local fn idx_acc(r: Raw, acc: List[(String, Raw)]) -> List[(String, Raw)] = match r {
  RPi(x, ty, b) => idx_acc(b, acc + [(if x == "_" then "i" + int.to_string(list.len(acc) + 1) else x, ty)]),
  _ => acc,
}

// A constructor's result: the type at the parameters and some indices.
fn result_of(ind: Inductive, c: Constructor) -> Raw = match c.result {
  some(r) => r,
  none => raw_apply(at_levels(ind, ind.name), names(ind.params)),
}

// The index arguments of an instance of the type (after its parameters).
fn index_args(ind: Inductive, r: Raw) -> List[Raw] = {
  let (_, args) = raw_spine(r)
  list.drop(args, list.len(ind.params))
}

// A recursive argument `(y: B) -> T(params, idx)`: its binders and indices.
fn recursive(ind: Inductive, ty: Raw) -> (List[(String, Raw)], List[Raw])? = rec_acc(ind, ty, [])

local fn rec_acc(ind: Inductive, ty: Raw, ys: List[(String, Raw)]) -> (List[(String, Raw)], List[Raw])? = match ty {
  RPi(y, b, rest) => rec_acc(ind, rest, ys + [(if y == "_" then "y" + int.to_string(list.len(ys) + 1) else y, b)]),
  other => if is_self(ind, other) then some((ys, index_args(ind, other))) else none,
}

// ── The generated declarations ──────────────────────────────────────

// Every name the user wrote, which generated binders must avoid.
local fn user_names(ind: Inductive) -> List[String] =
  [ind.name] + (ind.params |> list.map(((x, _)) => x))
    + (indices(ind.arity) |> list.map(((x, _)) => x))
    + (ind.ctors |> list.flat_map((c) => c.args |> list.map(((x, _)) => x)))
    + ind.levels

type Names = { motive: String, level: String, minors: List[String], major: String, idx: List[String] }

local fn generated_names(ind: Inductive) -> Names = {
  let taken = user_names(ind)
  let motive = fresh("motive", taken)
  let level = fresh("v", taken)
  var minors: List[String] = []
  for c in ind.ctors {
    list.push(minors, fresh(c.name, taken + [motive] + minors))
  }
  let major = fresh("t", taken + [motive] + minors)
  var idx: List[String] = []
  for (x, _) in indices(ind.arity) {
    list.push(idx, fresh(x, taken + [motive, major] + minors + idx))
  }
  Names { motive: motive, level: level, minors: minors, major: major, idx: idx }
}

local fn rec_levels(ind: Inductive, n: Names, plan: Plan) -> List[String] =
  if plan.large then [n.level] + ind.levels else ind.levels

local fn rec_head(ind: Inductive, n: Names, plan: Plan) -> Raw = {
  let ls = rec_levels(ind, n, plan)
  RExplicit(rec_name(ind), ls |> list.map((l) => RName(l)))
}

// motive: (indices, t: T(params, indices)) -> Sort(v), or Sort(0).
local fn motive_type(ind: Inductive, n: Names, plan: Plan) -> Raw = {
  let idx = indices(ind.arity)
  let target = raw_apply(at_levels(ind, ind.name), names(ind.params) + names(idx))
  let sort = RApp(RSort, RName(if plan.large then n.level else "0"))
  pis(idx + [(fresh(n.major, idx |> list.map(((x, _)) => x)), target)], sort)
}

// The minor premise for constructor c: its arguments, an induction
// hypothesis per recursive argument, and the motive at the constructor.
local fn minor_type(ind: Inductive, n: Names, c: Constructor) -> Raw = {
  let taken = user_names(ind) + [n.motive] + n.minors
  var ihs: List[(String, Raw)] = []
  for (a, ty) in c.args {
    match recursive(ind, ty) {
      some((ys, idx)) => {
        let ih = fresh("ih_" + a, taken + (ihs |> list.map(((x, _)) => x)))
        list.push(ihs, (ih, pis(ys, raw_apply(RName(n.motive), idx + [raw_apply(RName(a), names(ys))]))))
      },
      none => (),
    }
  }
  let built = raw_apply(at_levels(ind, ctor_name(ind, c)), names(ind.params) + names(c.args))
  pis(c.args + ihs, raw_apply(RName(n.motive), index_args(ind, result_of(ind, c)) + [built]))
}

local fn rec_type(ind: Inductive, n: Names, plan: Plan) -> Raw = {
  let idx = list.zip(n.idx, indices(ind.arity) |> list.map(((_, ty)) => ty))
  // Index types may mention earlier indices by their written names.
  let idx2 = rename_telescope(idx, indices(ind.arity) |> list.map(((x, _)) => x), n.idx)
  let minors = list.zip(n.minors, ind.ctors |> list.map((c) => minor_type(ind, n, c)))
  let target = raw_apply(at_levels(ind, ind.name), names(ind.params) + names(idx2))
  pis(ind.params + [(n.motive, motive_type(ind, n, plan))] + minors + idx2 + [(n.major, target)],
    raw_apply(RName(n.motive), names(idx2) + [RName(n.major)]))
}

// The rule that computes the recursor on constructor c.
local fn iota(ind: Inductive, n: Names, plan: Plan, c: Constructor, minor: String) -> Decl = {
  let head = rec_head(ind, n, plan)
  let fixed = names(ind.params) + [RName(n.motive)] + (n.minors |> list.map((m) => RName(m)))
  let vars = ind.params + [(n.motive, motive_type(ind, n, plan))]
    + list.zip(n.minors, ind.ctors |> list.map((d) => minor_type(ind, n, d))) + c.args
  let res_idx = index_args(ind, result_of(ind, c))
  let built = raw_apply(at_levels(ind, ctor_name(ind, c)), (ind.params |> list.map(((x, _)) => RBracket(RName(x)))) + names(c.args))
  let lhs = raw_apply(head, fixed + (res_idx |> list.map((i) => RBracket(i))) + [built])
  var ihs: List[Raw] = []
  for (a, ty) in c.args {
    match recursive(ind, ty) {
      some((ys, idx)) => list.push(ihs, lams(ys, raw_apply(head, fixed + idx + [raw_apply(RName(a), names(ys))]))),
      none => (),
    }
  }
  DRule(vars, lhs, raw_apply(RName(minor), names(c.args) + ihs))
}

// K: for a proposition with a single constructor without arguments, any
// proof at the constructor's indices computes like the constructor (the
// proofs are equal anyway; this makes the recursor see it).
local fn k_rule(ind: Inductive, n: Names, plan: Plan, c: Constructor, minor: String) -> Decl = {
  let head = rec_head(ind, n, plan)
  let res_idx = index_args(ind, result_of(ind, c))
  let h = fresh("h", user_names(ind) + [n.motive] + n.minors)
  let vars = ind.params + [(n.motive, motive_type(ind, n, plan)), (minor, minor_type(ind, n, c)), (h, result_of(ind, c))]
  let lhs = raw_apply(head, names(ind.params) + [RName(n.motive), RName(minor)] + (res_idx |> list.map((i) => RBracket(i))) + [RName(h)])
  DRule(vars, lhs, RName(minor))
}

// The type former alone: declared first, so that the constructors can be
// checked against it.
fn type_former(ind: Inductive) -> Decl = DSymbol(Sig { name: ind.name, levels: ind.levels, implicits: 0, ty: pis(ind.params, ind.arity) })

// The type's own name, written without levels inside its declaration
// (`tail: List(A)`), stands for the type at its own universe parameters:
// generated rules are not elaborated, so the levels are filled in here.
fn own_levels(ind: Inductive) -> Inductive =
  if list.is_empty(ind.levels) then ind
  else {
    let fill = (r: Raw) => self_levels(ind, r)
    {
      ...ind,
      arity: fill(ind.arity),
      ctors: ind.ctors |> list.map((c) => {
        ...c,
        args: c.args |> list.map(((x, ty)) => (x, fill(ty))),
        result: match c.result {
          some(r) => some(fill(r)),
          none => none,
        },
      }),
    }
  }

local fn self_levels(ind: Inductive, r: Raw) -> Raw = match r {
  RName(x) => if x == ind.name then at_levels(ind, x) else r,
  RApp(f, a) => RApp(self_levels(ind, f), self_levels(ind, a)),
  RLam(x, ty, b) => RLam(x, self_levels(ind, ty), if x == ind.name then b else self_levels(ind, b)),
  RPi(x, ty, b) => RPi(x, self_levels(ind, ty), if x == ind.name then b else self_levels(ind, b)),
  RBracket(b) => RBracket(self_levels(ind, b)),
  other => other,
}

// The constructors, checked against the type former. The parameters are
// implicit: `List.cons(x, xs)` infers the element type.
fn constructors(ind0: Inductive) -> List[Decl] = {
  let ind = own_levels(ind0)
  ind.ctors |> list.map((c) => DSymbol(Sig { name: ctor_name(ind, c), levels: ind.levels, implicits: list.len(ind.params), ty: pis(ind.params + c.args, result_of(ind, c)) }))
}

// The recursor and its rules, once the type is known to be admissible.
fn eliminator(ind0: Inductive, plan: Plan) -> List[Decl] = {
  let ind = own_levels(ind0)
  let n = generated_names(ind)
  var out: List[Decl] = []
  list.push(out, DSymbol(Sig { name: rec_name(ind), levels: rec_levels(ind, n, plan), implicits: list.len(ind.params), ty: rec_type(ind, n, plan) }))
  for (c, minor) in list.zip(ind.ctors, n.minors) {
    list.push(out, if plan.k then k_rule(ind, n, plan, c, minor) else iota(ind, n, plan, c, minor))
  }
  out
}

// ── Nested types ────────────────────────────────────────────────────
//
//   type Rose = | node(kids: List(Rose))
//
// Rose occurs inside another inductive type (List), as Lean allows. The
// checker (`nested` in checker.almd) finds each such occurrence `J(args)`
// and checks that the type stays strictly positive through J's
// constructors at those arguments; here each occurrence gets a motive, its
// constructors get minor premises, and the recursor gets a companion per
// occurrence (Lean's `Rose.rec_1`):
//
//   Rose.rec[v](motive: (t: Rose) -> Sort(v), motive_1: (t: List(Rose)) -> Sort(v),
//               node: (kids: List(Rose), ih_kids: motive_1(kids)) -> motive(Rose.node(kids)),
//               nil: motive_1(List.nil),
//               cons: (head: Rose, tail: List(Rose), ih_head: motive(head),
//                      ih_tail: motive_1(tail)) -> motive_1(List.cons(head, tail)),
//               t: Rose) -> motive(t)
//   Rose.rec_1[v](...the same..., t: List(Rose)) -> motive_1(t)
//
// with one computation rule per constructor of Rose and of each occurrence.

// An occurrence `J(args)`: the type, and J's constructors at those
// arguments. `kinds` says, per argument, which motive its induction
// hypothesis uses: -1 none, 0 the type's own, k the k-th occurrence's.
type Aux = { ty: Raw, ctors: List[AuxCtor] }
type AuxCtor = { name: String, head: Raw, params: List[Raw], args: List[(String, Raw)], kinds: List[Int] }
// `args`: the type's own constructors' arguments, at explicit levels
// (rules are not elaborated).
type Nested = { auxes: List[Aux], kinds: List[List[Int]], args: List[List[(String, Raw)]] }

// A constructor of the type or of an occurrence, for the recursor.
type Row = { args: List[(String, Raw)], kinds: List[Int], built: Raw, pat: Raw, motive: Int }

local fn peel(ty: Raw, ys: List[(String, Raw)]) -> List[(String, Raw)] = match ty {
  RPi(y, b, rest) => peel(rest, ys + [(if y == "_" then "y" + int.to_string(list.len(ys) + 1) else y, b)]),
  _ => ys,
}

fn nested_rec_name(ind: Inductive, k: Int) -> String = if k == 0 then rec_name(ind) else rec_name(ind) + "_" + int.to_string(k)

fn nested_eliminator(ind0: Inductive, plan: Plan, nest: Nested) -> List[Decl] = {
  let ind = own_levels(ind0)
  let n = generated_names(ind)
  let aux_args = nest.auxes |> list.flat_map((a) => a.ctors |> list.flat_map((c) => c.args |> list.map(((x, _)) => x)))
  let taken0 = user_names(ind) + aux_args + n.minors + [n.motive, n.major, n.level]
  var motives: List[String] = [n.motive]
  for (k, _) in list.enumerate(nest.auxes) {
    list.push(motives, fresh(n.motive + "_" + int.to_string(k + 1), taken0 + motives))
  }
  var minors: List[String] = n.minors
  for a in nest.auxes {
    for c in a.ctors {
      let short = match list.last(string.split(c.name, ".")) {
        some(x) => x,
        none => c.name,
      }
      list.push(minors, fresh(short, taken0 + motives + minors))
    }
  }
  let sort = RApp(RSort, RName(if plan.large then n.level else "0"))
  let self_ty = raw_apply(at_levels(ind, ind.name), names(ind.params))
  let tys = [self_ty] + (nest.auxes |> list.map((a) => a.ty))
  let motive_tys = list.zip(motives, tys |> list.map((t) => RPi(n.major, t, sort)))
  // Each constructor, of the type and of every occurrence: its arguments,
  // their kinds, the value it builds (with and without bracketed
  // parameters) and the motive it lands in.
  var rows: List[Row] = []
  for (i, c) in list.enumerate(ind.ctors) {
    let h = at_levels(ind, ctor_name(ind, c))
    let args = list.get(nest.args, i) ?? c.args
    list.push(rows, Row { args: args, kinds: list.get(nest.kinds, i) ?? [], built: raw_apply(h, names(ind.params) + names(args)), pat: raw_apply(h, (ind.params |> list.map(((x, _)) => RBracket(RName(x)))) + names(args)), motive: 0 })
  }
  for (k, a) in list.enumerate(nest.auxes) {
    for c in a.ctors {
      list.push(rows, Row { args: c.args, kinds: c.kinds, built: raw_apply(c.head, c.params + names(c.args)), pat: raw_apply(c.head, (c.params |> list.map((p) => RBracket(p))) + names(c.args)), motive: k + 1 })
    }
  }
  let mname = (k: Int) => list.get(motives, k) ?? n.motive
  let taken1 = taken0 + motives + minors
  var minor_tys: List[(String, Raw)] = []
  var row_ihs: List[List[(String, Raw)]] = []
  for (r, m) in list.zip(rows, minors) {
    var ih_bs: List[(String, Raw)] = []
    for (i, b) in list.enumerate(r.args) {
      let (a, ty) = b
      let kd = list.get(r.kinds, i) ?? -1
      if kd >= 0 then {
        let ys = peel(ty, [])
        let ih = fresh("ih_" + a, taken1 + (r.args |> list.map(((x, _)) => x)) + (ih_bs |> list.map(((x, _)) => x)))
        list.push(ih_bs, (ih, pis(ys, RApp(RName(mname(kd)), raw_apply(RName(a), names(ys))))))
      } else ()
    }
    list.push(minor_tys, (m, pis(r.args + ih_bs, RApp(RName(mname(r.motive)), r.built))))
    list.push(row_ihs, ih_bs)
  }
  let prefix = ind.params + motive_tys + minor_tys
  let rec_levels_ = rec_levels(ind, n, plan)
  let head_k = (k: Int) => RExplicit(nested_rec_name(ind, k), rec_levels_ |> list.map((l) => RName(l)))
  let fixed = names(ind.params) + (motives |> list.map((m) => RName(m))) + (minors |> list.map((m) => RName(m)))
  var out: List[Decl] = []
  for (k, t) in list.enumerate(tys) {
    list.push(out, DSymbol(Sig { name: nested_rec_name(ind, k), levels: rec_levels_, implicits: list.len(ind.params), ty: pis(prefix + [(n.major, t)], RApp(RName(mname(k)), RName(n.major))) }))
  }
  for (r, m) in list.zip(rows, minors) {
    var ihs: List[Raw] = []
    for (i, b) in list.enumerate(r.args) {
      let (a, ty) = b
      let kd = list.get(r.kinds, i) ?? -1
      if kd >= 0 then {
        let ys = peel(ty, [])
        list.push(ihs, lams(ys, raw_apply(head_k(kd), fixed + [raw_apply(RName(a), names(ys))])))
      } else ()
    }
    list.push(out, DRule(prefix + r.args, raw_apply(head_k(r.motive), fixed + [r.pat]), raw_apply(RName(m), names(r.args) + ihs)))
  }
  list.push(out, nested_cases(ind, n, plan, rows, row_ihs, minors, motives, prefix, head_k, tys))
  out
}

// `T.cases`: a case split on the type alone (no induction hypotheses), for
// a `match` that does not recurse. Defined by the recursor, the other
// motives being `motive(t) -> motive(t)`, so it is checked like any def.
local fn nested_cases(ind: Inductive, n: Names, plan: Plan, rows: List[Row], row_ihs: List[List[(String, Raw)]], minors: List[String], motives: List[String], prefix: List[(String, Raw)], head_k: (Int) -> Raw, tys: List[Raw]) -> Decl = {
  let nown = list.len(ind.ctors)
  let at_t = RApp(RName(n.motive), RName(n.major))
  let id_ty = RPi("_", at_t, at_t)
  let x = fresh("x", user_names(ind) + minors + motives + [n.major])
  let own_minors = list.take(list.zip(minors, rows), nown) |> list.map(((m, r)) => (m, pis(r.args, RApp(RName(n.motive), r.built))))
  let params = list.take(prefix, list.len(ind.params))
  var fixed: List[Raw] = names(ind.params) + [RName(n.motive)]
  for (k, t) in list.enumerate(tys) {
    if k > 0 then list.push(fixed, RLam(fresh("t", [n.major]), t, id_ty)) else ()
  }
  for (i, r) in list.enumerate(rows) {
    // An induction hypothesis's type, with the other motives filled in.
    var ihs: List[(String, Raw)] = []
    for (j, b) in list.enumerate(r.args) {
      let (a, ty) = b
      let kd = list.get(r.kinds, j) ?? -1
      if kd >= 0 then {
        let ys = peel(ty, [])
        let nm = match list.get(list.get(row_ihs, i) ?? [], list.len(ihs)) {
          some((nm, _)) => nm,
          none => "ih",
        }
        list.push(ihs, (nm, pis(ys, if kd == 0 then RApp(RName(n.motive), raw_apply(RName(a), names(ys))) else id_ty)))
      } else ()
    }
    let m = list.get(minors, i) ?? ""
    list.push(fixed, lams(r.args + ihs, if i < nown then raw_apply(RName(m), names(r.args)) else RLam(x, at_t, RName(x))))
  }
  let ty = pis(params + [(n.motive, RPi(n.major, list.first(tys) ?? RType, RApp(RSort, RName(if plan.large then n.level else "0"))))] + own_minors + [(n.major, list.first(tys) ?? RType)], at_t)
  let body = lams(params + [(n.motive, RPi(n.major, list.first(tys) ?? RType, RApp(RSort, RName(if plan.large then n.level else "0"))))] + own_minors + [(n.major, list.first(tys) ?? RType)], raw_apply(head_k(0), fixed + [RName(n.major)]))
  DDef(Sig { name: ind.name + ".cases", levels: rec_levels(ind, n, plan), implicits: list.len(ind.params), ty: ty }, body)
}

// ── Records ─────────────────────────────────────────────────────────

// One projection per field, defined by a match on the record:
//   def Sigma.snd[u, v, A, B](p: Sigma(A, B)) -> B(Sigma.fst(p)) = match p { mk(fst, snd) => snd }
// A field's type may mention earlier fields; there they are projections of p.
fn projections(ind0: Inductive) -> List[Decl] = {
  let ind = own_levels(ind0)
  let p = fresh("self", user_names(ind))
  let target = raw_apply(at_levels(ind, ind.name), names(ind.params))
  var out: List[Decl] = []
  var earlier: List[String] = []
  for (f, ty) in ind.fields |> list.map((f) => (f, field_type(ind, f))) {
    let proj = (g: String) => RApp(RName(ind.name + "." + g), RName(p))
    let ty2 = substitute(ty, earlier, earlier |> list.map((g) => proj(g)))
    let sig = Sig { name: ind.name + "." + f, levels: ind.levels, implicits: list.len(ind.params), ty: pis(ind.params + [(p, target)], ty2) }
    let arm = Arm { ctor: "mk", subs: ind.fields |> list.map((g) => SName(g)), body: RName(f) }
    let body = lams(ind.params + [(p, target)], RMatch(RName(p), [arm]))
    list.push(out, DDef(sig, body))
    list.push(earlier, f)
  }
  out
}

local fn field_type(ind: Inductive, f: String) -> Raw = match list.first(ind.ctors) {
  some(c) => match list.find(c.args, ((x, _)) => x == f) {
    some((_, ty)) => ty,
    none => RType,
  },
  none => RType,
}

// Replace free occurrences of names by terms (binders stop it).
fn substitute(r: Raw, from: List[String], to: List[Raw]) -> Raw = match r {
  RName(x) => match list.index_of(from, x) {
    some(i) => list.get(to, i) ?? r,
    none => r,
  },
  RApp(f, a) => RApp(substitute(f, from, to), substitute(a, from, to)),
  RLam(x, ty, b) => RLam(x, substitute(ty, from, to), substitute(b, keep_from(from, to, x), keep_to(from, to, x))),
  RPi(x, ty, b) => RPi(x, substitute(ty, from, to), substitute(b, keep_from(from, to, x), keep_to(from, to, x))),
  RBracket(b) => RBracket(substitute(b, from, to)),
  other => other,
}

local fn keep_from(from: List[String], to: List[Raw], x: String) -> List[String] =
  list.zip(from, to) |> list.filter(((f, _)) => f != x) |> list.map(((f, _)) => f)

local fn keep_to(from: List[String], to: List[Raw], x: String) -> List[Raw] =
  list.zip(from, to) |> list.filter(((f, _)) => f != x) |> list.map(((_, t)) => t)

// ── Renaming ────────────────────────────────────────────────────────

// Rename free occurrences of `from[i]` to `to[i]` in a telescope's types.
local fn rename_telescope(bs: List[(String, Raw)], from: List[String], to: List[String]) -> List[(String, Raw)] =
  bs |> list.map(((x, ty)) => (x, rename(ty, from, to)))

fn rename(r: Raw, from: List[String], to: List[String]) -> Raw = match r {
  RName(x) => match list.index_of(from, x) {
    some(i) => RName(list.get(to, i) ?? x),
    none => r,
  },
  RApp(f, a) => RApp(rename(f, from, to), rename(a, from, to)),
  RLam(x, ty, b) => RLam(x, rename(ty, from, to), rename(b, without(from, to, x), without_to(from, to, x))),
  RPi(x, ty, b) => RPi(x, rename(ty, from, to), rename(b, without(from, to, x), without_to(from, to, x))),
  RBracket(b) => RBracket(rename(b, from, to)),
  other => other,
}

// A binder named x stops the renaming of x below it.
local fn without(from: List[String], to: List[String], x: String) -> List[String] =
  list.zip(from, to) |> list.filter(((f, _)) => f != x) |> list.map(((f, _)) => f)

local fn without_to(from: List[String], to: List[String], x: String) -> List[String] =
  list.zip(from, to) |> list.filter(((f, _)) => f != x) |> list.map(((_, t)) => t)

test "names avoid what the user wrote" {
  assert_eq(fresh("motive", ["motive", "motive'"]), "motive''")
}
