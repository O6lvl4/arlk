// arlk absorb: turn a Lean or Rocq export (tools/lean-export,
// tools/rocq-export) into Arlk source.
//
// The output is ordinary Arlk text: every absorbed declaration, in a room
// of its own (`Init` for Lean, `Corelib` for Rocq), on top of the shared
// foundation in lib/core.arlk. Checking it needs only `arlk check`, and
// neither prover is involved. The kernel re-checks every proof, but the
// symbols and rules emitted here are assumptions of that check: their
// faithfulness to the source logic is this translator's responsibility
// (see "What a successful check means" in the README).

import json

// Named levels l0 .. l9 live in lib/core.arlk; higher ones are spelled with ls.
let NAMED_LEVELS = 10

local fn level(o: Out, n: Int) -> String =
  if n < NAMED_LEVELS then "core.l${int.to_string(n)}" else "core.ls(${level(o, n - 1)})"

// The room absorbed declarations live in, and the name prefix it replaces.
local fn library_room(th: String) -> String = match th {
  "rocq" => "Corelib",
  _ => "Init",
}

// Where output goes: the library room (whose own prefix is dropped from
// names, so Rocq's `Corelib.Init.Peano.plus_n_O` stays that), and the
// names a binder must not shadow.
type Out = { lib: String, reserved: Set[String] }

local fn cname(o: Out, raw: String) -> String = mangle(string.strip_prefix(raw, o.lib + ".") ?? raw)

// ── Names ───────────────────────────────────────────────────────────

let KEYWORDS = ["room", "uses", "symbol", "def", "theorem", "rule", "where", "irrelevant", "check", "eval", "axioms", "Type", "Sort", "type", "match", "view", "translate", "let"]

local fn plain_char(c: String) -> Bool = string.is_alphanumeric(c) or c == "_" or c == "'"

// A Lean constant name as an Arlk identifier: dots and `@levels` stay,
// anything else becomes `_`.
fn mangle(name: String) -> String = {
  let cs = string.chars(name) |> list.map((c) => if plain_char(c) or c == "." or c == "@" then c else "_")
  let s = list.join(cs, "")
  if list.contains(KEYWORDS, s) then s + "'" else s
}

// A binder name that reads well and cannot capture: Lean's hygienic
// suffixes are dropped, and a clash with an outer binder or a constant
// gets primes.
local fn binder(raw: String, outer: List[String], reserved: Set[String]) -> String = {
  let base = match string.index_of(raw, "._@") {
    some(i) => string.slice(raw, 0, i),
    none => raw,
  }
  let kept = list.join(string.chars(base) |> list.filter((c) => plain_char(c)), "")
  let named = if kept == "" then "x" else if string.is_digit(string.take(kept, 1)) then "x" + kept else kept
  let safe = if list.contains(KEYWORDS, named) then named + "'" else named
  prime_until_free(safe, outer, reserved)
}

local fn prime_until_free(x: String, outer: List[String], reserved: Set[String]) -> String =
  if list.contains(outer, x) or set.contains(reserved, x) then prime_until_free(x + "'", outer, reserved) else x

// ── Expressions ─────────────────────────────────────────────────────

local fn get(v: Value, k: String) -> Value! = value.field(v, k)
local fn int_of(v: Value) -> Int! = value.as_int(v)
local fn str_of(v: Value) -> String! = value.as_string(v)
local fn arr_of(v: Value) -> List[Value]! = value.as_array(v)

local fn kind_of(v: Value) -> String = list.first(value.keys(v)) ?? ""

// Only a function needs parentheses, and only when it is called.
local fn callee(s: String, v: Value) -> String = if kind_of(v) == "l" then "(" + s + ")" else s

// `names` holds the binders in scope, innermost first, so a de Bruijn
// index is a position in it.
fn expr(names: List[String], o: Out, v: Value) -> String! = match kind_of(v) {
  "v" => {
    let i = int_of(get(v, "v")!)!
    ok(list.get(names, i) ?? "#${int.to_string(i)}")
  },
  "c" => ok(cname(o, str_of(get(v, "c")!)!)),
  "s" => ok("core.sort(${level(o, int_of(get(v, "s")!)!)})"),
  "n" => {
    let n = int_of(get(v, "n")!)!
    guard n >= 0 else err("the numeral ${int.to_string(n)} is negative; natural-number literals must be at least 0")
    guard n <= 4096 else err("the numeral ${int.to_string(n)} is too large to spell in unary")
    ok(numeral(n))
  },
  "a" => {
    let (head, args) = app_spine(v, [])!
    let parts = args |> list.map((a) => expr(names, o, a)!)!
    ok(callee(expr(names, o, head)!, head) + "(" + list.join(parts, ", ") + ")")
  },
  "l" => {
    let xs = arr_of(get(v, "l")!)!
    let (x, dom, ld) = binder_parts(names, o, xs)!
    let body = expr([x] + names, o, list.get(xs, 3) ?? value.null())!
    ok("(${x}: core.El(${level(o, ld)}, ${dom})) => ${body}")
  },
  "p" => {
    let xs = arr_of(get(v, "p")!)!
    let (x, dom, ld) = binder_parts(names, o, xs)!
    let body = expr([x] + names, o, list.get(xs, 3) ?? value.null())!
    let lb = int_of(list.get(xs, 4) ?? value.null())!
    ok("core.pi(${level(o, ld)}, ${level(o, lb)}, ${dom}, (${x}: core.El(${level(o, ld)}, ${dom})) => ${body})")
  },
  "lift" => {
    let xs = arr_of(get(v, "lift")!)!
    let la = int_of(list.get(xs, 0) ?? value.null())!
    let lb = int_of(list.get(xs, 1) ?? value.null())!
    let t = list.get(xs, 2) ?? value.null()
    ok("core.lift(${level(o, la)}, ${level(o, lb)}, ${expr(names, o, t)!})")
  },
  other => err("unknown expression node '${other}'"),
}

local fn binder_parts(names: List[String], o: Out, xs: List[Value]) -> (String, String, Int)! = {
  let raw = str_of(list.get(xs, 0) ?? value.null())!
  let dom_v = list.get(xs, 1) ?? value.null()
  let dom = expr(names, o, dom_v)!
  let ld = int_of(list.get(xs, 2) ?? value.null())!
  ok((binder(raw, names, o.reserved), dom, ld))
}

local fn app_spine(v: Value, args: List[Value]) -> (Value, List[Value])! =
  if kind_of(v) == "a" then {
    let fa = arr_of(get(v, "a")!)!
    app_spine(list.get(fa, 0) ?? value.null(), [list.get(fa, 1) ?? value.null()] + args)
  } else ok((v, args))

// A loop, not recursion: the accepted maximum would otherwise be a
// recursion depth. Callers have checked 0 <= n.
local fn numeral(n: Int) -> String = {
  var s = "Nat.zero"
  var k = 0
  while k < n {
    s = "Nat.succ(" + s + ")"
    k = k + 1
  }
  s
}

// A Lean type `T` living in universe `l` is the Arlk type `El(l, T)`.
local fn el(names: List[String], o: Out, ty: Value, lvl: Int) -> String! = {
  let t = expr(names, o, ty)!
  ok("core.El(${level(o, lvl)}, ${t})")
}

// ── Rules ───────────────────────────────────────────────────────────

local fn pattern(names: List[String], o: Out, p: Value) -> String! = match kind_of(p) {
  "pv" => {
    let i = int_of(get(p, "pv")!)!
    ok(list.get(names, i) ?? "#${int.to_string(i)}")
  },
  "pb" => ok("{" + expr(names, o, get(p, "pb")!)! + "}"),
  _ => {
    let c = cname(o, str_of(get(p, "pc")!)!)
    let args = arr_of(get(p, "args")!)! |> list.map((a) => pattern(names, o, a)!)!
    if list.is_empty(args) then ok(c) else ok(c + "(" + list.join(args, ", ") + ")")
  },
}

local fn rule(o: Out, r: Value) -> String! = {
  // Rule variables, each typed in the context of the ones before it.
  var names: List[String] = []
  var decls: List[String] = []
  for v in arr_of(get(r, "vars")!)! {
    let parts = arr_of(v)!
    let x = binder(str_of(list.get(parts, 0) ?? value.null())!, names, o.reserved)
    let ty = el(names, o, list.get(parts, 1) ?? value.null(), int_of(list.get(parts, 2) ?? value.null())!)!
    list.push(decls, "${x}: ${ty}")
    names = [x] + names
  }
  let head = cname(o, str_of(get(r, "head")!)!)
  let args = arr_of(get(r, "args")!)! |> list.map((p) => pattern(names, o, p)!)!
  let rhs = expr(names, o, get(r, "rhs")!)!
  let lhs = if list.is_empty(args) then head else head + "(" + list.join(args, ", ") + ")"
  let vars = if list.is_empty(decls) then "" else "\n  where ${list.join(decls, ", ")}"
  ok("rule ${lhs} =\n  ${rhs}${vars}")
}

// ── Declarations ────────────────────────────────────────────────────

local fn decl(o: Out, d: Value) -> String! = {
  let kind = str_of(get(d, "kind")!)!
  let rules = match value.field(d, "rules") {
    ok(rs) => arr_of(rs)! |> list.map((r) => rule(o, r)!)!,
    err(_) => [],
  }
  // Rocq's auxiliary symbols get their rules after the rest of their block.
  guard kind != "rules" else ok(list.join(rules, "\n"))
  let name = cname(o, str_of(get(d, "name")!)!)
  let ty = el([], o, get(d, "type")!, int_of(get(d, "level")!)!)!
  let head = match kind {
    "def" | "theorem" => "${kind} ${name}: ${ty} =\n  ${expr([], o, get(d, "value")!)!}",
    _ => "symbol ${name}: ${ty}",
  }
  ok(list.join([head] + rules, "\n"))
}

fn absorb(src: String) -> String! = {
  let root = json.parse(src)!
  let th = match value.field(root, "theory") {
    ok(t) => str_of(t)!,
    err(_) => "lean",
  }
  let prover = if th == "rocq" then "Rocq" else "Lean 4"
  let lib = library_room(th)
  let decls = arr_of(get(root, "decls")!)!
  let named = decls |> list.filter((d) => (str_of(get(d, "kind") ?? value.null()) ?? "") != "rules")
  let bare = Out { lib: lib, reserved: set.new() }
  let names = named |> list.map((d) => cname(bare, str_of(get(d, "name")!)!))!
  let o = Out { lib: lib, reserved: set.from_list(names) }
  let targets = match value.field(root, "targets") {
    ok(ts) => arr_of(ts)! |> list.map((t) => cname(o, str_of(t)!))!,
    err(_) => [cname(o, str_of(get(root, "target")!)!)],
  }
  let body = decls |> list.map((d) => decl(o, d)!)!
  let what = match targets {
    [t] => "${t} and everything it uses",
    ts => "${int.to_string(list.len(ts))} theorems and everything they use",
  }
  let header = """
    // Absorbed from ${prover} by `arlk absorb`: ${what}.
    // Check it with `arlk check lib/core.arlk <this file>`;
    // ${prover} is not needed to check it. The check is relative to the symbols
    // and rules below (see `axioms`), which encode ${prover}'s theory.
    """
  let footer = match targets {
    [t] => ["", "axioms ${t}"],
    _ => [],
  }
  ok(list.join([header, "room ${lib} uses core", ""] + body + footer, "\n") + "\n")
}

test "mangling keeps dots and levels and escapes the rest" {
  assert_eq(mangle("HAdd.hAdd@0@0@0"), "HAdd.hAdd@0@0@0")
  assert_eq(mangle("Nat.add.match_1@1"), "Nat.add.match_1@1")
  assert_eq(mangle("«term_+_»"), "_term____")
  assert_eq(mangle("rule"), "rule'")
}

test "binders drop hygiene and avoid capture" {
  let reserved = set.from_list(["Nat"])
  assert_eq(binder("a._@._internal._hyg.0", [], reserved), "a")
  assert_eq(binder("a._@._internal._hyg.0", ["a"], reserved), "a'")
  assert_eq(binder("Nat", [], reserved), "Nat'")
  assert_eq(binder("x✝", [], reserved), "x")
}

test "levels and numerals" {
  assert_eq(level(Out { lib: "Init", reserved: set.new() }, 2), "core.l2")
  assert_eq(level(Out { lib: "Init", reserved: set.new() }, 11), "core.ls(core.ls(core.l9))")
  assert_eq(numeral(2), "Nat.succ(Nat.succ(Nat.zero))")
}

test "numerals: negative ones are rejected, the bounds hold" {
  let doc = (n: String) => "{\"theory\": \"lean\", \"targets\": [\"bad\"], \"decls\": [{\"kind\": \"def\", \"name\": \"bad\", \"type\": {\"c\": \"Nat\"}, \"level\": 1, \"value\": {\"n\": " + n + "}}]}"
  assert(match absorb(doc("-1")) { err(e) => string.contains(e, "negative"), ok(_) => false })
  assert(match absorb(doc("4097")) { err(e) => string.contains(e, "too large"), ok(_) => false })
  assert(match absorb(doc("0")) { ok(t) => string.contains(t, "= \n  Nat.zero") or string.contains(t, "Nat.zero"), err(_) => false })
  assert(match absorb(doc("1")) { ok(t) => string.contains(t, "Nat.succ(Nat.zero)"), err(_) => false })
  assert(match absorb(doc("4096")) { ok(_) => true, err(_) => false })
}
