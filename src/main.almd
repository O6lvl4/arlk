// arlk — the Arlk proof checker.
//
//   arlk check FILE.arlk                 check every declaration
//   arlk absorb EXPORT.json [-o OUT]     turn a Lean export into Arlk source

import env
import fs
import process
import self.syntax
import self.kernel
import self.absorb

let USAGE = """
  usage:
    arlk check FILE.arlk... [--timing] [--keep-going]
                                         check files in order, into one environment
                                         (--timing: list the slowest declarations;
                                          --keep-going: report every failure, not just the first)
    arlk absorb EXPORT.json [-o OUT]     turn a Lean export (tools/lean-export) into Arlk source
  """

effect fn main() -> Unit = {
  let args = process.args()
  let files = list.drop(args, 2) |> list.filter((a) => not string.starts_with(a, "-"))
  match list.get(args, 1) {
    some("check") if not list.is_empty(files) => run_check(files, list.contains(args, "--timing"), list.contains(args, "--keep-going"))!,
    some("absorb") if not list.is_empty(files) => run_absorb(list.first(files) ?? "", output_flag(args))!,
    _ => {
      println(USAGE)
      process.exit(2)
    },
  }
}

local fn output_flag(args: List[String]) -> String? = match list.index_of(args, "-o") {
  some(i) => list.get(args, i + 1),
  none => none,
}

// All files are checked into one environment, in order, so a later file
// can use the rooms of an earlier one (lib/core.arlk first).
// With keep_going, a declaration that fails is reported and left out, and
// checking continues (later declarations that need it fail too).
effect fn run_check(paths: List[String], timing: Bool, keep_going: Bool) -> Unit = {
  var kenv = kernel.empty()
  var failure: String? = none
  var failures = 0
  var times: List[(Int, Int)] = []
  for path in paths {
    if failure == none then {
      let src = fs.read_text(path) |> result.map_err((e) => "reading ${path}: ${e}")!
      match syntax.parse(src) {
        err(e) => {
          failure = some("${path}:${e}")
        },
        ok(ds) => {
          for d in ds {
            if failure == none then {
              let started = env.millis()
              let result = kernel.process(kenv, d)
              times = times + [(env.millis() - started, d.line)]
              match result {
                ok((env2, lines)) => {
                  kenv = env2
                  for line in lines {
                    println(line)
                  }
                },
                err(e) => {
                  let at = "${path}:${int.to_string(d.line)}: ${e}"
                  if keep_going then {
                    failures = failures + 1
                    println("✗ ${at}")
                  } else {
                    failure = some(at)
                  }
                },
              }
            }
          }
        },
      }
    }
  }
  if timing then report_timing(times)! else ()
  match failure {
    some(e) => {
      println("✗ ${e}")
      process.exit(1)
    },
    none =>
      if failures > 0 then {
        println("${int.to_string(failures)} failed, ${int.to_string(list.len(kenv.order))} declarations checked: ${list.join(paths, " ")}")
        process.exit(1)
      } else println("ok: ${list.join(paths, " ")} (${int.to_string(list.len(kenv.order))} declarations)"),
  }
}

effect fn report_timing(times: List[(Int, Int)]) -> Unit = {
  let total = list.sum(times |> list.map(((ms, _)) => ms))
  println("timing: ${int.to_string(total)} ms in ${int.to_string(list.len(times))} declarations; slowest:")
  let slowest = times |> list.sort_by(((ms, _)) => 0 - ms) |> list.take(10)
  for (ms, line) in slowest {
    println("  ${int.to_string(ms)} ms  line ${int.to_string(line)}")
  }
}

effect fn run_absorb(path: String, out: String?) -> Unit = {
  let src = fs.read_text(path) |> result.map_err((e) => "reading ${path}: ${e}")!
  match absorb.absorb(src) {
    err(e) => {
      println("✗ ${path}: ${e}")
      process.exit(1)
    },
    ok(text) => match out {
      some(o) => {
        fs.write(o, text) |> result.map_err((e) => "writing ${o}: ${e}")!
        println("wrote ${o}")
      },
      none => println(text),
    },
  }
}
