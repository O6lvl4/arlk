// Surface syntax of Arlk: lexer and parser. It reads like Almide.
//
//   room logic
//
//   symbol Prop: Type
//   symbol Prf(p: Prop) -> Type
//   symbol imp(a: Prop, b: Prop) -> Prop
//   rule Prf(imp(a, b)) = Prf(a) -> Prf(b)  where a: Prop, b: Prop
//
//   theorem k(a: Prop, b: Prop) -> Prf(imp(a, imp(b, a))) =
//     (x: Prf(a), y: Prf(b)) => x
//
// Declarations start with a keyword and need no terminator. Calls are
// `f(a, b)`, functions `(x: A) => e`, function types `(x: A) -> B` or
// `A -> B`, and `//` starts a comment. Name resolution to de Bruijn
// indices happens in the elaborator, which knows the rooms.

type Token = { kind: String, text: String, line: Int }

// `RBracket` is `{t}`: only legal in a rule's left-hand side, where it
// stands for a subterm fixed by typing and checked by conversion.
// `RSort` is the keyword `Sort`, applied to a level: `Sort(u)`.
// `RInst(c, ls)` is a constant at explicit universe levels: `id[u](A, x)`.
// Levels are written as terms: `0`, `u`, `u + 1`, `max(u, v)`, `imax(u, v)`.
type Raw =
  | RName(String)
  | RType
  | RSort
  | RInst(String, List[Raw])
  // Generated code only: a constant at the given levels with every
  // argument explicit (no implicit arguments inserted), like Lean's `@c`.
  | RExplicit(String, List[Raw])
  // `match x { C(a, b) => e, _ => e }`, Almide's match: compiled to the
  // recursor of x's type (structural recursion, see patterns.almd).
  | RMatch(Raw, List[Arm])
  // `Point { x: a, y: b }`: a record value, fields in any order.
  | RRecord(String, List[(String, Raw)])
  // `e.x`: a field of a record value (`p.x` on a name lexes as one name).
  | RField(Raw, String)
  | RApp(Raw, Raw)
  | RLam(String, Raw, Raw)
  | RPi(String, Raw, Raw)
  | RBracket(Raw)

type Decl =
  | DRoom(String, List[String])
  | DSymbol(Sig)
  | DDef(Sig, Raw)
  | DTheorem(Sig, Raw)
  | DRule(List[(String, Raw)], Raw, Raw)
  | DIrrelevant(List[(String, Raw)], Raw)
  // `structure S = S.mk(S.f1, S.f2)`: structure eta for a type given by
  // symbols and rules (an absorbed Lean structure).
  | DStructure(String, String, List[String])
  | DCheck(Raw)
  | DEval(Raw)
  | DAxioms(String)
  | DInductive(Inductive)
  // `view V from S { sym = term, ... }`: S's symbols as terms of this room.
  | DView(String, String, List[(String, Raw)])
  // `translate V name`: a declaration of a room built on V's source, with
  // everything it uses, carried along V into this room and checked again.
  | DTranslate(String, String)
  // `theorem t(...) -> T = search(lemma, ..., depth: n)`: a proof found by
  // bounded search (src/search.almd), then checked like a written one.
  | DSearch(Sig, String, List[String], Int)
  // `view V from S via v1, v2`: two views composed, checked as a view.
  | DViewVia(String, String, List[String])
  // `views`: the catalog; `routes from S`: ways from S into this room.
  | DViews
  | DRoutes(String)
  // Consecutive types that refer forward to each other: one mutual group
  // (see mutual.almd). Formed after parsing, never written directly.
  | DMutual(List[Inductive])
  // Consecutive definitions that refer forward to each other (formed after
  // parsing): mutually recursive, see mutual.almd.
  | DMutualDefs(List[Decl])

// `type Vec[u](A: Type(u)): (n: Nat) -> Type(u) = | nil: ... | cons(...): ...`
// `params` are fixed across the family, `arity` is the rest of its type
// (the indices, then a sort). A constructor without a result type builds
// the type applied to its parameters.
// A record (`= { x: A, y: B }`) is an inductive type with one constructor
// `mk` taking the fields; `fields` lists them, and they get projections.
type Inductive = { name: String, levels: List[String], params: List[(String, Raw)], arity: Raw, ctors: List[Constructor], fields: List[String] }

type Constructor = { name: String, args: List[(String, Raw)], result: Raw? }

type Located = { line: Int, decl: Decl }

// One arm of a match: a constructor (or `_`), the names it binds, the body.
type Arm = { ctor: String, subs: List[Sub], body: Raw }

// A pattern inside an arm: a name (a variable, `_`, or a constructor
// without arguments, told apart by the type it matches), or a constructor
// applied to patterns: `succ(succ(n))`.
type Sub =
  | SName(String)
  | SCon(String, List[Sub])

// A declared name: its universe parameters, how many of its leading
// parameters are implicit (written in `[...]`, inferred at each use), and
// its full type.
type Sig = { name: String, levels: List[String], implicits: Int, ty: Raw }

let KEYWORDS = [
  "room",
  "uses",
  "symbol",
  "def",
  "theorem",
  "rule",
  "where",
  "irrelevant",
  "structure",
  "check",
  "eval",
  "axioms",
  "Type",
  "Sort",
  "type",
  "match",
  "view",
  "translate",
  "let",
  "search",
  "views",
  "routes",
]

// ── Lexer ───────────────────────────────────────────────────────────

// `@` lets absorbed names carry universe levels: `Eq@1`, `HAdd@0@0@0`.
local fn is_ident_char(c: String) -> Bool =
  c != "" and (string.is_alphanumeric(c) or c == "_" or c == "'" or c == "@")

local fn at(cs: List[String], i: Int) -> String = list.get(cs, i) ?? ""

// Canonical spelling of each punctuation token; Unicode forms are aliases.
local fn punct(cs: List[String], i: Int) -> (String, Int)? = {
  let c = at(cs, i)
  let c2 = c + at(cs, i + 1)
  match c2 {
    "->" => some(("->", 2)),
    "=>" => some(("=>", 2)),
    _ => match c {
      "(" | ")" | "{" | "}" | "[" | "]" | ":" | "," | "=" | "|" | "+" | "." | "?" => some((c, 1)),
      "→" => some(("->", 1)),
      "⇒" => some(("=>", 1)),
      _ => none,
    },
  }
}

// An identifier may contain dots (`logic.Prf`) between identifier characters.
local fn scan_ident(cs: List[String], i: Int) -> Int =
  if is_ident_char(at(cs, i)) then scan_ident(cs, i + 1)
  else if at(cs, i) == "." and is_ident_char(at(cs, i + 1)) then scan_ident(cs, i + 1)
  else i

// Copy element by element: `list.slice` clones the whole list per call on
// native (almide/almide#3397), which made lexing quadratic.
local fn text_between(cs: List[String], i: Int, j: Int) -> String = {
  var parts: List[String] = []
  var k = i
  while k < j {
    list.push(parts, at(cs, k))
    k = k + 1
  }
  list.join(parts, "")
}

fn lex(src: String) -> List[Token]! = {
  let cs = string.chars(src)
  let n = list.len(cs)
  var toks: List[Token] = []
  var i = 0
  var line = 1
  var failure = ""
  while i < n and failure == "" {
    let c = at(cs, i)
    if c == "\n" then {
      line = line + 1
      i = i + 1
    } else if string.is_whitespace(c) then {
      i = i + 1
    } else if c == "/" and at(cs, i + 1) == "/" then {
      while i < n and at(cs, i) != "\n" {
        i = i + 1
      }
    } else if is_ident_char(c) then {
      let j = scan_ident(cs, i)
      let text = text_between(cs, i, j)
      let kind = if list.contains(KEYWORDS, text) then "kw" else "ident"
      list.push(toks, Token { kind: kind, text: text, line: line })
      i = j
    } else {
      match punct(cs, i) {
        some((text, len)) => {
          list.push(toks, Token { kind: "sym", text: text, line: line })
          i = i + len
        },
        none => {
          failure = "${int.to_string(line)}: unexpected character '${c}'"
        },
      }
    }
  }
  guard failure == "" else err(failure)
  list.push(toks, Token { kind: "eof", text: "end of file", line: line })
  ok(toks)
}

// ── Parser ──────────────────────────────────────────────────────────

local fn tok(ts: List[Token], p: Int) -> Token =
  list.get(ts, p) ?? Token { kind: "eof", text: "end of file", line: 0 }

local fn is_sym(ts: List[Token], p: Int, s: String) -> Bool = {
  let t = tok(ts, p)
  t.kind == "sym" and t.text == s
}

// The head a `decreasing` clause wraps a body in; no written name can be it.
let WF_MARK = "%decreasing"

local fn is_word(ts: List[Token], p: Int, k: String) -> Bool = {
  let t = tok(ts, p)
  t.kind != "kw" and t.text == k
}

local fn is_kw(ts: List[Token], p: Int, k: String) -> Bool = {
  let t = tok(ts, p)
  t.kind == "kw" and t.text == k
}

local fn fail_at(ts: List[Token], p: Int, msg: String) -> String = {
  let t = tok(ts, p)
  "${int.to_string(t.line)}: ${msg}, found '${t.text}'"
}

local fn expect(ts: List[Token], p: Int, s: String) -> Int! =
  if is_sym(ts, p, s) then ok(p + 1) else err(fail_at(ts, p, "expected '${s}'"))

local fn ident(ts: List[Token], p: Int) -> (String, Int)! = {
  let t = tok(ts, p)
  if t.kind == "ident" then ok((t.text, p + 1)) else err(fail_at(ts, p, "expected a name"))
}

// One entry of a parenthesised list: a binder `x: A`, or a term.
type Item = | Binder(String, Raw) | Plain(Raw)

local fn item(ts: List[Token], p: Int) -> (Item, Int)! =
  if tok(ts, p).kind == "ident" and is_sym(ts, p + 1, ":") then {
    let (ty, p1) = term(ts, p + 2)!
    ok((Binder(tok(ts, p).text, ty), p1))
  } else {
    let (t, p1) = term(ts, p)!
    ok((Plain(t), p1))
  }

local fn items(ts: List[Token], p: Int, acc: List[Item]) -> (List[Item], Int)! = {
  let (it, p1) = item(ts, p)!
  let acc2 = acc + [it]
  if is_sym(ts, p1, ",") then items(ts, p1 + 1, acc2)
  else {
    let p2 = expect(ts, p1, ")")!
    ok((acc2, p2))
  }
}

local fn binders_of(ts: List[Token], p: Int, its: List[Item]) -> List[(String, Raw)]! = {
  let bs = its |> list.filter_map((it) => match it {
    Binder(x, ty) => some((x, ty)),
    Plain(_) => none,
  })
  guard list.len(bs) == list.len(its) else err(fail_at(ts, p, "a function's parameters need types, like (x: A)"))
  ok(bs)
}

local fn wrap_lams(bs: List[(String, Raw)], body: Raw) -> Raw =
  list.fold(list.reverse(bs), body, (acc, (x, ty)) => RLam(x, ty, acc))

local fn wrap_pis(bs: List[(String, Raw)], body: Raw) -> Raw =
  list.fold(list.reverse(bs), body, (acc, (x, ty)) => RPi(x, ty, acc))

// `(x: A, B) -> C`: binders are dependent, plain terms are not.
local fn wrap_pi_items(its: List[Item], body: Raw) -> Raw =
  list.fold(list.reverse(its), body, (acc, it) => match it {
    Binder(x, ty) => RPi(x, ty, acc),
    Plain(ty) => RPi("_", ty, acc),
  })

fn term(ts: List[Token], p: Int) -> (Raw, Int)! = {
  if is_sym(ts, p, "(") then {
    let (its, p1) = items(ts, p + 1, [])!
    if is_sym(ts, p1, "=>") then {
      let bs = binders_of(ts, p, its)!
      let (body, p2) = term(ts, p1 + 1)!
      ok((wrap_lams(bs, body), p2))
    } else if is_sym(ts, p1, "->") then {
      let (body, p2) = term(ts, p1 + 1)!
      ok((wrap_pi_items(its, body), p2))
    } else {
      // `[it]` then `match it`, not `[Plain(inner)]`: almide/almide#3400.
      let lone = match its {
        [it] => match it {
          Plain(inner) => some(inner),
          _ => none,
        },
        _ => none,
      }
      match lone {
        some(inner) => {
          let (t, p2) = calls(ts, p1, inner)!
          arrow(ts, p2, t)
        },
        none => err(fail_at(ts, p1, "a parenthesised list must be followed by '=>' or '->'")),
      }
    }
  } else {
    let (head, p1) = atom(ts, p)!
    let (t, p2) = calls(ts, p1, head)!
    arrow(ts, p2, t)
  }
}

local fn arrow(ts: List[Token], p: Int, lhs: Raw) -> (Raw, Int)! =
  if is_sym(ts, p, "+") then {
    // Only levels add: `u + 1`.
    let (head, p1) = atom(ts, p + 1)!
    let (rhs, p2) = calls(ts, p1, head)!
    arrow(ts, p2, RApp(RApp(RName("+"), lhs), rhs))
  } else if is_sym(ts, p, "->") then {
    let (rhs, p1) = term(ts, p + 1)!
    ok((RPi("_", lhs, rhs), p1))
  } else ok((lhs, p))

// f(a, b)(c).x: each argument list applies in turn, `.x` reads a field.
local fn calls(ts: List[Token], p: Int, f: Raw) -> (Raw, Int)! =
  if is_sym(ts, p, "(") then {
    let (args, p1) = args_list(ts, p + 1, [])!
    calls(ts, p1, list.fold(args, f, (acc, a) => RApp(acc, a)))
  } else if is_sym(ts, p, ".") then {
    let (x, p1) = ident(ts, p + 1)!
    // `.x.y` after a call lexes as `.` then the name `x.y`.
    calls(ts, p1, list.fold(string.split(x, "."), f, (acc, g) => RField(acc, g)))
  } else ok((f, p))

local fn args_list(ts: List[Token], p: Int, acc: List[Raw]) -> (List[Raw], Int)! = {
  let (a, p1) = term(ts, p)!
  let acc2 = acc + [a]
  if is_sym(ts, p1, ",") then args_list(ts, p1 + 1, acc2)
  else {
    let p2 = expect(ts, p1, ")")!
    ok((acc2, p2))
  }
}

// `C(a, b) => body`, `C => body` or `_ => body`, separated by commas.
local fn arms(ts: List[Token], p: Int, acc: List[Arm]) -> (List[Arm], Int)! =
  if is_sym(ts, p, "}") then ok((acc, p + 1))
  else {
    let (ctor, p1) = ident(ts, p)!
    let (subs, p2) = (if is_sym(ts, p1, "(") then arm_subs(ts, p1 + 1) else ok(([], p1)))!
    let p3 = expect(ts, p2, "=>")!
    let (body, p4) = term(ts, p3)!
    let acc2 = acc + [Arm { ctor: ctor, subs: subs, body: body }]
    if is_sym(ts, p4, ",") then arms(ts, p4 + 1, acc2)
    else {
      let p5 = expect(ts, p4, "}")!
      ok((acc2, p5))
    }
  }

// Patterns up to the closing `)`.
local fn arm_subs(ts: List[Token], p: Int) -> (List[Sub], Int)! = {
  var out: List[Sub] = []
  var q = p
  var going = true
  while going {
    let (s, q1) = arm_sub(ts, q)!
    list.push(out, s)
    if is_sym(ts, q1, ",") then {
      q = q1 + 1
    } else {
      q = expect(ts, q1, ")")!
      going = false
    }
  }
  ok((out, q))
}

local fn arm_sub(ts: List[Token], p: Int) -> (Sub, Int)! = {
  let (x, p1) = ident(ts, p)!
  if is_sym(ts, p1, "(") then {
    let (subs, p2) = arm_subs(ts, p1 + 1)!
    ok((SCon(x, subs), p2))
  } else ok((SName(x), p1))
}

local fn atom(ts: List[Token], p: Int) -> (Raw, Int)! = {
  let t = tok(ts, p)
  guard not is_kw(ts, p, "match") else {
    let (scrut, p1) = term(ts, p + 1)!
    let p2 = expect(ts, p1, "{")!
    let (as, p3) = arms(ts, p2, [])!
    ok((RMatch(scrut, as), p3))
  }
  // `by simp(l1, l2)`: rewriting, by elab (see simp.almd); `by induction x
  // simp(...)`: a match on x whose every case is that. The words are not
  // reserved.
  if t.kind == "ident" and t.text == "by" and tok(ts, p + 1).text == "simp" then ok((RName("%simp"), p + 2))
  else if t.kind == "ident" and t.text == "by" and tok(ts, p + 1).text == "induction" then {
    let (x, p1) = ident(ts, p + 2)!
    guard tok(ts, p1).text == "simp" else err(fail_at(ts, p1, "by induction ${x}: expected `simp` (by induction ${x} simp(...))"))
    let (s, p2) = calls(ts, p1 + 1, RName("%simp"))!
    ok((RApp(RApp(RName("%induction"), RName(x)), s), p2))
  }
  else if t.kind == "ident" then {
    // `Point { x: ...`: a record value (a match's arms never start `name:`).
    if is_sym(ts, p + 1, "{") and tok(ts, p + 2).kind == "ident" and is_sym(ts, p + 3, ":") then {
      let (fs, p1) = field_values(ts, p + 2, [])!
      ok((RRecord(t.text, fs), p1))
    } else if is_sym(ts, p + 1, "[") then {
      let (ls, p1) = level_list(ts, p + 2, [])!
      ok((RInst(t.text, ls), p1))
    } else ok((RName(t.text), p + 1))
  }
  else if is_sym(ts, p, "?") then ok((RName("?"), p + 1))
  else if is_sym(ts, p, "{") and is_kw(ts, p + 1, "let") then block(ts, p + 1)
  else if is_kw(ts, p, "Type") then ok((RType, p + 1))
  else if is_kw(ts, p, "Sort") then ok((RSort, p + 1))
  else if is_sym(ts, p, "{") then {
    let (inner, p1) = term(ts, p + 1)!
    let p2 = expect(ts, p1, "}")!
    ok((RBracket(inner), p2))
  } else err(fail_at(ts, p, "expected a term"))
}

// `[u, v + 1]`, after the opening bracket.
local fn level_list(ts: List[Token], p: Int, acc: List[Raw]) -> (List[Raw], Int)! = {
  let (l, p1) = term(ts, p)!
  let acc2 = acc + [l]
  if is_sym(ts, p1, ",") then level_list(ts, p1 + 1, acc2)
  else {
    let p2 = expect(ts, p1, "]")!
    ok((acc2, p2))
  }
}

// `[u, v, A: Type(u)]` after a declaration's name, Almide's generics: bare
// names are universe parameters, typed entries are implicit parameters.
local fn level_params(ts: List[Token], p: Int) -> (List[String], Int)! = {
  let (ls, imps, p1) = generics(ts, p)!
  guard list.is_empty(imps) else err(fail_at(ts, p, "only universe parameters are allowed here"))
  ok((ls, p1))
}

local fn generics(ts: List[Token], p: Int) -> (List[String], List[(String, Raw)], Int)! =
  if is_sym(ts, p, "[") then generic_items(ts, p + 1, [], []) else ok(([], [], p))

local fn generic_item(ts: List[Token], p: Int, p1: Int, x: String, ls: List[String], imps: List[(String, Raw)]) -> (List[String], List[(String, Raw)], Int)! =
  if is_sym(ts, p1, ":") then {
    let (ty, q) = term(ts, p1 + 1)!
    ok((ls, imps + [(x, ty)], q))
  } else if list.is_empty(imps) then ok((ls + [x], imps, p1))
  else err(fail_at(ts, p, "universe parameters come before implicit parameters"))

local fn generic_items(ts: List[Token], p: Int, ls: List[String], imps: List[(String, Raw)]) -> (List[String], List[(String, Raw)], Int)! = {
  let (x, p1) = ident(ts, p)!
  let (ls2, imps2, p2) = generic_item(ts, p, p1, x, ls, imps)!
  if is_sym(ts, p2, ",") then generic_items(ts, p2 + 1, ls2, imps2)
  else {
    let p3 = expect(ts, p2, "]")!
    ok((ls2, imps2, p3))
  }
}

// `where x: A, y: B` after a rule; absent means no variables.
local fn where_vars(ts: List[Token], p: Int) -> (List[(String, Raw)], Int)! =
  if is_kw(ts, p, "where") then where_list(ts, p + 1, []) else ok(([], p))

local fn where_list(ts: List[Token], p: Int, acc: List[(String, Raw)]) -> (List[(String, Raw)], Int)! = {
  let (x, p1) = ident(ts, p)!
  let p2 = expect(ts, p1, ":")!
  let (ty, p3) = term(ts, p2)!
  let acc2 = acc + [(x, ty)]
  if is_sym(ts, p3, ",") then where_list(ts, p3 + 1, acc2) else ok((acc2, p3))
}

local fn room_uses(ts: List[Token], p: Int, acc: List[String]) -> (List[String], Int)! = {
  let (r, p1) = ident(ts, p)!
  if is_sym(ts, p1, ",") then room_uses(ts, p1 + 1, acc + [r]) else ok((acc + [r], p1))
}

// `name[u](x: A, ...) -> T` or `name[u]: T`: the universe parameters, the
// declared type with the parameters bound around it, and the parameters.
// `params` are the implicit ones and then the explicit ones: a body binds both.
type Signature = { sig: Sig, params: List[(String, Raw)] }

local fn signature(ts: List[Token], p: Int) -> (Signature, Int)! = {
  let (name, p0) = ident(ts, p)!
  let (levels, imps, p1) = generics(ts, p0)!
  if is_sym(ts, p1, "(") then {
    let (its, p2) = items(ts, p1 + 1, [])!
    let params = imps + binders_of(ts, p1, its)!
    let p3 = expect(ts, p2, "->")!
    let (ret, p4) = term(ts, p3)!
    let sig = Sig { name: name, levels: levels, implicits: list.len(imps), ty: wrap_pis(params, ret) }
    ok((Signature { sig: sig, params: params }, p4))
  } else {
    let p2 = expect(ts, p1, ":")!
    let (ty, p3) = term(ts, p2)!
    let sig = Sig { name: name, levels: levels, implicits: list.len(imps), ty: wrap_pis(imps, ty) }
    ok((Signature { sig: sig, params: imps }, p3))
  }
}

let DECL_HINT = "expected a declaration (room, type, symbol, def, theorem, rule, irrelevant, view, translate, check, eval, axioms)"

// `x: A, y: B }` (after the brace).
local fn field_list(ts: List[Token], p: Int, acc: List[(String, Raw)]) -> (List[(String, Raw)], Int)! =
  if is_sym(ts, p, "}") then ok((acc, p + 1))
  else {
    let (f, p1) = ident(ts, p)!
    let p2 = expect(ts, p1, ":")!
    let (ty, p3) = term(ts, p2)!
    let acc2 = acc + [(f, ty)]
    if is_sym(ts, p3, ",") then field_list(ts, p3 + 1, acc2)
    else {
      let p4 = expect(ts, p3, "}")!
      ok((acc2, p4))
    }
  }

// `x: a, y: b }`: a record value's fields.
// `search`, or `search(lemma, ..., depth: n)`.
local fn search_spec(ts: List[Token], p: Int) -> (List[String], Int, Int)! = {
  var names: List[String] = []
  var depth = 6
  var q = p
  if is_sym(ts, q, "(") then {
    q = q + 1
    var going = not is_sym(ts, q, ")")
    if not going then {
      q = q + 1
    } else ()
    while going {
      let (x, q1) = ident(ts, q)!
      if x == "depth" and is_sym(ts, q1, ":") then {
        let (n, q2) = ident(ts, q1 + 1)!
        depth = match int.parse(n) {
          ok(v) => v,
          err(_) => -1,
        }
        guard depth >= 0 else err(fail_at(ts, q1 + 1, "depth: expects a number"))
        q = q2
      } else {
        list.push(names, x)
        q = q1
      }
      if is_sym(ts, q, ",") then {
        q = q + 1
      } else {
        q = expect(ts, q, ")")!
        going = false
      }
    }
  } else ()
  ok((names, depth, q))
}

// `{ let h: A = e  ...  result }`: Almide's block, for the steps of a
// proof. Each `let` names a fact for what follows, opaquely, like Isar's
// `have`: the block is `((h: A) => result)(e)`. The type may be left out.
local fn block(ts: List[Token], p: Int) -> (Raw, Int)! = {
  var binds: List[(String, Raw, Raw)] = []
  var q = p
  while is_kw(ts, q, "let") {
    let (x, q1) = ident(ts, q + 1)!
    let (ty, q2) = (if is_sym(ts, q1, ":") then term(ts, q1 + 1) else ok((RName("_"), q1)))!
    let q3 = expect(ts, q2, "=")!
    let (e, q4) = term(ts, q3)!
    list.push(binds, (x, ty, e))
    q = q4
  }
  let (body, q5) = term(ts, q)!
  let q6 = expect(ts, q5, "}")!
  ok((list.fold(list.reverse(binds), body, (acc, (x, ty, e)) => RApp(RLam(x, ty, acc), e)), q6))
}

// `sym = term, ...` up to `}` (a trailing comma is fine).
local fn view_entries(ts: List[Token], p: Int) -> (List[(String, Raw)], Int)! = {
  var out: List[(String, Raw)] = []
  var q = p
  var failure = ""
  var going = true
  while going and failure == "" {
    if is_sym(ts, q, "}") then {
      q = q + 1
      going = false
    } else match ident(ts, q) {
      err(e) => {
        failure = e
      },
      ok((x, q1)) => match expect(ts, q1, "=") {
        err(e) => {
          failure = e
        },
        ok(q2) => match term(ts, q2) {
          err(e) => {
            failure = e
          },
          ok((v, q3)) => {
            list.push(out, (x, v))
            q = if is_sym(ts, q3, ",") then q3 + 1 else q3
            if not is_sym(ts, q, "}") and not is_sym(ts, q3, ",") then {
              failure = fail_at(ts, q, "expected `,` or `}` after a view entry")
            } else ()
          },
        },
      },
    }
  }
  guard failure == "" else err(failure)
  ok((out, q))
}

local fn field_values(ts: List[Token], p: Int, acc: List[(String, Raw)]) -> (List[(String, Raw)], Int)! =
  if is_sym(ts, p, "}") then ok((acc, p + 1))
  else {
    let (f, p1) = ident(ts, p)!
    let p2 = expect(ts, p1, ":")!
    let (v, p3) = term(ts, p2)!
    let acc2 = acc + [(f, v)]
    if is_sym(ts, p3, ",") then field_values(ts, p3 + 1, acc2)
    else {
      let p4 = expect(ts, p3, "}")!
      ok((acc2, p4))
    }
  }

// `(x: A, y: B)` if present.
local fn opt_binders(ts: List[Token], p: Int) -> (List[(String, Raw)], Int)! =
  if is_sym(ts, p, "(") then {
    let (its, q) = items(ts, p + 1, [])!
    ok((binders_of(ts, p, its)!, q))
  } else ok(([], p))

// `: T` if present.
local fn opt_result(ts: List[Token], p: Int) -> (Raw?, Int)! =
  if is_sym(ts, p, ":") then {
    let (r, q) = term(ts, p + 1)!
    ok((some(r), q))
  } else ok((none, p))

// `| name`, `| name(x: A, ...)`, either optionally followed by `: Result`.
local fn constructors(ts: List[Token], p: Int, acc: List[Constructor]) -> (List[Constructor], Int)! =
  if not is_sym(ts, p, "|") then ok((acc, p))
  else {
    let (name, p1) = ident(ts, p + 1)!
    let (args, p2) = opt_binders(ts, p1)!
    let (result, p3) = opt_result(ts, p2)!
    constructors(ts, p3, acc + [Constructor { name: name, args: args, result: result }])
  }

local fn decl(ts: List[Token], p: Int) -> (Decl, Int)! = {
  let t = tok(ts, p)
  guard t.kind == "kw" else err(fail_at(ts, p, DECL_HINT))
  match t.text {
    "room" => {
      let (name, p1) = ident(ts, p + 1)!
      if is_kw(ts, p1, "uses") then {
        let (rs, p2) = room_uses(ts, p1 + 1, [])!
        ok((DRoom(name, rs), p2))
      } else ok((DRoom(name, []), p1))
    },
    "type" => {
      let (name, p0) = ident(ts, p + 1)!
      let (levels, p1) = level_params(ts, p0)!
      let (params, p2) = opt_binders(ts, p1)!
      // `: Type` may be left out.
      let (arity, p4) = (if is_sym(ts, p2, ":") then term(ts, p2 + 1) else ok((RType, p2)))!
      let p5 = expect(ts, p4, "=")!
      if is_sym(ts, p5, "{") then {
        let (fields, p6) = field_list(ts, p5 + 1, [])!
        let ctor = Constructor { name: "mk", args: fields, result: none }
        ok((DInductive(Inductive { name: name, levels: levels, params: params, arity: arity, ctors: [ctor], fields: fields |> list.map(((f, _)) => f) }), p6))
      } else {
        let (ctors, p6) = constructors(ts, p5, [])!
        ok((DInductive(Inductive { name: name, levels: levels, params: params, arity: arity, ctors: ctors, fields: [] }), p6))
      }
    },
    "symbol" => {
      let (sg, p1) = signature(ts, p + 1)!
      ok((DSymbol(sg.sig), p1))
    },
    "def" | "theorem" => {
      let (sg, p0) = signature(ts, p + 1)!
      // `decreasing x by W`: well-founded recursion on the parameter x,
      // W proving its type's relation well-founded (checker.add_wf_def).
      // The words are not reserved; the clause marks the body.
      let (dec, p1) = (if is_word(ts, p0, "decreasing") then {
        let (x, q1) = ident(ts, p0 + 1)!
        guard is_word(ts, q1, "by") else err(fail_at(ts, q1, "decreasing ${x} by W: expected `by`"))
        let (w, q2) = term(ts, q1 + 1)!
        ok((some((x, w)), q2))
      } else ok((none, p0)))!
      let p2 = expect(ts, p1, "=")!
      guard not is_kw(ts, p2, "search") else {
        let (names, depth, p3) = search_spec(ts, p2 + 1)!
        ok((DSearch(sg.sig, t.text, names, depth), p3))
      }
      let (body0, p3) = term(ts, p2)!
      let body = match dec {
        some((x, w)) => RApp(RApp(RApp(RName(WF_MARK), RName(x)), w), body0),
        none => body0,
      }
      let value = wrap_lams(sg.params, body)
      if t.text == "def" then ok((DDef(sg.sig, value), p3)) else ok((DTheorem(sg.sig, value), p3))
    },
    "rule" => {
      let (lhs, p1) = term(ts, p + 1)!
      let p2 = expect(ts, p1, "=")!
      let (rhs, p3) = term(ts, p2)!
      let (vars, p4) = where_vars(ts, p3)!
      ok((DRule(vars, lhs, rhs), p4))
    },
    "structure" => {
      let (ty, p1) = ident(ts, p + 1)!
      let p2 = expect(ts, p1, "=")!
      let (mk, p3) = ident(ts, p2)!
      var q = expect(ts, p3, "(")!
      var projs: List[String] = []
      var going = true
      while going {
        let (f, q1) = ident(ts, q)!
        list.push(projs, f)
        if is_sym(ts, q1, ",") then {
          q = q1 + 1
        } else {
          q = expect(ts, q1, ")")!
          going = false
        }
      }
      ok((DStructure(ty, mk, projs), q))
    },
    "irrelevant" => {
      let (ty, p1) = term(ts, p + 1)!
      let (vars, p2) = where_vars(ts, p1)!
      ok((DIrrelevant(vars, ty), p2))
    },
    "check" => {
      let (e, p1) = term(ts, p + 1)!
      ok((DCheck(e), p1))
    },
    "eval" => {
      let (e, p1) = term(ts, p + 1)!
      ok((DEval(e), p1))
    },
    "axioms" => {
      let (name, p1) = ident(ts, p + 1)!
      ok((DAxioms(name), p1))
    },
    "view" => {
      let (name, p1) = ident(ts, p + 1)!
      guard tok(ts, p1).text == "from" else err(fail_at(ts, p1, "expected `from` and the room the view reads: view V from S { ... }"))
      let (src, p2) = ident(ts, p1 + 1)!
      guard tok(ts, p2).text != "via" else {
        var names: List[String] = []
        var q = p2 + 1
        var going = true
        while going {
          let (x, q1) = ident(ts, q)!
          list.push(names, x)
          if is_sym(ts, q1, ",") then {
            q = q1 + 1
          } else {
            q = q1
            going = false
          }
        }
        ok((DViewVia(name, src, names), q))
      }
      let p3 = expect(ts, p2, "{")!
      let (entries, p4) = view_entries(ts, p3)!
      ok((DView(name, src, entries), p4))
    },
    "views" => ok((DViews, p + 1)),
    "routes" => {
      guard tok(ts, p + 1).text == "from" else err(fail_at(ts, p + 1, "expected `from`: routes from S"))
      let (src, p1) = ident(ts, p + 2)!
      ok((DRoutes(src), p1))
    },
    "translate" => {
      let (v, p1) = ident(ts, p + 1)!
      let (name, p2) = ident(ts, p1)!
      ok((DTranslate(v, name), p2))
    },
    _ => err(fail_at(ts, p, DECL_HINT)),
  }
}

fn parse(src: String) -> List[Located]! = {
  let ts = lex(src)!
  ok(group_mutual_defs(group_mutual(decls(ts, 0, [])!)))
}

// Consecutive `type` declarations where one refers to a later one form a
// mutual group (everything from the first to the last one it reaches).
fn group_mutual(ds: List[Located]) -> List[Located] = {
  var out: List[Located] = []
  var i = 0
  let n = list.len(ds)
  while i < n {
    let d = list.get(ds, i) ?? Located { line: 0, decl: DViews }
    // How far the run of types starting here reaches by forward references.
    var j = i
    var end = i
    while j <= end and j < n {
      match ind_at(ds, j) {
        some(ind) => {
          let refs = mutual_refs(ind)
          var k = j + 1
          while k < n {
            match ind_at(ds, k) {
              some(other) => if list.contains(refs, other.name) and k > end then {
                end = k
              } else (),
              none => {
                k = n
              },
            }
            k = k + 1
          }
        },
        none => (),
      }
      j = j + 1
    }
    if end > i then {
      var group: List[Inductive] = []
      var m = i
      while m <= end {
        match ind_at(ds, m) {
          some(ind) => list.push(group, ind),
          none => (),
        }
        m = m + 1
      }
      list.push(out, Located { line: d.line, decl: DMutual(group) })
      i = end + 1
    } else {
      list.push(out, d)
      i = i + 1
    }
  }
  out
}

// The same for definitions and theorems: a group from the first to the
// last one reached by forward references.
fn group_mutual_defs(ds: List[Located]) -> List[Located] = {
  let n = list.len(ds)
  // Each definition's name and the names it mentions, computed once, and
  // where each name is defined: a library has tens of thousands of
  // definitions, so nothing here may look at every pair.
  var names: List[String] = []
  var refs: List[List[String]] = []
  var at: Map[String, List[Int]] = [:]
  for (i, l) in list.enumerate(ds) {
    match def_at(ds, i) {
      some((name, rs)) => {
        list.push(names, name)
        list.push(refs, list.unique(rs))
        map.insert(at, name, (map.get(at, name) ?? []) + [i])
      },
      none => {
        list.push(names, "")
        list.push(refs, [])
      },
    }
  }
  // The end of the run of consecutive definitions each one is in.
  var run_end: List[Int] = []
  var pending = 0
  for (k, nm) in list.enumerate(names) {
    if nm == "" then {
      for _ in 0..<pending {
        list.push(run_end, k - 1)
      }
      pending = 0
      list.push(run_end, k)
    } else {
      pending = pending + 1
    }
  }
  for _ in 0..<pending {
    list.push(run_end, n - 1)
  }
  var out: List[Located] = []
  var i = 0
  while i < n {
    let d = list.get(ds, i) ?? Located { line: 0, decl: DViews }
    var j = i
    var end = i
    let limit = list.get(run_end, i) ?? i
    while j <= end and j < n and (list.get(names, j) ?? "") != "" {
      for r in list.get(refs, j) ?? [] {
        for idx in map.get(at, r) ?? [] {
          if idx > end and idx <= limit then {
            end = idx
          } else ()
        }
      }
      j = j + 1
    }
    if end > i then {
      var group: List[Decl] = []
      var m = i
      while m <= end {
        match list.get(ds, m) {
          some(l) => list.push(group, l.decl),
          none => (),
        }
        m = m + 1
      }
      list.push(out, Located { line: d.line, decl: DMutualDefs(group) })
      i = end + 1
    } else {
      list.push(out, d)
      i = i + 1
    }
  }
  out
}

local fn def_at(ds: List[Located], i: Int) -> Option[(String, List[String])] = match list.get(ds, i) {
  some(l) => match l.decl {
    DDef(sig, body) => some((sig.name, free_names(sig.ty, []) + free_names(body, []))),
    DTheorem(sig, body) => some((sig.name, free_names(sig.ty, []) + free_names(body, []))),
    _ => none,
  },
  none => none,
}

// The names a term mentions that it does not bind itself (binders,
// pattern variables): what may refer to other declarations.
local fn free_names(r: Raw, bound: List[String]) -> List[String] = match r {
  RName(x) => if list.contains(bound, x) then [] else [x],
  RInst(x, _) => if list.contains(bound, x) then [] else [x],
  RApp(f, a) => free_names(f, bound) + free_names(a, bound),
  RLam(x, ty, b) => free_names(ty, bound) + free_names(b, [x] + bound),
  RPi(x, ty, b) => free_names(ty, bound) + free_names(b, [x] + bound),
  RBracket(b) => free_names(b, bound),
  RMatch(sc, arms) => free_names(sc, bound) + (arms |> list.flat_map((a) => free_names(a.body, (a.subs |> list.flat_map((t) => sub_vars(t))) + bound))),
  _ => [],
}

local fn sub_vars(s: Sub) -> List[String] = match s {
  SName(x) => [x],
  SCon(_, ss) => ss |> list.flat_map((t) => sub_vars(t)),
}

local fn ind_at(ds: List[Located], i: Int) -> Option[Inductive] = match list.get(ds, i) {
  some(l) => match l.decl {
    DInductive(ind) => some(ind),
    _ => none,
  },
  none => none,
}

local fn raw_names(r: Raw) -> List[String] = match r {
  RName(x) => [x],
  RInst(x, _) => [x],
  RApp(f, a) => raw_names(f) + raw_names(a),
  RLam(_, ty, b) => raw_names(ty) + raw_names(b),
  RPi(_, ty, b) => raw_names(ty) + raw_names(b),
  RBracket(b) => raw_names(b),
  _ => [],
}

local fn mutual_refs(ind: Inductive) -> List[String] = {
  let ps = ind.params |> list.map(((x, _)) => x)
  (ind.params |> list.flat_map(((_, t)) => free_names(t, ps))) + free_names(ind.arity, ps)
    + (ind.ctors |> list.flat_map((c) => {
      let bound = ps + (c.args |> list.map(((x, _)) => x))
      (c.args |> list.flat_map(((_, t)) => free_names(t, bound))) + match c.result {
        some(r) => free_names(r, bound),
        none => [],
      }
    }))
}

local fn decls(ts: List[Token], p: Int, acc: List[Located]) -> List[Located]! = {
  // A loop with push, not recursion with `acc + [d]`: absorbed files hold
  // thousands of declarations.
  var out = acc
  var q = p
  var failure = ""
  while failure == "" and tok(ts, q).kind != "eof" {
    let line = tok(ts, q).line
    match decl(ts, q) {
      ok((d, p1)) => {
        list.push(out, Located { line: line, decl: d })
        q = p1
      },
      err(e) => {
        failure = e
      },
    }
  }
  guard failure == "" else err(failure)
  ok(out)
}

local fn first_decl(src: String) -> Decl = match parse(src) {
  ok(ds) => (list.first(ds) ?? Located { line: 0, decl: DCheck(RType) }).decl,
  err(e) => DCheck(RName("parse error: " + e)),
}

test "the lexer keeps qualified names whole" {
  let ts = lex("symbol x: logic.Prop")!
  assert_eq(ts |> list.map((t) => t.text), ["symbol", "x", ":", "logic.Prop", "end of file"])
}

test "comments are skipped" {
  let ts = lex("a -> b // trailing comment\nc")!
  assert_eq(ts |> list.map((t) => t.text), ["a", "->", "b", "c", "end of file"])
}

test "calls apply each argument in turn" {
  assert_eq(first_decl("check f(a, b)(c)"), DCheck(RApp(RApp(RApp(RName("f"), RName("a")), RName("b")), RName("c"))))
}

test "arrows associate to the right and bind looser than calls" {
  assert_eq(first_decl("symbol f: A(B) -> C -> D"), DSymbol(Sig { name: "f", levels: [], implicits: 0, ty: RPi("_", RApp(RName("A"), RName("B")), RPi("_", RName("C"), RName("D"))) }))
}

test "a parameter list makes a function type or a function" {
  assert_eq(first_decl("check (x: A, B) -> C"), DCheck(RPi("x", RName("A"), RPi("_", RName("B"), RName("C")))))
  assert_eq(first_decl("check (x: A, y: B) => x"), DCheck(RLam("x", RName("A"), RLam("y", RName("B"), RName("x")))))
}

test "a declaration with parameters binds them in its type and its body" {
  let d = first_decl("def id(a: A) -> A = a")
  assert_eq(d, DDef(Sig { name: "id", levels: [], implicits: 0, ty: RPi("a", RName("A"), RName("A")) }, RLam("a", RName("A"), RName("a"))))
}

test "rules take their variables from a where clause" {
  let d = first_decl("rule El({ls(l)}, sort(l)) = Univ@1(l) where l: Lvl")
  let lhs = RApp(RApp(RName("El"), RBracket(RApp(RName("ls"), RName("l")))), RApp(RName("sort"), RName("l")))
  assert_eq(d, DRule([("l", RName("Lvl"))], lhs, RApp(RName("Univ@1"), RName("l"))))
}

test "declarations need no terminator" {
  match parse("symbol A: Type\nsymbol a: A\ncheck a") {
    ok(ds) => assert_eq(list.len(ds), 3),
    err(e) => assert_eq(e, ""),
  }
}

test "inductive types: parameters, indices, constructors with and without results" {
  match first_decl("type Vec[u](A: Type(u)): (n: Nat) -> Type(u) =\n  | nil: Vec[u](A, zero)\n  | cons(n: Nat, x: A, xs: Vec[u](A, n)): Vec[u](A, succ(n))") {
    DInductive(ind) => {
      assert_eq(ind.name, "Vec")
      assert_eq(ind.levels, ["u"])
      assert_eq(list.len(ind.params), 1)
      assert_eq(ind.ctors |> list.map((c) => c.name), ["nil", "cons"])
      assert_eq(list.len((list.get(ind.ctors, 1) ?? Constructor { name: "", args: [], result: none }).args), 3)
    },
    _ => assert(false),
  }
  match first_decl("type Nat: Type = | zero | succ(n: Nat)") {
    DInductive(ind) => assert_eq(ind.ctors |> list.map((c) => c.result == none), [true, true]),
    _ => assert(false),
  }
}

test "match: Almide's syntax, arms with and without bound names" {
  match first_decl("def f(n: Nat) -> Nat = match n {\n  Nat.zero => n,\n  Nat.succ(k) => k,\n  _ => n,\n}") {
    DDef(_, body) => match body {
      RLam(_, _, RMatch(RName(x), as)) => {
        assert_eq(x, "n")
        assert_eq(as |> list.map((a) => a.ctor), ["Nat.zero", "Nat.succ", "_"])
        assert_eq(as |> list.map((a) => list.len(a.subs)), [0, 1, 0])
      },
      _ => assert(false),
    },
    _ => assert(false),
  }
}

test "records: fields, values, and type annotations that can be left out" {
  match first_decl("type Point = { x: Nat, y: Nat }") {
    DInductive(ind) => {
      assert_eq(ind.fields, ["x", "y"])
      assert_eq(ind.arity, RType)
      assert_eq(ind.ctors |> list.map((c) => c.name), ["mk"])
    },
    _ => assert(false),
  }
  assert_eq(first_decl("check Point { y: b, x: a }"), DCheck(RRecord("Point", [("y", RName("b")), ("x", RName("a"))])))
}
