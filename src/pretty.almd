// Printing kernel terms back into Arlk surface syntax.

import self.term.{Term, Level, spine, occurs, level_simp}

// `room` is the room the reader is in: its own names print unqualified.
fn show(room: String, names: List[String], t: Term) -> String = pp(room, names, t, 0)

local fn fresh(names: List[String], x: String) -> String = {
  let base = if x == "_" then "x" else x
  if list.contains(names, base) then fresh(names, base + "'") else base
}

local fn paren(cond: Bool, s: String) -> String = if cond then "(" + s + ")" else s

local fn short(room: String, c: String) -> String = match literal_digits(c) {
  some(d) => d,
  none => string.strip_prefix(c, room + ".") ?? c,
}

// A numeral literal `T#n` prints as n.
local fn literal_digits(c: String) -> String? = {
  let parts = string.split(c, "#")
  let last = list.last(parts) ?? ""
  if list.len(parts) >= 2 and last != "" and list.all(string.chars(last), (d) => string.is_digit(d)) then some(last) else none
}

// prec 0: anywhere; 1: a callee or the left of an arrow, where a function
// or a function type needs parentheses.
local fn pp(room: String, names: List[String], t: Term, prec: Int) -> String = match t {
  Sort(l) => sort_text(level_simp(l)),
  Var(i) => list.get(names, i) ?? "#${int.to_string(i)}",
  Const(c, ls) => if list.is_empty(ls) then short(room, c) else short(room, c) + "[" + list.join(ls |> list.map((l) => level(l)), ", ") + "]",
  App(_, _) => {
    let (h, args) = spine(t)
    let parts = args |> list.map((a) => pp(room, names, a, 0))
    pp(room, names, h, 1) + "(" + list.join(parts, ", ") + ")"
  },
  Lam(_, _, _) => paren(prec > 0, lambdas(room, names, t, [])),
  Pi(_, _, _) => paren(prec > 0, pis(room, names, t, [], false)),
  Meta(n) => "?" + int.to_string(n),
}

// Sort(1) is `Type`, Sort(u + 1) is `Type(u)`.
local fn sort_text(l: Level) -> String = match l {
  LSucc(LZero) => "Type",
  LSucc(u) => "Type(" + level(u) + ")",
  _ => "Sort(" + level(l) + ")",
}

// `3`, `u`, `u + 2`, `max(u, v)`, `imax(u, v)`.
fn level(l: Level) -> String = {
  let (base, k) = offset(l, 0)
  match base {
    LZero => int.to_string(k),
    _ => {
      let b = match base {
        LParam(p) => p,
        LMax(a, c) => "max(" + level(a) + ", " + level(c) + ")",
        LIMax(a, c) => "imax(" + level(a) + ", " + level(c) + ")",
        LMeta(n) => "?u" + int.to_string(n),
        _ => "?",
      }
      if k == 0 then b else b + " + " + int.to_string(k)
    },
  }
}

local fn offset(l: Level, k: Int) -> (Level, Int) = match l {
  LSucc(a) => offset(a, k + 1),
  other => (other, k),
}

// (x: A, y: B) => body
local fn lambdas(room: String, names: List[String], t: Term, params: List[String]) -> String = match t {
  Lam(x, ty, b) => {
    let y = fresh(names, x)
    lambdas(room, [y] + names, b, params + ["${y}: ${pp(room, names, ty, 0)}"])
  },
  _ => "(" + list.join(params, ", ") + ") => " + pp(room, names, t, 0),
}

// (x: A, B) -> C, or A -> C for one plain argument. `named` records whether
// any entry is a binder, which forces the parenthesised form.
local fn pis(room: String, names: List[String], t: Term, items: List[String], named: Bool) -> String = match t {
  Pi(x, ty, b) =>
    if x == "_" and not occurs(b, 0) then pis(room, ["_"] + names, b, items + [pp(room, names, ty, 1)], named)
    else {
      let y = fresh(names, x)
      pis(room, [y] + names, b, items + ["${y}: ${pp(room, names, ty, 0)}"], true)
    },
  _ => {
    let body = pp(room, names, t, 0)
    match items {
      [one] => if named then "(" + one + ") -> " + body else one + " -> " + body,
      _ => "(" + list.join(items, ", ") + ") -> " + body,
    }
  },
}

test "calls print with parentheses and commas" {
  let t = App(App(Const("r.f", []), Var(0)), App(Const("r.g", []), Const("r.a", [])))
  assert_eq(show("r", ["x"], t), "f(x, g(a))")
}

test "a plain argument prints as an arrow, several as a list" {
  assert_eq(show("r", ["x"], Pi("_", App(Const("r.P", []), Var(0)), Const("r.C", []))), "P(x) -> C")
  assert_eq(show("r", [], Pi("_", Const("r.A", []), Pi("_", Const("r.B", []), Const("r.C", [])))), "(A, B) -> C")
  assert_eq(show("r", [], Pi("_", Pi("_", Const("r.A", []), Const("r.B", [])), Const("r.C", []))), "(A -> B) -> C")
}

test "dependent binders keep their names and foreign rooms stay qualified" {
  let t = Pi("n", Const("nat.Nat", []), App(Const("logic.Prf", []), Var(0)))
  assert_eq(show("nat", [], t), "(n: Nat) -> logic.Prf(n)")
}

test "functions print as Almide lambdas, shadowed names are freshened" {
  assert_eq(show("r", ["x"], Lam("x", Const("r.A", []), Lam("y", Const("r.B", []), Var(2)))), "(x': A, y: B) => x")
}

test "universes print as Type and Sort" {
  assert_eq(show("r", [], Sort(LSucc(LZero))), "Type")
  assert_eq(show("r", [], Sort(LZero)), "Sort(0)")
  assert_eq(show("r", [], Sort(LSucc(LSucc(LParam("u"))))), "Type(u + 1)")
  assert_eq(show("r", [], Const("r.id", [LMax(LParam("u"), LSucc(LZero))])), "id[max(u, 1)]")
}
