// The Arlk kernel: λΠ-calculus modulo rewriting, organised into rooms.
//
// Everything a proof may rely on is either
//   - a symbol   (an assumption, opaque),
//   - a rule     (a trusted rewrite attached to a symbol of the same room),
//   - a def      (transparent, unfolds during conversion), or
//   - a theorem  (checked like a def, but opaque afterwards).
// Rooms are sealed once left: no later room can add symbols or rules to
// them, so a room's assumptions are fixed by its own text.

import self.term.{Term, Level, shift, instantiate, subst, spine, apply, occurs, consts, level_eq, levels_eq, level_leq, inst_levels, type0, level_of_nat, level_has_meta, alpha_eq}
import self.pretty
import self.syntax.{Raw}

// `height` is the declaration's position in the file: a def can only
// mention earlier names, so unfolding the higher one first is the
// cheapest way to make two terms meet.
//
// Entries hold only small fields: Almide copies a value on every lookup,
// so types and bodies live in their own maps and are fetched only when
// they are needed.
type Entry = { room: String, kind: String, height: Int }

// A rule's left-hand side, below its head symbol.
//   PVar(k)      binds rule variable k (Var(k) in the rule's context)
//   PSym(c, ps)  a symbol applied to patterns
//   PBracket(t)  `{t}`: not matched structurally; once every variable is
//                bound, the argument must be convertible to t
type Pat =
  | PVar(Int)
  | PSym(String, List[Pat])
  | PBracket(Term)

type Rule = {
  id: String,
  head: String,
  room: String,
  arity: Int,
  nvars: Int,
  var_tys: List[Term],
  lhs_args: List[Pat],
  rhs: Term,
  text: String,
  // The universe parameters the left-hand side's head is matched at: a
  // rule on `Nat.rec[u]` holds for every u.
  lparams: List[String],
}

// What rewriting needs of a rule, and nothing else.
type Rw = { arity: Int, nvars: Int, lhs_args: List[Pat], rhs: Term, lparams: List[String] }

type Env = {
  entries: Map[String, Entry],
  types: Map[String, Term],
  // bodies of defs and theorems
  bodies: Map[String, Term],
  // def name → height; only defs unfold
  defs: Map[String, Int],
  rws: Map[String, List[Rw]],
  // every rule in declaration order, for reports
  rules: List[Rule],
  // `irrelevant` declarations, stored as rules without a right-hand side
  irrelevants: List[Rule],
  // room → every room it can see, transitively
  rooms: Map[String, List[String]],
  // universe parameters of each constant that has any
  lparams: Map[String, List[String]],
  // how many leading parameters of a constant are implicit (inferred by
  // the elaborator); only constants that have some are listed
  implicits: Map[String, Int],
  // inductive types: their number of parameters, indices and constructors
  inductives: Map[String, IndInfo],
  // declared structures (`structure S = S.mk(S.f1, ...)`), by constructor:
  // every value of S is S.mk of its projections (Lean's structure eta)
  structs: Map[String, StructEta],
  // views (`view V from S`), by their full name
  views: Map[String, View],
  // numerals (`numerals zero, succ`), by zero: its succ and their type.
  // The literal `n` is the constant `zero#n`, which stands for succ
  // applied n times to zero (see `numeral`).
  numerals: Map[String, (String, Term)],
  // operations computed on literals (`numerals zero computes { add: f }`),
  // by constant: declared assumptions that f agrees with the operation
  computes: Map[String, Compute],
  room: String,
  order: List[String],
}

// A view of room `source` in the room it was declared in: the term each of
// the source's symbols stands for (`images`), the name each declaration
// carried along it got there (`renamed`), and images given for symbols of
// rooms built on the source, used when a translation reaches them
// (`pending`, still to be checked against their translated types).
// `name`, `target` (the declaring room), what was mapped and what carried
// as assumptions, and the views it was composed of are kept for `views`
// and `routes`.
type View = {
  source: String,
  images: Map[String, Term],
  renamed: Map[String, String],
  pending: Map[String, Raw],
  name: String,
  target: String,
  mapped: List[String],
  carried: List[String],
  via: List[String],
}

// `nested`: the occurrences of a nested type inside other types
// (`List(Rose)`), in the context of its parameters; recursor `T.rec_k`
// eliminates the k-th.
// A structure declared for eta: its type former, how many parameters the
// constructor takes before the fields, the projections in field order, and
// the declaration as listed by `axioms`.
type StructEta = { ty: String, nparams: Int, projs: List[String], decl: Rule }

// An operation computed on the literals of `zero`: `op` names it (add,
// sub, mul, div, mod, gcd, pow, shiftLeft, shiftRight, beq, ble); a test
// (beq, ble) answers with the constants `yes` or `no`.
type Compute = { zero: String, op: String, yes: String, no: String }

type IndInfo = { params: Int, indices: Int, ctors: List[String], fields: List[String], nested: List[Term] }

// A typing context: innermost binder first.
type Ctx = List[(String, Term)]

fn empty() -> Env = Env {
  entries: [:],
  types: [:],
  bodies: [:],
  defs: [:],
  rws: [:],
  rules: [],
  irrelevants: [],
  rooms: ["main": []],
  lparams: [:],
  implicits: [:],
  inductives: [:],
  structs: [:],
  views: [:],
  numerals: [:],
  computes: [:],
  room: "main",
  order: [],
}

// ── Numerals ────────────────────────────────────────────────────────
//
// `zero#n` is the literal n of the numerals built from zero: an abbreviation for
// succ(succ(... zero)), n times, unfolded one succ at a time when a rule
// or a comparison needs to see it (`numeral_step`). Two literals of the
// same type are compared by their numbers. So a literal costs O(1) to
// write, whatever its size, and adds no assumption: it is a definition,
// expanded lazily.

// The zero and number of a literal constant.
fn numeral(env: Env, c: String) -> (String, Int)? = match string.last_index_of(c, "#") {
  some(i) => {
    let zero = string.take(c, i)
    let digits = string.drop(c, i + 1)
    if map.contains(env.numerals, zero) and digits != "" and list.all(string.chars(digits), (d) => string.is_digit(d)) then match int.parse(digits) {
      ok(n) => some((zero, n)),
      err(_) => none,
    } else none
  },
  none => none,
}

// A literal's type: its zero's.
fn numeral_type(env: Env, zero: String) -> Term = match map.get(env.numerals, zero) {
  some((_, ty)) => ty,
  none => Sort(LZero),
}

// succ applied k times to zero (or to a literal), written back as one
// literal, everywhere in t: for printing normal forms.
fn fold_numerals(env: Env, t: Term) -> Term = match t {
  App(f, a) => {
    let folded = App(fold_numerals(env, f), fold_numerals(env, a))
    match folded {
      App(Const(s, _), x) => match succ_of(env, s) {
        some(zero) => match literal_value(env, zero, x) {
          some(n) => Const(zero + "#" + int.to_string(n + 1), []),
          none => folded,
        },
        none => folded,
      },
      _ => folded,
    }
  },
  Lam(x, ty, b) => Lam(x, fold_numerals(env, ty), fold_numerals(env, b)),
  Pi(x, ty, b) => Pi(x, fold_numerals(env, ty), fold_numerals(env, b)),
  other => other,
}

// The zero of the numerals whose succ is s.
local fn succ_of(env: Env, s: String) -> String? =
  list.find(map.keys(env.numerals), (z) => match map.get(env.numerals, z) {
    some((sc, _)) => sc == s,
    none => false,
  })

// x as a number of the numerals built from zero: zero, or a literal.
local fn literal_value(env: Env, zero: String, x: Term) -> Int? = match x {
  Const(c, _) => if c == zero then some(0) else match numeral(env, c) {
    some((z, n)) => if z == zero then some(n) else none,
    none => none,
  },
  _ => none,
}

// A literal one succ unfolded: zero for 0, succ(zero#(n-1)) otherwise.
local fn numeral_step(env: Env, zero: String, n: Int) -> Term = match map.get(env.numerals, zero) {
  some((succ, _)) => if n == 0 then Const(zero, []) else App(Const(succ, []), Const(zero + "#" + int.to_string(n - 1), [])),
  none => Const(zero + "#" + int.to_string(n), []),
}

// ── Computing on literals ───────────────────────────────────────────
//
// `numerals Nat.zero computes { add: Nat.add, ... }` lets the kernel answer
// Nat.add(m, n) for two literals by adding the numbers, instead of
// unfolding Nat.add m or n times (Lean's kernel does the same for Nat).
// It is an assumption: that each constant computes the operation it is
// declared for. The declaration is checked on small numbers by unfolding
// (checker, DComputes), and `axioms` lists every use.

let COMPUTE_LIMIT = 4611686018427387904

let COMPUTE_OPS = ["add", "sub", "mul", "div", "mod", "gcd", "pow", "shiftLeft", "shiftRight", "land", "lor", "xor", "log2", "beq", "ble"]

fn is_test_op(op: String) -> Bool = op == "beq" or op == "ble"

// Operations of one argument (the others take two).
fn is_unary_op(op: String) -> Bool = op == "log2"

local fn log2_of(n: Int) -> Int = {
  var k = 0
  var m = n
  while m >= 2 {
    m = m / 2
    k = k + 1
  }
  k
}

local fn gcd_of(a: Int, b: Int) -> Int = {
  var x = a
  var y = b
  while y != 0 {
    let r = x % y
    x = y
    y = r
  }
  x
}

// 2^n, or none past the limit.
local fn pow_of(a: Int, n: Int) -> Int? = {
  var acc = 1
  var i = 0
  var fits = true
  while fits and i < n {
    if a != 0 and acc > COMPUTE_LIMIT / a then {
      fits = false
    } else {
      acc = acc * a
    }
    i = i + 1
  }
  if fits then some(acc) else none
}

// What op gives on m and n (a test: 1 for true, 0 for false), or none when
// the result would pass COMPUTE_LIMIT; it is then left to unfolding.
fn compute_op(op: String, m: Int, n: Int) -> Int? =
  if m > COMPUTE_LIMIT or n > COMPUTE_LIMIT then none
  else if op == "add" then (if m <= COMPUTE_LIMIT - n then some(m + n) else none)
  else if op == "sub" then some(if m > n then m - n else 0)
  else if op == "mul" then (if m == 0 or n <= COMPUTE_LIMIT / m then some(m * n) else none)
  else if op == "div" then some(if n == 0 then 0 else m / n)
  else if op == "mod" then some(if n == 0 then m else m % n)
  else if op == "gcd" then some(gcd_of(m, n))
  else if op == "pow" then pow_of(m, n)
  else if op == "shiftLeft" then match pow_of(2, n) {
    some(p) => if m == 0 or p <= COMPUTE_LIMIT / m then some(m * p) else none,
    none => if m == 0 then some(0) else none,
  }
  else if op == "shiftRight" then match pow_of(2, n) {
    some(p) => some(m / p),
    none => some(0),
  }
  else if op == "land" then some(int.band(m, n))
  else if op == "lor" then some(int.bor(m, n))
  else if op == "xor" then some(int.bxor(m, n))
  else if op == "log2" then some(log2_of(m))
  else if op == "beq" then some(if m == n then 1 else 0)
  else if op == "ble" then some(if m <= n then 1 else 0)
  else none

// The literal n of the numerals built from zero.
fn literal(zero: String, n: Int) -> Term = if n == 0 then Const(zero, []) else Const(zero + "#" + int.to_string(n), [])

// t as a number of the numerals built from zero, reducing it as far as its
// head shows: zero, a literal, or succ of one. None when it is not one.
local fn number_of(env: Env, ctx: Ctx, zero: String, succ: String, t: Term, mut b: Budget) -> Int? = {
  var cur = t
  var acc = 0
  var going = true
  var out: Int? = none
  while going {
    // A literal is read as it is: reducing it would unfold one succ.
    let w = if is_literal(env, cur) then cur else reduce(env, ctx, cur, true, b)
    match w {
      Const(c, _) => {
        out = if c == zero then some(acc) else match numeral(env, c) {
          some((z, n)) => if z == zero then some(acc + n) else none,
          none => none,
        }
        going = false
      },
      App(f, x) => match f {
        Const(s, _) => if s == succ and spend(b) then {
          acc = acc + 1
          cur = x
        } else {
          going = false
        },
        _ => {
          going = false
        },
      },
      _ => {
        going = false
      },
    }
  }
  out
}

// c applied to two literals, computed, when c is declared to compute.
local fn computed(env: Env, ctx: Ctx, c: String, args: List[Term], mut b: Budget) -> Term? = match map.get(env.computes, c) {
  none => none,
  some(cp) => match map.get(env.numerals, cp.zero) {
    none => none,
    some((succ, _)) => match list.get(args, 0) {
      none => none,
      some(x) => match (if is_unary_op(cp.op) then some(literal(cp.zero, 0)) else list.get(args, 1)) {
        none => none,
        some(y) => if list.len(args) != (if is_unary_op(cp.op) then 1 else 2) then none else match number_of(env, ctx, cp.zero, succ, x, b) {
          none => none,
          some(m) => match number_of(env, ctx, cp.zero, succ, y, b) {
            none => none,
            some(n) => match compute_op(cp.op, m, n) {
              none => none,
              some(r) => some(if is_test_op(cp.op) then Const(if r == 1 then cp.yes else cp.no, []) else literal(cp.zero, r)),
            },
          },
        },
      },
    },
  },
}

local fn names_of(ctx: Ctx) -> List[String] = ctx |> list.map(((x, _)) => x)

fn show(env: Env, ctx: Ctx, t: Term) -> String = pretty.show(env.room, names_of(ctx), t)

// Like `show`, but names from the rooms in use print as they are written
// there (`add`, not `nat.add`) whenever that spelling resolves back to the
// same name. For goals and hypotheses shown to the reader.
fn show_short(env: Env, ctx: Ctx, t: Term) -> String = {
  let names = names_of(ctx)
  var short: Map[String, String] = map.new()
  for c in list.unique(consts(t)) {
    let r = room_of(env, c)
    match string.strip_prefix(c, r + ".") {
      some(x) => if r != env.room and not list.contains(names, x) and resolves_to(env, x, c) then map.insert(short, c, env.room + "." + x) else (),
      none => (),
    }
  }
  pretty.show(env.room, names, rename_consts(t, short))
}

local fn resolves_to(env: Env, x: String, c: String) -> Bool = match resolve_const(env, x) {
  ok(q) => q == c,
  err(_) => false,
}

local fn rename_consts(t: Term, m: Map[String, String]) -> Term = match t {
  Const(c, ls) => match map.get(m, c) {
    // Not `map.get(m, c) ?? c`: v0.64.0 borrows and moves c in one call (almide/almide#3409).
    some(short) => Const(short, ls),
    none => Const(c, ls),
  },
  App(f, a) => App(rename_consts(f, m), rename_consts(a, m)),
  Lam(x, ty, b) => Lam(x, rename_consts(ty, m), rename_consts(b, m)),
  Pi(x, ty, b) => Pi(x, rename_consts(ty, m), rename_consts(b, m)),
  other => other,
}

// ── Work budget ─────────────────────────────────────────────────────
//
// Rules may loop, so every reduction step and every conversion or
// normalisation call is paid for from one budget per declaration, and
// nesting is bounded too: a conversion that keeps unfolding into itself
// (`f(x) = g(f(x))`) runs out of depth instead of the stack. Running out
// is recorded, never mistaken for a normal form: the declaration is then
// rejected with "out of budget", not accepted and not reported as a
// type mismatch. So a looping rule set makes the kernel incomplete, never
// unsound and never stuck.
//
// `failed` remembers pairs of applications with the same head whose
// arguments were found not convertible, so that unfolding both sides does
// not compare the same arguments again at every level of a tower of
// definitions (which made such comparisons exponential, as Lean's
// List.getElem_append_left showed). Pairs are told apart by a bounded
// fingerprint of the two terms and of the context entries their
// variables reach (conversion looks at those types, for proof
// irrelevance). A remembered pair only skips that shortcut: both sides are
// then unfolded and compared as if the shortcut had failed again, so a
// fingerprint that collides can cost completeness, never soundness.
//
// `memo` remembers weak-head normal forms of closed applications computed
// in this declaration, by a bounded hash; an entry is used only for a term
// exactly equal to the one it was computed for. Reduction substitutes
// arguments unevaluated, so without it a computation that uses a value
// twice computes it twice (Lean's omega proofs ran into the hundreds of
// millions of steps). A closed term's normal form depends only on the
// environment, which does not change within a declaration.
type Budget = { left: Int, depth: Int, exhausted: Bool, failed: Map[(Int, Int, Int), Bool], memo: Map[Int, List[(Term, Term)]] }

let STEPS = 50_000_000
let MAX_DEPTH = 512

fn budget() -> Budget = Budget { left: STEPS, depth: 0, exhausted: false, failed: [:], memo: [:] }

// Applications larger than this are not remembered (hashing and comparing
// them would cost more than it saves).
let MEMO_NODES = 4000

type Mk = { h: Int, left: Int, closed: Bool }

// A hash of t, and whether t is closed (no variable bound outside it, no
// hole), reading at most MEMO_NODES nodes; `left` below zero means larger.
local fn memo_hash(t: Term, depth: Int, mut k: Mk) -> Unit =
  if k.left < 0 or not k.closed then () else {
    k.left = k.left - 1
    match t {
      Var(i) => {
        if i >= depth then {
          k.closed = false
        } else {
          k.h = (k.h * 31 + i + 7) % 1000000007
        }
      },
      Sort(_) => {
        k.h = (k.h * 31 + 3) % 1000000007
      },
      Const(c, ls) => {
        var h = (k.h * 31 + list.len(ls) + 11) % 1000000007
        for byte in string.to_bytes(c) {
          h = (h * 131 + byte) % 1000000007
        }
        k.h = h
      },
      App(f, a) => {
        k.h = (k.h * 31 + 13) % 1000000007
        memo_hash(f, depth, k)
        memo_hash(a, depth, k)
      },
      Lam(_, ty, body) => {
        k.h = (k.h * 31 + 17) % 1000000007
        memo_hash(ty, depth, k)
        memo_hash(body, depth + 1, k)
      },
      Pi(_, ty, body) => {
        k.h = (k.h * 31 + 19) % 1000000007
        memo_hash(ty, depth, k)
        memo_hash(body, depth + 1, k)
      },
      Meta(_) => {
        k.closed = false
      },
    }
  }

// The key t is remembered under, when t is a closed application of
// bounded size; delta and non-delta reductions are kept apart.
local fn memo_key(t: Term, delta: Bool) -> Int? = match t {
  App(_, _) => {
    var k = Mk { h: 1, left: MEMO_NODES, closed: true }
    memo_hash(t, 0, k)
    if k.closed and k.left >= 0 then some(k.h * 2 + (if delta then 1 else 0)) else none
  },
  _ => none,
}

local fn memo_find(entries: List[(Term, Term)], t: Term) -> Term? = match list.find(entries, ((i, _)) => i == t) {
  some((_, o)) => some(o),
  none => none,
}

// Pay for one step; false once the budget is gone.
fn spend_step(mut b: Budget) -> Bool = spend(b)

local fn spend(mut b: Budget) -> Bool =
  if b.exhausted or b.left <= 0 then {
    b.exhausted = true
    false
  } else {
    b.left = b.left - 1
    true
  }

// Pay for building a term: a rewrite costs the size of what it builds (up
// to GROWTH_CAP), so a rule that keeps growing the term, `f(x) = f(f(x))`,
// runs out of budget quickly instead of copying ever larger terms.
let GROWTH_CAP = 10_000

local fn spend_size(mut b: Budget, t: Term) -> Bool = {
  let n = size_upto(t, GROWTH_CAP)
  if b.exhausted or b.left < n then {
    b.exhausted = true
    false
  } else {
    b.left = b.left - n
    true
  }
}

// The number of nodes of t, counting no further than cap. A recursion
// that only reads (nesting at most cap deep): an explicit stack of
// subterms copied each one (almide/almide#3434).
local fn size_upto(t: Term, cap: Int) -> Int =
  if cap <= 0 then 0
  else match t {
    App(f, a) => {
      let l = size_upto(f, cap - 1)
      1 + l + size_upto(a, cap - 1 - l)
    },
    Lam(_, a, c) => {
      let l = size_upto(a, cap - 1)
      1 + l + size_upto(c, cap - 1 - l)
    },
    Pi(_, a, c) => {
      let l = size_upto(a, cap - 1)
      1 + l + size_upto(c, cap - 1 - l)
    },
    _ => 1,
  }

// Enter one level of nesting; false (and exhausted) past the bound.
fn enter(mut b: Budget) -> Bool = enter_up_to(b, MAX_DEPTH)

// The elaborator's unification nests once per argument it compares, and
// is bounded separately (elab.UNIFY_DEPTH), so that what it accepts the
// kernel can still compare.
fn enter_up_to(mut b: Budget, max: Int) -> Bool =
  if not spend(b) then false
  else if b.depth >= max then {
    b.exhausted = true
    false
  } else {
    b.depth = b.depth + 1
    true
  }

fn leave(mut b: Budget) -> Unit = {
  b.depth = b.depth - 1
}

let REDUCE_WEIGHT = 4

local fn enter_by(mut b: Budget, k: Int) -> Bool =
  if not spend(b) then false
  else if b.depth + k > MAX_DEPTH then {
    b.exhausted = true
    false
  } else {
    b.depth = b.depth + k
    true
  }

local fn leave_by(mut b: Budget, k: Int) -> Unit = {
  b.depth = b.depth - k
}

fn exhausted_error() -> String =
  "out of budget: reduction did not finish (a rule set that does not terminate, or a term too deep to compare)"

// ── Reduction ───────────────────────────────────────────────────────

// Weak-head normal form: β, δ (defs) and the rewrite rules. `ctx` types the
// free variables of t: matching a rule's {bracket} compares terms in it.
fn whnf(env: Env, ctx: Ctx, t: Term, mut b: Budget) -> Term = reduce(env, ctx, t, true, b)

// β and rules only: definitions stay folded, so conversion can compare
// `f a` with `f b` without unfolding f.
fn whnf_core(env: Env, ctx: Ctx, t: Term, mut b: Budget) -> Term = reduce(env, ctx, t, false, b)

local fn reduce(env: Env, ctx: Ctx, t: Term, delta: Bool, mut b: Budget) -> Term =
  // Matching a rule reduces the arguments, which may match rules again
  // (issue #7): each reduction is one level of nesting, so such a cycle
  // ends at the depth bound instead of the native stack.
  // A reduction nested in matching costs several native frames, so it
  // counts as REDUCE_WEIGHT levels.
  if not enter_by(b, REDUCE_WEIGHT) then t
  else {
    let key = memo_key(t, delta)
    let known = match key {
      some(k) => match map.get(b.memo, k) {
        some(entries) => memo_find(entries, t),
        none => none,
      },
      none => none,
    }
    let r = match known {
      some(o) => o,
      none => {
        let o = reduce_loop(env, ctx, t, delta, b)
        // A reduction cut short by the budget is not a normal form.
        match key {
          some(k) => if b.exhausted then () else {
            // Read first: an insert whose value reads the same map does not
            // compile with Almide v0.64.0 (the class of almide/almide#3050, fixed
            // in the pinned build; kept while v0.64.0 builds Arlk too).
            let earlier = map.get(b.memo, k) ?? []
            map.insert(b.memo, k, [(t, o)] + earlier)
          },
          none => (),
        }
        o
      },
    }
    leave_by(b, REDUCE_WEIGHT)
    r
  }

local fn reduce_loop(env: Env, ctx: Ctx, t: Term, delta: Bool, mut b: Budget) -> Term = {
  // `cur` is taken apart, not read again: it is rebuilt from its head and
  // arguments when reduction stops, so no step copies the whole term.
  var cur = t
  var going = true
  while going {
    if not spend(b) then {
      going = false
    } else {
      let (h, args0) = spine(cur)
      var args = args0
      match h {
        Lam(x, ty, body) => match list.first(args) {
          some(a) => {
            cur = apply(subst(body, a), list.drop(args, 1))
          },
          none => {
            cur = Lam(x, ty, body)
            going = false
          },
        },
        Const(c, ls) => match (if delta and map.contains(env.computes, c) then computed(env, ctx, c, args, b) else none) {
          // An operation on two literals, computed (Lean's Nat acceleration).
          some(r) => {
            cur = r
          },
          none => match (if delta then unfold(env, c, ls) else none) {
          some(body) => {
            cur = apply(body, args)
          },
          none => match (if list.is_empty(args) then numeral(env, c) else none) {
            // A literal: one succ unfolded is its head normal form.
            some((zero, n)) => {
              cur = numeral_step(env, zero, n)
              going = false
            },
            none => match rewrite(env, ctx, c, ls, args, b) {
              some(t2) => {
                cur = t2
              },
              none => {
                cur = apply(Const(c, ls), args)
                going = false
              },
            },
          },
          },
        },
        other => {
          cur = apply(other, args)
          going = false
        },
      }
    }
  }
  cur
}

// A definition's body at the universe levels it is used at.
local fn unfold(env: Env, c: String, ls: List[Level]) -> Term? =
  if map.contains(env.defs, c) then match map.get(env.bodies, c) {
    some(body) => some(inst_levels(body, map.get(env.lparams, c) ?? [], ls)),
    none => none,
  } else none

// The arguments after the first n, copied one by one: `list.drop` on a
// borrowed list does not compile (almide/almide#3442).
local fn beyond(mut args: List[Term], n: Int) -> List[Term] = {
  var out: List[Term] = []
  var i = n
  while i < list.len(args) {
    match list.get(args, i) {
      some(a) => list.push(out, a),
      none => (),
    }
    i = i + 1
  }
  out
}

// `mut args`: borrowed, so trying the rules does not copy the arguments.
local fn rewrite(env: Env, ctx: Ctx, c: String, ls: List[Level], mut args: List[Term], mut b: Budget) -> Term? = {
  var found: Term? = none
  for r in map.get(env.rws, c) ?? [] {
    if found == none and not b.exhausted then {
      found = try_rule(env, ctx, c, r, ls, args, b)
    } else ()
  }
  found
}

// What matching has learned so far: the bound variables, and the bracket
// checks to run once all of them are known.
// `head`: the rule's head, so that structure eta is not used to match a
// projection's own rule (it would rewrite `f(t)` to `f(t)`).
type MState = { sub: Map[Int, Term], pending: List[(Term, Term)], head: String }

local fn try_rule(env: Env, ctx: Ctx, head: String, r: Rw, ls: List[Level], mut args: List[Term], mut b: Budget) -> Term? =
  if list.len(args) < r.arity then none
  else match match_all_at(env, ctx, list.zip(r.lhs_args, list.take(args, r.arity)), b, head) {
    some(st) => {
      let vals = list.map(0..<r.nvars, (k) => map.get(st.sub, k) ?? Var(k))
      // The rule's universe parameters take the levels of the head it matched.
      let st2 = if list.is_empty(r.lparams) then st
        else { ...st, pending: st.pending |> list.map(((br, t)) => (inst_levels(br, r.lparams, ls), t)) }
      if brackets_hold(env, ctx, st2, vals, b) then {
        let out = apply(instantiate(inst_levels(r.rhs, r.lparams, ls), vals, 0), beyond(args, r.arity))
        if spend_size(b, out) then some(out) else none
      } else none
    },
    none => none,
  }

// Each {bracket} must be convertible to the argument it stands for, in the
// context the arguments live in.
local fn brackets_hold(env: Env, ctx: Ctx, st: MState, vals: List[Term], mut b: Budget) -> Bool = {
  var all = true
  for (br, t) in st.pending {
    if all then {
      all = conv(env, ctx, instantiate(br, vals, 0), t, b)
    } else ()
  }
  all
}

fn match_all(env: Env, ctx: Ctx, pairs: List[(Pat, Term)], mut b: Budget) -> MState? = match_all_at(env, ctx, pairs, b, "")

fn match_all_at(env: Env, ctx: Ctx, pairs: List[(Pat, Term)], mut b: Budget, head: String) -> MState? = {
  var st: MState? = some(MState { sub: [:], pending: [], head: head })
  for (p, t) in pairs {
    match st {
      some(s) => {
        st = match_pat(env, ctx, p, t, s, b)
      },
      none => (),
    }
  }
  st
}

local fn match_pat(env: Env, ctx: Ctx, p: Pat, t: Term, st: MState, mut b: Budget) -> MState? = match p {
  PVar(k) => some({ ...st, sub: map.set(st.sub, k, t) }),
  PBracket(br) => some({ ...st, pending: st.pending + [(br, t)] }),
  PSym(c, ps) => {
    let (th, targs) = spine(whnf(env, ctx, t, b))
    match th {
      Const(d, _) if c == d =>
        if list.len(ps) == list.len(targs) then {
          var cur: MState? = some(st)
          for (q, u) in list.zip(ps, targs) {
            match cur {
              some(s) => {
                cur = match_pat(env, ctx, q, u, s, b)
              },
              none => (),
            }
          }
          cur
        } else none,
      _ => match struct_expand(env, ctx, c, st.head, t, b) {
        // Structure eta: a value of a declared structure matches its
        // constructor as the constructor of its projections.
        some(e) => match_pat(env, ctx, p, e, st, b),
        none => none,
      },
    }
  },
}

// t as `S.mk(params, S.f1(params, t), ...)`, when c is the constructor of
// a declared structure and t's type is S at some parameters (possibly as
// the last argument of a wrapper such as `El(l, S(...))`).
local fn struct_expand(env: Env, ctx: Ctx, c: String, head: String, t: Term, mut b: Budget) -> Term? = match map.get(env.structs, c) {
  none => none,
  some(si) => if head == "" or list.contains(si.projs, head) then none else match infer(env, ctx, t, b) {
    err(_) => none,
    ok(ty) => match struct_params(env, ctx, si, ty, b) {
      none => none,
      some((ls, params)) => some(apply(Const(c, ls), params + (si.projs |> list.map((f) => apply(Const(f, ls), params + [t]))))),
    },
  },
}

local fn struct_params(env: Env, ctx: Ctx, si: StructEta, ty: Term, mut b: Budget) -> (List[Level], List[Term])? = {
  let w = whnf(env, ctx, ty, b)
  let (h, args) = spine(w)
  match h {
    Const(s, ls) if s == si.ty and list.len(args) == si.nparams => some((ls, args)),
    Const(_, _) => match list.last(args) {
      some(inner) => {
        let (h2, args2) = spine(whnf(env, ctx, inner, b))
        match h2 {
          Const(s, ls) if s == si.ty and list.len(args2) == si.nparams => some((ls, args2)),
          _ => none,
        }
      },
      none => none,
    },
    _ => none,
  }
}

// Full normal form, for `eval`.
fn nf(env: Env, ctx: Ctx, t: Term, mut b: Budget) -> Term =
  if not enter(b) then t
  // A literal is normal: unfolding it would only spell out its succs.
  else if is_literal(env, t) then {
    leave(b)
    t
  }
  else {
    let w = whnf(env, ctx, t, b)
    let r = match w {
      Lam(x, ty, body) => {
        let ty2 = nf(env, ctx, ty, b)
        Lam(x, ty2, nf(env, [(x, ty)] + ctx, body, b))
      },
      Pi(x, ty, body) => {
        let ty2 = nf(env, ctx, ty, b)
        Pi(x, ty2, nf(env, [(x, ty)] + ctx, body, b))
      },
      _ => {
        let (h, args) = spine(w)
        var out: List[Term] = []
        for a in args {
          list.push(out, nf(env, ctx, a, b))
        }
        // succ of a literal is the next literal.
        fold_numerals(env, apply(h, out))
      },
    }
    leave(b)
    r
  }

local fn is_literal(env: Env, t: Term) -> Bool = match t {
  Const(c, _) => match numeral(env, c) {
    some(_) => true,
    none => false,
  },
  _ => false,
}

// ── Conversion ──────────────────────────────────────────────────────

// The height of the definition at the head of t, if t's head unfolds.
fn def_height(env: Env, t: Term) -> Int? = {
  let (h, _) = spine(t)
  match h {
    Const(c, _) => map.get(env.defs, c),
    _ => none,
  }
}

fn unfold_head(env: Env, t: Term) -> Term = {
  let (h, args) = spine(t)
  match h {
    Const(c, ls) => match unfold(env, c, ls) {
      some(body) => apply(body, args),
      none => t,
    },
    _ => t,
  }
}

// One step of lazy unfolding: t's head computed on literals when it is
// declared to compute (`numerals zero computes`), otherwise its definition
// unfolded; then reduced without unfolding further.
fn step_head(env: Env, ctx: Ctx, t: Term, mut bu: Budget) -> Term = {
  let (h, args) = spine(t)
  let r = match h {
    Const(c, _) => if map.contains(env.computes, c) then computed(env, ctx, c, args, bu) else none,
    _ => none,
  }
  match r {
    some(v) => whnf_core(env, ctx, v, bu),
    none => whnf_core(env, ctx, unfold_head(env, t), bu),
  }
}

// `ctx` types the free variables of a and b: proof irrelevance and rule
// brackets consult it.
fn conv(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool =
  // Up to binder names: comparing two copies of a term whose binders were
  // renamed must not unfold them (a Nat.rec on a fuel of a million).
  if alpha_eq(a, b) then true
  else if both_numerals(env, a, b) then false
  else if not enter(bu) then false
  else {
    // One `let` per reduced side: almide/almide#3405 merges two such
    // arguments into one.
    let wa = whnf_core(env, ctx, a, bu)
    let wb = whnf_core(env, ctx, b, bu)
    let r = conv_whnf(env, ctx, wa, wb, bu) or record_eta(env, ctx, wa, wb, bu) or record_eta(env, ctx, wb, wa, bu) or irrelevant_eq(env, ctx, a, b, bu)
    leave(bu)
    r
  }

// Two different literals of the same type: not equal (a and b are not ==).
fn both_numerals(env: Env, a: Term, b: Term) -> Bool = match a {
  Const(c, _) => match b {
    Const(d, _) => match numeral(env, c) {
      some((t1, _)) => match numeral(env, d) {
        some((t2, _)) => t1 == t2,
        none => false,
      },
      none => false,
    },
    _ => false,
  },
  _ => false,
}

// Two terms in weak-head normal form. Unfolding definitions is a loop, not
// a recursion: comparing a numeral built from n definitions takes n
// unfoldings, which must cost budget steps, not stack (#17's numeral
// family crashed the stack at n = 6400).
local fn conv_whnf(env: Env, ctx: Ctx, wa0: Term, wb0: Term, mut bu: Budget) -> Bool = {
  var wa = wa0
  var wb = wb0
  var answer = false
  var going = true
  while going {
    if alpha_eq(wa, wb) then {
      answer = true
      going = false
    } else if bu.exhausted then {
      going = false
    } else match conv_here(env, ctx, wa, wb, bu) {
      some(r) => {
        answer = r
        going = false
      },
      none => match unfold_step(env, ctx, wa, wb, bu) {
        some((ua, ub)) => {
          wa = ua
          wb = ub
        },
        none => {
          // Record and structure eta on the unfolded forms too (`conv`
          // tries them only before unfolding): `S.casesOn(x, mk)` unfolds
          // to `S.mk(x.1, x.2)`, which is x.
          answer = not bu.exhausted and (conv_spines(env, ctx, wa, wb, bu)
            or ((wa != wa0 or wb != wb0) and (record_eta(env, ctx, wa, wb, bu) or record_eta(env, ctx, wb, wa, bu))))
          going = false
        },
      },
    }
  }
  answer
}

// What the shapes decide without unfolding: some(answer), or none when
// the heads differ and unfolding may still make them agree.
local fn conv_here(env: Env, ctx: Ctx, wa: Term, wb: Term, mut bu: Budget) -> Option[Bool] =
  // Nested matches rather than `match (wa, wb)`: almide/almide#3390.
  match wa {
    Sort(i) => match wb {
      Sort(j) => some(level_eq(i, j)),
      _ => none,
    },
    Pi(x, t1, b1) => match wb {
      Pi(_, t2, b2) => some(conv(env, ctx, t1, t2, bu) and conv(env, [(x, t1)] + ctx, b1, b2, bu)),
      _ => none,
    },
    // η: (fun x => f x) ≡ f
    Lam(x, t1, b1) => match wb {
      Lam(_, t2, b2) => some(conv(env, ctx, t1, t2, bu) and conv(env, [(x, t1)] + ctx, b1, b2, bu)),
      _ => some(conv(env, [(x, t1)] + ctx, b1, App(shift(wb, 1, 0), Var(0)), bu)),
    },
    _ => match wb {
      Lam(x, t2, b2) => some(conv(env, [(x, t2)] + ctx, App(shift(wa, 1, 0), Var(0)), b2, bu)),
      _ => if same_head_args(env, ctx, wa, wb, bu) then some(true) else none,
    },
  }

local fn all_conv(env: Env, ctx: Ctx, xs: List[Term], ys: List[Term], mut bu: Budget) -> Bool =
  if list.len(xs) != list.len(ys) then false
  else {
    var all = true
    for (x, y) in list.zip(xs, ys) {
      if all then {
        all = conv(env, ctx, x, y, bu)
      } else ()
    }
    all
  }

// Same head constant and convertible arguments: equal without unfolding.
local fn same_head_args(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool = {
  let (ha, xs) = spine(a)
  let (hb, ys) = spine(b)
  let same = match ha {
    Const(c, ls) => match hb {
      Const(d, ms) => c == d and levels_eq(ls, ms),
      _ => false,
    },
    _ => false,
  }
  if not same then false
  else {
    let key = pair_key(ctx, a, b)
    if map.contains(bu.failed, key) then false
    else if all_conv(env, ctx, xs, ys, bu) then true
    else {
      if not bu.exhausted then map.insert(bu.failed, key, true) else ()
      false
    }
  }
}

// ── Fingerprints for the failure memory ─────────────────────────────

let FP_NODES = 256
let FP_MOD = 1_000_000_007

type Fp = { h: Int, left: Int, vars: List[Int] }

local fn mix(h: Int, x: Int) -> Int = (h * 31 + x % FP_MOD + FP_MOD) % FP_MOD

local fn name_code(s: String) -> Int = list.fold(string.to_bytes(s), 7, (h, b) => (h * 131 + b) % FP_MOD)

local fn level_code(l: Level) -> Int = match l {
  LZero => 1,
  LSucc(x) => mix(2, level_code(x)),
  LMax(x, y) => mix(mix(3, level_code(x)), level_code(y)),
  LIMax(x, y) => mix(mix(4, level_code(x)), level_code(y)),
  LParam(p) => mix(5, name_code(p)),
  LMeta(n) => mix(6, n),
}

// The first FP_NODES nodes of t, hashed; the variables met there (free
// above `depth` binders) are collected as context positions.
local fn fingerprint(t: Term, depth: Int, mut f: Fp) -> Unit =
  if f.left <= 0 then ()
  else {
    f.left = f.left - 1
    match t {
      Var(i) => {
        f.h = mix(mix(f.h, 11), i)
        if i >= depth and not list.contains(f.vars, i - depth) then list.push(f.vars, i - depth) else ()
      },
      Sort(l) => {
        f.h = mix(mix(f.h, 12), level_code(l))
      },
      Const(c, ls) => {
        f.h = mix(mix(f.h, 13), name_code(c))
        for l in ls {
          f.h = mix(f.h, level_code(l))
        }
      },
      App(g, x) => {
        f.h = mix(f.h, 14)
        fingerprint(g, depth, f)
        fingerprint(x, depth, f)
      },
      Lam(_, ty, b) => {
        f.h = mix(f.h, 15)
        fingerprint(ty, depth, f)
        fingerprint(b, depth + 1, f)
      },
      Pi(_, ty, b) => {
        f.h = mix(f.h, 16)
        fingerprint(ty, depth, f)
        fingerprint(b, depth + 1, f)
      },
      Meta(n) => {
        f.h = mix(mix(f.h, 17), n)
      },
    }
  }

local fn pair_key(ctx: Ctx, a: Term, b: Term) -> (Int, Int, Int) = {
  var fa = Fp { h: 1, left: FP_NODES, vars: [] }
  fingerprint(a, 0, fa)
  var fb = Fp { h: 2, left: FP_NODES, vars: fa.vars }
  fingerprint(b, 0, fb)
  // The context entries those variables reach, through their types.
  var seen: List[Int] = []
  var queue = fb.vars
  var hc = 3
  while not list.is_empty(queue) and list.len(seen) < 64 {
    let i = list.first(queue) ?? 0
    queue = list.drop(queue, 1)
    if not list.contains(seen, i) then {
      list.push(seen, i)
      match list.get(ctx, i) {
        some((_, ty)) => {
          var ft = Fp { h: 4, left: FP_NODES, vars: [] }
          fingerprint(ty, 0, ft)
          hc = mix(mix(hc, i), ft.h)
          for j in ft.vars {
            list.push(queue, i + 1 + j)
          }
        },
        none => (),
      }
    } else ()
  }
  (fa.h, fb.h, hc)
}

// Unfold one step on the side whose head was defined later (both when
// they are equally high), and reduce; none when neither side unfolds.
local fn unfold_step(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Option[(Term, Term)] =
  if not spend(bu) then none
  else match def_height(env, a) {
    some(ha) => match def_height(env, b) {
      some(hb) =>
        if ha > hb then some((step_head(env, ctx, a, bu), b))
        else if hb > ha then some((a, step_head(env, ctx, b, bu)))
        else {
          let ua = step_head(env, ctx, a, bu)
          let ub = step_head(env, ctx, b, bu)
          some((ua, ub))
        },
      none => some((step_head(env, ctx, a, bu), b)),
    },
    none => match def_height(env, b) {
      some(_) => some((a, step_head(env, ctx, b, bu))),
      none => none,
    },
  }

local fn conv_spines(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool = {
  let (ha, xs) = spine(a)
  let (hb, ys) = spine(b)
  // Nested matches: almide/almide#3390.
  let heads = match ha {
    Var(i) => match hb {
      Var(j) => i == j,
      _ => false,
    },
    Const(c, ls) => match hb {
      Const(d, ms) => c == d and levels_eq(ls, ms),
      _ => false,
    },
    _ => false,
  }
  heads and all_conv(env, ctx, xs, ys, bu)
}

// ── Record η ────────────────────────────────────────────────────────

// Eta for records (as in Lean, Agda and Rocq's primitive records): a value
// of a record type equals the record built from its own fields,
// `p ≡ P.mk(p.x, p.y)`. When `a` is a record's constructor applied to all
// its fields, each field is compared with the projection of `b`. Only
// non-recursive records, as in Lean (for a recursive one eta could unfold
// forever).
local fn record_eta(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool =
  if bu.exhausted then false
  else match eta_pairs(env, a, b) {
    none => false,
    some(pairs) => {
      var all = true
      for (field, proj) in pairs {
        if all then {
          all = conv(env, ctx, field, proj, bu)
        } else ()
      }
      all
    },
  }

// What record eta compares when `a` is a record built by its constructor:
// each field of `a` with the matching projection of `b`. None when `a`
// is not such a record.
fn eta_pairs(env: Env, a: Term, b: Term) -> Option[List[(Term, Term)]] = {
  let (h, args) = spine(a)
  match h {
    Const(c, ls) if map.contains(env.structs, c) => match map.get(env.structs, c) {
      some(si) => if list.len(args) != si.nparams + list.len(si.projs) then none else {
        let params = list.take(args, si.nparams)
        some(list.zip(list.drop(args, si.nparams), si.projs) |> list.map(((x, f)) => (x, apply(Const(f, ls), params + [b]))))
      },
      none => none,
    },
    Const(c, ls) => if not string.ends_with(c, ".mk") then none else {
      let q = string.drop_end(c, 3)
      match map.get(env.inductives, q) {
        none => none,
        some(info) => {
          let n = list.len(info.fields)
          if n == 0 or list.len(args) != info.params + n or not non_recursive(env, c, q) then none
          else {
            let params = list.take(args, info.params)
            var pairs: List[(Term, Term)] = []
            var i = 0
            for f in info.fields {
              list.push(pairs, (list.get(args, info.params + i) ?? Sort(LZero), apply(Const(q + "." + f, ls), params + [b])))
              i = i + 1
            }
            some(pairs)
          }
        },
      }
    },
    _ => none,
  }
}

// The constructor's arguments do not mention the record type itself.
local fn non_recursive(env: Env, c: String, q: String) -> Bool = {
  var t = map.get(env.types, c) ?? Sort(LZero)
  var ok_so_far = true
  var going = true
  while going {
    match t {
      Pi(_, dom, body) => {
        if list.contains(consts(dom), q) then ok_so_far = false else ()
        t = body
      },
      _ => {
        going = false
      },
    }
  }
  ok_so_far
}

// ── Proof irrelevance ───────────────────────────────────────────────

// Two terms are equal when both inhabit the same type and that type was
// declared `irrelevant` (in Lean's room: every proposition).
// Proofs of a proposition (a type in Sort(0)) are always irrelevant.
fn irrelevant_eq(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool =
  if bu.exhausted then false
  else match infer(env, ctx, a, bu) {
    ok(ta) =>
      if is_prop(env, ctx, ta, bu) or (not list.is_empty(env.irrelevants) and is_irrelevant_type(env, ctx, ta, bu)) then match infer(env, ctx, b, bu) {
        ok(tb) => conv(env, ctx, ta, tb, bu),
        err(_) => false,
      }
      else false,
    err(_) => false,
  }

local fn is_prop(env: Env, ctx: Ctx, ty: Term, mut bu: Budget) -> Bool = match infer(env, ctx, ty, bu) {
  ok(s) => match whnf(env, ctx, s, bu) {
    Sort(l) => level_eq(l, LZero),
    _ => false,
  },
  err(_) => false,
}

// Checked before and after reduction: reducing `El lz (p -> q)` turns it
// into an Arlk function type, which no longer has the declared shape. A
// function type into an irrelevant type is itself irrelevant (its values
// are equal pointwise, and conversion has η).
local fn is_irrelevant_type(env: Env, ctx: Ctx, t: Term, mut bu: Budget) -> Bool =
  if not enter(bu) then false
  else {
    let r = irrelevant_shape(env, ctx, t, bu) or irrelevant_shape(env, ctx, whnf_core(env, ctx, t, bu), bu) or {
      let w = whnf(env, ctx, t, bu)
      match w {
        Pi(x, dom, body) => is_irrelevant_type(env, [(x, dom)] + ctx, body, bu),
        _ => irrelevant_shape(env, ctx, w, bu),
      }
    }
    leave(bu)
    r
  }

local fn irrelevant_shape(env: Env, ctx: Ctx, t: Term, mut bu: Budget) -> Bool = {
  let (h, args) = spine(t)
  match h {
    Const(c, _) => {
      var found = false
      for ir in env.irrelevants {
        if not found and ir.head == c then {
          found = irrelevant_matches(env, ctx, ir, args, bu)
        } else ()
      }
      found
    },
    _ => false,
  }
}

local fn irrelevant_matches(env: Env, ctx: Ctx, ir: Rule, args: List[Term], mut bu: Budget) -> Bool =
  if list.len(args) != ir.arity then false
  else match match_all(env, ctx, list.zip(ir.lhs_args, args), bu) {
    some(st) => brackets_hold(env, ctx, st, list.map(0..<ir.nvars, (k) => map.get(st.sub, k) ?? Var(k)), bu),
    none => false,
  }

// ── Typing ──────────────────────────────────────────────────────────

fn infer(env: Env, ctx: Ctx, t: Term, mut bu: Budget) -> Term! = match t {
  Meta(n) => err("unsolved hole ?${int.to_string(n)}: the elaborator could not infer it"),
  Sort(l) => {
    guard not level_has_meta(l) else err("unsolved universe level: the elaborator could not infer it")
    ok(Sort(LSucc(l)))
  },
  Var(i) => match list.get(ctx, i) {
    some((_, ty)) => ok(shift(ty, i + 1, 0)),
    none => err("unbound variable #${int.to_string(i)}"),
  },
  Const(c, ls) => match map.get(env.types, c) {
    // (A literal is tested in the arm, not by a guard: almide/almide#3414.)
    none => match numeral(env, c) {
      some((zero, _)) => ok(numeral_type(env, zero)),
      none => err("unknown constant ${c}"),
    },
    some(ty) => {
      let ps = map.get(env.lparams, c) ?? []
      guard not list.any(ls, (l) => level_has_meta(l)) else err("unsolved universe level of ${c}: the elaborator could not infer it")
      guard list.len(ps) == list.len(ls) else err("${c} takes ${int.to_string(list.len(ps))} universe levels, given ${int.to_string(list.len(ls))}")
      ok(inst_levels(ty, ps, ls))
    },
  },
  App(f, a) => {
    // Neither f nor a is used after the call that checks it: a value used
    // again is copied first (almide/almide#3434), and in a deep proof term,
    // each step an argument of the next, those copies made checking
    // quadratic in time and memory (#17's term family).
    let label = brief(env, ctx, f)
    let tf = infer(env, ctx, f, bu)!
    match whnf(env, ctx, tf, bu) {
      Pi(_, dom, cod) => {
        // A non-dependent argument is not substituted at all.
        let result = if occurs(cod, 0) then subst(cod, a) else shift(cod, -1, 1)
        check(env, ctx, a, dom, bu)!
        ok(result)
      },
      other => {
        guard not bu.exhausted else err(exhausted_error())
        let msg = "${label} is applied to an argument, but its type is ${show(env, ctx, other)}"
        err(msg)
      },
    }
  },
  Lam(x, ty, body) => {
    expect_sort(env, ctx, ty, bu)!
    let tb = infer(env, [(x, ty)] + ctx, body, bu)!
    ok(Pi(x, ty, tb))
  },
  // A function type from Sort(u) to Sort(v) lives in Sort(imax(u, v)):
  // into a proposition it is a proposition (Prop is impredicative).
  Pi(x, ty, body) => {
    let u = expect_sort(env, ctx, ty, bu)!
    let v = expect_sort(env, [(x, ty)] + ctx, body, bu)!
    ok(Sort(LIMax(u, v)))
  },
}

// The type of `t` must be a sort; its level is returned.
fn expect_sort(env: Env, ctx: Ctx, t: Term, mut bu: Budget) -> Level! = {
  let ty = infer(env, ctx, t, bu)!
  let s = whnf(env, ctx, ty, bu)
  guard not bu.exhausted else err(exhausted_error())
  match s {
    Sort(l) => ok(l),
    other => err("${show(env, ctx, t)} is not a type (its type is ${show(env, ctx, other)})"),
  }
}

fn check(env: Env, ctx: Ctx, t: Term, expected: Term, mut bu: Budget) -> Unit! = {
  // The term is described before it is checked, not after (see infer's
  // application case).
  let label = brief(env, ctx, t)
  let actual = infer(env, ctx, t, bu)!
  let same = conv(env, ctx, actual, expected, bu)
  guard not bu.exhausted else err(exhausted_error())
  guard same else err("type mismatch for ${label}\n    expected: ${show(env, ctx, expected)}\n    found:    ${show(env, ctx, actual)}")
  ok(())
}

// A term for an error message: in full when it is small, otherwise its
// head and arguments elided, so describing it costs little.
let BRIEF = 400

fn brief(env: Env, ctx: Ctx, t: Term) -> String =
  if size_upto(t, BRIEF) < BRIEF then show(env, ctx, t)
  else "${head_text(env, ctx, t)}(… ${int.to_string(nargs(t))} arguments …)"

// The head of an application and its number of arguments, by recursions
// that only read the term (a loop over a `var` would copy it).
local fn head_text(env: Env, ctx: Ctx, t: Term) -> String = match t {
  App(f, _) => head_text(env, ctx, f),
  _ => if size_upto(t, BRIEF) < BRIEF then show(env, ctx, t) else "…",
}

local fn nargs(t: Term) -> Int = match t {
  App(f, _) => 1 + nargs(f),
  _ => 0,
}

// ── Rooms and names ─────────────────────────────────────────────────

// Names inside a room may contain dots (`Nat.add`); the room is recorded
// in the entry, not parsed out of the name.
fn room_of(env: Env, q: String) -> String = match map.get(env.entries, q) {
  some(e) => e.room,
  none => "",
}

local fn visible(env: Env) -> List[String] = [env.room] + (map.get(env.rooms, env.room) ?? [])

// A name resolves, in order, to: this room's declaration, a declaration
// written with its room in front (`logic.Prf`), or a unique declaration of
// a visible room.
fn resolve_const(env: Env, x: String) -> String! = if x != "" and list.all(string.chars(x), (d) => string.is_digit(d)) then {
  // A number: the literal of the numeral type in scope.
  let rooms = visible(env)
  let zeros = map.keys(env.numerals) |> list.filter((z) => list.contains(rooms, room_of(env, z)))
  match zeros {
    [] => err("${x}: no numerals in scope (declare them: `numerals Nat.zero, Nat.succ`)"),
    [z] => ok(z + "#" + x),
    many => err("${x} could be a literal built from ${list.join(list.sort(many), " or ")}"),
  }
} else {
  let own = env.room + "." + x
  // The own-room shortcut only counts if the entry really is this room's:
  // `room a` + `b.T` and `room a.b` + `T` spell the same key (issue #2).
  if map.contains(env.entries, own) and room_of(env, own) == env.room then ok(own)
  else {
    let rooms = visible(env)
    let qualified = if map.contains(env.entries, x) then [x] else []
    let found = list.unique(qualified + (rooms |> list.map((r) => r + "." + x) |> list.filter((q) => map.contains(env.entries, q))))
    match found {
      [] => err("unknown name ${x}"),
      [q] => {
        let r = room_of(env, q)
        guard list.contains(rooms, r) else err("${x} lives in room ${r}, which ${env.room} does not use (add `uses ${r}`)")
        ok(q)
      },
      many => err("${x} is ambiguous: ${list.join(many, ", ")}"),
    }
  }
}

// The number of single-character edits between two spellings.
fn edit_distance(a: List[String], b: List[String]) -> Int = {
  var prev = list.range(0, list.len(b) + 1)
  var i = 0
  for ca in a {
    i = i + 1
    var row = [i]
    var j = 0
    for cb in b {
      let sub = (list.get(prev, j) ?? 0) + (if ca == cb then 0 else 1)
      let del = (list.get(prev, j + 1) ?? 0) + 1
      let ins = (list.get(row, j) ?? 0) + 1
      list.push(row, int.min(sub, int.min(del, ins)))
      j = j + 1
    }
    prev = row
  }
  list.last(prev) ?? 0
}

// What to add to an "unknown name" error: the rooms that do declare the
// name, or visible names spelled almost the same.
fn name_hint(env: Env, x: String) -> String = {
  let rooms = visible(env)
  let xs = string.chars(x)
  let limit = if list.len(xs) <= 3 then 1 else 2
  let dotted = string.contains(x, ".")
  var elsewhere: List[String] = []
  var close: List[(Int, String)] = []
  for (q, e) in map.entries(env.entries) {
    let short = if e.room == "" then q else string.drop(q, string.len(e.room) + 1)
    if short == x then list.push(elsewhere, e.room)
    else if list.contains(rooms, e.room) and int.abs(string.len(short) - list.len(xs)) <= limit then {
      let d = edit_distance(xs, string.chars(short))
      if d <= limit then list.push(close, (d, short)) else ()
    } else if dotted and int.abs(string.len(q) - list.len(xs)) <= limit then {
      let d = edit_distance(xs, string.chars(q))
      if d <= limit then list.push(close, (d, q)) else ()
    } else ()
  }
  if not list.is_empty(elsewhere) then {
    let rs = list.sort(list.unique(elsewhere))
    " (declared in room ${list.join(rs, ", ")}: add `uses ${list.first(rs) ?? ""}` or write ${list.first(rs) ?? ""}.${x})"
  } else {
    let names = list.unique(list.sort_by(list.sort_by(close, ((_, n)) => n), ((d, _)) => d) |> list.map(((_, n)) => n))
    if list.is_empty(names) then "" else " (did you mean ${list.join(list.take(names, 3), ", ")}?)"
  }
}

// `resolve_const` for a name the user wrote, with a hint when it is unknown.
fn resolve_named(env: Env, x: String) -> String! = match resolve_const(env, x) {
  ok(q) => ok(q),
  err(e) => err(if string.starts_with(e, "unknown name") then e + name_hint(env, x) else e),
}

// ── Names and levels in surface syntax ──────────────────────────────

fn index_in(scope: List[String], x: String, i: Int) -> Int? = match scope {
  [] => none,
  [y, ..rest] => if y == x and x != "_" then some(i) else index_in(rest, x, i + 1),
}

local fn is_numeral(x: String) -> Bool = x != "" and list.all(string.chars(x), (c) => string.is_digit(c))

// A level written as a term: `2`, `u`, `u + 1`, `max(u, v)`, `imax(u, v)`.
fn level_of(lv: List[String], r: Raw) -> Level! = match r {
  RName(x) =>
    if is_numeral(x) then ok(level_of_nat(int.parse(x) ?? 0))
    else if list.contains(lv, x) then ok(LParam(x))
    else err("unknown universe level ${x} (declare it: name[${x}])"),
  RApp(RApp(RName(op), a), b) => {
    let la = level_of(lv, a)!
    match op {
      "+" => match b {
        RName(k) => if is_numeral(k) then ok(add_levels(la, int.parse(k) ?? 0)) else err("a level adds a number: u + 1"),
        _ => err("a level adds a number: u + 1"),
      },
      "max" => ok(LMax(la, level_of(lv, b)!)),
      "imax" => ok(LIMax(la, level_of(lv, b)!)),
      _ => err("not a universe level: ${op}(...)"),
    }
  },
  _ => err("not a universe level"),
}

local fn add_levels(l: Level, k: Int) -> Level = if k <= 0 then l else LSucc(add_levels(l, k - 1))

