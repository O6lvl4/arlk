// The Arlk kernel: λΠ-calculus modulo rewriting, organised into rooms.
//
// Everything a proof may rely on is either
//   - a symbol   (an assumption, opaque),
//   - a rule     (a trusted rewrite attached to a symbol of the same room),
//   - a def      (transparent, unfolds during conversion), or
//   - a theorem  (checked like a def, but opaque afterwards).
// Rooms are sealed once left: no later room can add symbols or rules to
// them, so a room's assumptions are fixed by its own text.

import self.term.{Term, shift, instantiate, subst, spine, apply, occurs, consts}
import self.pretty
import self.syntax.{Raw, Decl, Located}

// `height` is the declaration's position in the file: a def can only
// mention earlier names, so unfolding the higher one first is the
// cheapest way to make two terms meet.
//
// Entries hold only small fields: Almide copies a value on every lookup,
// so types and bodies live in their own maps and are fetched only when
// they are needed.
type Entry = { room: String, kind: String, height: Int }

// A rule's left-hand side, below its head symbol.
//   PVar(k)      binds rule variable k (Var(k) in the rule's context)
//   PSym(c, ps)  a symbol applied to patterns
//   PBracket(t)  `{t}`: not matched structurally; once every variable is
//                bound, the argument must be convertible to t
type Pat =
  | PVar(Int)
  | PSym(String, List[Pat])
  | PBracket(Term)

type Rule = {
  id: String,
  head: String,
  room: String,
  arity: Int,
  nvars: Int,
  var_tys: List[Term],
  lhs_args: List[Pat],
  rhs: Term,
  text: String,
}

// What rewriting needs of a rule, and nothing else.
type Rw = { arity: Int, nvars: Int, lhs_args: List[Pat], rhs: Term }

type Env = {
  entries: Map[String, Entry],
  types: Map[String, Term],
  // bodies of defs and theorems
  bodies: Map[String, Term],
  // def name → height; only defs unfold
  defs: Map[String, Int],
  rws: Map[String, List[Rw]],
  // every rule in declaration order, for reports
  rules: List[Rule],
  // `irrelevant` declarations, stored as rules without a right-hand side
  irrelevants: List[Rule],
  // room → every room it can see, transitively
  rooms: Map[String, List[String]],
  room: String,
  order: List[String],
}

// A typing context: innermost binder first.
type Ctx = List[(String, Term)]

fn empty() -> Env = Env {
  entries: [:],
  types: [:],
  bodies: [:],
  defs: [:],
  rws: [:],
  rules: [],
  irrelevants: [],
  rooms: ["main": []],
  room: "main",
  order: [],
}

local fn names_of(ctx: Ctx) -> List[String] = ctx |> list.map(((x, _)) => x)

local fn show(env: Env, ctx: Ctx, t: Term) -> String = pretty.show(env.room, names_of(ctx), t)

// ── Work budget ─────────────────────────────────────────────────────
//
// Rules may loop, so every reduction step and every conversion or
// normalisation call is paid for from one budget per declaration, and
// nesting is bounded too: a conversion that keeps unfolding into itself
// (`f(x) = g(f(x))`) runs out of depth instead of the stack. Running out
// is recorded, never mistaken for a normal form: the declaration is then
// rejected with "out of budget", not accepted and not reported as a
// type mismatch. So a looping rule set makes the kernel incomplete, never
// unsound and never stuck.
type Budget = { left: Int, depth: Int, exhausted: Bool }

let STEPS = 50_000_000
let MAX_DEPTH = 512

fn budget() -> Budget = Budget { left: STEPS, depth: 0, exhausted: false }

// Pay for one step; false once the budget is gone.
local fn spend(mut b: Budget) -> Bool =
  if b.exhausted or b.left <= 0 then {
    b.exhausted = true
    false
  } else {
    b.left = b.left - 1
    true
  }

// Enter one level of nesting; false (and exhausted) past the bound.
local fn enter(mut b: Budget) -> Bool =
  if not spend(b) then false
  else if b.depth >= MAX_DEPTH then {
    b.exhausted = true
    false
  } else {
    b.depth = b.depth + 1
    true
  }

local fn leave(mut b: Budget) -> Unit = {
  b.depth = b.depth - 1
}

local fn exhausted_error() -> String =
  "out of budget: reduction did not finish (a rule set that does not terminate, or a term too deep to compare)"

// ── Reduction ───────────────────────────────────────────────────────

// Weak-head normal form: β, δ (defs) and the rewrite rules. `ctx` types the
// free variables of t: matching a rule's {bracket} compares terms in it.
fn whnf(env: Env, ctx: Ctx, t: Term, mut b: Budget) -> Term = reduce(env, ctx, t, true, b)

// β and rules only: definitions stay folded, so conversion can compare
// `f a` with `f b` without unfolding f.
local fn whnf_core(env: Env, ctx: Ctx, t: Term, mut b: Budget) -> Term = reduce(env, ctx, t, false, b)

local fn reduce(env: Env, ctx: Ctx, t: Term, delta: Bool, mut b: Budget) -> Term = {
  var cur = t
  var going = true
  while going {
    if not spend(b) then {
      going = false
    } else {
      let (h, args) = spine(cur)
      match h {
        Lam(_, _, body) => match list.first(args) {
          some(a) => {
            cur = apply(subst(body, a), list.drop(args, 1))
          },
          none => {
            going = false
          },
        },
        Const(c) => match (if delta then unfold(env, c) else none) {
          some(body) => {
            cur = apply(body, args)
          },
          none => match rewrite(env, ctx, c, args, b) {
            some(t2) => {
              cur = t2
            },
            none => {
              going = false
            },
          },
        },
        _ => {
          going = false
        },
      }
    }
  }
  cur
}

local fn unfold(env: Env, c: String) -> Term? =
  if map.contains(env.defs, c) then map.get(env.bodies, c) else none

local fn rewrite(env: Env, ctx: Ctx, c: String, args: List[Term], mut b: Budget) -> Term? = {
  var found: Term? = none
  for r in map.get(env.rws, c) ?? [] {
    if found == none and not b.exhausted then {
      found = try_rule(env, ctx, r, args, b)
    } else ()
  }
  found
}

// What matching has learned so far: the bound variables, and the bracket
// checks to run once all of them are known.
type MState = { sub: Map[Int, Term], pending: List[(Term, Term)] }

local fn try_rule(env: Env, ctx: Ctx, r: Rw, args: List[Term], mut b: Budget) -> Term? =
  if list.len(args) < r.arity then none
  else match match_all(env, ctx, list.zip(r.lhs_args, list.take(args, r.arity)), b) {
    some(st) => {
      let vals = list.map(0..<r.nvars, (k) => map.get(st.sub, k) ?? Var(k))
      if brackets_hold(env, ctx, st, vals, b) then some(apply(instantiate(r.rhs, vals, 0), list.drop(args, r.arity)))
      else none
    },
    none => none,
  }

// Each {bracket} must be convertible to the argument it stands for, in the
// context the arguments live in.
local fn brackets_hold(env: Env, ctx: Ctx, st: MState, vals: List[Term], mut b: Budget) -> Bool = {
  var all = true
  for (br, t) in st.pending {
    if all then {
      all = conv(env, ctx, instantiate(br, vals, 0), t, b)
    } else ()
  }
  all
}

local fn match_all(env: Env, ctx: Ctx, pairs: List[(Pat, Term)], mut b: Budget) -> MState? = {
  var st: MState? = some(MState { sub: [:], pending: [] })
  for (p, t) in pairs {
    match st {
      some(s) => {
        st = match_pat(env, ctx, p, t, s, b)
      },
      none => (),
    }
  }
  st
}

local fn match_pat(env: Env, ctx: Ctx, p: Pat, t: Term, st: MState, mut b: Budget) -> MState? = match p {
  PVar(k) => some({ ...st, sub: map.set(st.sub, k, t) }),
  PBracket(br) => some({ ...st, pending: st.pending + [(br, t)] }),
  PSym(c, ps) => {
    let (th, targs) = spine(whnf(env, ctx, t, b))
    match th {
      Const(d) =>
        if c == d and list.len(ps) == list.len(targs) then {
          var cur: MState? = some(st)
          for (q, u) in list.zip(ps, targs) {
            match cur {
              some(s) => {
                cur = match_pat(env, ctx, q, u, s, b)
              },
              none => (),
            }
          }
          cur
        } else none,
      _ => none,
    }
  },
}

// Full normal form, for `eval`.
fn nf(env: Env, ctx: Ctx, t: Term, mut b: Budget) -> Term =
  if not enter(b) then t
  else {
    let w = whnf(env, ctx, t, b)
    let r = match w {
      Lam(x, ty, body) => {
        let ty2 = nf(env, ctx, ty, b)
        Lam(x, ty2, nf(env, [(x, ty)] + ctx, body, b))
      },
      Pi(x, ty, body) => {
        let ty2 = nf(env, ctx, ty, b)
        Pi(x, ty2, nf(env, [(x, ty)] + ctx, body, b))
      },
      _ => {
        let (h, args) = spine(w)
        var out: List[Term] = []
        for a in args {
          list.push(out, nf(env, ctx, a, b))
        }
        apply(h, out)
      },
    }
    leave(b)
    r
  }

// ── Conversion ──────────────────────────────────────────────────────

// The height of the definition at the head of t, if t's head unfolds.
local fn def_height(env: Env, t: Term) -> Int? = {
  let (h, _) = spine(t)
  match h {
    Const(c) => map.get(env.defs, c),
    _ => none,
  }
}

local fn unfold_head(env: Env, t: Term) -> Term = {
  let (h, args) = spine(t)
  match h {
    Const(c) => match unfold(env, c) {
      some(body) => apply(body, args),
      none => t,
    },
    _ => t,
  }
}

// `ctx` types the free variables of a and b: proof irrelevance and rule
// brackets consult it.
fn conv(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool =
  if a == b then true
  else if not enter(bu) then false
  else {
    // One `let` per reduced side: almide/almide#3405 merges two such
    // arguments into one.
    let wa = whnf_core(env, ctx, a, bu)
    let wb = whnf_core(env, ctx, b, bu)
    let r = conv_whnf(env, ctx, wa, wb, bu) or irrelevant_eq(env, ctx, a, b, bu)
    leave(bu)
    r
  }

local fn conv_whnf(env: Env, ctx: Ctx, wa: Term, wb: Term, mut bu: Budget) -> Bool =
  if wa == wb then true
  else if bu.exhausted then false
  else {
    // Nested matches rather than `match (wa, wb)`: almide/almide#3390.
    match wa {
      Sort(i) => match wb {
        Sort(j) => i == j,
        _ => conv_delta(env, ctx, wa, wb, bu),
      },
      Pi(x, t1, b1) => match wb {
        Pi(_, t2, b2) => conv(env, ctx, t1, t2, bu) and conv(env, [(x, t1)] + ctx, b1, b2, bu),
        _ => conv_delta(env, ctx, wa, wb, bu),
      },
      // η: (fun x => f x) ≡ f
      Lam(x, t1, b1) => match wb {
        Lam(_, t2, b2) => conv(env, ctx, t1, t2, bu) and conv(env, [(x, t1)] + ctx, b1, b2, bu),
        _ => conv(env, [(x, t1)] + ctx, b1, App(shift(wb, 1, 0), Var(0)), bu),
      },
      _ => match wb {
        Lam(x, t2, b2) => conv(env, [(x, t2)] + ctx, App(shift(wa, 1, 0), Var(0)), b2, bu),
        _ => same_head_args(env, ctx, wa, wb, bu) or conv_delta(env, ctx, wa, wb, bu),
      },
    }
  }

local fn all_conv(env: Env, ctx: Ctx, xs: List[Term], ys: List[Term], mut bu: Budget) -> Bool =
  if list.len(xs) != list.len(ys) then false
  else {
    var all = true
    for (x, y) in list.zip(xs, ys) {
      if all then {
        all = conv(env, ctx, x, y, bu)
      } else ()
    }
    all
  }

// Same head constant and convertible arguments: equal without unfolding.
local fn same_head_args(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool = {
  let (ha, xs) = spine(a)
  let (hb, ys) = spine(b)
  match ha {
    Const(c) => match hb {
      Const(d) => c == d and all_conv(env, ctx, xs, ys, bu),
      _ => false,
    },
    _ => false,
  }
}

// Unfold one step on the side whose head was defined later, then retry.
local fn conv_delta(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool =
  if not spend(bu) then false
  else match def_height(env, a) {
    some(ha) => match def_height(env, b) {
      some(hb) =>
        if ha > hb then conv_whnf(env, ctx, whnf_core(env, ctx, unfold_head(env, a), bu), b, bu)
        else if hb > ha then conv_whnf(env, ctx, a, whnf_core(env, ctx, unfold_head(env, b), bu), bu)
        else {
          let wa = whnf_core(env, ctx, unfold_head(env, a), bu)
          let wb = whnf_core(env, ctx, unfold_head(env, b), bu)
          conv_whnf(env, ctx, wa, wb, bu)
        },
      none => conv_whnf(env, ctx, whnf_core(env, ctx, unfold_head(env, a), bu), b, bu),
    },
    none => match def_height(env, b) {
      some(_) => conv_whnf(env, ctx, a, whnf_core(env, ctx, unfold_head(env, b), bu), bu),
      none => conv_spines(env, ctx, a, b, bu),
    },
  }

local fn conv_spines(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool = {
  let (ha, xs) = spine(a)
  let (hb, ys) = spine(b)
  let heads = match (ha, hb) {
    (Var(i), Var(j)) => i == j,
    (Const(c), Const(d)) => c == d,
    _ => false,
  }
  heads and all_conv(env, ctx, xs, ys, bu)
}

// ── Proof irrelevance ───────────────────────────────────────────────

// Two terms are equal when both inhabit the same type and that type was
// declared `irrelevant` (in Lean's room: every proposition).
local fn irrelevant_eq(env: Env, ctx: Ctx, a: Term, b: Term, mut bu: Budget) -> Bool =
  if list.is_empty(env.irrelevants) or bu.exhausted then false
  else match infer(env, ctx, a, bu) {
    ok(ta) =>
      if is_irrelevant_type(env, ctx, ta, bu) then match infer(env, ctx, b, bu) {
        ok(tb) => conv(env, ctx, ta, tb, bu),
        err(_) => false,
      }
      else false,
    err(_) => false,
  }

// Checked before and after reduction: reducing `El lz (p -> q)` turns it
// into an Arlk function type, which no longer has the declared shape. A
// function type into an irrelevant type is itself irrelevant (its values
// are equal pointwise, and conversion has η).
local fn is_irrelevant_type(env: Env, ctx: Ctx, t: Term, mut bu: Budget) -> Bool =
  if not enter(bu) then false
  else {
    let r = irrelevant_shape(env, ctx, t, bu) or irrelevant_shape(env, ctx, whnf_core(env, ctx, t, bu), bu) or {
      let w = whnf(env, ctx, t, bu)
      match w {
        Pi(x, dom, body) => is_irrelevant_type(env, [(x, dom)] + ctx, body, bu),
        _ => irrelevant_shape(env, ctx, w, bu),
      }
    }
    leave(bu)
    r
  }

local fn irrelevant_shape(env: Env, ctx: Ctx, t: Term, mut bu: Budget) -> Bool = {
  let (h, args) = spine(t)
  match h {
    Const(c) => {
      var found = false
      for ir in env.irrelevants {
        if not found and ir.head == c then {
          found = irrelevant_matches(env, ctx, ir, args, bu)
        } else ()
      }
      found
    },
    _ => false,
  }
}

local fn irrelevant_matches(env: Env, ctx: Ctx, ir: Rule, args: List[Term], mut bu: Budget) -> Bool =
  if list.len(args) != ir.arity then false
  else match match_all(env, ctx, list.zip(ir.lhs_args, args), bu) {
    some(st) => brackets_hold(env, ctx, st, list.map(0..<ir.nvars, (k) => map.get(st.sub, k) ?? Var(k)), bu),
    none => false,
  }

// ── Typing ──────────────────────────────────────────────────────────

fn infer(env: Env, ctx: Ctx, t: Term, mut bu: Budget) -> Term! = match t {
  Sort(0) => ok(Sort(1)),
  Sort(_) => err("Kind has no type"),
  Var(i) => match list.get(ctx, i) {
    some((_, ty)) => ok(shift(ty, i + 1, 0)),
    none => err("unbound variable #${int.to_string(i)}"),
  },
  Const(c) => match map.get(env.types, c) {
    some(ty) => ok(ty),
    none => err("unknown constant ${c}"),
  },
  App(f, a) => {
    let tf = infer(env, ctx, f, bu)!
    match whnf(env, ctx, tf, bu) {
      Pi(_, dom, cod) => {
        check(env, ctx, a, dom, bu)!
        ok(subst(cod, a))
      },
      other => {
        guard not bu.exhausted else err(exhausted_error())
        let msg = "${show(env, ctx, f)} is applied to an argument, but its type is ${show(env, ctx, other)}"
        err(msg)
      },
    }
  },
  Lam(x, ty, body) => {
    expect_sort(env, ctx, ty, false, bu)!
    let tb = infer(env, [(x, ty)] + ctx, body, bu)!
    guard tb != Sort(1) else err("a function cannot return Kind")
    ok(Pi(x, ty, tb))
  },
  Pi(x, ty, body) => {
    expect_sort(env, ctx, ty, false, bu)!
    let s = expect_sort(env, [(x, ty)] + ctx, body, true, bu)!
    ok(s)
  },
}

// The type of `t` must be a sort. Domains must live in Type (λΠ has no
// polymorphism); codomains may be Type or Kind.
local fn expect_sort(env: Env, ctx: Ctx, t: Term, allow_kind: Bool, mut bu: Budget) -> Term! = {
  let ty = infer(env, ctx, t, bu)!
  let s = whnf(env, ctx, ty, bu)
  guard not bu.exhausted else err(exhausted_error())
  match s {
    Sort(0) => ok(s),
    Sort(_) => if allow_kind then ok(s) else err("${show(env, ctx, t)} is a kind, but a type was expected here"),
    other => err("${show(env, ctx, t)} is not a type (its type is ${show(env, ctx, other)})"),
  }
}

fn check(env: Env, ctx: Ctx, t: Term, expected: Term, mut bu: Budget) -> Unit! = {
  let actual = infer(env, ctx, t, bu)!
  let same = conv(env, ctx, actual, expected, bu)
  guard not bu.exhausted else err(exhausted_error())
  guard same else err("type mismatch for ${show(env, ctx, t)}\n    expected: ${show(env, ctx, expected)}\n    found:    ${show(env, ctx, actual)}")
  ok(())
}

// ── Rooms and names ─────────────────────────────────────────────────

// Names inside a room may contain dots (`Nat.add`); the room is recorded
// in the entry, not parsed out of the name.
local fn room_of(env: Env, q: String) -> String = match map.get(env.entries, q) {
  some(e) => e.room,
  none => "",
}

local fn visible(env: Env) -> List[String] = [env.room] + (map.get(env.rooms, env.room) ?? [])

// A name resolves, in order, to: this room's declaration, a declaration
// written with its room in front (`logic.Prf`), or a unique declaration of
// a visible room.
fn resolve_const(env: Env, x: String) -> String! = {
  let own = env.room + "." + x
  // The own-room shortcut only counts if the entry really is this room's:
  // `room a` + `b.T` and `room a.b` + `T` spell the same key (issue #2).
  if map.contains(env.entries, own) and room_of(env, own) == env.room then ok(own)
  else {
    let rooms = visible(env)
    let qualified = if map.contains(env.entries, x) then [x] else []
    let found = list.unique(qualified + (rooms |> list.map((r) => r + "." + x) |> list.filter((q) => map.contains(env.entries, q))))
    match found {
      [] => err("unknown name ${x}"),
      [q] => {
        let r = room_of(env, q)
        guard list.contains(rooms, r) else err("${x} lives in room ${r}, which ${env.room} does not use (add `uses ${r}`)")
        ok(q)
      },
      many => err("${x} is ambiguous: ${list.join(many, ", ")}"),
    }
  }
}

local fn index_in(scope: List[String], x: String, i: Int) -> Int? = match scope {
  [] => none,
  [y, ..rest] => if y == x and x != "_" then some(i) else index_in(rest, x, i + 1),
}

// Named surface terms → de Bruijn terms. `scope` is innermost first.
// A bracket is transparent here; only rule patterns give it meaning.
fn resolve(env: Env, scope: List[String], r: Raw) -> Term! = match r {
  RName(x) => match index_in(scope, x, 0) {
    some(i) => ok(Var(i)),
    none => ok(Const(resolve_const(env, x)!)),
  },
  RType => ok(Sort(0)),
  RApp(f, a) => ok(App(resolve(env, scope, f)!, resolve(env, scope, a)!)),
  RLam(x, ty, b) => ok(Lam(x, resolve(env, scope, ty)!, resolve(env, [x] + scope, b)!)),
  RPi(x, ty, b) => ok(Pi(x, resolve(env, scope, ty)!, resolve(env, [x] + scope, b)!)),
  RBracket(inner) => resolve(env, scope, inner),
}

local fn has_bracket(r: Raw) -> Bool = match r {
  RBracket(_) => true,
  RApp(f, a) => has_bracket(f) or has_bracket(a),
  RLam(_, ty, b) => has_bracket(ty) or has_bracket(b),
  RPi(_, ty, b) => has_bracket(ty) or has_bracket(b),
  _ => false,
}

local fn no_brackets(rs: List[Raw]) -> Unit! = {
  guard not list.any(rs, (r) => has_bracket(r)) else err("brackets {...} are only allowed in the left-hand side of a rule")
  ok(())
}

// ── Declarations ────────────────────────────────────────────────────

// What a checked declaration adds to the environment. Checking is pure;
// `commit` then updates the environment in place, because a functional
// `map.set` copies the whole map on every declaration (almide/almide#3404).
type Change =
  | Declare(String, Entry, Term, Term?)
  | EnterRoom(String, List[String])
  | AddRule(Rule)
  | AddIrrelevant(Rule)
  | NoChange

local fn declare(env: Env, name: String, kind: String, ty: Term, body: Term?) -> Change! = {
  let q = env.room + "." + name
  guard not map.contains(env.entries, q) else err("${q} is already declared")
  ok(Declare(q, Entry { room: env.room, kind: kind, height: list.len(env.order) }, ty, body))
}

local fn enter_room(env: Env, name: String, uses: List[String]) -> Change! = {
  guard not map.contains(env.rooms, name) else err("room ${name} already exists; rooms are sealed once left")
  let missing = uses |> list.filter((u) => not map.contains(env.rooms, u))
  guard list.is_empty(missing) else err("unknown room ${list.join(missing, ", ")}")
  let seen = uses + (uses |> list.flat_map((u) => map.get(env.rooms, u) ?? []))
  ok(EnterRoom(name, list.unique(seen)))
}

local fn commit(mut env: Env, c: Change) -> Unit = match c {
  Declare(q, entry, ty, body) => {
    map.insert(env.entries, q, entry)
    map.insert(env.types, q, ty)
    match body {
      some(b) => map.insert(env.bodies, q, b),
      none => (),
    }
    if entry.kind == "def" then map.insert(env.defs, q, entry.height) else ()
    list.push(env.order, q)
  },
  EnterRoom(name, seen) => {
    map.insert(env.rooms, name, seen)
    env.room = name
  },
  AddRule(r) => {
    let rw = Rw { arity: r.arity, nvars: r.nvars, lhs_args: r.lhs_args, rhs: r.rhs }
    let existing = map.get(env.rws, r.head) ?? []
    map.insert(env.rws, r.head, existing + [rw])
    list.push(env.rules, r)
  },
  AddIrrelevant(r) => list.push(env.irrelevants, r),
  NoChange => (),
}

// `match` rather than `?.kind`: almide/almide#3391 (wasm).
local fn is_symbol(env: Env, c: String) -> Bool = match map.get(env.entries, c) {
  some(e) => e.kind == "symbol",
  none => false,
}

local fn raw_spine(r: Raw, args: List[Raw]) -> (Raw, List[Raw]) = match r {
  RApp(f, a) => raw_spine(f, [a] + args),
  other => (other, args),
}

// Build a pattern from surface syntax. In a rule, every bound name is a
// rule variable (the scope holds nothing else).
local fn resolve_pat(env: Env, scope: List[String], r: Raw) -> Pat! = {
  let (h, args) = raw_spine(r, [])
  match h {
    RBracket(inner) => {
      guard list.is_empty(args) else err("a bracket cannot be applied to arguments in a pattern")
      ok(PBracket(resolve(env, scope, inner)!))
    },
    RName(x) => match index_in(scope, x, 0) {
      some(k) => {
        guard list.is_empty(args) else err("a rule variable cannot be applied to arguments in a pattern (${x})")
        ok(PVar(k))
      },
      none => {
        let c = resolve_const(env, x)!
        guard is_symbol(env, c) else err("${c} is not a symbol, so it cannot appear in a pattern")
        let ps = args |> list.map((a) => resolve_pat(env, scope, a)!)!
        ok(PSym(c, ps))
      },
    },
    _ => err("patterns are built from symbols, rule variables and {brackets}"),
  }
}

local fn pat_vars(p: Pat) -> List[Int] = match p {
  PVar(k) => [k],
  PSym(_, ps) => ps |> list.flat_map((q) => pat_vars(q)),
  PBracket(_) => [],
}

local fn pat_brackets(p: Pat) -> List[Term] = match p {
  PVar(_) => [],
  PSym(_, ps) => ps |> list.flat_map((q) => pat_brackets(q)),
  PBracket(t) => [t],
}

local fn pat_consts(p: Pat) -> List[String] = match p {
  PVar(_) => [],
  PSym(c, ps) => [c] + (ps |> list.flat_map((q) => pat_consts(q))),
  PBracket(t) => consts(t),
}

// Free variables of t, as indices into the context t lives in.
local fn free_vars(t: Term, depth: Int) -> List[Int] = match t {
  Var(i) => if i >= depth then [i - depth] else [],
  App(f, a) => free_vars(f, depth) + free_vars(a, depth),
  Lam(_, ty, b) => free_vars(ty, depth) + free_vars(b, depth + 1),
  Pi(_, ty, b) => free_vars(ty, depth) + free_vars(b, depth + 1),
  _ => [],
}

// The shared front half of `rule` and `irrelevant`: the variable context,
// the head symbol (of this room), and the argument patterns.
type Lhs = { ctx: Ctx, scope: List[String], head: String, pats: List[Pat], term: Term }

local fn rule_lhs(env: Env, vars: List[(String, Raw)], lhs_raw: Raw, mut bu: Budget) -> Lhs! = {
  // Build the rule context left to right; Var(0) is the last variable.
  var ctx: Ctx = []
  var scope: List[String] = []
  for (x, ty_raw) in vars {
    no_brackets([ty_raw])!
    let ty = resolve(env, scope, ty_raw)!
    expect_sort(env, ctx, ty, true, bu)!
    ctx = [(x, ty)] + ctx
    scope = [x] + scope
  }
  let n = list.len(vars)
  let (head_raw, arg_raws) = raw_spine(lhs_raw, [])
  let head = match head_raw {
    RName(x) => ok(resolve_const(env, x)!),
    _ => err("the left-hand side must start with a symbol"),
  }!
  guard is_symbol(env, head) else err("${head} is not a symbol; only symbols can have rules")
  let owner = room_of(env, head)
  guard owner == env.room else err("${head} belongs to room ${owner}; rules can only be added to symbols of the current room (${env.room})")
  guard not list.is_empty(arg_raws) else err("the left-hand side needs at least one argument pattern")
  let pats = arg_raws |> list.map((a) => resolve_pat(env, scope, a)!)!
  let bound = pats |> list.flat_map((p) => pat_vars(p))
  guard list.len(list.unique(bound)) == list.len(bound) else err("a rule variable can be matched only once; write {x} for the other occurrences")
  let unbound = list.map(0..<n, (k) => k) |> list.filter((k) => not list.contains(bound, k))
  guard list.is_empty(unbound) else err("every rule variable must appear on the left-hand side outside brackets")
  let in_brackets = pats |> list.flat_map((p) => pat_brackets(p)) |> list.flat_map((t) => free_vars(t, 0))
  guard list.all(in_brackets, (k) => list.contains(bound, k)) else err("a bracket mentions a variable that the pattern does not bind")
  // Brackets read as the terms they stand for.
  let lhs = resolve(env, scope, lhs_raw)!
  ok(Lhs { ctx: ctx, scope: scope, head: head, pats: pats, term: lhs })
}

local fn add_rule(mut env: Env, vars: List[(String, Raw)], lhs_raw: Raw, rhs_raw: Raw, line: Int) -> Change! = {
  no_brackets([rhs_raw])!
  var bu = budget()
  let l = rule_lhs(env, vars, lhs_raw, bu)!
  let ctx = l.ctx
  let rhs = resolve(env, l.scope, rhs_raw)!
  let tl = infer(env, ctx, l.term, bu)!
  let tr = infer(env, ctx, rhs, bu)!
  let text = "${show(env, ctx, l.term)} = ${show(env, ctx, rhs)}"
  let same = conv(env, ctx, tl, tr, bu)
  guard not bu.exhausted else err(exhausted_error())
  guard same else err("rule does not preserve types: ${text}\n    left:  ${show(env, ctx, tl)}\n    right: ${show(env, ctx, tr)}")
  let r = Rule {
    id: "${env.room}:${int.to_string(line)}",
    head: l.head,
    room: env.room,
    arity: list.len(l.pats),
    nvars: list.len(vars),
    var_tys: ctx |> list.map(((_, ty)) => ty),
    lhs_args: l.pats,
    rhs: rhs,
    text: text,
  }
  ok(AddRule(r))
}

// `irrelevant [x : A] T.`: every two values of an instance of T are equal.
local fn add_irrelevant(mut env: Env, vars: List[(String, Raw)], ty_raw: Raw, line: Int) -> Change! = {
  var bu = budget()
  let l = rule_lhs(env, vars, ty_raw, bu)!
  expect_sort(env, l.ctx, l.term, false, bu)!
  let r = Rule {
    id: "${env.room}:${int.to_string(line)}",
    head: l.head,
    room: env.room,
    arity: list.len(l.pats),
    nvars: list.len(vars),
    var_tys: l.ctx |> list.map(((_, ty)) => ty),
    lhs_args: l.pats,
    rhs: l.term,
    text: "irrelevant ${show(env, l.ctx, l.term)}",
  }
  ok(AddIrrelevant(r))
}

// Process one declaration: check it, add it to `env` if it is good, and
// return the lines to print. A declaration that fails leaves `env` as it was.
fn process(mut env: Env, d: Located) -> List[String]! = {
  let (change, lines) = examine(env, d)!
  commit(env, change)
  ok(lines)
}

// `mut` only so that the call from `process` borrows the environment instead
// of copying it (it is not changed here).
local fn examine(mut env: Env, d: Located) -> (Change, List[String])! = match d.decl {
  DRoom(name, uses) => ok((enter_room(env, name, uses)!, [])),
  DSymbol(name, ty_raw) => {
    no_brackets([ty_raw])!
    let ty = resolve(env, [], ty_raw)!
    var bu = budget()
    expect_sort(env, [], ty, true, bu)!
    ok((declare(env, name, "symbol", ty, none)!, []))
  },
  DDef(name, ty_raw, body_raw) => {
    let (ty, body) = typed_body(env, ty_raw, body_raw)!
    ok((declare(env, name, "def", ty, some(body))!, []))
  },
  DTheorem(name, ty_raw, body_raw) => {
    let (ty, body) = typed_body(env, ty_raw, body_raw)!
    let c = declare(env, name, "theorem", ty, some(body))!
    ok((c, ["✓ theorem ${env.room}.${name}: ${show(env, [], ty)}"]))
  },
  DRule(vars, lhs, rhs) => ok((add_rule(env, vars, lhs, rhs, d.line)!, [])),
  DIrrelevant(vars, ty) => ok((add_irrelevant(env, vars, ty, d.line)!, [])),
  DCheck(e_raw) => {
    no_brackets([e_raw])!
    let e = resolve(env, [], e_raw)!
    var bu = budget()
    let ty = infer(env, [], e, bu)!
    ok((NoChange, ["${show(env, [], e)}: ${show(env, [], ty)}"]))
  },
  DEval(e_raw) => {
    no_brackets([e_raw])!
    let e = resolve(env, [], e_raw)!
    var bu = budget()
    infer(env, [], e, bu)!
    let v = nf(env, [], e, bu)
    guard not bu.exhausted else err(exhausted_error())
    ok((NoChange, ["${show(env, [], e)} = ${show(env, [], v)}"]))
  },
  DAxioms(name) => {
    let q = resolve_const(env, name)!
    ok((NoChange, report_axioms(env, q)))
  },
}

local fn typed_body(env: Env, ty_raw: Raw, body_raw: Raw) -> (Term, Term)! = {
  no_brackets([ty_raw, body_raw])!
  let ty = resolve(env, [], ty_raw)!
  var bu = budget()
  expect_sort(env, [], ty, true, bu)!
  let body = resolve(env, [], body_raw)!
  check(env, [], body, ty, bu)!
  ok((ty, body))
}

// ── Dependency tracking ─────────────────────────────────────────────

type Deps = { symbols: List[String], rules: List[Rule], lemmas: List[String] }

// Everything `name` rests on: the symbols it assumes, the rules attached to
// them, and the defs/theorems it goes through. Transitive.
fn deps(env: Env, name: String) -> Deps = {
  // A loop with an explicit stack: dependency chains in absorbed libraries
  // run thousands of declarations deep.
  var pending: List[String] = [name]
  var seen: Map[String, Bool] = [:]
  var symbols: List[String] = []
  var rules: List[Rule] = []
  var lemmas: List[String] = []
  var queued: List[String] = []
  while not list.is_empty(pending) {
    let c = list.pop(pending) ?? ""
    if map.contains(seen, c) then () else {
      map.insert(seen, c, true)
      match map.get(env.entries, c) {
        none => (),
        some(e) => {
          if e.kind == "symbol" then {
            list.push(symbols, c)
            for r in env.rules + env.irrelevants {
              if r.head == c then {
                list.push(rules, r)
                for m in list.reverse(rule_mentions(r)) {
                  list.push(queued, m)
                }
              } else ()
            }
          } else if c != name then list.push(lemmas, c) else ()
          // Visit in source order: the type, then the body, then the rules.
          let body = match map.get(env.bodies, c) {
            some(b) => consts(b),
            none => [],
          }
          let ty = match map.get(env.types, c) {
            some(t) => consts(t),
            none => [],
          }
          for m in queued {
            list.push(pending, m)
          }
          queued = []
          for m in list.reverse(ty + body) {
            list.push(pending, m)
          }
        },
      }
    }
  }
  Deps { symbols: symbols, rules: rules, lemmas: lemmas }
}

local fn rule_mentions(r: Rule) -> List[String] =
  (r.var_tys |> list.flat_map((t) => consts(t)))
    + (r.lhs_args |> list.flat_map((p) => pat_consts(p)))
    + consts(r.rhs)

local fn report_axioms(env: Env, q: String) -> List[String] = {
  let d = deps(env, q)
  let rooms = list.unique((d.symbols |> list.map((s) => room_of(env, s))) + (d.rules |> list.map((r) => r.room)))
  let header = ["axioms ${q}", "  rooms:   ${list.join(rooms, ", ")}"]
  let syms = if list.is_empty(d.symbols) then ["  symbols: (none)"] else ["  symbols: ${list.join(d.symbols, ", ")}"]
  let rules = if list.is_empty(d.rules) then ["  rules:   (none)"]
    else d.rules |> list.enumerate |> list.map(((i, r)) =>
      (if i == 0 then "  rules:   " else "           ") + "[${r.id}] ${r.text}")
  let lemmas = if list.is_empty(d.lemmas) then [] else ["  through: ${list.join(d.lemmas, ", ")}"]
  header + syms + rules + lemmas
}

// ── Whole files ─────────────────────────────────────────────────────

type Outcome = { env: Env, output: List[String], error: String? }

// Check declarations in order, stopping at the first failure.
fn check_all(env: Env, ds: List[Located]) -> Outcome = {
  var cur = env
  var out: List[String] = []
  var error: String? = none
  for d in ds {
    if error == none then match process(cur, d) {
      ok(lines) => {
        for l in lines {
          list.push(out, l)
        }
      },
      err(e) => {
        error = some("${int.to_string(d.line)}: ${e}")
      },
    } else ()
  }
  Outcome { env: cur, output: out, error: error }
}
