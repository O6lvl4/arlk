// The declaration checker: surface syntax to kernel terms, declarations,
// rewrite rules, inductive types, and the `axioms` report. Everything it
// adds to an environment has been checked by the kernel (kernel.almd).

import self.term.{Term, Level, shift, instantiate, subst, spine, apply, occurs, consts, level_eq, levels_eq, level_leq, inst_levels, type0, level_of_nat}
import self.syntax.{Raw, Decl, Located, Inductive}
import self.kernel.{Env, Entry, Pat, Rule, Rw, Ctx, Budget, MState, budget, whnf, nf, conv, infer, check, expect_sort, resolve_const, room_of, show, exhausted_error, match_all}
import self.inductive

local fn index_in(scope: List[String], x: String, i: Int) -> Int? = match scope {
  [] => none,
  [y, ..rest] => if y == x and x != "_" then some(i) else index_in(rest, x, i + 1),
}

// Named surface terms → de Bruijn terms. `scope` is innermost first; `lv`
// holds the universe parameters in scope. A bracket is transparent here;
// only rule patterns give it meaning.
fn resolve(env: Env, lv: List[String], scope: List[String], r: Raw) -> Term! = match r {
  RName(x) => match index_in(scope, x, 0) {
    some(i) => ok(Var(i)),
    none => {
      let c = resolve_const(env, x)!
      let ps = map.get(env.lparams, c) ?? []
      guard list.is_empty(ps) else err("${x} takes universe levels: write ${x}[${list.join(ps, ", ")}]")
      ok(Const(c, []))
    },
  },
  RInst(x, ls) => {
    let c = resolve_const(env, x)!
    var levels: List[Level] = []
    for l in ls {
      list.push(levels, level_of(lv, l)!)
    }
    ok(Const(c, levels))
  },
  RType => ok(type0()),
  RSort => err("Sort needs a level: Sort(0) is Prop, Sort(1) is Type"),
  RApp(RSort, l) => ok(Sort(level_of(lv, l)!)),
  RApp(RType, l) => ok(Sort(LSucc(level_of(lv, l)!))),
  RApp(f, a) => ok(App(resolve(env, lv, scope, f)!, resolve(env, lv, scope, a)!)),
  RLam(x, ty, b) => ok(Lam(x, resolve(env, lv, scope, ty)!, resolve(env, lv, [x] + scope, b)!)),
  RPi(x, ty, b) => ok(Pi(x, resolve(env, lv, scope, ty)!, resolve(env, lv, [x] + scope, b)!)),
  RBracket(inner) => resolve(env, lv, scope, inner),
}

local fn is_numeral(x: String) -> Bool = x != "" and list.all(string.chars(x), (c) => string.is_digit(c))

// A level written as a term: `2`, `u`, `u + 1`, `max(u, v)`, `imax(u, v)`.
fn level_of(lv: List[String], r: Raw) -> Level! = match r {
  RName(x) =>
    if is_numeral(x) then ok(level_of_nat(int.parse(x) ?? 0))
    else if list.contains(lv, x) then ok(LParam(x))
    else err("unknown universe level ${x} (declare it: name[${x}])"),
  RApp(RApp(RName(op), a), b) => {
    let la = level_of(lv, a)!
    match op {
      "+" => match b {
        RName(k) => if is_numeral(k) then ok(add_levels(la, int.parse(k) ?? 0)) else err("a level adds a number: u + 1"),
        _ => err("a level adds a number: u + 1"),
      },
      "max" => ok(LMax(la, level_of(lv, b)!)),
      "imax" => ok(LIMax(la, level_of(lv, b)!)),
      _ => err("not a universe level: ${op}(...)"),
    }
  },
  _ => err("not a universe level"),
}

local fn add_levels(l: Level, k: Int) -> Level = if k <= 0 then l else LSucc(add_levels(l, k - 1))

local fn has_bracket(r: Raw) -> Bool = match r {
  RBracket(_) => true,
  RApp(f, a) => has_bracket(f) or has_bracket(a),
  RLam(_, ty, b) => has_bracket(ty) or has_bracket(b),
  RPi(_, ty, b) => has_bracket(ty) or has_bracket(b),
  _ => false,
}

local fn no_brackets(rs: List[Raw]) -> Unit! = {
  guard not list.any(rs, (r) => has_bracket(r)) else err("brackets {...} are only allowed in the left-hand side of a rule")
  ok(())
}

// ── Declarations ────────────────────────────────────────────────────

// What a checked declaration adds to the environment. Checking is pure;
// `commit` then updates the environment in place, because a functional
// `map.set` copies the whole map on every declaration (almide/almide#3404).
type Change =
  | Declare(String, List[String], Entry, Term, Term?)
  | EnterRoom(String, List[String])
  | AddRule(Rule)
  | AddIrrelevant(Rule)
  | NoChange

local fn declare(env: Env, name: String, lv: List[String], kind: String, ty: Term, body: Term?) -> Change! = {
  let q = env.room + "." + name
  guard not map.contains(env.entries, q) else err("${q} is already declared")
  guard list.len(list.unique(lv)) == list.len(lv) else err("${name} lists a universe parameter twice")
  ok(Declare(q, lv, Entry { room: env.room, kind: kind, height: list.len(env.order) }, ty, body))
}

local fn enter_room(env: Env, name: String, uses: List[String]) -> Change! = {
  guard not map.contains(env.rooms, name) else err("room ${name} already exists; rooms are sealed once left")
  let missing = uses |> list.filter((u) => not map.contains(env.rooms, u))
  guard list.is_empty(missing) else err("unknown room ${list.join(missing, ", ")}")
  let seen = uses + (uses |> list.flat_map((u) => map.get(env.rooms, u) ?? []))
  ok(EnterRoom(name, list.unique(seen)))
}

local fn commit(mut env: Env, c: Change) -> Unit = match c {
  Declare(q, lv, entry, ty, body) => {
    map.insert(env.entries, q, entry)
    if list.is_empty(lv) then () else map.insert(env.lparams, q, lv)
    map.insert(env.types, q, ty)
    match body {
      some(b) => map.insert(env.bodies, q, b),
      none => (),
    }
    if entry.kind == "def" then map.insert(env.defs, q, entry.height) else ()
    list.push(env.order, q)
  },
  EnterRoom(name, seen) => {
    map.insert(env.rooms, name, seen)
    env.room = name
  },
  AddRule(r) => {
    let rw = Rw { arity: r.arity, nvars: r.nvars, lhs_args: r.lhs_args, rhs: r.rhs, lparams: r.lparams }
    let existing = map.get(env.rws, r.head) ?? []
    map.insert(env.rws, r.head, existing + [rw])
    list.push(env.rules, r)
  },
  AddIrrelevant(r) => list.push(env.irrelevants, r),
  NoChange => (),
}

// `match` rather than `?.kind`: almide/almide#3391 (wasm).
local fn is_symbol(env: Env, c: String) -> Bool = match map.get(env.entries, c) {
  some(e) => e.kind == "symbol",
  none => false,
}

local fn raw_spine(r: Raw, args: List[Raw]) -> (Raw, List[Raw]) = match r {
  RApp(f, a) => raw_spine(f, [a] + args),
  other => (other, args),
}

// Build a pattern from surface syntax. In a rule, every bound name is a
// rule variable (the scope holds nothing else).
// A symbol in a pattern matches at any universe levels: typing fixes them.
local fn resolve_pat(env: Env, lv: List[String], scope: List[String], r: Raw) -> Pat! = {
  let (h, args) = raw_spine(r, [])
  match h {
    RBracket(inner) => {
      guard list.is_empty(args) else err("a bracket cannot be applied to arguments in a pattern")
      ok(PBracket(resolve(env, lv, scope, inner)!))
    },
    RName(x) => match index_in(scope, x, 0) {
      some(k) => {
        guard list.is_empty(args) else err("a rule variable cannot be applied to arguments in a pattern (${x})")
        ok(PVar(k))
      },
      none => pat_symbol(env, lv, scope, x, args),
    },
    RInst(x, _) => pat_symbol(env, lv, scope, x, args),
    _ => err("patterns are built from symbols, rule variables and {brackets}"),
  }
}

local fn pat_symbol(env: Env, lv: List[String], scope: List[String], x: String, args: List[Raw]) -> Pat! = {
  let c = resolve_const(env, x)!
  guard is_symbol(env, c) else err("${c} is not a symbol, so it cannot appear in a pattern")
  let ps = args |> list.map((a) => resolve_pat(env, lv, scope, a)!)!
  ok(PSym(c, ps))
}

local fn pat_vars(p: Pat) -> List[Int] = match p {
  PVar(k) => [k],
  PSym(_, ps) => ps |> list.flat_map((q) => pat_vars(q)),
  PBracket(_) => [],
}

local fn pat_brackets(p: Pat) -> List[Term] = match p {
  PVar(_) => [],
  PSym(_, ps) => ps |> list.flat_map((q) => pat_brackets(q)),
  PBracket(t) => [t],
}

local fn pat_consts(p: Pat) -> List[String] = match p {
  PVar(_) => [],
  PSym(c, ps) => [c] + (ps |> list.flat_map((q) => pat_consts(q))),
  PBracket(t) => consts(t),
}

// Free variables of t, as indices into the context t lives in.
local fn free_vars(t: Term, depth: Int) -> List[Int] = match t {
  Var(i) => if i >= depth then [i - depth] else [],
  App(f, a) => free_vars(f, depth) + free_vars(a, depth),
  Lam(_, ty, b) => free_vars(ty, depth) + free_vars(b, depth + 1),
  Pi(_, ty, b) => free_vars(ty, depth) + free_vars(b, depth + 1),
  _ => [],
}

// The shared front half of `rule` and `irrelevant`: the variable context,
// the head symbol (of this room), and the argument patterns.
type Lhs = { ctx: Ctx, scope: List[String], head: String, pats: List[Pat], term: Term, lparams: List[String] }

// The head of a rule's left-hand side, and the universe parameters it is
// written at: `Nat.rec[u](...)` makes u a parameter of the rule.
local fn rule_head(env: Env, lhs_raw: Raw) -> (String, List[String])! = {
  let (head_raw, _) = raw_spine(lhs_raw, [])
  match head_raw {
    RName(x) => ok((resolve_const(env, x)!, [])),
    RInst(x, ls) => {
      var names: List[String] = []
      for l in ls {
        match l {
          RName(u) => list.push(names, u),
          _ => (),
        }
      }
      guard list.len(names) == list.len(ls) and list.len(list.unique(names)) == list.len(names) else err("the head of a rule takes distinct universe parameters: ${x}[u, v]")
      ok((resolve_const(env, x)!, names))
    },
    _ => err("the left-hand side must start with a symbol"),
  }
}

local fn rule_lhs(env: Env, vars: List[(String, Raw)], lhs_raw: Raw, mut bu: Budget) -> Lhs! = {
  let (head, lv) = rule_head(env, lhs_raw)!
  // Build the rule context left to right; Var(0) is the last variable.
  var ctx: Ctx = []
  var scope: List[String] = []
  for (x, ty_raw) in vars {
    no_brackets([ty_raw])!
    let ty = resolve(env, lv, scope, ty_raw)!
    expect_sort(env, ctx, ty, bu)!
    ctx = [(x, ty)] + ctx
    scope = [x] + scope
  }
  let n = list.len(vars)
  let (_, arg_raws) = raw_spine(lhs_raw, [])
  guard is_symbol(env, head) else err("${head} is not a symbol; only symbols can have rules")
  let owner = room_of(env, head)
  guard owner == env.room else err("${head} belongs to room ${owner}; rules can only be added to symbols of the current room (${env.room})")
  guard not list.is_empty(arg_raws) else err("the left-hand side needs at least one argument pattern")
  let pats = arg_raws |> list.map((a) => resolve_pat(env, lv, scope, a)!)!
  let bound = pats |> list.flat_map((p) => pat_vars(p))
  guard list.len(list.unique(bound)) == list.len(bound) else err("a rule variable can be matched only once; write {x} for the other occurrences")
  let unbound = list.map(0..<n, (k) => k) |> list.filter((k) => not list.contains(bound, k))
  guard list.is_empty(unbound) else err("every rule variable must appear on the left-hand side outside brackets")
  let in_brackets = pats |> list.flat_map((p) => pat_brackets(p)) |> list.flat_map((t) => free_vars(t, 0))
  guard list.all(in_brackets, (k) => list.contains(bound, k)) else err("a bracket mentions a variable that the pattern does not bind")
  // Brackets read as the terms they stand for.
  let lhs = resolve(env, lv, scope, lhs_raw)!
  ok(Lhs { ctx: ctx, scope: scope, head: head, pats: pats, term: lhs, lparams: lv })
}

local fn add_rule(mut env: Env, vars: List[(String, Raw)], lhs_raw: Raw, rhs_raw: Raw, line: Int) -> Change! = {
  no_brackets([rhs_raw])!
  var bu = budget()
  let l = rule_lhs(env, vars, lhs_raw, bu)!
  let ctx = l.ctx
  let rhs = resolve(env, l.lparams, l.scope, rhs_raw)!
  let tl = infer(env, ctx, l.term, bu)!
  let tr = infer(env, ctx, rhs, bu)!
  let text = "${show(env, ctx, l.term)} = ${show(env, ctx, rhs)}"
  let same = conv(env, ctx, tl, tr, bu)
  guard not bu.exhausted else err(exhausted_error())
  guard same else err("rule does not preserve types: ${text}\n    left:  ${show(env, ctx, tl)}\n    right: ${show(env, ctx, tr)}")
  let r = Rule {
    id: "${env.room}:${int.to_string(line)}",
    head: l.head,
    room: env.room,
    arity: list.len(l.pats),
    nvars: list.len(vars),
    var_tys: ctx |> list.map(((_, ty)) => ty),
    lhs_args: l.pats,
    rhs: rhs,
    text: text,
    lparams: l.lparams,
  }
  ok(AddRule(r))
}

// `irrelevant [x : A] T.`: every two values of an instance of T are equal.
local fn add_irrelevant(mut env: Env, vars: List[(String, Raw)], ty_raw: Raw, line: Int) -> Change! = {
  var bu = budget()
  let l = rule_lhs(env, vars, ty_raw, bu)!
  expect_sort(env, l.ctx, l.term, bu)!
  let r = Rule {
    id: "${env.room}:${int.to_string(line)}",
    head: l.head,
    room: env.room,
    arity: list.len(l.pats),
    nvars: list.len(vars),
    var_tys: l.ctx |> list.map(((_, ty)) => ty),
    lhs_args: l.pats,
    rhs: l.term,
    text: "irrelevant ${show(env, l.ctx, l.term)}",
    lparams: l.lparams,
  }
  ok(AddIrrelevant(r))
}

// Process one declaration: check it, add it to `env` if it is good, and
// return the lines to print. A declaration that fails leaves `env` as it was.
fn process(mut env: Env, d: Located) -> List[String]! = match d.decl {
  DInductive(ind) => {
    // All or nothing: a type whose constructors fail leaves no trace.
    let start = list.len(env.order)
    let nrules = list.len(env.rules)
    match add_inductive(env, d.line, ind) {
      ok(lines) => ok(lines),
      err(e) => {
        rollback(env, start, nrules)
        err(e)
      },
    }
  },
  _ => {
    let (change, lines) = examine(env, d)!
    commit(env, change)
    ok(lines)
  },
}

local fn step(mut env: Env, line: Int, d: Decl) -> Unit! = {
  let (change, _) = examine(env, Located { line: line, decl: d })!
  commit(env, change)
  ok(())
}

// Undo the declarations after position `start` and the rules after `nrules`.
local fn rollback(mut env: Env, start: Int, nrules: Int) -> Unit = {
  for q in list.drop(env.order, start) {
    map.delete(env.entries, q)
    map.delete(env.types, q)
    map.delete(env.bodies, q)
    map.delete(env.defs, q)
    map.delete(env.lparams, q)
    map.delete(env.rws, q)
  }
  env.order = list.take(env.order, start)
  env.rules = list.take(env.rules, nrules)
}

// `type T ... = | c ...`: the type former, the constructors, then (once
// the type is known to be admissible) the recursor and its rules.
local fn add_inductive(mut env: Env, line: Int, ind: Inductive) -> List[String]! = {
  for c in ind.ctors {
    guard not list.any(c.args, ((a, _)) => list.any(ind.params, ((p, _)) => p == a)) else err("constructor ${c.name}: argument names must differ from the parameters")
  }
  step(env, line, inductive.type_former(ind))!
  for d in inductive.constructors(ind) {
    step(env, line, d)!
  }
  var bu = budget()
  let plan = admissible(env, ind, bu)!
  for d in inductive.eliminator(ind, plan) {
    step(env, line, d)! 
  }
  let q = env.room + "." + ind.name
  let elim = if plan.large then "into any universe" else "into Prop only"
  ok(["✓ type ${q}: ${int.to_string(list.len(ind.ctors))} constructors, recursor ${q}.rec ${elim}"])
}

// Peel `n` binders off a type (reducing to expose them), extending ctx.
local fn telescope(env: Env, ctx: Ctx, ty: Term, n: Int, mut bu: Budget) -> (Ctx, Term)! = {
  var c = ctx
  var t = ty
  var k = 0
  while k < n {
    match whnf(env, c, t, bu) {
      Pi(x, dom, body) => {
        c = [(x, dom)] + c
        t = body
      },
      _ => {
        k = n
      },
    }
    k = k + 1
  }
  guard list.len(c) == list.len(ctx) + n else err("expected ${int.to_string(n)} parameters in ${show(env, ctx, ty)}")
  ok((c, t))
}

// The parameters, as variables at the given depth below them.
local fn uniform(args: List[Term], np: Int, depth: Int) -> Bool =
  list.len(args) >= np and list.all(list.enumerate(list.take(args, np)), ((i, a)) => a == Var(depth - 1 - i))

// Is the type admissible, and what may its recursor eliminate into?
//   - every constructor ends in the type at its own parameters,
//   - the type occurs in an argument only strictly positively,
//   - arguments live in universes no larger than the type's (unless the
//     type is a proposition),
//   - a proposition eliminates only into Prop, unless it is a subsingleton
//     (no constructor, or one whose arguments are proofs or indices).
local fn admissible(env: Env, ind: Inductive, mut bu: Budget) -> inductive.Plan! = {
  let q = env.room + "." + ind.name
  let np = list.len(ind.params)
  let ni = list.len(inductive.indices(ind.arity))
  let (_, sort_t) = telescope(env, [], map.get(env.types, q) ?? type0(), np + ni, bu)!
  let level = match whnf(env, [], sort_t, bu) {
    Sort(l) => ok(l),
    other => err("${ind.name}'s type must end in a universe, not ${show(env, [], other)}"),
  }!
  let maybe_prop = not level_leq(LSucc(LZero), level)
  let is_prop = level_eq(level, LZero)
  let ls = ind.levels |> list.map((u) => LParam(u))
  var large = not maybe_prop
  for c in ind.ctors {
    let cq = q + "." + c.name
    let (pctx, rest) = telescope(env, [], map.get(env.types, cq) ?? type0(), np, bu)!
    var ctx = pctx
    var t = rest
    var proofs_or_indices = true
    var arg_vars: List[Int] = []
    for (a, _) in c.args {
      match whnf(env, ctx, t, bu) {
        Pi(x, dom, body) => {
          let depth = list.len(ctx)
          positive(env, ctx, q, np, depth, dom, bu)! 
          let u = sort_level(env, ctx, dom, bu)!
          guard is_prop or level_leq(u, level) else err("constructor ${c.name}: argument ${a} lives in a universe too large for ${ind.name}")
          if not level_eq(u, LZero) then {
            list.push(arg_vars, depth)
          } else ()
          ctx = [(x, dom)] + ctx
          t = body
        },
        _ => (),
      }
    }
    // The result: the type itself, at its parameters, the type absent from the indices.
    let depth = list.len(ctx)
    let (h, args) = spine(whnf(env, ctx, t, bu))
    let head_ok = match h {
      Const(d, us) => d == q and levels_eq(us, ls),
      _ => false,
    }
    guard head_ok and uniform(args, np, depth) else err("constructor ${c.name} must build ${ind.name} at its own parameters")
    let idx = list.drop(args, np)
    guard not list.any(idx, (i) => list.contains(consts(i), q)) else err("constructor ${c.name}: ${ind.name} cannot appear in its own indices")
    // A non-proof argument keeps a proposition small unless an index names it.
    for v in arg_vars {
      let var_here = Var(depth - 1 - v)
      if not list.contains(idx, var_here) then {
        proofs_or_indices = false
      } else ()
    }
    if maybe_prop and list.len(ind.ctors) == 1 and proofs_or_indices then {
      large = true
    } else ()
  }
  if maybe_prop and list.is_empty(ind.ctors) then {
    large = true
  } else ()
  let k = is_prop and large and list.len(ind.ctors) == 1 and list.all(ind.ctors, (c) => list.is_empty(c.args))
  ok(inductive.Plan { large: large, k: k })
}

local fn sort_level(env: Env, ctx: Ctx, ty: Term, mut bu: Budget) -> Level! = expect_sort(env, ctx, ty, bu)

// Strict positivity of one constructor argument: the type may appear only
// as the conclusion of the argument, at its own parameters.
local fn positive(env: Env, ctx: Ctx, q: String, np: Int, depth0: Int, dom: Term, mut bu: Budget) -> Unit! =
  if not list.contains(consts(dom), q) then ok(())
  else {
    var c = ctx
    var t = whnf(env, ctx, dom, bu)
    var going = true
    while going {
      match t {
        Pi(x, a, b) => {
          guard not list.contains(consts(a), q) else err("${q} occurs in a negative position (left of an arrow) in a constructor argument")
          c = [(x, a)] + c
          t = whnf(env, c, b, bu)
        },
        _ => {
          going = false
        },
      }
    }
    let (h, args) = spine(t)
    let head_ok = match h {
      Const(d, _) => d == q,
      _ => false,
    }
    guard head_ok else err("${q} must appear in a constructor argument only as its result (strict positivity)")
    // Parameters of the outer declaration sit `depth0` binders up from the
    // argument; the argument's own binders add the rest.
    guard uniform(args, np, list.len(c)) else err("${q} must appear in a constructor argument at its own parameters")
    guard not list.any(list.drop(args, np), (i) => list.contains(consts(i), q)) else err("${q} cannot appear in the indices of a recursive argument")
    ok(())
  }

// `mut` only so that the call from `process` borrows the environment instead
// of copying it (it is not changed here).
local fn examine(mut env: Env, d: Located) -> (Change, List[String])! = match d.decl {
  DRoom(name, uses) => ok((enter_room(env, name, uses)!, [])),
  DSymbol(name, lv, ty_raw) => {
    no_brackets([ty_raw])!
    let ty = resolve(env, lv, [], ty_raw)!
    var bu = budget()
    expect_sort(env, [], ty, bu)!
    ok((declare(env, name, lv, "symbol", ty, none)!, []))
  },
  DDef(name, lv, ty_raw, body_raw) => {
    let (ty, body) = typed_body(env, lv, ty_raw, body_raw)!
    ok((declare(env, name, lv, "def", ty, some(body))!, []))
  },
  DTheorem(name, lv, ty_raw, body_raw) => {
    let (ty, body) = typed_body(env, lv, ty_raw, body_raw)!
    let c = declare(env, name, lv, "theorem", ty, some(body))!
    ok((c, ["✓ theorem ${env.room}.${name}: ${show(env, [], ty)}"]))
  },
  DRule(vars, lhs, rhs) => ok((add_rule(env, vars, lhs, rhs, d.line)!, [])),
  DIrrelevant(vars, ty) => ok((add_irrelevant(env, vars, ty, d.line)!, [])),
  DCheck(e_raw) => {
    no_brackets([e_raw])!
    let e = resolve(env, [], [], e_raw)!
    var bu = budget()
    let ty = infer(env, [], e, bu)!
    ok((NoChange, ["${show(env, [], e)}: ${show(env, [], ty)}"]))
  },
  DEval(e_raw) => {
    no_brackets([e_raw])!
    let e = resolve(env, [], [], e_raw)!
    var bu = budget()
    infer(env, [], e, bu)!
    let v = nf(env, [], e, bu)
    guard not bu.exhausted else err(exhausted_error())
    ok((NoChange, ["${show(env, [], e)} = ${show(env, [], v)}"]))
  },
  DAxioms(name) => {
    let q = resolve_const(env, name)!
    ok((NoChange, report_axioms(env, q)))
  },
  DInductive(_) => err("a type declaration is processed by `process`"),
}

local fn typed_body(env: Env, lv: List[String], ty_raw: Raw, body_raw: Raw) -> (Term, Term)! = {
  no_brackets([ty_raw, body_raw])!
  let ty = resolve(env, lv, [], ty_raw)!
  var bu = budget()
  expect_sort(env, [], ty, bu)!
  let body = resolve(env, lv, [], body_raw)!
  check(env, [], body, ty, bu)!
  ok((ty, body))
}

// ── Dependency tracking ─────────────────────────────────────────────

type Deps = { symbols: List[String], rules: List[Rule], lemmas: List[String] }

// Everything `name` rests on: the symbols it assumes, the rules attached to
// them, and the defs/theorems it goes through. Transitive.
fn deps(env: Env, name: String) -> Deps = {
  // A loop with an explicit stack: dependency chains in absorbed libraries
  // run thousands of declarations deep.
  var pending: List[String] = [name]
  var seen: Map[String, Bool] = [:]
  var symbols: List[String] = []
  var rules: List[Rule] = []
  var lemmas: List[String] = []
  var queued: List[String] = []
  while not list.is_empty(pending) {
    let c = list.pop(pending) ?? ""
    if map.contains(seen, c) then () else {
      map.insert(seen, c, true)
      match map.get(env.entries, c) {
        none => (),
        some(e) => {
          if e.kind == "symbol" then {
            list.push(symbols, c)
            for r in env.rules + env.irrelevants {
              if r.head == c then {
                list.push(rules, r)
                for m in list.reverse(rule_mentions(r)) {
                  list.push(queued, m)
                }
              } else ()
            }
          } else if c != name then list.push(lemmas, c) else ()
          // Visit in source order: the type, then the body, then the rules.
          let body = match map.get(env.bodies, c) {
            some(b) => consts(b),
            none => [],
          }
          let ty = match map.get(env.types, c) {
            some(t) => consts(t),
            none => [],
          }
          for m in queued {
            list.push(pending, m)
          }
          queued = []
          for m in list.reverse(ty + body) {
            list.push(pending, m)
          }
        },
      }
    }
  }
  Deps { symbols: symbols, rules: rules, lemmas: lemmas }
}

local fn rule_mentions(r: Rule) -> List[String] =
  (r.var_tys |> list.flat_map((t) => consts(t)))
    + (r.lhs_args |> list.flat_map((p) => pat_consts(p)))
    + consts(r.rhs)

local fn report_axioms(env: Env, q: String) -> List[String] = {
  let d = deps(env, q)
  let rooms = list.unique((d.symbols |> list.map((s) => room_of(env, s))) + (d.rules |> list.map((r) => r.room)))
  let header = ["axioms ${q}", "  rooms:   ${list.join(rooms, ", ")}"]
  let syms = if list.is_empty(d.symbols) then ["  symbols: (none)"] else ["  symbols: ${list.join(d.symbols, ", ")}"]
  let rules = if list.is_empty(d.rules) then ["  rules:   (none)"]
    else d.rules |> list.enumerate |> list.map(((i, r)) =>
      (if i == 0 then "  rules:   " else "           ") + "[${r.id}] ${r.text}")
  let lemmas = if list.is_empty(d.lemmas) then [] else ["  through: ${list.join(d.lemmas, ", ")}"]
  header + syms + rules + lemmas
}

// ── Whole files ─────────────────────────────────────────────────────

type Outcome = { env: Env, output: List[String], error: String? }

// Check declarations in order, stopping at the first failure.
fn check_all(env: Env, ds: List[Located]) -> Outcome = {
  var cur = env
  var out: List[String] = []
  var error: String? = none
  for d in ds {
    if error == none then match process(cur, d) {
      ok(lines) => {
        for l in lines {
          list.push(out, l)
        }
      },
      err(e) => {
        error = some("${int.to_string(d.line)}: ${e}")
      },
    } else ()
  }
  Outcome { env: cur, output: out, error: error }
}
