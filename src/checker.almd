// The declaration checker: surface syntax to kernel terms, declarations,
// rewrite rules, inductive types, and the `axioms` report. Everything it
// adds to an environment has been checked by the kernel (kernel.almd).

import self.term.{Term, Level, shift, instantiate, subst, spine, apply, occurs, consts, level_eq, levels_eq, level_leq, inst_levels, type0, level_of_nat}
import self.syntax.{Raw, Decl, Located, Inductive, Sig}
import self.syntax
import self.kernel
import self.kernel.{IndInfo, StructEta, View, Env, Entry, Pat, Rule, Rw, Ctx, Budget, MState, budget, whnf, nf, conv, infer, check, expect_sort, resolve_const, room_of, show, exhausted_error, match_all, index_in, level_of}
import self.inductive
import self.elab
import self.patterns
import self.search
import self.mutual
import self.pretty

// Named surface terms → de Bruijn terms. `scope` is innermost first; `lv`
// holds the universe parameters in scope. A bracket is transparent here;
// only rule patterns give it meaning.
fn resolve(env: Env, lv: List[String], scope: List[String], r: Raw) -> Term! = match r {
  RName(x) => match index_in(scope, x, 0) {
    some(i) => ok(Var(i)),
    none => {
      let c = kernel.resolve_named(env, x)!
      let ps = map.get(env.lparams, c) ?? []
      guard list.is_empty(ps) else err("${x} takes universe levels: write ${x}[${list.join(ps, ", ")}]")
      ok(Const(c, []))
    },
  },
  RInst(x, ls) => {
    let c = resolve_const(env, x)!
    var levels: List[Level] = []
    for l in ls {
      list.push(levels, level_of(lv, l)!)
    }
    ok(Const(c, levels))
  },
  RExplicit(x, ls) => {
    let c = resolve_const(env, x)!
    var levels: List[Level] = []
    for l in ls {
      list.push(levels, level_of(lv, l)!)
    }
    ok(Const(c, levels))
  },
  RType => ok(type0()),
  RSort => err("Sort needs a level: Sort(0) is Prop, Sort(1) is Type"),
  RApp(RSort, l) => ok(Sort(level_of(lv, l)!)),
  RApp(RType, l) => ok(Sort(LSucc(level_of(lv, l)!))),
  RApp(f, a) => ok(App(resolve(env, lv, scope, f)!, resolve(env, lv, scope, a)!)),
  RLam(x, ty, b) => ok(Lam(x, resolve(env, lv, scope, ty)!, resolve(env, lv, [x] + scope, b)!)),
  RPi(x, ty, b) => ok(Pi(x, resolve(env, lv, scope, ty)!, resolve(env, lv, [x] + scope, b)!)),
  RBracket(inner) => resolve(env, lv, scope, inner),
  RMatch(_, _) => err("a match must be a definition's whole body, on one of its parameters"),
  RRecord(_, _) => err("internal: a record value must be elaborated"),
  RField(_, _) => err("internal: a field access must be elaborated"),
}

local fn has_bracket(r: Raw) -> Bool = match r {
  RBracket(_) => true,
  RApp(f, a) => has_bracket(f) or has_bracket(a),
  RLam(_, ty, b) => has_bracket(ty) or has_bracket(b),
  RPi(_, ty, b) => has_bracket(ty) or has_bracket(b),
  _ => false,
}

local fn no_brackets(rs: List[Raw]) -> Unit! = {
  guard not list.any(rs, (r) => has_bracket(r)) else err("brackets {...} are only allowed in the left-hand side of a rule")
  ok(())
}

// ── Declarations ────────────────────────────────────────────────────

// What a checked declaration adds to the environment. Checking is pure;
// `commit` then updates the environment in place, because a functional
// `map.set` copies the whole map on every declaration (almide/almide#3404).
type Change =
  | Declare(String, List[String], Int, Entry, Term, Term?)
  | EnterRoom(String, List[String])
  | AddRule(Rule)
  | AddIrrelevant(Rule)
  | AddStruct(String, StructEta)
  | NoChange

local fn declare(env: Env, sig: Sig, kind: String, ty: Term, body: Term?) -> Change! = {
  let q = env.room + "." + sig.name
  guard not map.contains(env.entries, q) else err("${q} is already declared")
  guard list.len(list.unique(sig.levels)) == list.len(sig.levels) else err("${sig.name} lists a universe parameter twice")
  ok(Declare(q, sig.levels, sig.implicits, Entry { room: env.room, kind: kind, height: list.len(env.order) }, ty, body))
}

local fn enter_room(env: Env, name: String, uses: List[String]) -> Change! = {
  guard not map.contains(env.rooms, name) else err("room ${name} already exists; rooms are sealed once left")
  let missing = uses |> list.filter((u) => not map.contains(env.rooms, u))
  guard list.is_empty(missing) else err("unknown room ${list.join(missing, ", ")}")
  let seen = uses + (uses |> list.flat_map((u) => map.get(env.rooms, u) ?? []))
  ok(EnterRoom(name, list.unique(seen)))
}

local fn commit(mut env: Env, c: Change) -> Unit = match c {
  Declare(q, lv, imps, entry, ty, body) => {
    map.insert(env.entries, q, entry)
    if list.is_empty(lv) then () else map.insert(env.lparams, q, lv)
    if imps == 0 then () else map.insert(env.implicits, q, imps)
    map.insert(env.types, q, ty)
    match body {
      some(b) => map.insert(env.bodies, q, b),
      none => (),
    }
    if entry.kind == "def" then map.insert(env.defs, q, entry.height) else ()
    list.push(env.order, q)
  },
  EnterRoom(name, seen) => {
    map.insert(env.rooms, name, seen)
    env.room = name
  },
  AddRule(r) => {
    let rw = Rw { arity: r.arity, nvars: r.nvars, lhs_args: r.lhs_args, rhs: r.rhs, lparams: r.lparams }
    let existing = map.get(env.rws, r.head) ?? []
    map.insert(env.rws, r.head, existing + [rw])
    list.push(env.rules, r)
  },
  AddIrrelevant(r) => list.push(env.irrelevants, r),
  AddStruct(c, si) => map.insert(env.structs, c, si),
  NoChange => (),
}

// `match` rather than `?.kind`: almide/almide#3391 (wasm).
local fn is_symbol(env: Env, c: String) -> Bool = match map.get(env.entries, c) {
  some(e) => e.kind == "symbol",
  none => false,
}

local fn raw_spine(r: Raw, args: List[Raw]) -> (Raw, List[Raw]) = match r {
  RApp(f, a) => raw_spine(f, [a] + args),
  other => (other, args),
}

// Build a pattern from surface syntax. In a rule, every bound name is a
// rule variable (the scope holds nothing else).
// A symbol in a pattern matches at any universe levels: typing fixes them.
local fn resolve_pat(env: Env, lv: List[String], scope: List[String], r: Raw) -> Pat! = {
  let (h, args) = raw_spine(r, [])
  match h {
    RBracket(inner) => {
      guard list.is_empty(args) else err("a bracket cannot be applied to arguments in a pattern")
      ok(PBracket(resolve(env, lv, scope, inner)!))
    },
    RName(x) => match index_in(scope, x, 0) {
      some(k) => {
        guard list.is_empty(args) else err("a rule variable cannot be applied to arguments in a pattern (${x})")
        ok(PVar(k))
      },
      none => pat_symbol(env, lv, scope, x, args),
    },
    RInst(x, _) => pat_symbol(env, lv, scope, x, args),
    RExplicit(x, _) => pat_symbol(env, lv, scope, x, args),
    _ => err("patterns are built from symbols, rule variables and {brackets}"),
  }
}

local fn pat_symbol(env: Env, lv: List[String], scope: List[String], x: String, args: List[Raw]) -> Pat! = {
  let c = resolve_const(env, x)!
  guard is_symbol(env, c) else err("${c} is not a symbol, so it cannot appear in a pattern")
  let ps = args |> list.map((a) => resolve_pat(env, lv, scope, a)!)!
  ok(PSym(c, ps))
}

local fn pat_vars(p: Pat) -> List[Int] = match p {
  PVar(k) => [k],
  PSym(_, ps) => ps |> list.flat_map((q) => pat_vars(q)),
  PBracket(_) => [],
}

local fn pat_brackets(p: Pat) -> List[Term] = match p {
  PVar(_) => [],
  PSym(_, ps) => ps |> list.flat_map((q) => pat_brackets(q)),
  PBracket(t) => [t],
}

local fn pat_consts(p: Pat) -> List[String] = match p {
  PVar(_) => [],
  PSym(c, ps) => [c] + (ps |> list.flat_map((q) => pat_consts(q))),
  PBracket(t) => consts(t),
}

// Free variables of t, as indices into the context t lives in.
local fn free_vars(t: Term, depth: Int) -> List[Int] = match t {
  Var(i) => if i >= depth then [i - depth] else [],
  App(f, a) => free_vars(f, depth) + free_vars(a, depth),
  Lam(_, ty, b) => free_vars(ty, depth) + free_vars(b, depth + 1),
  Pi(_, ty, b) => free_vars(ty, depth) + free_vars(b, depth + 1),
  _ => [],
}

// The shared front half of `rule` and `irrelevant`: the variable context,
// the head symbol (of this room), and the argument patterns.
type Lhs = { ctx: Ctx, scope: List[String], head: String, pats: List[Pat], term: Term, lparams: List[String] }

// The head of a rule's left-hand side, and the universe parameters it is
// written at: `Nat.rec[u](...)` makes u a parameter of the rule.
local fn rule_head(env: Env, lhs_raw: Raw) -> (String, List[String])! = {
  let (head_raw, _) = raw_spine(lhs_raw, [])
  match head_raw {
    RName(x) => ok((resolve_const(env, x)!, [])),
    RExplicit(x, ls) => rule_head(env, RInst(x, ls)),
    RInst(x, ls) => {
      var names: List[String] = []
      for l in ls {
        match l {
          RName(u) => list.push(names, u),
          _ => (),
        }
      }
      guard list.len(names) == list.len(ls) and list.len(list.unique(names)) == list.len(names) else err("the head of a rule takes distinct universe parameters: ${x}[u, v]")
      ok((resolve_const(env, x)!, names))
    },
    _ => err("the left-hand side must start with a symbol"),
  }
}

local fn rule_lhs(env: Env, vars: List[(String, Raw)], lhs_raw: Raw, mut bu: Budget) -> Lhs! = {
  let (head, lv) = rule_head(env, lhs_raw)!
  // Build the rule context left to right; Var(0) is the last variable.
  var ctx: Ctx = []
  var scope: List[String] = []
  for (x, ty_raw) in vars {
    no_brackets([ty_raw])!
    let ty = resolve(env, lv, scope, ty_raw)!
    expect_sort(env, ctx, ty, bu)!
    ctx = [(x, ty)] + ctx
    scope = [x] + scope
  }
  let n = list.len(vars)
  let (_, arg_raws) = raw_spine(lhs_raw, [])
  guard is_symbol(env, head) else err("${head} is not a symbol; only symbols can have rules")
  let owner = room_of(env, head)
  guard owner == env.room else err("${head} belongs to room ${owner}; rules can only be added to symbols of the current room (${env.room})")
  guard not list.is_empty(arg_raws) else err("the left-hand side needs at least one argument pattern")
  let pats = arg_raws |> list.map((a) => resolve_pat(env, lv, scope, a)!)!
  let bound = pats |> list.flat_map((p) => pat_vars(p))
  guard list.len(list.unique(bound)) == list.len(bound) else err("a rule variable can be matched only once; write {x} for the other occurrences")
  let unbound = list.map(0..<n, (k) => k) |> list.filter((k) => not list.contains(bound, k))
  guard list.is_empty(unbound) else err("every rule variable must appear on the left-hand side outside brackets")
  let in_brackets = pats |> list.flat_map((p) => pat_brackets(p)) |> list.flat_map((t) => free_vars(t, 0))
  guard list.all(in_brackets, (k) => list.contains(bound, k)) else err("a bracket mentions a variable that the pattern does not bind")
  // Brackets read as the terms they stand for.
  let lhs = resolve(env, lv, scope, lhs_raw)!
  ok(Lhs { ctx: ctx, scope: scope, head: head, pats: pats, term: lhs, lparams: lv })
}

local fn add_rule(mut env: Env, vars: List[(String, Raw)], lhs_raw: Raw, rhs_raw: Raw, line: Int) -> Change! = {
  no_brackets([rhs_raw])!
  var bu = budget()
  let l = rule_lhs(env, vars, lhs_raw, bu)!
  let ctx = l.ctx
  let rhs = resolve(env, l.lparams, l.scope, rhs_raw)!
  let tl = infer(env, ctx, l.term, bu)!
  let tr = infer(env, ctx, rhs, bu)!
  let text = "${show(env, ctx, l.term)} = ${show(env, ctx, rhs)}"
  let same = conv(env, ctx, tl, tr, bu)
  guard not bu.exhausted else err(exhausted_error())
  guard same else err("rule does not preserve types: ${text}\n    left:  ${show(env, ctx, tl)}\n    right: ${show(env, ctx, tr)}")
  let r = Rule {
    id: "${env.room}:${int.to_string(line)}",
    head: l.head,
    room: env.room,
    arity: list.len(l.pats),
    nvars: list.len(vars),
    var_tys: ctx |> list.map(((_, ty)) => ty),
    lhs_args: l.pats,
    rhs: rhs,
    text: text,
    lparams: l.lparams,
  }
  ok(AddRule(r))
}

// `irrelevant [x : A] T.`: every two values of an instance of T are equal.
// `structure S = S.mk(S.f1, ..., S.fn)`: every value of S is the
// constructor applied to its projections (Lean's structure eta). An
// assumption about symbols of this room, listed by `axioms`; checked here:
// the names are this room's symbols, the constructor builds S from its
// parameters and n fields, each projection takes the parameters and an S,
// and each computes on the constructor to its field.
local fn add_structure(mut env: Env, ty_name: String, mk_name: String, proj_names: List[String], line: Int) -> Change! = {
  let ty = resolve_const(env, ty_name)!
  let mk = resolve_const(env, mk_name)!
  var projs: List[String] = []
  for f in proj_names {
    list.push(projs, resolve_const(env, f)!)
  }
  for q in [ty, mk] + projs {
    guard is_symbol(env, q) and room_of(env, q) == env.room else err("structure ${ty_name}: ${q} must be a symbol of this room")
  }
  guard not map.contains(env.structs, mk) else err("structure ${ty_name}: already declared")
  guard map.get(env.lparams, mk) == map.get(env.lparams, ty) and list.all(projs, (f) => map.get(env.lparams, f) == map.get(env.lparams, ty)) else err("structure ${ty_name}: the type, constructor and projections must share their universe parameters")
  var bu = budget()
  // The constructor: parameters, then one argument per field, ending in S(parameters).
  var ctx: Ctx = []
  var t = map.get(env.types, mk) ?? type0()
  var n = 0
  var going = true
  while going {
    match whnf(env, ctx, t, bu) {
      Pi(x, dom, b) => {
        ctx = [(x, dom)] + ctx
        t = b
        n = n + 1
      },
      other => {
        t = other
        going = false
      },
    }
  }
  let nfields = list.len(projs)
  let np = n - nfields
  guard np >= 0 else err("structure ${ty_name}: ${mk_name} takes fewer arguments than there are fields")
  let si = StructEta { ty: ty, nparams: np, projs: projs, decl: Rule { id: "${env.room}:${int.to_string(line)}", head: mk, room: env.room, arity: 0, nvars: 0, var_tys: [], lhs_args: [], rhs: type0(), text: "structure ${ty_name} = ${mk_name}(${list.join(proj_names, ", ")})", lparams: [] } }
  let params = list.map(0..<np, (i) => Var(n - 1 - i))
  guard struct_params_ok(env, ctx, si, t, params, bu) else err("structure ${ty_name}: ${mk_name} must build ${ty_name} at its parameters")
  // Each projection computes on the constructor to its field.
  let ls = (map.get(env.lparams, mk) ?? []) |> list.map((u) => LParam(u))
  let built = apply(Const(mk, ls), list.map(0..<n, (i) => Var(n - 1 - i)))
  for (i, f) in list.enumerate(projs) {
    let got = apply(Const(f, ls), params + [built])
    guard conv(env, ctx, got, Var(nfields - 1 - i), bu) else err("structure ${ty_name}: ${f} does not compute to field ${int.to_string(i + 1)} on ${mk_name}")
  }
  ok(AddStruct(mk, si))
}

local fn struct_params_ok(env: Env, ctx: Ctx, si: StructEta, result: Term, params: List[Term], mut bu: Budget) -> Bool = {
  let check_spine = (w: Term) => {
    let (h, args) = spine(w)
    match h {
      Const(s, _) => s == si.ty and args == params,
      _ => false,
    }
  }
  let w = whnf(env, ctx, result, bu)
  check_spine(w) or (match list.last(spine(w).1) {
    some(inner) => check_spine(whnf(env, ctx, inner, bu)),
    none => false,
  })
}

local fn add_irrelevant(mut env: Env, vars: List[(String, Raw)], ty_raw: Raw, line: Int) -> Change! = {
  var bu = budget()
  let l = rule_lhs(env, vars, ty_raw, bu)!
  expect_sort(env, l.ctx, l.term, bu)!
  let r = Rule {
    id: "${env.room}:${int.to_string(line)}",
    head: l.head,
    room: env.room,
    arity: list.len(l.pats),
    nvars: list.len(vars),
    var_tys: l.ctx |> list.map(((_, ty)) => ty),
    lhs_args: l.pats,
    rhs: l.term,
    text: "irrelevant ${show(env, l.ctx, l.term)}",
    lparams: l.lparams,
  }
  ok(AddIrrelevant(r))
}

// Process one declaration: check it, add it to `env` if it is good, and
// return the lines to print. A declaration that fails leaves `env` as it was.
fn process(mut env: Env, d: Located) -> List[String]! = match d.decl {
  DInductive(ind) => {
    // All or nothing: a type whose constructors fail leaves no trace.
    let start = list.len(env.order)
    let nrules = list.len(env.rules)
    match add_inductive(env, d.line, ind) {
      ok(lines) => ok(lines),
      err(e) => {
        rollback(env, start, nrules)
        err(e)
      },
    }
  },
  // All or nothing, like a type: a view or translation that fails leaves
  // no declarations behind.
  DView(name, src, entries) => {
    let start = list.len(env.order)
    let nrules = list.len(env.rules)
    match add_view(env, name, src, entries) {
      ok(lines) => ok(lines),
      err(e) => {
        rollback(env, start, nrules)
        err(e)
      },
    }
  },
  DViewVia(name, src, via) => {
    let start = list.len(env.order)
    let nrules = list.len(env.rules)
    match compose_view(env, name, src, via) {
      ok(lines) => ok(lines),
      err(e) => {
        rollback(env, start, nrules)
        err(e)
      },
    }
  },
  DTranslate(v, name) => {
    let start = list.len(env.order)
    let nrules = list.len(env.rules)
    match translate(env, v, name) {
      ok(lines) => ok(lines),
      err(e) => {
        rollback(env, start, nrules)
        err(e)
      },
    }
  },
  // All or nothing.
  DMutualDefs(group) => {
    let start = list.len(env.order)
    let nrules = list.len(env.rules)
    match add_mutual_defs(env, d.line, group) {
      ok(lines) => ok(lines),
      err(e) => {
        rollback(env, start, nrules)
        err(e)
      },
    }
  },
  // All or nothing, like a type.
  DMutual(inds) => {
    let start = list.len(env.order)
    let nrules = list.len(env.rules)
    match add_mutual(env, d.line, inds) {
      ok(lines) => ok(lines),
      err(e) => {
        rollback(env, start, nrules)
        err(e)
      },
    }
  },
  // A definition matching on one type of a mutual group: through the
  // group's family, like a group of functions (one function here).
  DDef(sig, body) if wf_marked(sig, body) => add_wf_def(env, d.line, d.decl),
  DTheorem(sig, body) if wf_marked(sig, body) => add_wf_def(env, d.line, d.decl),
  DDef(sig, body) if matches_mutual(env, sig, body) => process(env, { ...d, decl: DMutualDefs([d.decl]) }),
  DTheorem(sig, body) if matches_mutual(env, sig, body) => process(env, { ...d, decl: DMutualDefs([d.decl]) }),
  _ => {
    let (change, lines) = examine(env, d)!
    commit(env, change)
    ok(lines)
  },
}

local fn matches_mutual(env: Env, sig: Sig, body: Raw) -> Bool = {
  let (x, sty) = last_param(sig, body)
  var b = body
  var going = true
  while going {
    match b {
      RLam(_, _, inner) => {
        b = inner
      },
      _ => {
        going = false
      },
    }
  }
  let on_last = match b {
    RMatch(RName(v), _) => v == x and x != "",
    _ => false,
  }
  on_last and mutual_member(env, raw_head_name(sty)) != none
}

// Mutually recursive definitions (mutual.encode_defs): the combined
// definition, then each one, checked as usual.
local fn add_mutual_defs(mut env: Env, line: Int, group: List[Decl]) -> List[String]! =
  match list.first(group) {
    some(DDef(sig, body)) if nested_kind(env, sig, body) != none => add_nested_defs(env, line, group),
    some(DTheorem(sig, body)) if nested_kind(env, sig, body) != none => add_nested_defs(env, line, group),
    _ => add_family_defs(env, line, group),
  }

// ── Well-founded recursion ──────────────────────────────────────────
//
//   def div(n: Nat, d: Nat) -> Nat decreasing n by lt_wf = ... div(m, d, h) ...
//
// W (`lt_wf`) proves a relation R well-founded on n's type; each recursive
// call passes, last, a proof `R(m, n)` that its n is smaller. This becomes
//
//   def div.step(n, d, rec: (y: Nat, r: Lt(y, n), d: Nat) -> Nat) -> Nat = ... rec(m, h, d) ...
//   def div(n, d) = wf.fix(W, (n) => (d: Nat) -> Nat, (n, rec) => (d) => div.step(n, d, rec), n)(d)
//   theorem div.unfold(n, d): div(n, d) = div.step(n, d, (y, r, d) => div(y, d))
//
// all ordinary declarations, checked as usual (lib/std/wf.arlk defines
// fix by the recursor of Acc). Nothing here is trusted. The other
// parameters may change in recursive calls.

local fn wf_marked(sig: Sig, body: Raw) -> Bool = {
  let (_, _, b) = def_parts(sig, body)
  let (h, args) = inductive.raw_spine(b)
  h == RName(syntax.WF_MARK) and list.len(args) == 3
}

local fn add_wf_def(mut env: Env, line: Int, decl: Decl) -> List[String]! = {
  let (sig, body, is_thm) = match decl {
    DTheorem(sg, b) => (sg, b, true),
    DDef(sg, b) => (sg, b, false),
    _ => (Sig { name: "", levels: [], implicits: 0, ty: RType }, RType, false),
  }
  let (params, ret, marked) = def_parts(sig, body)
  let (_, margs) = inductive.raw_spine(marked)
  let x = match list.first(margs) {
    some(RName(v)) => v,
    _ => "",
  }
  let w = list.get(margs, 1) ?? RType
  let body0 = list.get(margs, 2) ?? RType
  let pnames = params |> list.map(((p, _)) => p)
  let k = match list.index_of(pnames, x) {
    some(i) => ok(i),
    none => err("${sig.name}: decreasing ${x}: ${x} is not a parameter"),
  }!
  guard k >= sig.implicits else err("${sig.name}: decreasing ${x}: an implicit parameter cannot be the decreasing one")
  let xty = match list.get(params, k) {
    some((_, t)) => t,
    none => RType,
  }
  guard not list.any(inductive.raw_spine(xty).1, (a) => list.any(list.drop(pnames, sig.implicits), (p) => mentions(a, p))) else err("${sig.name}: the type of ${x} may depend only on implicit parameters")
  // R, from W's type: WellFounded(A, R), that is (x: A) -> Acc(A, R, x).
  let (_, wty) = elab.elab_infer(env, sig.levels, w)!
  var bu = budget()
  let rel_opt: Option[Term] = match whnf(env, [], wty, bu) {
    Pi(_, _, b) => {
      let (_, aargs) = spine(whnf(env, [("x", type0())], b, bu))
      match list.get(aargs, 1) {
        some(r) => if occurs(r, 0) then none else some(shift(r, -1, 0)),
        none => none,
      }
    },
    _ => none,
  }
  guard rel_opt != none else err("${sig.name}: decreasing ${x} by W: W must prove a relation well-founded (WellFounded(A, R)), not ${show(env, [], wty)}")
  let rel = rel_opt ?? type0()
  let r_raw = term_raw(rel, [])
  let implicit_ps = list.take(params, sig.implicits)
  let explicit_ps = list.drop(params, sig.implicits)
  let others = explicit_ps |> list.filter(((p, _)) => p != x)
  let taken = pnames + inductive_names(ret) + inductive_names(body0) + [sig.name]
  let y = inductive.fresh(x + "'", taken)
  let rn = inductive.fresh("r", taken + [y])
  let rec = inductive.fresh("rec", taken + [y, rn])
  let at_y = (t: Raw) => inductive.substitute(t, [x], [RName(y)])
  let others_y = others |> list.map(((p, t)) => (p, at_y(t)))
  let rec_ty = RPi(y, xty, RPi(rn, RApp(RApp(r_raw, RName(y)), RName(x)), pis_raw(others_y, at_y(ret))))
  let pos = k - sig.implicits
  let body1 = wf_calls(body0, sig.name, list.len(explicit_ps), pos, rec)!
  let step_name = sig.name + ".step"
  let step_sig = Sig { name: step_name, levels: sig.levels, implicits: sig.implicits, ty: pis_raw(params + [(rec, rec_ty)], ret) }
  let step = DDef(step_sig, lams_raw(params + [(rec, rec_ty)], body1))
  // fix(W, C, F, x)(others)
  let motive = RLam(x, xty, pis_raw(others, ret))
  let step_call = inductive.raw_apply(RName(step_name), explicit_ps |> list.map(((p, _)) => RName(p)))
  let f_fn = RLam(x, xty, RLam(rec, rec_ty, lams_raw(others, RApp(step_call, RName(rec)))))
  let fixed = inductive.raw_apply(RName("wf.fix"), [w, motive, f_fn, RName(x)] + (others |> list.map(((p, _)) => RName(p))))
  let main = if is_thm then DTheorem(sig, lams_raw(params, fixed)) else DDef(sig, lams_raw(params, fixed))
  var lines: List[String] = []
  lines = lines + process(env, Located { line: line, decl: step })!
  lines = lines + process(env, Located { line: line, decl: main })!
  // The unfolding law, when Eq is at hand (lib/std/eq.arlk).
  if not is_thm and map.contains(env.entries, "eq.cong") and map.contains(env.entries, "wf.fix_eq") then {
    let call = (args: List[Raw]) => inductive.raw_apply(RName(sig.name), args)
    let again = RLam(y, xty, RLam(rn, RApp(RApp(r_raw, RName(y)), RName(x)), lams_raw(others, call(explicit_ps |> list.map(((p, _)) => if p == x then RName(y) else RName(p))))))
    let lhs = call(explicit_ps |> list.map(((p, _)) => RName(p)))
    let rhs = RApp(step_call, again)
    let g = inductive.fresh("g", taken + [y, rn, rec])
    let cfun = RLam(g, pis_raw(others, ret), inductive.raw_apply(RName(g), others |> list.map(((p, _)) => RName(p))))
    let proof = inductive.raw_apply(RName("eq.cong"), [cfun, inductive.raw_apply(RName("wf.fix_eq"), [w, motive, f_fn, RName(x)])])
    let usig = Sig { name: sig.name + ".unfold", levels: sig.levels, implicits: sig.implicits, ty: pis_raw(params, inductive.raw_apply(RName("eq.Eq"), [ret, lhs, rhs])) }
    lines = lines + process(env, Located { line: line, decl: DTheorem(usig, lams_raw(params, proof)) })!
  } else ()
  ok(lines)
}

local fn pis_raw(bs: List[(String, Raw)], body: Raw) -> Raw =
  list.fold(list.reverse(bs), body, (acc, (x, ty)) => RPi(x, ty, acc))

local fn lams_raw(bs: List[(String, Raw)], body: Raw) -> Raw =
  list.fold(list.reverse(bs), body, (acc, (x, ty)) => RLam(x, ty, acc))

local fn mentions(r: Raw, x: String) -> Bool = list.contains(inductive_names(r), x)

// Every name a raw term mentions (bound or free; for freshness).
local fn inductive_names(r: Raw) -> List[String] = match r {
  RName(n) => [n],
  RApp(f, a) => inductive_names(f) + inductive_names(a),
  RLam(n, t, b) => [n] + inductive_names(t) + inductive_names(b),
  RPi(n, t, b) => [n] + inductive_names(t) + inductive_names(b),
  RMatch(e, arms) => inductive_names(e) + (arms |> list.flat_map((a) => inductive_names(a.body))),
  RBracket(b) => inductive_names(b),
  _ => [],
}

// Each recursive call `f(a1, ..., an, proof)` becomes `rec(a_pos, proof,
// the other arguments)`; any other mention of f is not well-founded
// recursion.
local fn wf_calls(r: Raw, f: String, n: Int, pos: Int, rec: String) -> Raw! = {
  let (h, args) = inductive.raw_spine(r)
  match h {
    RName(g) if g == f => {
      guard list.len(args) == n + 1 else err("a recursive call to ${f} passes its ${int.to_string(n)} arguments and then a proof that the decreasing one is smaller")
      var out: List[Raw] = []
      for a in args {
        list.push(out, wf_calls(a, f, n, pos, rec)!)
      }
      let rest = list.enumerate(list.take(out, n)) |> list.filter(((i, _)) => i != pos) |> list.map(((_, a)) => a)
      ok(inductive.raw_apply(RName(rec), [list.get(out, pos) ?? RType, list.get(out, n) ?? RType] + rest))
    },
    _ => match r {
      RApp(a, b) => ok(RApp(wf_calls(a, f, n, pos, rec)!, wf_calls(b, f, n, pos, rec)!)),
      RLam(x, t, b) => ok(RLam(x, wf_calls(t, f, n, pos, rec)!, if x == f then b else wf_calls(b, f, n, pos, rec)!)),
      RPi(x, t, b) => ok(RPi(x, wf_calls(t, f, n, pos, rec)!, if x == f then b else wf_calls(b, f, n, pos, rec)!)),
      RMatch(e, arms) => {
        var arms2: List[syntax.Arm] = []
        for a in arms {
          list.push(arms2, { ...a, body: wf_calls(a.body, f, n, pos, rec)! })
        }
        ok(RMatch(wf_calls(e, f, n, pos, rec)!, arms2))
      },
      RName(g) if g == f => err("${f} is used other than in a full recursive call; well-founded recursion passes all arguments and a proof"),
      other => ok(other),
    },
  }
}

// `by induction x simp(...)`: a match on x with that proof in every case
// (the recursive cases get their induction hypotheses in scope).
local fn induction_arms(env: Env, sig: Sig, body: Raw) -> Raw! = {
  let (params, _, b) = def_parts(sig, body)
  match b {
    // The mark is tested in the arm, not a guard: almide/almide#3414.
    RApp(RApp(RName(mark), RName(x)), proof) => if mark != "%induction" then ok(body) else {
      let dom = match list.find(params, ((p, _)) => p == x) {
        some((_, d)) => ok(d),
        none => err("by induction ${x}: ${x} is not a parameter of ${sig.name}"),
      }!
      let target = match_target(env, dom)!
      let taken = params |> list.map(((p, _)) => p)
      var arms: List[syntax.Arm] = []
      for ci in target.ctors {
        let short = match list.last(string.split(ci.name, ".")) {
          some(s) => s,
          none => ci.name,
        }
        var subs: List[syntax.Sub] = []
        for k in 0..<ci.nargs {
          list.push(subs, SName(inductive.fresh("a" + int.to_string(k + 1), taken)))
        }
        list.push(arms, syntax.Arm { ctor: short, subs: subs, body: proof })
      }
      ok(list.fold(list.reverse(params), RMatch(RName(x), arms), (acc, (p, pty)) => RLam(p, pty, acc)))
    }
    _ => ok(body),
  }
}

// A definition's parameters, its result type and the body under them.
local fn def_parts(sig: Sig, body: Raw) -> (List[(String, Raw)], Raw, Raw) = {
  var params: List[(String, Raw)] = []
  var ty = sig.ty
  var b = body
  var going = true
  while going {
    match b {
      RLam(x, _, inner) => match ty {
        RPi(_, dom, rest) => {
          list.push(params, (x, dom))
          ty = rest
          b = inner
        },
        _ => {
          going = false
        },
      },
      _ => {
        going = false
      },
    }
  }
  (params, ty, b)
}

// Does the definition match on a nested type (kind 0) or on one of its
// nested occurrences (kind k, `List(Rose)`)? The type's full name and the kind.
local fn nested_kind(mut env: Env, sig: Sig, body: Raw) -> (String, Int)? = {
  let (params, _, b) = def_parts(sig, body)
  let x = match b {
    RMatch(RName(v), _) => v,
    _ => "",
  }
  match list.index_of(params |> list.map(((p, _)) => p), x) {
    none => none,
    some(k) => match surface_type(env, sig.levels, sig.ty) {
      err(_) => none,
      ok(ty) => {
        var ctx: Ctx = []
        var t = ty
        var i = 0
        while i < k {
          match t {
            Pi(y, dom, cod) => {
              ctx = [(y, dom)] + ctx
              t = cod
            },
            _ => (),
          }
          i = i + 1
        }
        let dom = match t {
          Pi(_, d, _) => d,
          _ => type0(),
        }
        var bu = budget()
        let w = whnf(env, ctx, dom, bu)
        let (h, _) = spine(w)
        let own = match h {
          Const(c, _) => match map.get(env.inductives, c) {
            some(info) => if list.is_empty(info.nested) then none else some((c, 0)),
            none => none,
          },
          _ => none,
        }
        match own {
          some(r) => some(r),
          none => {
            var found: (String, Int)? = none
            for c in consts(w) {
              match map.get(env.inductives, c) {
                some(info) => for (j, aux) in list.enumerate(info.nested) {
                  if found == none and shape(aux, w, info.params, 0) then {
                    found = some((c, j + 1))
                  } else ()
                },
                none => (),
              }
            }
            found
          },
        }
      },
    },
  }
}

// Does t have the shape of a nested occurrence (its variables stand for
// the type's parameters, which may be anything)?
local fn shape(pat: Term, t: Term, np: Int, depth: Int) -> Bool = match pat {
  Var(i) => if i >= depth and i < depth + np then true else t == Var(i),
  Const(c, _) => match t {
    Const(d, _) => c == d,
    _ => false,
  },
  App(f, a) => match t {
    App(g, b) => shape(f, g, np, depth) and shape(a, b, np, depth),
    _ => false,
  },
  Pi(_, a, b) => match t {
    Pi(_, a2, b2) => shape(a, a2, np, depth) and shape(b, b2, np, depth + 1),
    _ => false,
  },
  Lam(_, a, b) => match t {
    Lam(_, a2, b2) => shape(a, a2, np, depth) and shape(b, b2, np, depth + 1),
    _ => false,
  },
  // Compared through `pat`, not the arm's binding: almide/almide#3437.
  _ => pat == t,
}

// The constructors of the k-th type of a nested group (0: the type
// itself), with the kind of every argument, for the match compiler.
local fn nested_target(env: Env, q: String, kind: Int) -> patterns.Target! = {
  let info = map.get(env.inductives, q) ?? IndInfo { params: 0, indices: 0, ctors: [], fields: [], nested: [] }
  let np = info.params
  var bu = budget()
  let (pctx, _) = telescope(env, [], map.get(env.types, q) ?? type0(), np, bu)!
  var list_ctors: List[(String, Ctx)] = []
  if kind == 0 then {
    for c in info.ctors {
      let (cctx, rest) = telescope(env, [], map.get(env.types, c) ?? type0(), np, bu)!
      var ctx = cctx
      var t = rest
      var going = true
      while going {
        match whnf(env, ctx, t, bu) {
          Pi(x, dom, b) => {
            ctx = [(x, dom)] + ctx
            t = b
          },
          _ => {
            going = false
          },
        }
      }
      list.push(list_ctors, (c, ctx))
    }
  } else {
    for (c, _, _, ctx) in occurrence_ctors(env, pctx, list.get(info.nested, kind - 1) ?? type0(), bu)! {
      list.push(list_ctors, (c, ctx))
    }
  }
  var ctors: List[patterns.Ctor] = []
  for (c, ctx) in list_ctors {
    let doms = list.reverse(list.take(ctx, list.len(ctx) - np))
    var recs: List[Int] = []
    var kinds: List[Int] = []
    var heads: List[String] = []
    var i = 0
    for (_, dom) in doms {
      let here = list.drop(ctx, list.len(ctx) - np - i)
      let kd = arg_kind(env, here, np, q, info.nested, dom, bu)
      if kd >= 0 then list.push(recs, i) else ()
      list.push(kinds, kd)
      list.push(heads, result_head(dom) ?? "")
      i = i + 1
    }
    list.push(ctors, patterns.Ctor { name: c, nargs: list.len(doms), recs: recs, heads: heads, kinds: kinds, idx: [] })
  }
  ok(patterns.Target { rec: if kind == 0 then q + ".rec" else q + ".rec_" + int.to_string(kind), indices: 0, ctors: ctors })
}

// Functions over a nested type and its occurrences, one per type
// (`size(r: Rose)`, `sizes(l: List(Rose))`): each match is compiled with
// calls to the others on fields as induction hypotheses, and every
// function becomes the recursor (`Rose.rec` or `Rose.rec_k`) given all of
// their motives and cases. Nothing here is trusted: the results are
// ordinary definitions, checked as usual.
local fn add_nested_defs(mut env: Env, line: Int, group: List[Decl]) -> List[String]! = {
  var items: List[(Decl, Sig, Raw, String, Int)] = []
  for d in group {
    match d {
      DDef(sig, body) => match nested_kind(env, sig, body) {
        some((q, kd)) => list.push(items, (d, sig, body, q, kd)),
        none => (),
      },
      DTheorem(sig, body) => match nested_kind(env, sig, body) {
        some((q, kd)) => list.push(items, (d, sig, body, q, kd)),
        none => (),
      },
      _ => (),
    }
  }
  let fnames = group |> list.map((d) => match d {
    DDef(sig, _) => sig.name,
    DTheorem(sig, _) => sig.name,
    _ => "",
  })
  guard list.len(items) == list.len(group) else err("the functions ${list.join(fnames, ", ")} call each other; they must all match on a nested type or its occurrences")
  let q = match list.first(items) {
    some((_, _, _, q, _)) => q,
    none => "",
  }
  let info = map.get(env.inductives, q) ?? IndInfo { params: 0, indices: 0, ctors: [], fields: [], nested: [] }
  guard list.all(items, ((_, _, _, q2, _)) => q2 == q) else err("the functions ${list.join(fnames, ", ")} match on different nested types")
  let n = list.len(info.nested) + 1
  var by_kind: List[Int] = []
  var k = 0
  while k < n {
    var at: List[Int] = []
    for (i, it) in list.enumerate(items) {
      let (_, _, _, _, kd) = it
      if kd == k then list.push(at, i) else ()
    }
    guard list.len(at) == 1 else err("functions over the nested type ${q} recurse through all of its types together: give exactly one function for each of ${q} and the ${int.to_string(n - 1)} types it is nested in (found ${int.to_string(list.len(at))} for type ${int.to_string(k)}${if k == 0 then "" else ", " + show(env, [], list.get(info.nested, k - 1) ?? type0())})")
    list.push(by_kind, list.first(at) ?? 0)
    k = k + 1
  }
  let siblings = items |> list.map(((_, sig, _, _, kd)) => (sig.name, kd))
  let (p0, _, _) = match list.first(items) {
    some((_, sig, body, _, _)) => def_parts(sig, body),
    none => ([], RType, RType),
  }
  var motives: List[Raw] = list.repeat(RType, n)
  var minors: List[List[Raw]] = list.repeat([], n)
  var calls: List[(Raw, String, List[String], List[(String, Raw)])] = []
  for (_, sig, body, _, kd) in items {
    let (params, ret, b) = def_parts(sig, body)
    let (scrut, arms) = match b {
      RMatch(RName(v), arms) => (v, arms),
      _ => ("", []),
    }
    let pos = list.index_of(params |> list.map(((x, _)) => x), scrut) ?? 0
    guard list.len(params) == list.len(p0) and list.take(params, pos) == list.take(p0, pos) else err("${sig.name}: functions over a nested type must take the same parameters, before the matched one, as the others in the group")
    let target = nested_target(env, q, kd)!
    let d = patterns.Def { name: sig.name, implicits: sig.implicits, params: params, ret: ret }
    let compiled = patterns.compile_in(d, scrut, arms, target, (nm) => target_named(env, nm), kd, siblings)!
    let (_, args) = inductive.raw_spine(compiled)
    let nc = list.len(target.ctors)
    motives = list.set(motives, kd, list.first(args) ?? RType)
    minors = list.set(minors, kd, list.take(list.drop(args, 1), nc))
    list.push(calls, (RName(target.rec), scrut, list.drop(args, 1 + nc + 1) |> list.map((a) => match a {
      RName(x) => x,
      _ => "",
    }), params))
  }
  let all_minors = minors |> list.flat_map((ms) => ms)
  var lines: List[String] = []
  for (it, cl) in list.zip(items, calls) {
    let (decl, sig, _, _, _) = it
    let (rec, scrut, others, params) = cl
    let call = inductive.raw_apply(rec, motives + all_minors + [RName(scrut)] + (others |> list.map((x) => RName(x))))
    let body = list.fold(list.reverse(params), call, (acc, (p, pty)) => RLam(p, pty, acc))
    let out = match decl {
      DTheorem(_, _) => DTheorem(sig, body),
      _ => DDef(sig, body),
    }
    lines = lines + process(env, Located { line: line, decl: out })!
  }
  ok(lines)
}

local fn add_family_defs(mut env: Env, line: Int, group: List[Decl]) -> List[String]! = {
  var defs: List[mutual.MutualDef] = []
  for d in group {
    match d {
      DDef(sig, body) => list.push(defs, mutual.MutualDef { kind: "def", sig: sig, body: body }),
      DTheorem(sig, body) => list.push(defs, mutual.MutualDef { kind: "theorem", sig: sig, body: body }),
      _ => (),
    }
  }
  // The sort of each result type: they must agree (it is the sort the
  // combined definition's result type, picked by the tag, lands in).
  var sorts: List[Level] = []
  for d in defs {
    list.push(sorts, result_sort(env, d.sig, d.body)!)
  }
  let s0 = list.first(sorts) ?? LZero
  guard list.all(sorts, (l) => level_eq(l, s0)) else err("the mutually recursive definitions ${list.join(defs |> list.map((d) => d.sig.name), ", ")} have results in different universes")
  let member = (n: String) => mutual_member(env, n)
  let ctors = (q: String) => ctors_of(env, q)
  // A group of propositions that eliminates only into Prop can only be
  // matched to build proofs.
  for d in defs {
    let (_, sty) = last_param(d.sig, d.body)
    match mutual_member(env, raw_head_name(sty)) {
      some(m) => {
        let own = list.len(d.sig.levels)
        let large = list.len(map.get(env.lparams, m.family + ".rec") ?? []) > list.len(map.get(env.lparams, m.family) ?? [])
        guard large or level_eq(s0, LZero) else err("${d.sig.name} matches on ${raw_head_name(sty)}, a proposition that eliminates only into Prop (like Lean's and Rocq's), so it can only build proofs; its result lives in ${show(env, [], Sort(s0))}")
        if own < 0 then () else ()
      },
      none => (),
    }
  }
  var lines: List[String] = []
  for decl in mutual.encode_defs(defs, member, ctors, RApp(RSort, level_raw(s0)))! {
    lines = lines + process(env, Located { line: line, decl: decl })!
  }
  ok(lines)
}

local fn last_param(sig: Sig, body: Raw) -> (String, Raw) = {
  var ty = sig.ty
  var b = body
  var last = ("", RType)
  var going = true
  while going {
    match b {
      RLam(x, _, inner) => match ty {
        RPi(_, dom, rest) => {
          last = (x, dom)
          ty = rest
          b = inner
        },
        _ => {
          going = false
        },
      },
      _ => {
        going = false
      },
    }
  }
  last
}

local fn raw_head_name(r: Raw) -> String = {
  let (h, _) = raw_head(r)
  match h {
    RName(x) => x,
    RInst(x, _) => x,
    _ => "",
  }
}

// The universe a definition's result type lives in (its parameters are
// the binders its body takes).
local fn result_sort(mut env: Env, sig: Sig, body: Raw) -> Level! = {
  let ty = surface_type(env, sig.levels, sig.ty)!
  var n = 0
  var b = body
  var going = true
  while going {
    match b {
      RLam(_, _, inner) => {
        n = n + 1
        b = inner
      },
      _ => {
        going = false
      },
    }
  }
  var ctx: Ctx = []
  var t = ty
  var k = 0
  while k < n {
    match t {
      Pi(x, dom, cod) => {
        ctx = [(x, dom)] + ctx
        t = cod
      },
      _ => (),
    }
    k = k + 1
  }
  var bu = budget()
  expect_sort(env, ctx, t, bu)
}

// A level as written: `0`, `u`, `u + 1`, `max(u, v)`.
local fn level_raw(l: Level) -> Raw = match l {
  LZero => RName("0"),
  LParam(u) => RName(u),
  LMax(a, b) => RApp(RApp(RName("max"), level_raw(a)), level_raw(b)),
  LIMax(a, b) => RApp(RApp(RName("imax"), level_raw(a)), level_raw(b)),
  LSucc(_) => {
    var k = 0
    var base = l
    var going = true
    while going {
      match base {
        LSucc(x) => {
          k = k + 1
          base = x
        },
        _ => {
          going = false
        },
      }
    }
    match base {
      LZero => RName(int.to_string(k)),
      _ => RApp(RApp(RName("+"), level_raw(base)), RName(int.to_string(k))),
    }
  },
  _ => RName("0"),
}

// For a type of a mutual group (a definition `X(params, idx) =
// family(params, tag.X, idx)`), its family, tag constructor and number of
// parameters.
local fn mutual_member(env: Env, n: String) -> Option[mutual.Member] = {
  let q = match resolve_const(env, n) {
    ok(c) => c,
    err(_) => "",
  }
  var b = map.get(env.bodies, q) ?? type0()
  var going = true
  while going {
    match b {
      Lam(_, _, inner) => {
        b = inner
      },
      _ => {
        going = false
      },
    }
  }
  let (h, args) = spine(b)
  match h {
    Const(fam, _) => match map.get(env.inductives, fam) {
      some(info) => if not string.ends_with(fam, ".mutual") or info.indices < 1 then none
        else match list.get(args, info.params) {
          some(Const(tag, _)) => {
            let varied = map.contains(env.types, fam + ".index")
            var n = 0
            var body = map.get(env.bodies, q) ?? type0()
            var going2 = true
            while going2 {
              match body {
                Lam(_, _, inner) => {
                  n = n + 1
                  body = inner
                },
                _ => {
                  going2 = false
                },
              }
            }
            some(mutual.Member { family: fam, tag: tag, nparams: info.params, varied: varied, nidx: n - info.params })
          },
          _ => none,
        },
      none => none,
    },
    _ => none,
  }
}

// An inductive type's constructors, named after the type's own name, with
// their numbers of fields.
local fn ctors_of(env: Env, q: String) -> List[(String, Int)] = match map.get(env.inductives, q) {
  none => [],
  some(info) => info.ctors |> list.map((c) => (string.drop(c, string.len(q) + 1), list.len(pi_domains(map.get(env.types, c) ?? type0())) - info.params)),
}

// A mutual group: the family it is encoded as, then each type, each
// constructor and each recursor (mutual.almd), all checked as usual.
local fn add_mutual(mut env: Env, line: Int, inds: List[Inductive]) -> List[String]! = {
  let names = inds |> list.map((i) => i.name)
  for decl in mutual.encode(inds)! {
    process(env, Located { line: line, decl: decl })!
  }
  let g = env.room + "." + mutual.group_name(inds)
  let own = list.len((list.first(inds) ?? mutual.empty_ind()).levels)
  let large = list.len(map.get(env.lparams, g + ".rec") ?? []) > own
  for decl in (if mutual.varied(inds) then mutual.recursors_varied(inds, large) else mutual.recursors(inds, large)) {
    process(env, Located { line: line, decl: decl })!
  }
  ok(["✓ types ${list.join(names |> list.map((n) => env.room + "." + n), ", ")}: mutual, encoded as the family ${g} (recursors ${list.join(names |> list.map((n) => n + ".rec"), ", ")}${if large then " into any universe" else " into Prop"})"])
}

local fn step(mut env: Env, line: Int, d: Decl) -> Unit! = {
  let (change, _) = examine(env, Located { line: line, decl: d })!
  commit(env, change)
  ok(())
}

// Undo the declarations after position `start` and the rules after `nrules`.
local fn rollback(mut env: Env, start: Int, nrules: Int) -> Unit = {
  for q in list.drop(env.order, start) {
    map.delete(env.entries, q)
    map.delete(env.types, q)
    map.delete(env.bodies, q)
    map.delete(env.defs, q)
    map.delete(env.lparams, q)
    map.delete(env.implicits, q)
    map.delete(env.rws, q)
  }
  env.order = list.take(env.order, start)
  env.rules = list.take(env.rules, nrules)
}

// `type T ... = | c ...`: the type former, the constructors, then (once
// the type is known to be admissible) the recursor and its rules.
local fn add_inductive(mut env: Env, line: Int, ind: Inductive) -> List[String]! = {
  for c in ind.ctors {
    guard not list.any(c.args, ((a, _)) => list.any(ind.params, ((p, _)) => p == a)) else err("constructor ${c.name}: argument names must differ from the parameters")
  }
  step(env, line, inductive.type_former(ind))!
  for d in inductive.constructors(ind) {
    step(env, line, d)!
  }
  var bu = budget()
  let (plan, auxes) = admissible(env, ind, bu)!
  let q = env.room + "." + ind.name
  let elim_decls = if list.is_empty(auxes) then inductive.eliminator(ind, plan) else inductive.nested_eliminator(ind, plan, nested_layout(env, ind, q, auxes, bu)!)
  for d in elim_decls {
    step(env, line, d)! 
  }
  map.insert(env.inductives, q, IndInfo { params: list.len(ind.params), indices: list.len(inductive.indices(ind.arity)), ctors: ind.ctors |> list.map((c) => q + "." + c.name), fields: ind.fields, nested: auxes })
  guard not list.contains(ind.fields, "mk") and not list.contains(ind.fields, "rec") else err("a field cannot be called mk or rec")
  for d in inductive.projections(ind) {
    step(env, line, d)!
  }
  let elim = if plan.large then "into any universe" else "into Prop only"
  ok(["✓ type ${q}: ${int.to_string(list.len(ind.ctors))} constructors, recursor ${q}.rec ${elim}"])
}

// ── Views ───────────────────────────────────────────────────────────
//
// `view V from S { sym = term, ... }` interprets room S in the current
// room: each symbol of S stands for a term here, checked against the
// symbol's type as the view translates it, and every rule of S must still
// hold here (by conversion). Symbols left out are carried as assumptions,
// definitions and theorems of S are carried and checked again.
//
// `translate V name` carries a declaration of a room built on S, with
// everything it uses, into this room. Nothing is taken on trust: every
// carried definition and theorem is checked again here, so a wrong view
// can only make a translation fail.

local fn sees(env: Env, room: String, src: String) -> Bool =
  room == src or list.contains(map.get(env.rooms, room) ?? [], src)

// A term of a room built on the view's source, as a term of this room.
fn carry(v: View, t: Term) -> Term = match t {
  Const(c, ls) => match map.get(v.images, c) {
    some(u) => u,
    none => match map.get(v.renamed, c) {
      some(n) => Const(n, ls),
      none => t,
    },
  },
  App(f, a) => App(carry(v, f), carry(v, a)),
  Lam(x, ty, b) => Lam(x, carry(v, ty), carry(v, b)),
  Pi(x, ty, b) => Pi(x, carry(v, ty), carry(v, b)),
  other => other,
}

local fn add_view(mut env: Env, name: String, src: String, entries: List[(String, Raw)]) -> List[String]! = {
  guard map.contains(env.rooms, src) else err("view ${name}: unknown room ${src}")
  guard src != env.room else err("view ${name}: a room cannot view itself")
  let vq = env.room + "." + name
  guard not map.contains(env.views, vq) else err("view ${vq} already exists")
  var given: Map[String, Raw] = [:]
  var pending: Map[String, Raw] = [:]
  for (x, r) in entries {
    let own = src + "." + x
    let q = if map.contains(env.entries, own) and room_of(env, own) == src then own else x
    guard map.contains(env.entries, q) else err("view ${name}: ${x} is not a declaration of ${src} or of a room built on it")
    guard is_symbol(env, q) else err("view ${name}: ${x} is a definition or theorem; those are carried along, only symbols are mapped")
    let home = room_of(env, q)
    guard sees(env, home, src) else err("view ${name}: ${x} is in room ${home}, which does not use ${src}")
    guard not map.contains(given, q) and not map.contains(pending, q) else err("view ${name}: ${x} is mapped twice")
    if home == src then map.insert(given, q, r) else map.insert(pending, q, r)
  }
  let none_yet: Map[String, Term] = [:]
  install_view(env, name, src, given, none_yet, pending, [])
}

// The checks every view goes through, written or composed: each image
// against its symbol's translated type, the source's definitions and
// theorems carried and checked again, its rules kept by conversion.
local fn install_view(mut env: Env, name: String, src: String, given: Map[String, Raw], terms: Map[String, Term], pending: Map[String, Raw], via: List[String]) -> List[String]! = {
  let vq = env.room + "." + name
  var v = View { source: src, images: [:], renamed: [:], pending: pending, name: vq, target: env.room, mapped: [], carried: [], via: via }
  var order: List[String] = []
  for q in env.order {
    if room_of(env, q) == src then list.push(order, q) else ()
  }
  var mapped = 0
  var carried: List[String] = []
  for q in order {
    match map.get(given, q) {
      some(r) => {
        image(env, v, q, r)!
        mapped = mapped + 1
      },
      none => match map.get(terms, q) {
        some(t) => {
          image_term(env, v, q, t)!
          mapped = mapped + 1
        },
        none => {
          let _ = carry_decl(env, v, name, q)!
          if is_symbol(env, q) then list.push(carried, q) else ()
        },
      },
    }
  }
  let rules = env.rules
  for r in rules {
    if r.room == src then keeps_rule(env, v, name, r)! else ()
  }
  for r in env.irrelevants {
    guard r.room != src else err("view ${name}: ${src} declares irrelevant types, which views do not carry yet")
  }
  for (_, si) in map.entries(env.structs) {
    guard si.decl.room != src else err("view ${name}: ${src} declares structures, which views do not carry yet")
  }
  v.mapped = list.sort(map.keys(v.images))
  v.carried = carried
  map.insert(env.views, vq, v)
  let note = if list.is_empty(carried) then "" else "; carried as assumptions: ${list.join(carried, ", ")}"
  let route = if list.is_empty(via) then "" else " (composed: ${list.join(via, " then ")})"
  ok(["✓ view ${vq}: ${src} in ${env.room}${route}, ${int.to_string(mapped)} symbols mapped${note}"])
}

// The image of a symbol: a term of this room with the symbol's translated type.
local fn image(mut env: Env, mut v: View, q: String, r: Raw) -> Unit! = {
  guard not map.contains(env.lparams, q) else err("${q} has universe parameters; a view maps only symbols without them")
  let ty = carry(v, map.get(env.types, q) ?? type0())
  var bu = budget()
  expect_sort(env, [], ty, bu)!
  let t = surface_term(env, [], no_brackets_ok(r)!, ty)!
  check(env, [], t, ty, bu)!
  map.insert(v.images, q, t)
  ok(())
}

// An image given as a term (a composed view's): checked the same way.
local fn image_term(mut env: Env, mut v: View, q: String, t: Term) -> Unit! = {
  guard not map.contains(env.lparams, q) else err("${q} has universe parameters; a view maps only symbols without them")
  let ty = carry(v, map.get(env.types, q) ?? type0())
  var bu = budget()
  expect_sort(env, [], ty, bu)!
  check(env, [], t, ty, bu)!
  map.insert(v.images, q, t)
  ok(())
}

// ── Composing and finding views (#13) ───────────────────────────────

// A view by the name it was declared with (`ab` or `b.ab`), among the
// views whose source is `src`; two candidates are an error that lists them.
local fn view_named(env: Env, n: String, src: String) -> View! = {
  var found: List[View] = []
  for (k, v) in map.entries(env.views) {
    if (k == n or string.ends_with(k, "." + n)) and v.source == src then list.push(found, v) else ()
  }
  match found {
    [] => err("no view ${n} from ${src}"),
    [v] => ok(v),
    many => err("${n} is ambiguous: ${list.join(many |> list.map((v) => v.name), ", ")}"),
  }
}

// `view ac from a via ab, bc`: ab reads a in b, bc (declared here) reads b
// here; each image of ab is carried along bc, and the result is checked
// as a view of its own.
local fn compose_view(mut env: Env, name: String, src: String, via: List[String]) -> List[String]! = {
  guard list.len(via) == 2 else err("view ${name}: compose exactly two views (via first, second)")
  guard map.contains(env.rooms, src) else err("view ${name}: unknown room ${src}")
  let vq = env.room + "." + name
  guard not map.contains(env.views, vq) else err("view ${vq} already exists")
  let first = view_named(env, list.get(via, 0) ?? "", src)!
  var second = view_named(env, list.get(via, 1) ?? "", first.target)!
  guard second.target == env.room else err("view ${name}: ${second.name} reads ${first.target} in ${second.target}, not here (${env.room})")
  guard map.is_empty(first.pending) else err("view ${name}: ${first.name} maps symbols of rooms built on ${src}; composing those is not supported yet")
  var terms: Map[String, Term] = [:]
  for (q, t) in map.entries(first.images) {
    carry_closure(env, second, t)!
    map.insert(terms, q, carry(second, t))
  }
  let none_raw: Map[String, Raw] = [:]
  let lines = install_view(env, name, src, none_raw, terms, none_raw, [first.name, second.name])!
  // Only now: if anything failed, the declarations are rolled back and the
  // second view must not remember them.
  map.insert(env.views, second.name, second)
  ok(lines)
}

// Carry along v everything t uses that is built on v's source.
local fn carry_closure(mut env: Env, mut v: View, t: Term) -> Unit! = {
  var need: List[(Int, String)] = []
  var seen: Map[String, Bool] = [:]
  var stack: List[String] = consts(t)
  var going = true
  while going {
    match list.pop(stack) {
      none => {
        going = false
      },
      some(c) => {
        let skip = map.contains(seen, c) or map.contains(v.images, c) or map.contains(v.renamed, c) or not sees(env, room_of(env, c), v.source)
        if skip then ()
        else {
          map.insert(seen, c, true)
          let h = match map.get(env.entries, c) {
            some(e) => e.height,
            none => 0,
          }
          list.push(need, (h, c))
          for d in consts(map.get(env.types, c) ?? type0()) {
            list.push(stack, d)
          }
          match map.get(env.bodies, c) {
            some(b) => for d in consts(b) {
              list.push(stack, d)
            },
            none => (),
          }
        }
      },
    }
  }
  let prefix = match list.last(string.split(v.name, ".")) {
    some(x) => x,
    none => v.name,
  }
  for (_, c) in list.sort_by(need, ((h, _)) => h) {
    let _ = carry_decl(env, v, prefix, c)!
  }
  ok(())
}

// The symbols a view's images rest on (what using it assumes).
local fn footprint(env: Env, v: View) -> List[String] = {
  var out: List[String] = []
  for (_, t) in map.entries(v.images) {
    for c in consts(t) {
      for s in deps(env, c).symbols {
        if list.contains(out, s) then () else list.push(out, s)
      }
    }
  }
  list.sort(out)
}

local fn rests_on(env: Env, vs: List[View]) -> String = {
  var all: List[String] = []
  for v in vs {
    for x in footprint(env, v) + v.carried {
      if list.contains(all, x) then () else list.push(all, x)
    }
  }
  if list.is_empty(all) then "(nothing)" else list.join(all, ", ")
}

local fn catalog(env: Env) -> List[String] = {
  var out: List[String] = []
  for v in list.sort_by(map.values(env.views), (v) => v.name) {
    let via = if list.is_empty(v.via) then "" else ", composed of " + list.join(v.via, " then ")
    list.push(out, "view ${v.name}: ${v.source} in ${v.target}${via}")
    list.push(out, "  mapped:  ${list.join(v.mapped, ", ")}")
    list.push(out, "  carried: ${if list.is_empty(v.carried) then "(none)" else list.join(v.carried, ", ")}")
    list.push(out, "  rests on: ${rests_on(env, [v])}")
  }
  if list.is_empty(out) then ["no views"] else out
}

// Routes from room src into this room: a view declared here (one hop), or
// a view into some room r followed by a view of r declared here (two). The
// search stops at two hops; every route found is listed, none is chosen.
local fn routes(env: Env, src: String) -> List[String] = {
  var out: List[String] = []
  let here = map.values(env.views) |> list.filter((v) => v.target == env.room)
  for v in here {
    if v.source == src then list.push(out, "route ${src} -> ${env.room}: ${v.name}; rests on ${rests_on(env, [v])}") else ()
  }
  for v2 in here {
    for v1 in map.values(env.views) {
      if v1.source == src and v1.target == v2.source and v1.target != env.room then {
        list.push(out, "route ${src} -> ${v1.target} -> ${env.room}: ${v1.name} then ${v2.name}; rests on ${rests_on(env, [v1, v2])} (compose with: view NAME from ${src} via ${v1.name}, ${v2.name})")
      } else ()
    }
  }
  if list.is_empty(out) then ["no route from ${src} to ${env.room} within two views (inconclusive: longer routes are not searched)"]
  else if list.len(out) > 1 then ["${int.to_string(list.len(out))} routes; none is chosen for you:"] + out
  else out
}

local fn no_brackets_ok(r: Raw) -> Raw! = {
  no_brackets([r])!
  ok(r)
}

// A declaration carried along a view: declared here under the view's name,
// its type (and body) translated and checked again.
local fn carry_decl(mut env: Env, mut v: View, prefix: String, q: String) -> String! = {
  let e = match map.get(env.entries, q) {
    some(x) => ok(x),
    none => err("unknown name ${q}"),
  }!
  guard not (e.kind == "symbol" and map.contains(env.rws, q)) else err("${q} has rewrite rules; give it an image in the view")
  let n = env.room + "." + prefix + "." + q
  guard not map.contains(env.entries, n) else err("${n} is already declared")
  let lv = map.get(env.lparams, q) ?? []
  let imps = map.get(env.implicits, q) ?? 0
  let ty = carry(v, map.get(env.types, q) ?? type0())
  var bu = budget()
  expect_sort(env, [], ty, bu)!
  let body = match map.get(env.bodies, q) {
    some(b) => some(carry(v, b)),
    none => none,
  }
  match body {
    some(b) => check(env, [], b, ty, bu)!,
    none => (),
  }
  commit(env, Declare(n, lv, imps, Entry { room: env.room, kind: e.kind, height: list.len(env.order) }, ty, body))
  map.insert(v.renamed, q, n)
  ok(n)
}

local fn pat_term(p: Pat) -> Term = match p {
  PVar(k) => Var(k),
  PSym(c, ps) => apply(Const(c, []), ps |> list.map((x) => pat_term(x))),
  PBracket(t) => t,
}

// A rule of the source still holds here: both sides, translated, convert.
local fn keeps_rule(mut env: Env, v: View, name: String, r: Rule) -> Unit! = {
  guard list.is_empty(r.lparams) else err("view ${name}: the rule ${r.text} has universe parameters, which views do not carry yet")
  let lhs = carry(v, apply(Const(r.head, []), r.lhs_args |> list.map((p) => pat_term(p))))
  let rhs = carry(v, r.rhs)
  var ctx: Ctx = []
  var i = 0
  for ty in r.var_tys {
    list.push(ctx, ("x" + int.to_string(i), carry(v, ty)))
    i = i + 1
  }
  var bu = budget()
  let same = conv(env, ctx, lhs, rhs, bu)
  guard not bu.exhausted else err(exhausted_error())
  guard same else err("view ${name} does not keep the rule ${r.text}\n    left:  ${show(env, ctx, lhs)}\n    right: ${show(env, ctx, rhs)}")
  ok(())
}

local fn translate(mut env: Env, vname: String, name: String) -> List[String]! = {
  let vq = env.room + "." + vname
  var v = match map.get(env.views, vq) {
    some(x) => ok(x),
    none => err("unknown view ${vname} (a view is used in the room that declares it)"),
  }!
  // The source theory need not be visible here: that is the point.
  let q = if map.contains(env.entries, name) then name else resolve_const(env, name)!
  let src = v.source
  guard sees(env, room_of(env, q), src) else err("${q} is not built on ${src}, which ${vname} views")
  // Everything q uses that is built on the source, oldest first.
  var need: List[(Int, String)] = []
  var seen: Map[String, Bool] = [:]
  var stack: List[String] = [q]
  var going = true
  while going {
    match list.pop(stack) {
      none => {
        going = false
      },
      some(c) => {
        let skip = map.contains(seen, c) or map.contains(v.images, c) or map.contains(v.renamed, c) or not sees(env, room_of(env, c), src)
        if skip then ()
        else {
          map.insert(seen, c, true)
          let h = match map.get(env.entries, c) {
            some(e) => e.height,
            none => 0,
          }
          list.push(need, (h, c))
          for d in consts(map.get(env.types, c) ?? type0()) {
            list.push(stack, d)
          }
          match map.get(env.bodies, c) {
            some(b) => for d in consts(b) {
              list.push(stack, d)
            },
            none => (),
          }
        }
      },
    }
  }
  let ordered = list.sort_by(need, ((h, _)) => h)
  for (_, c) in ordered {
    match map.get(v.pending, c) {
      some(r) => image(env, v, c, r)!,
      none => {
        let _ = carry_decl(env, v, vname, c)!
      },
    }
  }
  map.insert(env.views, vq, v)
  match map.get(v.renamed, q) {
    some(n) => ok(["✓ translated ${n}: ${show(env, [], map.get(env.types, n) ?? type0())} (${int.to_string(list.len(ordered))} declarations carried)"]),
    none => ok(["✓ translated ${q}: given by the view"]),
  }
}

// Peel `n` binders off a type (reducing to expose them), extending ctx.
local fn telescope(env: Env, ctx: Ctx, ty: Term, n: Int, mut bu: Budget) -> (Ctx, Term)! = {
  var c = ctx
  var t = ty
  var k = 0
  while k < n {
    match whnf(env, c, t, bu) {
      Pi(x, dom, body) => {
        c = [(x, dom)] + c
        t = body
      },
      _ => {
        k = n
      },
    }
    k = k + 1
  }
  guard list.len(c) == list.len(ctx) + n else err("expected ${int.to_string(n)} parameters in ${show(env, ctx, ty)}")
  ok((c, t))
}

// The parameters, as variables at the given depth below them.
local fn uniform(args: List[Term], np: Int, depth: Int) -> Bool =
  list.len(args) >= np and list.all(list.enumerate(list.take(args, np)), ((i, a)) => a == Var(depth - 1 - i))

// Is the type admissible, and what may its recursor eliminate into?
//   - every constructor ends in the type at its own parameters,
//   - the type occurs in an argument only strictly positively,
//   - arguments live in universes no larger than the type's (unless the
//     type is a proposition),
//   - a proposition eliminates only into Prop, unless it is a subsingleton
//     (no constructor, or one whose arguments are proofs or indices).
local fn admissible(env: Env, ind: Inductive, mut bu: Budget) -> (inductive.Plan, List[Term])! = {
  let q = env.room + "." + ind.name
  let np = list.len(ind.params)
  let ni = list.len(inductive.indices(ind.arity))
  let (_, sort_t) = telescope(env, [], map.get(env.types, q) ?? type0(), np + ni, bu)!
  let level = match whnf(env, [], sort_t, bu) {
    Sort(l) => ok(l),
    other => err("${ind.name}'s type must end in a universe, not ${show(env, [], other)}"),
  }!
  let maybe_prop = not level_leq(LSucc(LZero), level)
  let is_prop = level_eq(level, LZero)
  let ls = ind.levels |> list.map((u) => LParam(u))
  var large = not maybe_prop
  var found: List[Term] = []
  for c in ind.ctors {
    let cq = q + "." + c.name
    let (pctx, rest) = telescope(env, [], map.get(env.types, cq) ?? type0(), np, bu)!
    var ctx = pctx
    var t = rest
    var proofs_or_indices = true
    var arg_vars: List[Int] = []
    for (a, _) in c.args {
      match whnf(env, ctx, t, bu) {
        Pi(x, dom, body) => {
          let depth = list.len(ctx)
          for o in positive(env, ctx, q, np, depth, dom, bu)! {
            if not list.contains(found, o) then list.push(found, o) else ()
          }
          let u = sort_level(env, ctx, dom, bu)!
          guard is_prop or level_leq(u, level) else err("constructor ${c.name}: argument ${a} lives in a universe too large for ${ind.name}")
          if not level_eq(u, LZero) then {
            list.push(arg_vars, depth)
          } else ()
          ctx = [(x, dom)] + ctx
          t = body
        },
        _ => (),
      }
    }
    // The result: the type itself, at its parameters, the type absent from the indices.
    let depth = list.len(ctx)
    let (h, args) = spine(whnf(env, ctx, t, bu))
    let head_ok = match h {
      Const(d, us) => d == q and levels_eq(us, ls),
      _ => false,
    }
    guard head_ok and uniform(args, np, depth) else err("constructor ${c.name} must build ${ind.name} at its own parameters")
    let idx = list.drop(args, np)
    guard not list.any(idx, (i) => list.contains(consts(i), q)) else err("constructor ${c.name}: ${ind.name} cannot appear in its own indices")
    // A non-proof argument keeps a proposition small unless an index names it.
    for v in arg_vars {
      let var_here = Var(depth - 1 - v)
      if not list.contains(idx, var_here) then {
        proofs_or_indices = false
      } else ()
    }
    if maybe_prop and list.len(ind.ctors) == 1 and proofs_or_indices then {
      large = true
    } else ()
  }
  if maybe_prop and list.is_empty(ind.ctors) then {
    large = true
  } else ()
  let k = is_prop and large and list.len(ind.ctors) == 1 and list.all(ind.ctors, (c) => list.is_empty(c.args))
  if list.is_empty(found) then ok((inductive.Plan { large: large, k: k }, []))
  else {
    guard ni == 0 else err("${ind.name}: a nested type cannot have indices yet")
    guard not maybe_prop else err("${ind.name}: a proposition cannot be nested in another type")
    ok((inductive.Plan { large: large, k: false }, nested_closure(env, ind, q, np, found, bu)!))
  }
}

local fn sort_level(env: Env, ctx: Ctx, ty: Term, mut bu: Budget) -> Level! = expect_sort(env, ctx, ty, bu)

// Strict positivity of one constructor argument: the type may appear only
// as the conclusion of the argument, at its own parameters.
local fn positive(env: Env, ctx: Ctx, q: String, np: Int, depth0: Int, dom: Term, mut bu: Budget) -> List[Term]! =
  if not list.contains(consts(dom), q) then ok([])
  else {
    var c = ctx
    var t = whnf(env, ctx, dom, bu)
    var going = true
    while going {
      match t {
        Pi(x, a, b) => {
          guard not list.contains(consts(a), q) else err("${q} occurs in a negative position (left of an arrow) in a constructor argument")
          c = [(x, a)] + c
          t = whnf(env, c, b, bu)
        },
        _ => {
          going = false
        },
      }
    }
    let (h, args) = spine(t)
    match h {
      Const(d, _) if d == q => {
        // Parameters of the outer declaration sit `depth0` binders up from the
        // argument; the argument's own binders add the rest.
        guard uniform(args, np, list.len(c)) else err("${q} must appear in a constructor argument at its own parameters")
        guard not list.any(list.drop(args, np), (i) => list.contains(consts(i), q)) else err("${q} cannot appear in the indices of a recursive argument")
        ok([])
      },
      Const(j, _) => nested_occurrence(env, c, q, np, j, t, args),
      _ => err("${q} must appear in a constructor argument only as its result (strict positivity)"),
    }
  }

// `q` inside the parameters of another inductive type j (`List(Rose)`):
// a nested occurrence. j must have no indices, and the arguments may
// depend only on q's own parameters. The occurrence is returned in the
// context of those parameters; `nested_closure` then checks q's
// positivity through j's constructors.
local fn nested_occurrence(env: Env, c: Ctx, q: String, np: Int, j: String, t: Term, args: List[Term]) -> List[Term]! = {
  let info = match map.get(env.inductives, j) {
    some(i) => ok(i),
    none => err("${q} must appear in a constructor argument only as its result, or among the parameters of an inductive type (strict positivity)"),
  }!
  guard info.indices == 0 and list.len(args) == info.params else err("${q} can be nested only among the parameters of a type without indices (${j} has indices)")
  let nloc = list.len(c) - np
  guard not list.any(args, (a) => loose(a, nloc, 0)) else err("${q} is nested in ${j} at arguments that depend on a constructor's arguments")
  ok([shift(t, 0 - nloc, 0)])
}

// Does t mention one of the variables depth .. depth + n - 1?
local fn loose(t: Term, n: Int, depth: Int) -> Bool = match t {
  Var(i) => i >= depth and i < depth + n,
  App(f, a) => loose(f, n, depth) or loose(a, n, depth),
  Lam(_, ty, b) => loose(ty, n, depth) or loose(b, n, depth + 1),
  Pi(_, ty, b) => loose(ty, n, depth) or loose(b, n, depth + 1),
  _ => false,
}

// The constructors of a nested occurrence `j(args)`, at those arguments:
// each one's arguments in order, in the context of q's parameters.
local fn occurrence_ctors(env: Env, pctx: Ctx, occ: Term, mut bu: Budget) -> List[(String, List[Level], List[Term], Ctx)]! = {
  let (h, args) = spine(occ)
  let (j, us) = match h {
    Const(j, us) => (j, us),
    _ => ("", []),
  }
  let info = map.get(env.inductives, j) ?? IndInfo { params: 0, indices: 0, ctors: [], fields: [], nested: [] }
  var out: List[(String, List[Level], List[Term], Ctx)] = []
  for c in info.ctors {
    var t = inst_levels(map.get(env.types, c) ?? type0(), map.get(env.lparams, c) ?? [], us)
    for a in args {
      t = match whnf(env, pctx, t, bu) {
        Pi(_, _, b) => ok(subst(b, a)),
        _ => err("constructor ${c} takes fewer parameters than ${j}"),
      }!
    }
    var ctx = pctx
    var going = true
    while going {
      match whnf(env, ctx, t, bu) {
        Pi(x, dom, b) => {
          ctx = [(x, dom)] + ctx
          t = b
        },
        _ => {
          going = false
        },
      }
    }
    out = out + [(c, us, args, ctx)]
  }
  ok(out)
}

// Every nested occurrence, closed under j's constructors (`List(Rose)`
// needs `Rose` positive in List.cons's arguments at A := Rose, and may
// reveal further occurrences there).
local fn nested_closure(env: Env, ind: Inductive, q: String, np: Int, found: List[Term], mut bu: Budget) -> List[Term]! = {
  let (pctx, _) = telescope(env, [], map.get(env.types, q) ?? type0(), np, bu)!
  var all = found
  var i = 0
  while i < list.len(all) {
    guard list.len(all) <= 16 else err("${ind.name}: too many nested occurrences")
    let occ = list.get(all, i) ?? type0()
    for (_, _, _, ctx) in occurrence_ctors(env, pctx, occ, bu)! {
      let doms = list.reverse(list.take(ctx, list.len(ctx) - np))
      var k = 0
      for (_, dom) in doms {
        let here = list.drop(ctx, list.len(ctx) - np - k)
        for o in positive(env, here, q, np, list.len(here), dom, bu)! {
          if not list.contains(all, o) then list.push(all, o) else ()
        }
        k = k + 1
      }
    }
    i = i + 1
  }
  ok(all)
}

// The argument's kind for the recursor: 0 a recursive argument, k the
// k-th nested occurrence, -1 neither.
local fn arg_kind(env: Env, ctx: Ctx, np: Int, q: String, auxes: List[Term], dom: Term, mut bu: Budget) -> Int = {
  var c = ctx
  var t = whnf(env, ctx, dom, bu)
  var going = true
  while going {
    match t {
      Pi(x, a, b) => {
        c = [(x, a)] + c
        t = whnf(env, c, b, bu)
      },
      _ => {
        going = false
      },
    }
  }
  let (h, _) = spine(t)
  let nloc = list.len(c) - np
  match h {
    Const(d, _) if d == q => 0,
    Const(_, _) => if loose(t, nloc, 0) then -1 else match list.index_of(auxes, shift(t, 0 - nloc, 0)) {
      some(i) => i + 1,
      none => -1,
    },
    _ => -1,
  }
}

// A term as written, its variables named by `names` (innermost first).
local fn term_raw(t: Term, names: List[String]) -> Raw = match t {
  Var(i) => RName(list.get(names, i) ?? "_"),
  Const(c, ls) => RExplicit(c, ls |> list.map((l) => level_raw(l))),
  Sort(l) => RApp(RSort, level_raw(l)),
  App(f, a) => RApp(term_raw(f, names), term_raw(a, names)),
  Lam(x, ty, b) => {
    let y = inductive.fresh(if x == "_" then "x" else x, names)
    RLam(y, term_raw(ty, names), term_raw(b, [y] + names))
  },
  Pi(x, ty, b) => {
    let y = inductive.fresh(if x == "_" then "x" else x, names)
    RPi(y, term_raw(ty, names), term_raw(b, [y] + names))
  },
  _ => RName("_"),
}

// What `inductive.nested_eliminator` needs: each occurrence and its
// constructors as written, and the kind of every constructor argument.
local fn nested_layout(env: Env, ind: Inductive, q: String, auxes: List[Term], mut bu: Budget) -> inductive.Nested! = {
  let np = list.len(ind.params)
  let (pctx, _) = telescope(env, [], map.get(env.types, q) ?? type0(), np, bu)!
  let pnames = list.reverse(ind.params |> list.map(((x, _)) => x))
  let taken0 = [ind.name] + pnames + (ind.ctors |> list.flat_map((c) => c.args |> list.map(((x, _)) => x))) + ind.levels
  var out: List[inductive.Aux] = []
  for occ in auxes {
    var ctors: List[inductive.AuxCtor] = []
    for (c, us, args, ctx) in occurrence_ctors(env, pctx, occ, bu)! {
      let doms = list.reverse(list.take(ctx, list.len(ctx) - np))
      var names = pnames
      var bs: List[(String, Raw)] = []
      var kinds: List[Int] = []
      var k = 0
      for (x, dom) in doms {
        let here = list.drop(ctx, list.len(ctx) - np - k)
        let y = inductive.fresh(if x == "_" then "a" else x, taken0 + names)
        list.push(bs, (y, term_raw(dom, names)))
        list.push(kinds, arg_kind(env, here, np, q, auxes, dom, bu))
        names = [y] + names
        k = k + 1
      }
      list.push(ctors, inductive.AuxCtor { name: c, head: RExplicit(c, us |> list.map((l) => level_raw(l))), params: args |> list.map((a) => term_raw(a, pnames)), args: bs, kinds: kinds })
    }
    list.push(out, inductive.Aux { ty: term_raw(occ, pnames), ctors: ctors })
  }
  var kinds: List[List[Int]] = []
  var own: List[List[(String, Raw)]] = []
  for c in ind.ctors {
    let (cctx, rest) = telescope(env, [], map.get(env.types, q + "." + c.name) ?? type0(), np, bu)!
    var ctx = cctx
    var t = rest
    var ks: List[Int] = []
    var bs: List[(String, Raw)] = []
    var names = pnames
    for (a, _) in c.args {
      match whnf(env, ctx, t, bu) {
        Pi(x, dom, b) => {
          list.push(ks, arg_kind(env, ctx, np, q, auxes, dom, bu))
          list.push(bs, (a, term_raw(dom, names)))
          names = [a] + names
          ctx = [(x, dom)] + ctx
          t = b
        },
        _ => (),
      }
    }
    list.push(kinds, ks)
    list.push(own, bs)
  }
  ok(inductive.Nested { auxes: out, kinds: kinds, args: own })
}

// `mut` only so that the call from `process` borrows the environment instead
// of copying it (it is not changed here).
local fn examine(mut env: Env, d: Located) -> (Change, List[String])! = match d.decl {
  DRoom(name, uses) => ok((enter_room(env, name, uses)!, [])),
  DSymbol(sig) => {
    no_brackets([sig.ty])!
    let ty = surface_type(env, sig.levels, sig.ty)!
    var bu = budget()
    expect_sort(env, [], ty, bu)!
    ok((declare(env, sig, "symbol", ty, none)!, []))
  },
  DDef(sig, body_raw) => {
    let (ty, body) = typed_body(env, sig.levels, sig.ty, compile_match(env, sig, body_raw)!)!
    ok((declare(env, sig, "def", ty, some(body))!, []))
  },
  DTheorem(sig, body_raw) => {
    let (ty, body) = typed_body(env, sig.levels, sig.ty, compile_match(env, sig, body_raw)!)!
    let c = declare(env, sig, "theorem", ty, some(body))!
    ok((c, ["✓ theorem ${env.room}.${sig.name}: ${show(env, [], ty)}"]))
  },
  DRule(vars, lhs, rhs) => ok((add_rule(env, vars, lhs, rhs, d.line)!, [])),
  DIrrelevant(vars, ty) => ok((add_irrelevant(env, vars, ty, d.line)!, [])),
  DStructure(ty, mk, projs) => ok((add_structure(env, ty, mk, projs, d.line)!, [])),
  DCheck(e_raw) => {
    no_brackets([e_raw])!
    let e = if needs_elab(env, e_raw) then {
      let (t, _) = elab.elab_infer(env, [], e_raw)!
      t
    } else resolve(env, [], [], e_raw)!
    var bu = budget()
    let ty = infer(env, [], e, bu)!
    ok((NoChange, ["${show(env, [], e)}: ${show(env, [], ty)}"]))
  },
  DEval(e_raw) => {
    no_brackets([e_raw])!
    let e = if needs_elab(env, e_raw) then {
      let (t, _) = elab.elab_infer(env, [], e_raw)!
      t
    } else resolve(env, [], [], e_raw)!
    var bu = budget()
    infer(env, [], e, bu)!
    let v = nf(env, [], e, bu)
    guard not bu.exhausted else err(exhausted_error())
    ok((NoChange, ["${show(env, [], e)} = ${show(env, [], v)}"]))
  },
  DAxioms(name) => {
    let q = resolve_const(env, name)!
    ok((NoChange, report_axioms(env, q)))
  },
  DInductive(_) => err("a type declaration is processed by `process`"),
  DView(_, _, _) => err("a view is processed by `process`"),
  DViewVia(_, _, _) => err("a view is processed by `process`"),
  DViews => ok((NoChange, catalog(env))),
  DRoutes(src) => {
    guard map.contains(env.rooms, src) else err("unknown room ${src}")
    ok((NoChange, routes(env, src)))
  },
  DSearch(sig, kind, names, depth) => {
    no_brackets([sig.ty])!
    let ty = surface_type(env, sig.levels, sig.ty)!
    var bu = budget()
    expect_sort(env, [], ty, bu)!
    var using: List[(String, List[String], Term)] = []
    for n in names {
      let q = resolve_const(env, n)!
      list.push(using, (q, map.get(env.lparams, q) ?? [], map.get(env.types, q) ?? type0()))
    }
    let t = search.find(env, ty, using, depth)!
    check(env, [], t, ty, bu)!
    let c = declare(env, sig, kind, ty, some(t))!
    ok((c, ["✓ found by search: ${sig.name} = ${show(env, [], t)}", "✓ ${kind} ${env.room}.${sig.name}: ${show(env, [], ty)}"]))
  },
  DTranslate(_, _) => err("a translation is processed by `process`"),
  DMutual(_) => err("a mutual group is processed by `process`"),
  DMutualDefs(_) => err("mutually recursive definitions are processed by `process`"),
}

// Surface syntax that uses implicit arguments, inferred universe levels or
// `_` goes through the elaborator; everything else (absorbed libraries,
// hand-written kernel terms) is resolved directly.
local fn needs_elab(env: Env, r: Raw) -> Bool =
  if map.is_empty(env.implicits) and map.is_empty(env.lparams) and map.is_empty(env.inductives) then has_hole(r)
  else uses_inference(env, r)

local fn has_hole(r: Raw) -> Bool = match r {
  RName(x) => x == "_" or x == "?" or x == "%simp",
  RApp(f, a) => has_hole(f) or has_hole(a),
  RLam(_, ty, b) => has_hole(ty) or has_hole(b),
  RPi(_, ty, b) => has_hole(ty) or has_hole(b),
  _ => false,
}

local fn uses_inference(env: Env, r: Raw) -> Bool = match r {
  RName(x) => x == "_" or x == "?" or x == "%simp" or match resolve_const(env, x) {
    ok(c) => map.contains(env.implicits, c) or map.contains(env.lparams, c),
    // `p.x` (a field of a local p) is the elaborator's to read.
    err(_) => string.contains(x, "."),
  },
  RRecord(_, _) => true,
  RField(_, _) => true,
  RInst(x, _) => match resolve_const(env, x) {
    ok(c) => map.contains(env.implicits, c),
    err(_) => false,
  },
  RExplicit(x, ls) => list.is_empty(ls) and match resolve_const(env, x) {
    ok(c) => map.contains(env.lparams, c),
    err(_) => false,
  },
  RApp(f, a) => uses_inference(env, f) or uses_inference(env, a),
  RLam(_, ty, b) => uses_inference(env, ty) or uses_inference(env, b),
  RPi(_, ty, b) => uses_inference(env, ty) or uses_inference(env, b),
  _ => false,
}

// `mut env` here and below only to borrow the environment: passed by value,
// it is copied on every declaration (the checker became quadratic).
local fn surface_type(mut env: Env, lv: List[String], r: Raw) -> Term! =
  if needs_elab(env, r) then elab.elab_type(env, lv, r) else resolve(env, lv, [], r)

local fn surface_term(mut env: Env, lv: List[String], r: Raw, ty: Term) -> Term! =
  if needs_elab(env, r) then elab.elab_term(env, lv, r, ty) else resolve(env, lv, [], r)

// A body that is `match x { ... }` (under the parameters' lambdas) is
// compiled to x's recursor first.
local fn compile_match(env: Env, sig: Sig, body0: Raw) -> Raw! = {
  let body = induction_arms(env, sig, body0)!
  var params: List[(String, Raw)] = []
  var ty = sig.ty
  var b = body
  var going = true
  while going {
    match b {
      RLam(x, _, inner) => match ty {
        RPi(y, dom, rest) => {
          list.push(params, (x, dom))
          ty = if y == x then rest else rest
          b = inner
        },
        _ => {
          going = false
        },
      },
      _ => {
        going = false
      },
    }
  }
  match b {
    RMatch(RName(x), arms) => {
      let dom = match list.find(params, ((p, _)) => p == x) {
        some((_, d)) => d,
        none => RType,
      }
      let target = match_target(env, dom)!
      let d = patterns.Def { name: sig.name, implicits: sig.implicits, params: params, ret: ty }
      let compiled = patterns.compile(d, x, arms, target, (n) => target_named(env, n))!
      ok(list.fold(list.reverse(params), compiled, (acc, (p, pty)) => RLam(p, pty, acc)))
    },
    RMatch(_, _) => {
      let d = patterns.Def { name: sig.name, implicits: sig.implicits, params: params, ret: ty }
      let compiled = patterns.compile_on(d, b, (n) => target_named(env, n))!
      ok(list.fold(list.reverse(params), compiled, (acc, (p, pty)) => RLam(p, pty, acc)))
    },
    _ => ok(body),
  }
}

// The recursor and constructors of the type a matched parameter has.
local fn match_target(env: Env, dom: Raw) -> patterns.Target! = {
  let (h, _) = raw_head(dom)
  let name = match h {
    RName(x) => ok(x),
    RInst(x, _) => ok(x),
    RExplicit(x, _) => ok(x),
    _ => err("match needs a parameter whose type is an inductive type"),
  }!
  match target_named(env, name) {
    some(t) => ok(t),
    none => err("${name} is not an inductive type, so it cannot be matched"),
  }
}

// An inductive type by its name as written (or its full name), as the
// match compiler needs it.
local fn target_named(env: Env, name: String) -> patterns.Target? =
  if string.starts_with(name, "#") then {
    // `#c`: the type constructor c builds.
    match resolve_const(env, string.drop(name, 1)) {
      ok(c) => match result_head(map.get(env.types, c) ?? type0()) {
        some(t) => if map.contains(env.inductives, t) and list.contains((map.get(env.inductives, t) ?? IndInfo { params: 0, indices: 0, ctors: [], fields: [], nested: [] }).ctors, c) then target_type(env, t) else none,
        none => none,
      },
      err(_) => none,
    }
  } else if string.starts_with(name, "=") then {
    // `=f`: the type a call of f returns.
    match resolve_const(env, string.drop(name, 1)) {
      ok(f) => match result_head(map.get(env.types, f) ?? type0()) {
        some(t) => target_named(env, t),
        none => none,
      },
      err(_) => none,
    }
  } else target_type(env, name)

local fn target_type(env: Env, name: String) -> patterns.Target? = {
  let q = if map.contains(env.inductives, name) then name else match resolve_const(env, name) {
    ok(c) => c,
    err(_) => "",
  }
  match map.get(env.inductives, q) {
    none => none,
    some(info) => {
      var ctors: List[patterns.Ctor] = []
      for c in info.ctors {
        let cty = map.get(env.types, c) ?? type0()
        let own = list.drop(pi_domains(cty), info.params)
        var recs: List[Int] = []
        var heads: List[String] = []
        var kinds: List[Int] = []
        let nested = not list.is_empty(info.nested)
        for (i, a) in list.enumerate(own) {
          let h = result_head(a)
          if h == some(q) and not nested then list.push(recs, i) else ()
          list.push(kinds, if h == some(q) and not nested then 0 else -1)
          list.push(heads, h ?? "")
        }
        list.push(ctors, patterns.Ctor { name: c, nargs: list.len(own), recs: recs, heads: heads, kinds: kinds, idx: ctor_indices(cty, info.params, info.indices) })
      }
      // A nested type is split by `T.cases` (no recursion); recursion goes
      // through a group of functions, one per type (`nested_defs`).
      some(patterns.Target { rec: q + (if list.is_empty(info.nested) then ".rec" else ".cases"), indices: info.indices, ctors: ctors })
    },
  }
}

local fn raw_head(r: Raw) -> (Raw, Int) = match r {
  RApp(f, _) => {
    let (h, n) = raw_head(f)
    (h, n + 1)
  },
  other => (other, 0),
}

// A constructor's indices, over `%p<i>` for the type's parameters and
// `%f<j>` for the constructor's own fields.
local fn ctor_indices(cty: Term, nparams: Int, nindices: Int) -> List[Raw] = {
  var names: List[String] = []
  var t = cty
  var going = true
  while going {
    match t {
      Pi(_, _, b) => {
        let i = list.len(names)
        names = [if i < nparams then "%p" + int.to_string(i) else "%f" + int.to_string(i - nparams)] + names
        t = b
      },
      _ => {
        going = false
      },
    }
  }
  let (_, args) = spine(t)
  list.drop(args, list.len(args) - nindices) |> list.map((a) => term_raw(a, names))
}

local fn pi_domains(t: Term) -> List[Term] = match t {
  Pi(_, dom, b) => [dom] + pi_domains(b),
  _ => [],
}

// The head constant at the end of a (function) type.
local fn result_head(t: Term) -> String? = match t {
  Pi(_, _, b) => result_head(b),
  _ => {
    let (h, _) = spine(t)
    match h {
      Const(c, _) => some(c),
      _ => none,
    }
  },
}

local fn typed_body(mut env: Env, lv: List[String], ty_raw: Raw, body_raw: Raw) -> (Term, Term)! = {
  no_brackets([ty_raw, body_raw])!
  let ty = surface_type(env, lv, ty_raw)!
  var bu = budget()
  expect_sort(env, [], ty, bu)!
  let body = surface_term(env, lv, body_raw, ty)!
  check(env, [], body, ty, bu)!
  ok((ty, body))
}

// ── Dependency tracking ─────────────────────────────────────────────

type Deps = { symbols: List[String], rules: List[Rule], lemmas: List[String] }

// Everything `name` rests on: the symbols it assumes, the rules attached to
// them, and the defs/theorems it goes through. Transitive.
fn deps(env: Env, name: String) -> Deps = {
  // A loop with an explicit stack: dependency chains in absorbed libraries
  // run thousands of declarations deep.
  var pending: List[String] = [name]
  var seen: Map[String, Bool] = [:]
  var symbols: List[String] = []
  var rules: List[Rule] = []
  var lemmas: List[String] = []
  var queued: List[String] = []
  while not list.is_empty(pending) {
    let c = list.pop(pending) ?? ""
    if map.contains(seen, c) then () else {
      map.insert(seen, c, true)
      match map.get(env.entries, c) {
        none => (),
        some(e) => {
          if e.kind == "symbol" then {
            list.push(symbols, c)
            for r in env.rules + env.irrelevants {
              if r.head == c then {
                list.push(rules, r)
                for m in list.reverse(rule_mentions(r)) {
                  list.push(queued, m)
                }
              } else ()
            }
            match map.get(env.structs, c) {
              some(si) => list.push(rules, si.decl),
              none => (),
            }
          } else if c != name then list.push(lemmas, c) else ()
          // Visit in source order: the type, then the body, then the rules.
          let body = match map.get(env.bodies, c) {
            some(b) => consts(b),
            none => [],
          }
          let ty = match map.get(env.types, c) {
            some(t) => consts(t),
            none => [],
          }
          for m in queued {
            list.push(pending, m)
          }
          queued = []
          for m in list.reverse(ty + body) {
            list.push(pending, m)
          }
        },
      }
    }
  }
  Deps { symbols: symbols, rules: rules, lemmas: lemmas }
}

local fn rule_mentions(r: Rule) -> List[String] =
  (r.var_tys |> list.flat_map((t) => consts(t)))
    + (r.lhs_args |> list.flat_map((p) => pat_consts(p)))
    + consts(r.rhs)

// What `axioms q` prints, for proof bundles.
fn axioms_report(env: Env, q: String) -> List[String] = report_axioms(env, q)

local fn report_axioms(env: Env, q: String) -> List[String] = {
  let d = deps(env, q)
  let rooms = list.unique((d.symbols |> list.map((s) => room_of(env, s))) + (d.rules |> list.map((r) => r.room)))
  let header = ["axioms ${q}", "  rooms:   ${list.join(rooms, ", ")}"]
  // Symbols and rules a `type` declaration generated were admitted by the
  // inductive checks (see docs/TRUST.md); they are listed apart from the
  // assumptions declared by hand, and the listing is not a certificate.
  let typed = d.symbols |> list.filter((c) => generated(env, c))
  let assumed = d.symbols |> list.filter((c) => not generated(env, c))
  let syms = if list.is_empty(assumed) then ["  symbols: (none)"] else ["  symbols: ${list.join(assumed, ", ")}"]
  let types = if list.is_empty(typed) then [] else ["  types:   ${list.join(typed, ", ")} (from type declarations)"]
  let own_rules = d.rules |> list.filter((r) => not generated(env, r.head))
  let rules = if list.is_empty(own_rules) then ["  rules:   (none)"]
    else own_rules |> list.enumerate |> list.map(((i, r)) =>
      (if i == 0 then "  rules:   " else "           ") + "[${r.id}] ${r.text}")
  let lemmas = if list.is_empty(d.lemmas) then [] else ["  through: ${list.join(d.lemmas, ", ")}"]
  header + syms + types + rules + lemmas
}

// Was c generated by a `type` declaration (its type former, a
// constructor or its recursor)?
local fn generated(env: Env, c: String) -> Bool =
  map.contains(env.inductives, c) or list.any(map.entries(env.inductives), ((q, info)) => c == q + ".rec" or list.contains(info.ctors, c))

// ── Whole files ─────────────────────────────────────────────────────

type Outcome = { env: Env, output: List[String], error: String? }

// Check declarations in order, stopping at the first failure.
fn check_all(env: Env, ds: List[Located]) -> Outcome = {
  var cur = env
  var out: List[String] = []
  var error: String? = none
  for d in ds {
    if error == none then match process(cur, d) {
      ok(lines) => {
        for l in lines {
          list.push(out, l)
        }
      },
      err(e) => {
        error = some("${int.to_string(d.line)}: ${e}")
      },
    } else ()
  }
  Outcome { env: cur, output: out, error: error }
}

// ── What packages export (#20) ──────────────────────────────────────

// The rooms of the symbols and rules declared by hand that q rests on: what
// an allowed-assumption policy is stated in. Generated ones (from `type`
// declarations, admitted by the inductive checks) are not assumptions.
fn assumption_rooms(env: Env, q: String) -> List[String] = {
  let d = deps(env, q)
  let syms = d.symbols |> list.filter((c) => not generated(env, c)) |> list.map((s) => room_of(env, s))
  let rls = d.rules |> list.filter((r) => not generated(env, r.head)) |> list.map((r) => r.room)
  list.sort(list.unique(syms + rls))
}

// A checked view as text: its name, source and target, the image of every
// mapped symbol, what it carried as assumptions, what it was composed of,
// and what it rests on. Its hash is the view's identity in a package.
fn view_text(env: Env, q: String) -> String? = match map.get(env.views, q) {
  none => none,
  some(v) => {
    var out: List[String] = ["view ${v.name}: ${v.source} in ${v.target}"]
    for k in list.sort(map.keys(v.images)) {
      let img = map.get(v.images, k) ?? Sort(LZero)
      list.push(out, "  ${k} = ${pretty.show("", [], img)}")
    }
    list.push(out, "  carried: ${list.join(v.carried, ", ")}")
    list.push(out, "  via: ${list.join(v.via, ", ")}")
    list.push(out, "  rests on: ${rests_on(env, [v])}")
    some(list.join(out, "\n"))
  },
}
