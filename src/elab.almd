// The elaborator: surface terms with implicit arguments, inferred universe
// levels and `_` holes, turned into complete kernel terms.
//
//   def length[u, A: Type(u)](xs: List(A)) -> Nat = ...
//   length(List.cons(Nat.zero, List.nil))
//
// becomes `length[0](Nat, List.cons[0](Nat, Nat.zero, List.nil[0](Nat)))`:
// the level 0 and the type Nat are found by unification. Holes are
// metavariables applied to the variables in scope where they were made, so
// a solution may mention those variables; `?m x y =?= t` with distinct
// variables is solved by `?m := (x, y) => t` (Miller's pattern fragment).
//
// Nothing here is trusted. The output has no holes left and goes to the
// kernel like any hand-written term; a wrong solution is a type error.

import self.term.{Term, Level, shift, instantiate, subst, spine, apply, inst_levels, type0, level_eq, level_has_meta, has_meta, occurs}
import self.syntax.{Raw}
import self.kernel.{Env, Ctx, Budget, budget, whnf, whnf_core, nf, def_height, unfold_head, resolve_const, show, exhausted_error, index_in, level_of, eta_pairs}
import self.kernel

// `typed`: holes for implicit arguments with the type their solution must
// have, checked once solved (that is how levels like the u in `id[u]` are
// found from the argument's type).
type ElabState = {
  metas: Map[Int, Term],
  lmetas: Map[Int, Level],
  // Every hole solved, in order, so a failed attempt can undo exactly its
  // own solutions (copying the maps to restore them made unification
  // quadratic in the number of holes).
  trail: List[Int],
  ltrail: List[Int],
  next: Int,
  bu: Budget,
  typed: List[(Ctx, Term, Term)],
  // Equations between types that could not be decided yet (both sides
  // waiting on holes); retried as holes get solved.
  // The term each is about is kept, not its message: printing the term
  // at every postponement (each level of a nested proof) made elaboration
  // quadratic in time and memory (#17's term family).
  postponed: List[(Ctx, Term, Term, Term)],
  // `?`: goals left open on purpose, reported with their types
  goals: List[(Ctx, Term, Term)],
}

fn state() -> ElabState = ElabState { metas: [:], lmetas: [:], trail: [], ltrail: [], next: 0, bu: budget(), typed: [], postponed: [], goals: [] }

// ── Holes ───────────────────────────────────────────────────────────

local fn new_meta(mut st: ElabState, ctx: Ctx) -> Term = {
  let n = st.next
  st.next = n + 1
  let k = list.len(ctx)
  apply(Meta(n), list.map(0..<k, (j) => Var(k - 1 - j)))
}

local fn new_level(mut st: ElabState) -> Level = {
  let n = st.next
  st.next = n + 1
  LMeta(n)
}

// Replace solved holes by their solutions (and compute the applications
// this creates).
fn zonk(st: ElabState, t: Term) -> Term = match t {
  Meta(n) => match map.get(st.metas, n) {
    some(v) => zonk(st, v),
    none => t,
  },
  // Only an application headed by a solved hole needs its spine (to
  // compute the solution applied); any other one is zonked part by part,
  // since taking the spine copies the arguments, at every level of a
  // nested term (almide/almide#3434).
  App(f, a) =>
    if solved_head(st, f) then {
      let (h, args) = spine(t)
      let zargs = args |> list.map((x) => zonk(st, x))
      match h {
        Meta(n) => match map.get(st.metas, n) {
          some(v) => zonk(st, beta(v, zargs)),
          none => apply(h, zargs),
        },
        _ => apply(zonk(st, h), zargs),
      }
    } else App(zonk(st, f), zonk(st, a)),
  Sort(l) => Sort(zonk_level(st, l)),
  Const(c, ls) => Const(c, ls |> list.map((l) => zonk_level(st, l))),
  Lam(x, ty, b) => Lam(x, zonk(st, ty), zonk(st, b)),
  Pi(x, ty, b) => Pi(x, zonk(st, ty), zonk(st, b)),
  Var(_) => t,
}

local fn beta(f: Term, args: List[Term]) -> Term = match args {
  [] => f,
  [a, ..rest] => match f {
    Lam(_, _, b) => beta(subst(b, a), rest),
    _ => apply(f, args),
  },
}

local fn solved_head(st: ElabState, t: Term) -> Bool = match t {
  App(f, _) => solved_head(st, f),
  Meta(n) => map.contains(st.metas, n),
  _ => false,
}

local fn solve(mut st: ElabState, n: Int, v: Term) -> Unit = {
  map.insert(st.metas, n, v)
  list.push(st.trail, n)
}

local fn solve_level(mut st: ElabState, n: Int, l: Level) -> Unit = {
  map.insert(st.lmetas, n, l)
  list.push(st.ltrail, n)
}

// Undo the solutions made since `mark` (lengths of the two trails).
local fn undo(mut st: ElabState, mark: (Int, Int)) -> Unit = {
  let (m, l) = mark
  while list.len(st.trail) > m {
    match list.pop(st.trail) {
      some(n) => map.delete(st.metas, n),
      none => (),
    }
  }
  while list.len(st.ltrail) > l {
    match list.pop(st.ltrail) {
      some(n) => map.delete(st.lmetas, n),
      none => (),
    }
  }
}

fn zonk_level(st: ElabState, l: Level) -> Level = match l {
  LMeta(n) => match map.get(st.lmetas, n) {
    some(v) => zonk_level(st, v),
    none => l,
  },
  LSucc(a) => LSucc(zonk_level(st, a)),
  LMax(a, b) => LMax(zonk_level(st, a), zonk_level(st, b)),
  LIMax(a, b) => LIMax(zonk_level(st, a), zonk_level(st, b)),
  other => other,
}

// ── Unification ─────────────────────────────────────────────────────

local fn level_mentions(l: Level, n: Int) -> Bool = match l {
  LMeta(m) => m == n,
  LSucc(a) => level_mentions(a, n),
  LMax(a, b) => level_mentions(a, n) or level_mentions(b, n),
  LIMax(a, b) => level_mentions(a, n) or level_mentions(b, n),
  _ => false,
}

fn unify_level(mut st: ElabState, a: Level, b: Level) -> Bool = {
  let x = zonk_level(st, a)
  let y = zonk_level(st, b)
  if x == y then true
  else match x {
    LMeta(n) => if level_mentions(y, n) then false else {
      solve_level(st, n, y)
      true
    },
    _ => match y {
      LMeta(n) => if level_mentions(x, n) then false else {
        solve_level(st, n, x)
        true
      },
      _ =>
        if not level_has_meta(x) and not level_has_meta(y) then level_eq(x, y)
        else match x {
          LSucc(p) => match y {
            LSucc(q) => unify_level(st, p, q),
            _ => false,
          },
          LMax(p1, p2) => match y {
            LMax(q1, q2) => unify_level(st, p1, q1) and unify_level(st, p2, q2),
            _ => false,
          },
          LIMax(p1, p2) => match y {
            LIMax(q1, q2) => unify_level(st, p1, q1) and unify_level(st, p2, q2),
            _ => false,
          },
          _ => false,
        },
    },
  }
}

// The distinct bound variables a hole is applied to, if that is all it is applied to.
local fn pattern_args(args: List[Term]) -> List[Int]? = {
  var out: List[Int] = []
  var good = true
  for a in args {
    match a {
      Var(i) => if list.contains(out, i) then {
        good = false
      } else list.push(out, i),
      _ => {
        good = false
      },
    }
  }
  if good then some(out) else none
}

local fn mentions_meta(t: Term, n: Int) -> Bool = match t {
  Meta(m) => m == n,
  App(f, a) => mentions_meta(f, n) or mentions_meta(a, n),
  Lam(_, ty, b) => mentions_meta(ty, n) or mentions_meta(b, n),
  Pi(_, ty, b) => mentions_meta(ty, n) or mentions_meta(b, n),
  _ => false,
}

// Rewrite t (seen `depth` binders deep) so that free variable vars[j]
// becomes the j-th of k new outer binders; none if another variable occurs.
local fn abstract(t: Term, vars: List[Int], depth: Int) -> Term? = {
  let k = list.len(vars)
  match t {
    Var(i) =>
      if i < depth then some(t)
      else match list.index_of(vars, i - depth) {
        some(j) => some(Var(depth + (k - 1 - j))),
        none => none,
      },
    App(f, a) => match abstract(f, vars, depth) {
      some(f2) => match abstract(a, vars, depth) {
        some(a2) => some(App(f2, a2)),
        none => none,
      },
      none => none,
    },
    Lam(x, ty, b) => match abstract(ty, vars, depth) {
      some(ty2) => match abstract(b, vars, depth + 1) {
        some(b2) => some(Lam(x, ty2, b2)),
        none => none,
      },
      none => none,
    },
    Pi(x, ty, b) => match abstract(ty, vars, depth) {
      some(ty2) => match abstract(b, vars, depth + 1) {
        some(b2) => some(Pi(x, ty2, b2)),
        none => none,
      },
      none => none,
    },
    other => some(other),
  }
}

// `?n x1 .. xk =?= t`: ?n := (x1, .., xk) => t, when the xi are distinct
// variables, t mentions no others and does not mention ?n.
local fn try_solve(mut st: ElabState, ctx: Ctx, a: Term, b: Term) -> Bool = {
  let (h, args) = spine(a)
  match h {
    Meta(n) =>
      if map.contains(st.metas, n) or mentions_meta(b, n) then false
      else match pattern_args(args) {
        some(vars) => match abstract(prune(st, b, vars, 0), vars, 0) {
          some(body) => {
            // Each binder gets the type its variable has in ctx, rewritten
            // over the binders before it.
            var sol = body
            var j = list.len(vars) - 1
            while j >= 0 {
              let i = list.get(vars, j) ?? 0
              let ty = match list.get(ctx, i) {
                some((_, t)) => abstract(shift(t, i + 1, 0), list.take(vars, j), 0) ?? type0(),
                none => type0(),
              }
              sol = Lam(name_of(ctx, i), ty, sol)
              j = j - 1
            }
            solve(st, n, sol)
            true
          },
          none => false,
        },
        none => false,
      },
    _ => false,
  }
}

// Holes inside a candidate solution that are applied to variables the
// solution may not mention lose those arguments: `?k(x, y)` with y out of
// scope becomes `?k'(x)`, where ?k := (x, y) => ?k'(x). Without this,
// `?h(A) =?= S(?k(A, s))` would fail for no reason.
local fn prune(mut st: ElabState, t: Term, allowed: List[Int], depth: Int) -> Term = {
  let (h, args) = spine(t)
  match h {
    Meta(n) =>
      if map.contains(st.metas, n) then t
      else match pattern_args(args) {
        some(vars) => {
          let keep = vars |> list.filter((i) => i < depth or list.contains(allowed, i - depth))
          if list.len(keep) == list.len(vars) then t
          else {
            let m = st.next
            st.next = m + 1
            // ?n := (v1, .., vk) => ?m(the kept ones), as positions in vs.
            let k = list.len(vars)
            let body = apply(Meta(m), keep |> list.map((i) => match list.index_of(vars, i) {
              some(j) => Var(k - 1 - j),
              none => Var(0),
            }))
            solve(st, n, list.fold(vars, body, (acc, _) => Lam("x", type0(), acc)))
            apply(Meta(m), keep |> list.map((i) => Var(i)))
          }
        },
        none => t,
      },
    _ => match t {
      App(f, a) => App(prune(st, f, allowed, depth), prune(st, a, allowed, depth)),
      Lam(x, ty, b) => Lam(x, prune(st, ty, allowed, depth), prune(st, b, allowed, depth + 1)),
      Pi(x, ty, b) => Pi(x, prune(st, ty, allowed, depth), prune(st, b, allowed, depth + 1)),
      other => other,
    },
  }
}

local fn name_of(ctx: Ctx, i: Int) -> String = match list.get(ctx, i) {
  some((x, _)) => x,
  none => "x",
}

local fn is_pattern_meta(st: ElabState, t: Term) -> Bool = {
  let (h, args) = spine(t)
  match h {
    Meta(n) => not map.contains(st.metas, n) and pattern_args(args) != none,
    _ => false,
  }
}

local fn is_meta_app(t: Term) -> Bool = {
  let (h, _) = spine(t)
  match h {
    Meta(_) => true,
    _ => false,
  }
}

// How deeply unification may nest (one level per compared argument):
// well inside the native stack, which ran out near 12,800 levels.
let UNIFY_DEPTH = 4096

fn unify(env: Env, mut st: ElabState, ctx: Ctx, a: Term, b: Term) -> Bool = {
  let x = zonk(st, a)
  let y = zonk(st, b)
  if x == y then true
  else if try_solve(st, ctx, x, y) or try_solve(st, ctx, y, x) then true
  // A variable the solution may not mention can disappear by computing
  // (`((p) => B(p.fst))(mk(a, b))` is `B(a)`): normalise, then try again.
  else if is_pattern_meta(st, x) and try_solve(st, ctx, x, nf(env, ctx, y, st.bu)) then true
  else if is_pattern_meta(st, y) and try_solve(st, ctx, y, nf(env, ctx, x, st.bu)) then true
  // Nesting is bounded like the kernel's comparison: each unfolding of a
  // definition goes one level deeper, so a deep computation runs out of
  // budget instead of the stack.
  else if not kernel.enter_up_to(st.bu, UNIFY_DEPTH) then false
  else {
    let wx = whnf_core(env, ctx, x, st.bu)
    let wy = whnf_core(env, ctx, y, st.bu)
    let r = if (wx != x or wy != y) and (is_meta_app(wx) or is_meta_app(wy)) then unify(env, st, ctx, wx, wy)
      else unify_whnf(env, st, ctx, wx, wy)
    kernel.leave(st.bu)
    r
  }
}

// Record eta (see kernel.eta_pairs): `P.mk(a1, a2) =?= p` when
// `a1 =?= p.x` and `a2 =?= p.y`.
local fn unify_eta(env: Env, mut st: ElabState, ctx: Ctx, x: Term, y: Term) -> Bool =
  if is_meta_app(y) then false
  else match eta_pairs(env, x, y) {
    none => false,
    some(pairs) => {
      var good = true
      for (a, b) in pairs {
        if good then {
          good = unify(env, st, ctx, a, b)
        } else ()
      }
      good
    },
  }

// Two terms in weak-head normal form. Unfolding definitions is a loop
// (as in the kernel's conv_whnf), so a long computation costs budget
// steps, not stack.
local fn unify_whnf(env: Env, mut st: ElabState, ctx: Ctx, x0: Term, y0: Term) -> Bool = {
  var x = x0
  var y = y0
  var answer = false
  var going = true
  while going {
    if x == y then {
      answer = true
      going = false
    } else if st.bu.exhausted then {
      going = false
    } else match unify_here(env, st, ctx, x, y) {
      some(r) => {
        answer = r
        going = false
      },
      none => match unfold_step(env, st, ctx, x, y) {
        some((ux, uy)) =>
          if is_meta_app(ux) or is_meta_app(uy) then {
            answer = unify(env, st, ctx, ux, uy)
            going = false
          } else {
            x = ux
            y = uy
          },
        none => {
          answer = attempt_eta(env, st, ctx, x, y) or attempt_eta(env, st, ctx, y, x)
          going = false
        },
      },
    }
  }
  answer
}

// What the shapes decide without unfolding: some(answer), or none when
// unfolding may still make them agree.
local fn unify_here(env: Env, mut st: ElabState, ctx: Ctx, x: Term, y: Term) -> Option[Bool] =
  match x {
    Sort(l1) => match y {
      Sort(l2) => some(unify_level(st, l1, l2)),
      _ => none,
    },
    Pi(n1, t1, b1) => match y {
      Pi(_, t2, b2) => some(unify(env, st, ctx, t1, t2) and unify(env, st, [(n1, t1)] + ctx, b1, b2)),
      _ => none,
    },
    Lam(n1, t1, b1) => match y {
      Lam(_, t2, b2) => some(unify(env, st, ctx, t1, t2) and unify(env, st, [(n1, t1)] + ctx, b1, b2)),
      _ => some(unify(env, st, [(n1, t1)] + ctx, b1, App(shift(y, 1, 0), Var(0)))),
    },
    _ => match y {
      Lam(n2, t2, b2) => some(unify(env, st, [(n2, t2)] + ctx, App(shift(x, 1, 0), Var(0)), b2)),
      _ => if neutral_attempts(env, st, ctx, x, y) then some(true) else none,
    },
  }

// Same head, or a hole applied too generally. Each attempt starts from
// the holes as they were, so a failed one (same head, but the arguments
// differ) leaves no solution behind; otherwise `length[?l](B, ..) =?=
// length[u](A, ..)` would fix ?l := u before both sides compute to the
// same number.
local fn neutral_attempts(env: Env, mut st: ElabState, ctx: Ctx, x: Term, y: Term) -> Bool = {
  let mark = (list.len(st.trail), list.len(st.ltrail))
  var found = false
  var i = 0
  while not found and i < 3 {
    if i > 0 then undo(st, mark) else ()
    found = if i == 0 then unify_spines(env, st, ctx, x, y)
      else if i == 1 then first_order(env, st, ctx, x, y)
      else first_order(env, st, ctx, y, x)
    i = i + 1
  }
  if not found then undo(st, mark) else ()
  found
}

local fn attempt_eta(env: Env, mut st: ElabState, ctx: Ctx, x: Term, y: Term) -> Bool = {
  let mark = (list.len(st.trail), list.len(st.ltrail))
  let found = unify_eta(env, st, ctx, x, y)
  if not found then undo(st, mark) else ()
  found
}

// Unfold the definition defined later (both when equally high), and
// reduce; none when neither side unfolds.
local fn unfold_step(env: Env, mut st: ElabState, ctx: Ctx, x: Term, y: Term) -> Option[(Term, Term)] =
  if not kernel.spend_step(st.bu) then none
  else match def_height(env, x) {
    some(hx) => match def_height(env, y) {
      some(hy) =>
        if hx > hy then some((whnf_core(env, ctx, unfold_head(env, x), st.bu), y))
        else if hy > hx then some((x, whnf_core(env, ctx, unfold_head(env, y), st.bu)))
        else {
          let ux = whnf_core(env, ctx, unfold_head(env, x), st.bu)
          let uy = whnf_core(env, ctx, unfold_head(env, y), st.bu)
          some((ux, uy))
        },
      none => some((whnf_core(env, ctx, unfold_head(env, x), st.bu), y)),
    },
    none => match def_height(env, y) {
      some(_) => some((x, whnf_core(env, ctx, unfold_head(env, y), st.bu))),
      none => none,
    },
  }

// `?m(xs, a) =?= f(b)` outside the pattern fragment: try `?m(xs) =?= f`
// and `a =?= b` (Lean's first-order approximation).
local fn first_order(env: Env, mut st: ElabState, ctx: Ctx, x: Term, y: Term) -> Bool =
  if not is_meta_app(x) or is_pattern_meta(st, x) then false
  else match x {
    App(f, a) => match y {
      App(g, b) => unify(env, st, ctx, f, g) and unify(env, st, ctx, a, b),
      _ => false,
    },
    _ => false,
  }

local fn unify_spines(env: Env, mut st: ElabState, ctx: Ctx, x: Term, y: Term) -> Bool = {
  let (hx, xs) = spine(x)
  let (hy, ys) = spine(y)
  let heads = match hx {
    Const(c, ls) => match hy {
      Const(d, ms) => c == d and list.len(ls) == list.len(ms) and unify_levels(st, ls, ms),
      _ => false,
    },
    Var(i) => match hy {
      Var(j) => i == j,
      _ => false,
    },
    _ => false,
  }
  heads and list.len(xs) == list.len(ys) and unify_all(env, st, ctx, xs, ys)
}

local fn unify_levels(mut st: ElabState, ls: List[Level], ms: List[Level]) -> Bool = {
  var good = true
  for (l, m) in list.zip(ls, ms) {
    if good then {
      good = unify_level(st, l, m)
    } else ()
  }
  good
}

local fn unify_all(env: Env, mut st: ElabState, ctx: Ctx, xs: List[Term], ys: List[Term]) -> Bool = {
  var good = true
  for (a, b) in list.zip(xs, ys) {
    if good then {
      good = unify(env, st, ctx, a, b)
    } else ()
  }
  good
}


// ── Elaboration ─────────────────────────────────────────────────────

// What the elaborator needs alongside the state: the environment, the
// universe parameters in scope.
// The environment is passed beside the scope, not inside it: a record
// field holds a copy, and copying the environment for every declaration
// made checking quadratic in the number of declarations (#17's scaling
// families).
type Scope = { lv: List[String] }

local fn names(ctx: Ctx) -> List[String] = ctx |> list.map(((x, _)) => x)

local fn reduce_type(env: Env, sc: Scope, mut st: ElabState, ctx: Ctx, ty: Term) -> Term = {
  let z = zonk(st, ty)
  whnf(env, ctx, z, st.bu)
}

// A constant at fresh levels, applied to holes for its implicit parameters.
local fn constant(env: Env, sc: Scope, mut st: ElabState, ctx: Ctx, c: String, given: List[Level]?, implicit: Bool) -> (Term, Term)! = {
  let ps = map.get(env.lparams, c) ?? []
  // A loop, not `list.map` with a lambda: almide/almide#3410.
  var fresh: List[Level] = []
  for _p in ps {
    list.push(fresh, new_level(st))
  }
  let ls = match given {
    some(g) => g,
    none => fresh,
  }
  guard list.len(ls) == list.len(ps) else err("${c} takes ${int.to_string(list.len(ps))} universe levels, given ${int.to_string(list.len(ls))}")
  let ty0 = match map.get(env.types, c) {
    some(t) => inst_levels(t, ps, ls),
    none => type0(),
  }
  var t = Const(c, ls)
  var ty = ty0
  var k = if implicit then map.get(env.implicits, c) ?? 0 else 0
  while k > 0 {
    match reduce_type(env, sc, st, ctx, ty) {
      Pi(_, dom, cod) => {
        let m = new_meta(st, ctx)
        list.push(st.typed, (ctx, m, dom))
        t = App(t, m)
        ty = subst(cod, m)
        k = k - 1
      },
      _ => {
        k = 0
      },
    }
  }
  ok((t, ty))
}

fn infer(env: Env, sc: Scope, mut st: ElabState, ctx: Ctx, r: Raw) -> (Term, Term)! = match r {
  RName("_") => {
    let ty = new_meta(st, ctx)
    ok((new_meta(st, ctx), ty))
  },
  RName("?") => {
    let ty = new_meta(st, ctx)
    let m = new_meta(st, ctx)
    list.push(st.goals, (ctx, m, ty))
    ok((m, ty))
  },
  RName(x) => match index_in(names(ctx), x, 0) {
    some(i) => match list.get(ctx, i) {
      some((_, ty)) => ok((Var(i), shift(ty, i + 1, 0))),
      none => err("unbound ${x}"),
    },
    none => match resolve_const(env, x) {
      ok(c) => constant(env, sc, st, ctx, c, none, true),
      err(e) => match field_access(env, sc, st, ctx, x) {
        some(found) => found,
        none => err(e),
      },
    },
  },
  RField(e, f) => {
    let (t, ty) = infer(env, sc, st, ctx, e)!
    walk_fields(env, sc, st, ctx, t, ty, [f])
  },
  RRecord(name, fvs) => {
    let q = resolve_const(env, name)!
    let info = match map.get(env.inductives, q) {
      some(i) => ok(i),
      none => err("${name} is not a record type"),
    }!
    guard not list.is_empty(info.fields) else err("${name} is not a record type")
    for (f, _) in fvs {
      guard list.contains(info.fields, f) else err("${name} has no field ${f}")
    }
    var args: List[Raw] = []
    for f in info.fields {
      match list.find(fvs, ((g, _)) => g == f) {
        some((_, v)) => list.push(args, v),
        none => (),
      }
    }
    guard list.len(args) == list.len(info.fields) and list.len(fvs) == list.len(info.fields) else err("${name} { ... } must give every field once: ${list.join(info.fields, ", ")}")
    infer(env, sc, st, ctx, list.fold(args, RName(q + ".mk"), (acc, a) => RApp(acc, a)))
  },
  RInst(x, lraws) => {
    var ls: List[Level] = []
    for l in lraws {
      list.push(ls, level_of(sc.lv, l)!)
    }
    constant(env, sc, st, ctx, resolve_const(env, x)!, some(ls), true)
  },
  RExplicit(x, lraws) => {
    var ls: List[Level] = []
    for l in lraws {
      list.push(ls, level_of(sc.lv, l)!)
    }
    let c = resolve_const(env, x)!
    let given = if list.is_empty(ls) and not list.is_empty(map.get(env.lparams, c) ?? []) then none else some(ls)
    constant(env, sc, st, ctx, c, given, false)
  },
  RType => ok((type0(), Sort(LSucc(LSucc(LZero))))),
  RSort => err("Sort needs a level: Sort(0) is Prop, Sort(1) is Type"),
  RApp(RSort, l) => {
    let lv = level_of(sc.lv, l)!
    ok((Sort(lv), Sort(LSucc(lv))))
  },
  RApp(RType, l) => {
    let lv = LSucc(level_of(sc.lv, l)!)
    ok((Sort(lv), Sort(LSucc(lv))))
  },
  RApp(f, a) => {
    let (tf, ty) = infer(env, sc, st, ctx, f)!
    match reduce_type(env, sc, st, ctx, ty) {
      Pi(_, dom, cod) => {
        let ta = check(env, sc, st, ctx, a, dom)!
        // Substituted only when the result depends on it, and before it is
        // placed in the application: either way would copy it otherwise
        // (almide/almide#3434), once per level of a nested term.
        let rty = if occurs(cod, 0) then subst(cod, ta) else shift(cod, -1, 1)
        ok((App(tf, ta), rty))
      },
      other => {
        guard not st.bu.exhausted else err(exhausted_error())
        err("${show(env, ctx, zonk(st, tf))} is applied to an argument, but its type is ${show(env, ctx, zonk(st, other))}")
      },
    }
  },
  RLam(x, ty, b) => {
    let (tty, _) = sort_of(env, sc, st, ctx, ty)!
    let (tb, bty) = infer(env, sc, st, [(x, tty)] + ctx, b)!
    ok((Lam(x, tty, tb), Pi(x, tty, bty)))
  },
  RPi(x, ty, b) => {
    let (tty, u) = sort_of(env, sc, st, ctx, ty)!
    let (tb, v) = sort_of(env, sc, st, [(x, tty)] + ctx, b)!
    ok((Pi(x, tty, tb), Sort(LIMax(u, v))))
  },
  RBracket(_) => err("brackets {...} are only allowed in the left-hand side of a rule"),
  RMatch(_, _) => err("a match must be a definition's whole body, on one of its parameters"),
}

// `p.x.y`: p is a local, x and y are fields of the records along the way.
local fn field_access(env: Env, sc: Scope, mut st: ElabState, ctx: Ctx, x: String) -> Option[Result[(Term, Term), String]] = {
  let parts = string.split(x, ".")
  match index_in(names(ctx), list.first(parts) ?? "", 0) {
    none => none,
    some(i) => match list.get(ctx, i) {
      none => none,
      some((_, ty0)) => some(walk_fields(env, sc, st, ctx, Var(i), shift(ty0, i + 1, 0), list.drop(parts, 1))),
    },
  }
}

local fn record_of(env: Env, ty: Term, f: String, shown: String) -> String! = {
  let (h, _) = spine(ty)
  match h {
    Const(c, _) => match map.get(env.inductives, c) {
      some(info) => if list.contains(info.fields, f) then ok(c) else err("${shown} has no field ${f}"),
      none => err("${shown} is not a record, so it has no field ${f}"),
    },
    _ => err("cannot see which record ${shown} is, to read its field ${f}"),
  }
}

local fn walk_fields(env: Env, sc: Scope, mut st: ElabState, ctx: Ctx, t0: Term, ty0: Term, fields: List[String]) -> (Term, Term)! = {
  var t = t0
  var ty = ty0
  for f in fields {
    let red = reduce_type(env, sc, st, ctx, ty)
    let q = record_of(env, red, f, show(env, ctx, zonk(st, ty)))!
    let (proj, pty) = constant(env, sc, st, ctx, q + "." + f, none, true)!
    match reduce_type(env, sc, st, ctx, pty) {
      Pi(_, dom, cod) => {
        guard unify(env, st, ctx, ty, dom) else err("cannot read field ${f}")
        let record = t
        t = App(proj, record)
        ty = subst(cod, record)
      },
      _ => {
        t = t
      },
    }
  }
  ok((t, ty))
}

// A type, and the level of the universe it lives in.
fn sort_of(env: Env, sc: Scope, mut st: ElabState, ctx: Ctx, r: Raw) -> (Term, Level)! = {
  let (t, ty) = infer(env, sc, st, ctx, r)!
  match reduce_type(env, sc, st, ctx, ty) {
    Sort(l) => ok((t, l)),
    other => {
      let l = new_level(st)
      guard unify(env, st, ctx, other, Sort(l)) else err("${show(env, ctx, zonk(st, t))} is not a type (its type is ${show(env, ctx, zonk(st, other))})")
      ok((t, l))
    },
  }
}

fn check(env: Env, sc: Scope, mut st: ElabState, ctx: Ctx, r: Raw, expected: Term) -> Term! = match r {
  RName("_") => {
    let m = new_meta(st, ctx)
    list.push(st.typed, (ctx, m, expected))
    ok(m)
  },
  RName("?") => {
    let m = new_meta(st, ctx)
    list.push(st.typed, (ctx, m, expected))
    list.push(st.goals, (ctx, m, expected))
    ok(m)
  },
  RLam(x, ty, b) => match reduce_type(env, sc, st, ctx, expected) {
    Pi(_, dom, cod) => {
      let (tty, _) = sort_of(env, sc, st, ctx, ty)!
      guard unify(env, st, ctx, tty, dom) else err("the parameter ${x}: ${show(env, ctx, zonk(st, tty))} does not match the expected ${show(env, ctx, zonk(st, dom))}")
      let tb = check(env, sc, st, [(x, tty)] + ctx, b, cod)!
      ok(Lam(x, tty, tb))
    },
    _ => infer_then_unify(env, sc, st, ctx, r, expected),
  },
  _ => infer_then_unify(env, sc, st, ctx, r, expected),
}

local fn mismatch(env: Env, st: ElabState, ctx: Ctx, t: Term, expected: Term, ty: Term) -> String =
  "type mismatch for ${show(env, ctx, zonk(st, t))}\n    expected: ${show(env, ctx, zonk(st, expected))}\n    found:    ${show(env, ctx, zonk(st, ty))}"

local fn infer_then_unify(env: Env, sc: Scope, mut st: ElabState, ctx: Ctx, r: Raw, expected: Term) -> Term! = {
  let (t, ty) = infer(env, sc, st, ctx, r)!
  let same = unify(env, st, ctx, ty, expected)
  guard not st.bu.exhausted else err(exhausted_error())
  if same then ok(t)
  else {
    let zt = zonk(st, ty)
    let ze = zonk(st, expected)
    // Holes on both sides may be decided later; otherwise it is an error.
    if has_meta(zt) and has_meta(ze) then {
      list.push(st.postponed, (ctx, ty, expected, t))
      ok(t)
    } else err(mismatch(env, st, ctx, t, expected, ty))
  }
}

// ── Entry points ────────────────────────────────────────────────────

// Check solved implicit arguments against their types until nothing more
// is learned.
local fn settle(env: Env, sc: Scope, mut st: ElabState) -> Unit! = {
  var waiting = st.typed
  var progress = true
  var failure = ""
  while progress and failure == "" {
    progress = false
    // Postponed equations first: one may now be decidable.
    let pending = st.postponed
    let none_yet: List[(Ctx, Term, Term, Term)] = []
    st.postponed = none_yet
    for (ctx, a, b, t) in pending {
      if unify(env, st, ctx, a, b) then {
        progress = true
      } else list.push(st.postponed, (ctx, a, b, t))
    }
    var later: List[(Ctx, Term, Term)] = []
    for (ctx, m, dom) in waiting {
      let zm = zonk(st, m)
      let zctx = ctx |> list.map(((x, ty)) => (x, zonk(st, ty)))
      if failure != "" or has_meta(zm) or list.any(zctx, ((_, ty)) => has_meta(ty)) then list.push(later, (ctx, m, dom))
      else match kernel.infer(env, zctx, zm, st.bu) {
        ok(ty) => if unify(env, st, ctx, ty, dom) then {
          progress = true
        } else {
          failure = "the inferred argument ${show(env, zctx, zm)} has type ${show(env, zctx, ty)}, but ${show(env, zctx, zonk(st, dom))} was expected"
        },
        err(e) => {
          failure = e
        },
      }
    }
    waiting = later
  }
  guard failure == "" else err(failure)
  match list.first(st.postponed) {
    some((ctx, ty, expected, t)) => err(mismatch(env, st, ctx, t, expected, ty)),
    none => ok(()),
  }
}

local fn complete(env: Env, sc: Scope, mut st: ElabState, t: Term, what: String) -> Term! = {
  settle(env, sc, st)!
  guard list.is_empty(st.goals) else err(goal_report(env, sc, st))
  let z = zonk(st, t)
  guard not has_meta(z) else err("cannot infer every part of ${what}: ${show(env, [], z)} (write the missing arguments, or the universe levels in [...])")
  ok(z)
}

// Each open goal: what it must prove, what is at hand, and what
// unification already knows it to be.
local fn goal_report(env: Env, sc: Scope, st: ElabState) -> String = {
  var out: List[String] = []
  let n = list.len(st.goals)
  list.push(out, "${int.to_string(n)} open goal${if n == 1 then "" else "s"} (?)")
  for (ctx, m, ty) in st.goals {
    list.push(out, "  goal: ${show(env, ctx, zonk(st, ty))}")
    var i = list.len(ctx) - 1
    while i >= 0 {
      match list.get(ctx, i) {
        some((x, xty)) => {
          let outer = list.drop(ctx, i + 1)
          list.push(out, "    ${x}: ${show(env, outer, zonk(st, xty))}")
        },
        none => (),
      }
      i = i - 1
    }
    let zm = zonk(st, m)
    if not has_meta(zm) then list.push(out, "    (unification found: ${show(env, ctx, zm)})") else ()
  }
  list.join(out, "\n")
}

// A closed type, as written with holes and implicit arguments.
fn elab_type(env: Env, lv: List[String], r: Raw) -> Term! = {
  let sc = Scope { lv: lv }
  var st = state()
  let (t, _) = sort_of(env, sc, st, [], r)!
  complete(env, sc, st, t, "this type")
}

// A closed term of the given (complete) type.
fn elab_term(env: Env, lv: List[String], r: Raw, expected: Term) -> Term! = {
  let sc = Scope { lv: lv }
  var st = state()
  let t = check(env, sc, st, [], r, expected)!
  complete(env, sc, st, t, "this term")
}

// A closed term and its type, for `check` and `eval`.
fn elab_infer(env: Env, lv: List[String], r: Raw) -> (Term, Term)! = {
  let sc = Scope { lv: lv }
  var st = state()
  let (t, ty) = infer(env, sc, st, [], r)!
  ok((complete(env, sc, st, t, "this term")!, complete(env, sc, st, ty, "its type")!))
}
