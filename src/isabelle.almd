// Isabelle/HOL, absorbed from its source: `arlk absorb-isabelle FILE.thy`
// reads a theory written in a subset of Isabelle and writes the same
// development as Arlk declarations, checked by the kernel like any other.
//
//   datatype num = Z | S num               type num: Type = | Z | S(x1: num)
//   fun add :: "num ⇒ num ⇒ num" where      def add(x1: num, n: num) -> num = match x1 { ... }
//     "add Z n = n"
//   | "add (S m) n = S (add m n)"
//   lemma add_Z [simp]: "add n Z = n"      theorem add_Z(n: num) -> Eq(_, add(n, num.Z), n) =
//     by (induction n) auto                  by induction n simp
//
// A lemma's proof method is replayed by Arlk's own `simp` (simp.almd):
// `simp`, `auto`, `force` and the like rewrite with the lemmas marked
// [simp] so far, those given with `simp add:`, the equations of every
// function, and the induction hypotheses; `(induction x)` or `(induct x)`
// first splits on x. Nothing of Isabelle is trusted or needed: a proof
// method that Arlk's simp cannot replay is a failed check, and a wrong
// lemma cannot be proved. Equality is the native one (lib/std/eq.arlk).
//
// The subset: `theory ... begin ... end`, `datatype` (with type variables),
// `fun`/`primrec`/`definition` by equations, `lemma`/`theorem` with a
// statement `"l = r"` (free variables are universally quantified, their
// types inferred from the functions and constructors they are passed to),
// `[simp]` and `declare ... [simp]`, proofs `by m`, `by m1 m2`, and
// `apply m ... done`, `arbitrary:`, Isar proofs by induction and simp, and
// equational premises `a = b ⟹ ...` (hypotheses simp rewrites with).
// Terms are curried applications and Main's infix operators (`+`, `*`,
// `#`, `@`, `=`), numerals and list literals, over Main's fragment (nat,
// lists and their functions: MAIN_SRC below, lib/isabelle_main.arlk).

import self.agda.{AExpr, APat, AData, ACtor, AScope, ACx}
import self.agda

// Prefixed types: almide/almide#3439.
// `prems`: equations assumed (`a = b ⟹ ...`), which simp rewrites with.
type IThm = { name: String, lhs: AExpr, rhs: AExpr, prems: List[(AExpr, AExpr)], induct: String, add: List[String], line: Int }

// ── Lexing (outer syntax) ───────────────────────────────────────────

type ITok = { text: String, quoted: Bool, line: Int }

local fn ident_char(c: String) -> Bool = string.is_alphanumeric(c) or c == "_" or c == "'" or c == "." or c == "?"

fn lex(src: String) -> List[ITok] = {
  let cs = string.chars(src)
  let n = list.len(cs)
  var out: List[ITok] = []
  var i = 0
  var line = 1
  var depth = 0
  while i < n {
    let c = list.get(cs, i) ?? ""
    let c2 = c + (list.get(cs, i + 1) ?? "")
    if c == "\n" then {
      line = line + 1
      i = i + 1
    } else if c2 == "(*" then {
      depth = depth + 1
      i = i + 2
    } else if depth > 0 then {
      if c2 == "*)" then {
        depth = depth - 1
        i = i + 2
      } else {
        i = i + 1
      }
    } else if c == " " or c == "\t" or c == "\r" then {
      i = i + 1
    } else if c == "\"" then {
      var j = i + 1
      var text = ""
      while j < n and (list.get(cs, j) ?? "\"") != "\"" {
        let d = list.get(cs, j) ?? ""
        if d == "\n" then {
          line = line + 1
        } else ()
        text = text + d
        j = j + 1
      }
      list.push(out, ITok { text: text, quoted: true, line: line })
      i = j + 1
    } else if c == "‹" then {
      // A cartouche (text ‹...›): kept as one quoted token.
      var j = i + 1
      var text = ""
      var level = 1
      while j < n and level > 0 {
        let d = list.get(cs, j) ?? ""
        if d == "‹" then {
          level = level + 1
        } else if d == "›" then {
          level = level - 1
        } else ()
        if level > 0 then {
          text = text + d
        } else ()
        if d == "\n" then {
          line = line + 1
        } else ()
        j = j + 1
      }
      list.push(out, ITok { text: text, quoted: true, line: line })
      i = j
    } else if ident_char(c) then {
      var j = i
      var text = ""
      while j < n and ident_char(list.get(cs, j) ?? "") {
        text = text + (list.get(cs, j) ?? "")
        j = j + 1
      }
      list.push(out, ITok { text: text, quoted: false, line: line })
      i = j
    } else if c2 == "::" then {
      list.push(out, ITok { text: "::", quoted: false, line: line })
      i = i + 2
    } else {
      list.push(out, ITok { text: c, quoted: false, line: line })
      i = i + 1
    }
  }
  out
}

let COMMANDS = ["theory", "imports", "begin", "end", "datatype", "fun", "primrec", "definition", "lemma", "theorem", "corollary", "declare", "text", "section", "subsection", "subsubsection", "chapter", "by", "apply", "done"]

// ── Inner syntax: terms and types ───────────────────────────────────

// Tokens of a quoted term or type.
local fn inner(s: String) -> List[String] = {
  let cs = string.chars(s)
  var out: List[String] = []
  var cur = ""
  for c in cs {
    if ident_char(c) then {
      cur = cur + c
    } else {
      if cur != "" then {
        list.push(out, cur)
        cur = ""
      } else ()
      if c != " " and c != "\t" and c != "\n" and c != "\r" then list.push(out, c) else ()
    }
  }
  if cur != "" then list.push(out, cur) else ()
  // `=>` and `\<Rightarrow>` as `⇒`.
  var merged: List[String] = []
  var i = 0
  while i < list.len(out) {
    let t = list.get(out, i) ?? ""
    if t == "=" and (list.get(out, i + 1) ?? "") == ">" then {
      list.push(merged, "⇒")
      i = i + 2
    } else {
      list.push(merged, t)
      i = i + 1
    }
  }
  merged
}

local fn at(ts: List[String], i: Int) -> String = list.get(ts, i) ?? ""

local fn close_at(ts: List[String], i: Int) -> Int = {
  var depth = 0
  var j = i
  var found = -1
  while found < 0 and j < list.len(ts) {
    let t = at(ts, j)
    if t == "(" then {
      depth = depth + 1
    } else if t == ")" then {
      depth = depth - 1
      if depth == 0 then {
        found = j
      } else ()
    } else ()
    j = j + 1
  }
  found
}

// Infix operators of Main's fragment: precedence, associativity, and the
// function or constructor each stands for.
let INFIX = [("=", 50, "n", "="), ("≡", 2, "n", "="), ("#", 65, "r", "#"), ("@", 65, "r", "append"), ("+", 65, "l", "plus"), ("*", 70, "l", "times")]

// A term: applications (atoms side by side) joined by infix operators.
fn parse_term(ts: List[String]) -> AExpr! = {
  let (e, k) = p_expr(ts, 0, 0)!
  guard k == list.len(ts) else err("unexpected '${at(ts, k)}' in a term")
  ok(e)
}

local fn p_expr(ts: List[String], i: Int, minp: Int) -> (AExpr, Int)! = {
  let (first, j) = p_app(ts, i)!
  var lhs = first
  var k = j
  var going = true
  while going {
    match list.find(INFIX, ((op, _, _, _)) => op == at(ts, k)) {
      some((_, prec, assoc, f)) => if prec >= minp then {
        let (rhs, k2) = p_expr(ts, k + 1, if assoc == "r" then prec else prec + 1)!
        lhs = EApp(EVar(f), [lhs, rhs])
        k = k2
      } else {
        going = false
      },
      none => {
        going = false
      },
    }
  }
  ok((lhs, k))
}

local fn starts_atom(t: String) -> Bool =
  t == "(" or t == "[" or (t != "" and t != ")" and t != "]" and t != "," and not list.any(INFIX, ((op, _, _, _)) => op == t))

local fn p_app(ts: List[String], i: Int) -> (AExpr, Int)! = {
  var atoms: List[AExpr] = []
  var k = i
  while starts_atom(at(ts, k)) {
    let (a, k2) = p_atom(ts, k)!
    list.push(atoms, a)
    k = k2
  }
  guard not list.is_empty(atoms) else err("expected a term at '${at(ts, k)}'")
  let head = list.first(atoms) ?? EHole
  ok((if list.len(atoms) == 1 then head else EApp(head, list.drop(atoms, 1)), k))
}

local fn p_atom(ts: List[String], i: Int) -> (AExpr, Int)! = {
  let t = at(ts, i)
  if t == "(" then {
    let (e, k) = p_expr(ts, i + 1, 0)!
    guard at(ts, k) == ")" else err("expected ) in a term")
    ok((e, k + 1))
  } else if t == "[" then {
    // `[]`, or a list `[a, b]` as conses.
    if at(ts, i + 1) == "]" then ok((EVar("[]"), i + 2))
    else {
      var items: List[AExpr] = []
      var k = i + 1
      var going = true
      while going {
        let (e, k2) = p_expr(ts, k, 0)!
        list.push(items, e)
        if at(ts, k2) == "," then {
          k = k2 + 1
        } else {
          guard at(ts, k2) == "]" else err("expected ] in a list")
          k = k2 + 1
          going = false
        }
      }
      ok((list.fold(list.reverse(items), EVar("[]"), (acc, x) => EApp(EVar("#"), [x, acc])), k))
    }
  } else if t != "" and list.all(string.chars(t), (c) => string.is_digit(c)) then {
    // A numeral of type nat: Suc applied n times to 0.
    let n = int.parse(t) ?? 0
    var e = EVar("0")
    for _ in list.range(0, n) {
      e = EApp(EVar("Suc"), [e])
    }
    ok((e, i + 1))
  } else ok((EVar(t), i + 1))
}

// An equation `l = r` (or `l ≡ r`).
fn parse_eq(ts: List[String]) -> (AExpr, AExpr)! = {
  // The sides are taken with list.get, not an `[l, r]` pattern nested in
  // the variant: almide/almide#3413.
  let (op, args) = agda.head_args(parse_term(ts)!)
  guard op == "=" and list.len(args) == 2 else err("expected an equation `l = r`")
  ok((list.get(args, 0) ?? EHole, list.get(args, 1) ?? EHole))
}

// A type: `a ⇒ b`, `'a list`, `('a, 'b) pair`, `(a ⇒ b)`.
fn parse_type(ts: List[String]) -> AExpr! = {
  var depth = 0
  var arrow = -1
  for (i, t) in list.enumerate(ts) {
    if t == "(" then {
      depth = depth + 1
    } else if t == ")" then {
      depth = depth - 1
    } else if t == "⇒" and depth == 0 and arrow < 0 then {
      arrow = i
    } else ()
  }
  if arrow >= 0 then ok(EArrow(parse_type(list.take(ts, arrow))!, parse_type(list.drop(ts, arrow + 1))!))
  else {
    // Postfix application: arguments first, the type constructor last.
    var cur: List[AExpr] = []
    var i = 0
    while i < list.len(ts) {
      let t = at(ts, i)
      if t == "(" then {
        let e = close_at(ts, i)
        guard e > i else err("unclosed ( in a type")
        var parts: List[List[String]] = []
        var part: List[String] = []
        var d = 0
        for u in list.slice(ts, i + 1, e) {
          if u == "(" then {
            d = d + 1
          } else if u == ")" then {
            d = d - 1
          } else ()
          if u == "," and d == 0 then {
            list.push(parts, part)
            part = []
          } else list.push(part, u)
        }
        list.push(parts, part)
        var parsed: List[AExpr] = []
        for q in parts {
          list.push(parsed, parse_type(q)!)
        }
        cur = parsed
        i = e + 1
      } else {
        let base = EVar(type_name(t))
        cur = [if list.is_empty(cur) then base else EApp(base, cur)]
        i = i + 1
      }
    }
    guard list.len(cur) == 1 else err("cannot read this type")
    ok(list.first(cur) ?? EHole)
  }
}

local fn type_name(t: String) -> String = if string.starts_with(t, "'") then string.drop(t, 1) else t


// ── The theory ──────────────────────────────────────────────────────

// Isabelle's ASCII names for symbols, as the characters they stand for.
let SYMBOLS = [("\\<open>", "‹"), ("\\<close>", "›"), ("\\<Rightarrow>", "⇒"), ("\\<equiv>", "≡"), ("\\<forall>", "∀"), ("\\<lambda>", "λ"), ("\\<longrightarrow>", "⟶"), ("\\<Longrightarrow>", "⟹")]

// What a theory has declared so far: data types and functions (the most
// recent first, so a theory's own `rev` shadows Main's), the Arlk text
// written, and the lemmas marked [simp].
// `calls`: the functions each function's equations mention; `heads`: the
// functions each [simp] lemma's left-hand side mentions (a lemma is passed
// to simp only where those functions can occur).
type IState = { sc: AScope, type_names: List[String], sigs: List[(String, AExpr)], out: List[String], simps: List[String], unnamed: Int, calls: List[(String, List[String])], heads: List[(String, List[String], List[String])] }

// Main's fragment that theories use: nat and lists, with Isabelle's
// defining equations, and the [simp] lemmas of Main that proofs by `simp`
// and `auto` rely on. They are absorbed like a theory's own (into the
// room isabelle.Main, lib/isabelle_main.arlk) and proved by Arlk's simp.
let MAIN_SRC = """
fun plus :: "nat ⇒ nat ⇒ nat" where
  "0 + n = n"
| "Suc m + n = Suc (m + n)"

fun times :: "nat ⇒ nat ⇒ nat" where
  "0 * n = 0"
| "Suc m * n = n + m * n"

fun append :: "'a list ⇒ 'a list ⇒ 'a list" where
  "[] @ ys = ys"
| "(x # xs) @ ys = x # (xs @ ys)"

fun rev :: "'a list ⇒ 'a list" where
  "rev [] = []"
| "rev (x # xs) = rev xs @ [x]"

fun length :: "'a list ⇒ nat" where
  "length [] = 0"
| "length (x # xs) = Suc (length xs)"

fun map :: "('a ⇒ 'b) ⇒ 'a list ⇒ 'b list" where
  "map f [] = []"
| "map f (x # xs) = f x # map f xs"

lemma add_0_right [simp]: "m + 0 = m" by (induction m) auto
lemma add_Suc_right [simp]: "m + Suc n = Suc (m + n)" by (induction m) auto
lemma add_assoc [simp]: "a + b + c = a + (b + c)" by (induction a) auto
lemma mult_0_right [simp]: "m * 0 = 0" by (induction m) auto
lemma append_Nil2 [simp]: "xs @ [] = xs" by (induction xs) auto
lemma append_assoc [simp]: "(xs @ ys) @ zs = xs @ (ys @ zs)" by (induction xs) auto
lemma length_append [simp]: "length (xs @ ys) = length xs + length ys" by (induction xs) auto
lemma rev_append [simp]: "rev (xs @ ys) = rev ys @ rev xs" by (induction xs) auto
lemma rev_rev_ident [simp]: "rev (rev xs) = xs" by (induction xs) auto
lemma map_append [simp]: "map f (xs @ ys) = map f xs @ map f ys" by (induction xs) auto
lemma length_map [simp]: "length (map f xs) = length xs" by (induction xs) auto
lemma length_rev [simp]: "length (rev xs) = length xs" by (induction xs) auto
lemma rev_map: "rev (map f xs) = map f (rev xs)" by (induction xs) auto
lemma add_commute: "m + n = n + m" by (induction m) auto
"""

// Main's names for its lemmas (`simp add: add.commute`) and the lemmas of
// the fragment that stand for them.
let MAIN_ALIASES = [("add.commute", "isabelle.Main.add_commute"), ("add.assoc", "isabelle.Main.add_assoc"), ("append.assoc", "isabelle.Main.append_assoc")]

local fn main_datas() -> List[AData] = {
  let nat = EVar("nat")
  let lst = EApp(EVar("list"), [EVar("a")])
  [
    AData { name: "list", params: [("a", ESet(0), false)], arity: ESet(0), ctors: [ACtor { name: "[]", args: [], result: lst }, ACtor { name: "#", args: [("_", EVar("a"), false), ("_", lst, false)], result: lst }] },
    AData { name: "nat", params: [], arity: ESet(0), ctors: [ACtor { name: "0", args: [], result: nat }, ACtor { name: "Suc", args: [("_", nat, false)], result: nat }] },
  ]
}

local fn empty_state() -> IState =
  IState { sc: AScope { datas: [], funs: [], fixes: [], own: "", opens: [] }, type_names: [], sigs: [], out: [], simps: [], unnamed: 0, calls: [], heads: [] }

// Main's fragment, absorbed: the state a theory starts from.
fn main_state() -> IState! = {
  var st = empty_state()
  for d in main_datas() {
    list.push(st.out, agda.emit_data(st.sc, d))
    st = { ...st, sc: { ...st.sc, datas: [d] + st.sc.datas }, type_names: [d.name] + st.type_names }
  }
  let toks = lex(list.fold(SYMBOLS, MAIN_SRC, (acc, (a, b)) => string.replace(acc, a, b)))
  run(st, toks, 0, "Main")
}

// lib/isabelle_main.arlk: the room isabelle.Main.
fn main_room() -> String! = {
  let st = main_state()!
  let header = """
    // Main's fragment for theories absorbed from Isabelle, written by
    // `arlk absorb-isabelle --main`: nat and lists with Isabelle's defining
    // equations, and Main's [simp] lemmas that proofs rely on, each proved
    // by Arlk's simp. Nothing here is assumed.
    """
  ok(header + "\nroom isabelle.Main uses eq\n\n" + list.join(st.out, "\n\n") + "\n")
}

fn absorb(src0: String, file: String) -> String! = {
  let src = list.fold(SYMBOLS, src0, (acc, (a, b)) => string.replace(acc, a, b))
  let ts = lex(src)
  let words = ts |> list.map((t) => t.text)
  guard at(words, 0) == "theory" else err("${file}: expected `theory Name imports ... begin`")
  let thy = at(words, 1)
  let main = main_state()!
  // A theory starts from Main's declarations; its [simp] lemmas are used
  // by their full names, and nothing of Main's text is repeated.
  let no_text: List[String] = []
  let st0 = { ...main, out: no_text, simps: main.simps |> list.map((n) => "isabelle.Main." + n), unnamed: 0, heads: main.heads |> list.map(((n, hs, rs)) => ("isabelle.Main." + n, hs, rs)) }
  let st = run(st0, ts, (list.index_of(words, "begin") ?? 0) + 1, file)!
  let header = """
    // Absorbed from Isabelle by `arlk absorb-isabelle`: theory ${thy} (${file}).
    // Isabelle is not needed to check it: the types and functions are
    // ordinary Arlk declarations, and each lemma's proof method is replayed
    // by Arlk's `simp`, checked by the kernel. Main's fragment is
    // lib/isabelle_main.arlk.
    """
  ok(header + "\nroom isabelle." + agda.mangle(thy) + " uses eq, isabelle.Main\n\n" + list.join(st.out, "\n\n") + "\n")
}

// The commands from token i on, until `end`.
local fn run(st0: IState, ts: List[ITok], from: Int, file: String) -> IState! = {
  let words = ts |> list.map((t) => t.text)
  var i = from
  var sc = st0.sc
  var type_names = st0.type_names
  var sigs = st0.sigs
  var out = st0.out
  var simps = st0.simps
  var unnamed = st0.unnamed
  var calls = st0.calls
  var heads = st0.heads
  while i < list.len(ts) and at(words, i) != "end" {
    let t = list.get(ts, i) ?? ITok { text: "", quoted: false, line: 0 }
    let cmd = t.text
    let line = t.line
    // The command's tokens, up to the next command.
    var j = i + 1
    while j < list.len(ts) and not (is_command(list.get(ts, j)) and not list.contains(["by", "apply", "done"], at(words, j))) {
      j = j + 1
    }
    let body = list.slice(ts, i + 1, j)
    let bw = body |> list.map((x) => x.text)
    if cmd == "datatype" then {
      let d = datatype(body, line)!
      type_names = [d.name] + type_names
      sc = { ...sc, datas: [d] + sc.datas }
      list.push(out, agda.emit_data(sc, d))
    } else if cmd == "fun" or cmd == "primrec" or cmd == "definition" then {
      let name = at(bw, 0)
      let colon = list.index_of(bw, "::") ?? -1
      guard colon == 1 else err("${file}:${int.to_string(line)}: ${cmd} ${name}: give its type (`${name} :: \"...\"`)")
      let ty0 = parse_type(inner(at(bw, 2)))!
      let tvs = list.unique(agda.type_vars(ty0, type_names))
      let ty = list.fold(list.reverse(tvs), ty0, (acc, v) => EPi([(v, ESet(0))], true, acc))
      sigs = [(name, ty0)] + sigs
      sc = { ...sc, funs: [(name, [])] + sc.funs }
      var clauses: List[(List[APat], AExpr)] = []
      for b in body {
        if b.quoted and b.text != at(bw, 2) then {
          let (lhs, rhs) = parse_eq(inner(b.text))!
          let (f, args) = agda.head_args(lhs)
          guard f == name else err("${file}:${int.to_string(b.line)}: an equation of ${name} must define ${name}")
          var ps: List[APat] = []
          for a in args {
            list.push(ps, agda.to_pat(sc, a)!)
          }
          list.push(clauses, (ps, rhs))
        } else ()
      }
      list.push(out, agda.emit_fun(sc, name, ty, clauses)!)
      calls = [(name, list.unique(clauses |> list.flat_map(((_, rhs)) => fun_names(rhs, sigs))))] + calls
      // A theory's own function shadows Main's of that name, and Main's
      // lemmas about the latter no longer apply to the name.
      let stale = heads |> list.filter(((m, hs, rs)) => string.starts_with(m, "isabelle.Main.") and (list.contains(hs, name) or list.contains(rs, name))) |> list.map(((m, _, _)) => m)
      simps = simps |> list.filter((n) => not list.contains(stale, n))
    } else if cmd == "lemma" or cmd == "theorem" or cmd == "corollary" then {
      let th0 = lemma(bw, body, unnamed, line)!
      if at(bw, 0) == ":" or (list.first(body) ?? t).quoted then {
        unnamed = unnamed + 1
      } else ()
      // `proof - have ... show ?thesis ... qed`: each step is proved on its
      // own and rewrites in the steps after it.
      let (steps, th) = isar_steps(th0, body, line)!
      for h in steps {
        list.push(out, emit_theorem(sc, sigs, type_names, h, usable_simps(h, sigs, simps, heads, calls))!)
      }
      list.push(out, emit_theorem(sc, sigs, type_names, th, usable_simps(th, sigs, simps, heads, calls))!)
      heads = [(th.name, fun_names(th.lhs, sigs), fun_names(th.rhs, sigs))] + heads
      if list.contains(bw, "simp") and list.index_of(bw, "simp") ?? 99 < (list.index_of(bw, ":") ?? 0) then list.push(simps, th.name) else ()
    } else if cmd == "declare" then {
      if list.contains(bw, "simp") then {
        for w in bw {
          if w != "[" and w != "]" and w != "simp" and w != "," then list.push(simps, w) else ()
        }
      } else ()
    } else {
      guard cmd == "text" or cmd == "section" or cmd == "subsection" or cmd == "subsubsection" or cmd == "chapter" else err("${file}:${int.to_string(line)}: `${cmd}` is not supported")
    }
    i = j
  }
  ok(IState { sc: sc, type_names: type_names, sigs: sigs, out: out, simps: simps, unnamed: unnamed, calls: calls, heads: heads })
}

// The functions a term applies.
local fn fun_names(e: AExpr, sigs: List[(String, AExpr)]) -> List[String] = match e {
  EVar(n) => if list.any(sigs, ((g, _)) => g == n) then [n] else [],
  EApp(f, args) => fun_names(f, sigs) + (args |> list.flat_map((a) => fun_names(a, sigs))),
  _ => [],
}

// The functions reachable from `start` through their equations.
local fn reachable(start: List[String], calls: List[(String, List[String])]) -> List[String] = {
  var seen: List[String] = []
  var queue = start
  while not list.is_empty(queue) {
    let f = list.first(queue) ?? ""
    queue = list.drop(queue, 1)
    if not list.contains(seen, f) then {
      list.push(seen, f)
      match list.find(calls, ((g, _)) => g == f) {
        some((_, cs)) => {
          queue = queue + cs
        },
        none => (),
      }
    } else ()
  }
  seen
}

local fn is_command(t: ITok?) -> Bool = match t {
  some(x) => not x.quoted and list.contains(COMMANDS, x.text),
  none => false,
}

// `datatype ('a, 'b) name = C1 t1 "t2" | C2`
local fn datatype(body: List[ITok], line: Int) -> AData! = {
  let ws = body |> list.map((t) => t.text)
  let eq = list.index_of(ws, "=") ?? -1
  guard eq > 0 else err("line ${int.to_string(line)}: datatype: expected `=`")
  let head = list.take(ws, eq) |> list.filter((w) => w != "(" and w != ")" and w != ",")
  let name = match list.last(head) {
    some(n) => n,
    none => "",
  }
  let params = list.take(head, list.len(head) - 1) |> list.map((p) => type_name(p))
  let self_ty = if list.is_empty(params) then EVar(name) else EApp(EVar(name), params |> list.map((p) => EVar(p)))
  var ctors: List[ACtor] = []
  var cur: List[ITok] = []
  for t in list.drop(body, eq + 1) {
    if t.text == "|" and not t.quoted then {
      list.push(ctors, ctor_of(cur, self_ty)!)
      cur = []
    } else list.push(cur, t)
  }
  list.push(ctors, ctor_of(cur, self_ty)!)
  ok(AData { name: name, params: params |> list.map((p) => (p, ESet(0), false)), arity: ESet(0), ctors: ctors })
}

local fn ctor_of(ts: List[ITok], self_ty: AExpr) -> ACtor! = {
  let c = match list.first(ts) {
    some(t) => ok(t.text),
    none => err("datatype: an empty constructor"),
  }!
  var args: List[(String, AExpr, Bool)] = []
  for t in list.drop(ts, 1) {
    list.push(args, ("_", parse_type(if t.quoted then inner(t.text) else [t.text])!, false))
  }
  ok(ACtor { name: c, args: args, result: self_ty })
}

// `lemma name [simp]: "l = r" by (induction n) auto`
// Only the [simp] lemmas about functions the statement can reach. A usable
// lemma's right-hand side may bring more functions in.
local fn usable_simps(th: IThm, sigs: List[(String, AExpr)], simps: List[String], heads: List[(String, List[String], List[String])], calls: List[(String, List[String])]) -> List[String] = {
  var reach = reachable(fun_names(th.lhs, sigs) + fun_names(th.rhs, sigs) + (th.prems |> list.flat_map(((a, b)) => fun_names(a, sigs) + fun_names(b, sigs))), calls)
  var usable: List[String] = []
  var grew = true
  while grew {
    let now = simps |> list.filter((n) => match list.find(heads, ((m, _, _)) => m == n) {
      some((_, hs, _)) => list.all(hs, (h) => list.contains(reach, h)),
      none => true,
    })
    grew = list.len(now) > list.len(usable)
    usable = now
    let more = now |> list.flat_map((n) => match list.find(heads, ((m, _, _)) => m == n) {
      some((_, _, rs)) => rs,
      none => [],
    })
    reach = reachable(reach + more, calls)
  }
  usable
}

// Words that end an Isar step's proof method.
let ISAR_STOPS = ["have", "also", "moreover", "finally", "ultimately", "show", "thus", "hence", "then", "qed", "next", "from", "with", "using", "case"]

// The right-hand side of `a = b`, as written: after its first `=` outside
// brackets.
local fn rhs_text(text: String) -> String = {
  let cs = string.chars(text)
  var depth = 0
  var at_eq = -1
  for (k, c) in list.enumerate(cs) {
    if c == "(" or c == "[" then {
      depth = depth + 1
    } else if c == ")" or c == "]" then {
      depth = depth - 1
    } else if c == "=" and depth == 0 and at_eq < 0 and (list.get(cs, k + 1) ?? "") != "=" and (list.get(cs, k - 1) ?? "") != "=" then {
      at_eq = k
    } else ()
  }
  if at_eq < 0 then text else string.trim(list.join(list.drop(cs, at_eq + 1), ""))
}

// The steps of `proof - ... qed` (Isar without induction): each `have "s"
// by m` becomes a theorem of its own, proved by m, and the main statement
// is then proved by simp with every step. `also have "... = c"` reads `...`
// as the previous step's right-hand side, so a chain a = b, b = c rewrites
// a to c. Nothing is taken on trust: every step is replayed by simp.
local fn isar_steps(th: IThm, body: List[ITok], line: Int) -> (List[IThm], IThm)! = {
  let ws = body |> list.map((x) => x.text)
  let open_at = list.index_of(ws, "proof") ?? -1
  if open_at < 0 or at(ws, open_at + 1) != "-" then ok(([], th))
  else {
    var steps: List[IThm] = []
    var labels: List[(String, String)] = []
    var prev_rhs = ""
    var k = open_at + 2
    while k < list.len(body) {
      if at(ws, k) == "have" then {
        let label = if at(ws, k + 2) == ":" and not ((list.get(body, k + 1) ?? ITok { text: "", quoted: false, line: line }).quoted) then at(ws, k + 1) else ""
        let name = th.name + "_step" + int.to_string(list.len(steps) + 1)
        if label != "" then list.push(labels, (label, name)) else ()
        var q = k + 1
        while q < list.len(body) and not ((list.get(body, q) ?? ITok { text: "", quoted: false, line: line }).quoted) {
          q = q + 1
        }
        let stmt = list.get(body, q) ?? ITok { text: "", quoted: true, line: line }
        let written = string.trim(stmt.text)
        let text = if string.starts_with(written, "...") then "(" + prev_rhs + ")" + string.drop(written, 3) else written
        prev_rhs = rhs_text(text)
        var e = q + 1
        while e < list.len(body) and not list.contains(ISAR_STOPS, at(ws, e)) {
          e = e + 1
        }
        let toks = [ITok { text: name, quoted: false, line: stmt.line }, ITok { text: ":", quoted: false, line: stmt.line }, ITok { text: text, quoted: true, line: stmt.line }] + list.slice(body, q + 1, e)
        let step = lemma(toks |> list.map((x) => x.text), toks, 0, stmt.line)!
        list.push(steps, step)
        k = e
      } else {
        k = k + 1
      }
    }
    let names = steps |> list.map((h) => h.name)
    let add = th.add |> list.map((a) => match list.find(labels, ((l, _)) => l == a) {
      some((_, n)) => n,
      none => a,
    })
    ok((steps, { ...th, induct: "", add: list.unique(add + names) }))
  }
}

local fn lemma(bw: List[String], body: List[ITok], unnamed: Int, line: Int) -> IThm! = {
  let stmt_at = match list.index_of(body |> list.map((t) => t.quoted), true) {
    some(k) => ok(k),
    none => err("line ${int.to_string(line)}: lemma: expected a statement in quotes"),
  }!
  let named = stmt_at > 0 and at(bw, 0) != ":" and at(bw, 0) != "["
  let name = if named then at(bw, 0) else "lemma_" + int.to_string(unnamed + 1)
  let stmt = list.get(body, stmt_at) ?? ITok { text: "", quoted: true, line: line }
  // `a = b ⟹ c = d ⟹ l = r`: premises, then the equation proved.
  var parts: List[List[String]] = []
  var cur: List[String] = []
  var depth = 0
  for t in inner(stmt.text) {
    if t == "(" or t == "[" then {
      depth = depth + 1
    } else if t == ")" or t == "]" then {
      depth = depth - 1
    } else ()
    if t == "⟹" and depth == 0 then {
      list.push(parts, cur)
      cur = []
    } else list.push(cur, t)
  }
  var prems: List[(AExpr, AExpr)] = []
  for ptoks in parts {
    let pe = parse_eq(ptoks)
    guard result.is_ok(pe) else err("line ${int.to_string(line)}: ${name}: a premise must be an equation `a = b`")
    list.push(prems, pe ?? (EHole, EHole))
  }
  let (lhs, rhs) = parse_eq(cur)!
  // The proof: `by m [m]` or `apply m ... done`.
  let rest = list.drop(bw, stmt_at + 1)
  guard list.contains(rest, "by") or list.contains(rest, "apply") else err("line ${int.to_string(line)}: ${name}: expected a proof (`by ...`)")
  // `arbitrary: ys` needs nothing more: the variables after the induction
  // variable are generalised in its induction hypothesis anyway.
  guard not list.contains(rest, "sorry") and not list.contains(rest, "oops") else err("line ${int.to_string(line)}: ${name}: an unfinished proof")
  var induct = ""
  for (k, w) in list.enumerate(rest) {
    if (w == "induction" or w == "induct" or w == "cases") and induct == "" then {
      induct = at(rest, k + 1)
    } else ()
  }
  var add: List[String] = []
  var in_add = false
  for w in rest {
    if w == ":" then () else if w == "add" or w == "simp" and in_add then {
      in_add = true
    } else if w == ")" or w == "by" or w == "apply" or w == "done" or w == "del" or w == "only" then {
      in_add = false
    } else if in_add and w != "add" then list.push(add, w) else ()
  }
  ok(IThm { name: name, lhs: lhs, rhs: rhs, prems: prems, induct: induct, add: add, line: line })
}

// ── Type inference for a statement ─────────────────────────────────

// Free variables' types and the type variables solved so far. A type
// variable of the inference is `?k`.
type TInfer = { vars: List[(String, AExpr)], subst: List[(String, AExpr)], next: Int }

local fn fresh_meta(mut ti: TInfer) -> AExpr = {
  let n = ti.next
  ti.next = n + 1
  EVar("?" + int.to_string(n))
}

local fn is_meta(t: AExpr) -> Bool = match t {
  EVar(x) => string.starts_with(x, "?"),
  _ => false,
}

local fn resolve(ti: TInfer, t: AExpr) -> AExpr = match t {
  EVar(x) => if string.starts_with(x, "?") then match list.find(ti.subst, ((m, _)) => m == x) {
    some((_, u)) => resolve(ti, u),
    none => t,
  } else t,
  EApp(f, args) => EApp(resolve(ti, f), args |> list.map((a) => resolve(ti, a))),
  EArrow(a, b) => EArrow(resolve(ti, a), resolve(ti, b)),
  other => other,
}

local fn meta_vars(t: AExpr) -> List[String] = match t {
  EVar(x) => if string.starts_with(x, "?") then [x] else [],
  EApp(f, args) => meta_vars(f) + (args |> list.flat_map((a) => meta_vars(a))),
  EArrow(a, b) => meta_vars(a) + meta_vars(b),
  _ => [],
}

local fn rename_metas(t: AExpr, names: List[(String, AExpr)]) -> AExpr = match t {
  EVar(x) => match list.find(names, ((m, _)) => m == x) {
    some((_, n)) => n,
    none => t,
  },
  EApp(f, args) => EApp(rename_metas(f, names), args |> list.map((a) => rename_metas(a, names))),
  EArrow(a, b) => EArrow(rename_metas(a, names), rename_metas(b, names)),
  other => other,
}

local fn unify(mut ti: TInfer, a: AExpr, b: AExpr) -> Unit! = {
  let x = resolve(ti, a)
  let y = resolve(ti, b)
  if x == y then ok(())
  else if is_meta(x) then {
    guard not list.contains(meta_vars(y), agda_var(x)) else err("a type would contain itself")
    list.push(ti.subst, (agda_var(x), y))
    ok(())
  } else if is_meta(y) then unify(ti, y, x)
  else unify_shapes(ti, x, y)
}

// Two types with known heads. Matched one at a time, not as a tuple of
// patterns: almide/almide#3416.
local fn unify_shapes(mut ti: TInfer, x: AExpr, y: AExpr) -> Unit! = match x {
  EArrow(a1, b1) => match y {
    EArrow(a2, b2) => {
      unify(ti, a1, a2)!
      unify(ti, b1, b2)
    },
    _ => err("types do not match"),
  },
  EApp(f1, as1) => match y {
    EApp(f2, as2) => {
      guard list.len(as1) == list.len(as2) else err("types do not match")
      unify(ti, f1, f2)!
      var k = 0
      while k < list.len(as1) {
        unify(ti, list.get(as1, k) ?? EHole, list.get(as2, k) ?? EHole)!
        k = k + 1
      }
      ok(())
    },
    _ => err("types do not match"),
  },
  _ => err("types do not match"),
}

local fn agda_var(t: AExpr) -> String = match t {
  EVar(x) => x,
  _ => "",
}

// A declared type with its type variables (names that are not types)
// replaced by fresh inference variables.
local fn instantiate(mut ti: TInfer, t: AExpr, type_names: List[String]) -> AExpr = {
  var names: List[(String, AExpr)] = []
  for v in list.unique(agda.type_vars(t, type_names)) {
    list.push(names, (v, fresh_meta(ti)))
  }
  rename_metas(t, names)
}

local fn infer_type(sc: AScope, sigs: List[(String, AExpr)], type_names: List[String], mut ti: TInfer, e: AExpr) -> AExpr! = match e {
  EVar(x) => match list.find(sigs, ((g, _)) => g == x) {
    some((_, ty)) => ok(instantiate(ti, ty, type_names)),
    none => match ctor_type(sc, x) {
      some(ty) => ok(instantiate(ti, ty, type_names)),
      none => match list.find(ti.vars, ((v, _)) => v == x) {
        some((_, t)) => ok(t),
        none => {
          let t = fresh_meta(ti)
          list.push(ti.vars, (x, t))
          ok(t)
        },
      },
    },
  },
  EApp(f, args) => {
    var tf = infer_type(sc, sigs, type_names, ti, f)!
    for a in args {
      let ta = infer_type(sc, sigs, type_names, ti, a)!
      let r = fresh_meta(ti)
      unify(ti, tf, EArrow(ta, r))!
      tf = r
    }
    ok(tf)
  },
  _ => err("cannot infer the type of this term"),
}

// A constructor's type: its arguments to its type.
local fn ctor_type(sc: AScope, c: String) -> AExpr? = {
  var found: AExpr? = none
  for d in sc.datas {
    for k in d.ctors {
      if found == none and k.name == c then {
        found = some(list.fold(list.reverse(k.args), k.result, (acc, (_, t, _)) => EArrow(t, acc)))
      } else ()
    }
  }
  found
}

local fn emit_theorem(sc: AScope, sigs: List[(String, AExpr)], type_names: List[String], th: IThm, simps: List[String]) -> String! = {
  let order = list.unique((th.prems |> list.flat_map(((a, b)) => agda.var_order(sc, sigs, a) + agda.var_order(sc, sigs, b))) + agda.var_order(sc, sigs, th.lhs) + agda.var_order(sc, sigs, th.rhs))
  // The variables' types, by unification over the statement (Isabelle's
  // type inference, for the first-order types used here); type variables
  // left open become the theorem's type parameters.
  var ti = TInfer { vars: [], subst: [], next: 0 }
  let tl = infer_type(sc, sigs, type_names, ti, th.lhs)!
  let tr = infer_type(sc, sigs, type_names, ti, th.rhs)!
  unify(ti, tl, tr)!
  for (pa, pb) in th.prems {
    let ta = infer_type(sc, sigs, type_names, ti, pa)!
    let tb = infer_type(sc, sigs, type_names, ti, pb)!
    unify(ti, ta, tb)!
  }
  var vars: List[(String, AExpr)] = []
  for v in order {
    match list.find(ti.vars, ((x, _)) => x == v) {
      some((_, t)) => list.push(vars, (v, resolve(ti, t))),
      none => (),
    }
  }
  // Open type variables, named apart from the term variables.
  let open_tvs = list.unique(vars |> list.flat_map(((_, t)) => meta_vars(t)))
  var tnames: List[(String, AExpr)] = []
  // Built in the same loop, not mapped from tnames afterwards (a list
  // filled in a loop and then mapped is moved: almide/almide#3440).
  var tvs: List[String] = []
  for (k, m) in list.enumerate(open_tvs) {
    var n = if k < 26 then string.slice("abcdefghijklmnopqrstuvwxyz", k, k + 1) else "t" + int.to_string(k)
    while list.contains(order, n) or list.contains(type_names, n) {
      n = n + "'"
    }
    list.push(tnames, (m, EVar(n)))
    list.push(tvs, n)
  }
  var renamed: List[(String, AExpr)] = []
  for (v, t) in vars {
    list.push(renamed, (v, rename_metas(t, tnames)))
  }
  vars = renamed
  guard th.induct == "" or list.any(vars, ((v, _)) => v == th.induct) else err("${th.name}: induction on ${th.induct}, which is not a variable of the statement")
  let cx = ACx { sc: sc, ren: [], bound: order + tvs }
  let generics = if list.is_empty(tvs) then "" else "[" + list.join(tvs |> list.map((v) => agda.mangle(v) + ": Type"), ", ") + "]"
  // The premises: hypotheses after the variables, named apart from them.
  var hyps: List[String] = []
  for (k, pr) in list.enumerate(th.prems) {
    let (pa, pb) = pr
    var h = "h" + int.to_string(k + 1)
    while list.contains(order, h) {
      h = h + "'"
    }
    list.push(hyps, h + ": Eq(_, " + agda.emit(cx, pa) + ", " + agda.emit(cx, pb) + ")")
  }
  let binders = (vars |> list.map(((v, t)) => agda.mangle(v) + ": " + agda.emit(cx, t))) + hyps
  let params = if list.is_empty(binders) then "" else "(" + list.join(binders, ", ") + ")"
  let arrow = if list.is_empty(binders) and list.is_empty(tvs) then ": " else " -> "
  let rules = list.unique(simps + (th.add |> list.map((n) => match list.find(MAIN_ALIASES, ((a, _)) => a == n) {
    some((_, full)) => full,
    none => n,
  }))) |> list.map((n) => agda.mangle(n))
  let using = if list.is_empty(rules) then "" else "(" + list.join(rules, ", ") + ")"
  let proof = if th.induct == "" then "by simp" + using else "by induction " + agda.mangle(th.induct) + " simp" + using
  ok("theorem ${agda.mangle(th.name)}${generics}${params}${arrow}Eq(_, ${agda.emit(cx, th.lhs)}, ${agda.emit(cx, th.rhs)}) =\n  ${proof}")
}

// Tests: spec/isabelle_test.almd (a test here would match the agda
// module's variants in a native test build: almide/almide#3422).
