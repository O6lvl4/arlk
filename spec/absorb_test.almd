// Absorbed Lean and Rocq declarations, checked by the Arlk kernel alone.

import fs
import self.syntax
import self.kernel
import self.checker
import self.absorb

let CORE = "lib/core.arlk"
let LEAN_EXPORT = "absorbed/lean/nat_add_zero.json"
let LEAN_ABSORBED = "absorbed/lean/nat_add_zero.arlk"
let ROCQ_EXPORT = "absorbed/rocq/init_peano.json"
let ROCQ_ABSORBED = "absorbed/rocq/init_peano.arlk"

// Absorbed files sit on the shared foundation, so it is checked first.
fn check_with(core: String, src: String) -> String? = match syntax.parse(core + "\n" + src) {
  err(e) => some("parse: " + e),
  ok(ds) => checker.check_all(kernel.empty(), ds).error,
}

test "the committed Lean file is exactly what absorb produces" {
  assert_eq(absorb.absorb(fs.read_text(LEAN_EXPORT)!), ok(fs.read_text(LEAN_ABSORBED)!))
}

test "the committed Rocq file is exactly what absorb produces" {
  assert_eq(absorb.absorb(fs.read_text(ROCQ_EXPORT)!), ok(fs.read_text(ROCQ_ABSORBED)!))
}

test "Lean's Nat.add_zero checks without Lean" {
  assert_eq(check_with(fs.read_text(CORE)!, fs.read_text(LEAN_ABSORBED)!), none)
}

test "Rocq's Peano module checks without Rocq" {
  assert_eq(check_with(fs.read_text(CORE)!, fs.read_text(ROCQ_ABSORBED)!), none)
}

test "a false statement with the same proof is rejected" {
  let src = fs.read_text(LEAN_ABSORBED)!
  let zero = "OfNat.ofNat@0(Nat, Nat.zero, instOfNatNat(Nat.zero))), n))) ="
  let one = "OfNat.ofNat@0(Nat, Nat.succ(Nat.zero), instOfNatNat(Nat.succ(Nat.zero)))), n))) ="
  assert(string.contains(src, zero))
  match check_with(fs.read_text(CORE)!, string.replace_first(src, zero, one)) {
    some(e) => assert(string.contains(e, "type mismatch")),
    none => assert(false),
  }
}

test "the Lean proof really computes through Lean's definitions" {
  // Without the projection rule for HAdd.hAdd, n + 0 no longer reduces to n.
  let src = fs.read_text(LEAN_ABSORBED)!
  let start = string.index_of(src, "rule HAdd.hAdd@0@0@0(") ?? -1
  assert(start >= 0)
  let rest = string.drop(src, start)
  // The rule ends with its `where` line.
  let at_where = string.index_of(rest, "\n  where ") ?? 0
  let stop = at_where + 1 + (string.index_of(string.drop(rest, at_where + 1), "\n") ?? 0) + 1
  match check_with(fs.read_text(CORE)!, string.take(src, start) + string.drop(rest, stop)) {
    some(e) => assert(string.contains(e, "type mismatch")),
    none => assert(false),
  }
}

test "Rocq's cumulativity is checked: lifting nat downwards is rejected" {
  // eq wants its type in universe 2; nat is lifted from 1. Claiming it
  // came from 3 breaks the proof, because lift only goes up.
  let src = fs.read_text(ROCQ_ABSORBED)!
  let up = "core.lift(core.l1, core.l2, Init.Datatypes.nat)"
  assert(string.contains(src, up))
  let down = string.replace(src, up, "core.lift(core.l3, core.l2, Init.Datatypes.nat)")
  assert(check_with(fs.read_text(CORE)!, down) != none)
}
