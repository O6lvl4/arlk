// Lean's Nat.add_zero, absorbed: checked by the Arlk kernel alone.

import fs
import self.syntax
import self.kernel
import self.absorb

let EXPORT = "absorbed/lean/nat_add_zero.json"
let ABSORBED = "absorbed/lean/nat_add_zero.arlk"

fn check_text(src: String) -> String? = match syntax.parse(src) {
  err(e) => some("parse: " + e),
  ok(ds) => kernel.check_all(kernel.empty(), ds).error,
}

test "the committed .arlk is exactly what absorb produces from the export" {
  let exported = fs.read_text(EXPORT)!
  let absorbed = fs.read_text(ABSORBED)!
  assert_eq(absorb.absorb(exported), ok(absorbed))
}

test "Nat.add_zero checks without Lean" {
  let src = fs.read_text(ABSORBED)!
  assert_eq(check_text(src), none)
}

test "a false statement with the same proof is rejected" {
  let src = fs.read_text(ABSORBED)!
  let zero = "(OfNat.ofNat@0 Nat Nat.zero (instOfNatNat Nat.zero))) n)) :="
  let one = "(OfNat.ofNat@0 Nat (Nat.succ Nat.zero) (instOfNatNat (Nat.succ Nat.zero)))) n)) :="
  assert(string.contains(src, zero))
  let tampered = string.replace_first(src, zero, one)
  match check_text(tampered) {
    some(e) => assert(string.contains(e, "type mismatch")),
    none => assert(false),
  }
}

test "the proof really computes through Lean's definitions" {
  // Without the projection rule for HAdd.hAdd, n + 0 no longer reduces to n.
  let src = fs.read_text(ABSORBED)!
  let start = string.index_of(src, "rule [α : lean.El lean.l2 (lean.sort lean.l1), β") ?? -1
  assert(start >= 0)
  let rest = string.drop(src, start)
  let stop = (string.index_of(rest, ".\n") ?? 0) + 2
  let without = string.take(src, start) + string.drop(rest, stop)
  match check_text(without) {
    some(e) => assert(string.contains(e, "type mismatch")),
    none => assert(false),
  }
}
