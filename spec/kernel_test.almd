// The kernel must accept good proofs and, more importantly, reject bad ones.
import fs
import self.syntax
import self.kernel
import self.checker

let PRELUDE = """
  room logic
  symbol Prop: Type
  symbol Prf(p: Prop) -> Type
  symbol imp(a: Prop, b: Prop) -> Prop
  rule Prf(imp(a, b)) = Prf(a) -> Prf(b)  where a: Prop, b: Prop
  """

// none = accepted; some(msg) = rejected with msg.
fn run(src: String) -> String? = match syntax.parse(PRELUDE + "\n" + src) {
  err(e) => some("parse: " + e),
  ok(ds) => checker.check_all(kernel.empty(), ds).error,
}

fn accepts(src: String) -> Bool = run(src) == none

fn rejects_with(src: String, needle: String) -> Bool = match run(src) {
  some(e) => string.contains(e, needle),
  none => false,
}

test "a correct proof is accepted" {
  assert(accepts("theorem k(a: Prop, b: Prop) -> Prf(imp(a, imp(b, a))) = (x: Prf(a), y: Prf(b)) => x"))
}

test "returning the wrong hypothesis is rejected" {
  assert(rejects_with(
    "theorem k(a: Prop, b: Prop) -> Prf(imp(a, imp(b, a))) = (x: Prf(a), y: Prf(b)) => y",
    "type mismatch",
  ))
}

test "a proof of a different proposition is rejected" {
  assert(rejects_with(
    "theorem bad(a: Prop, b: Prop) -> Prf(imp(a, b)) = (x: Prf(a)) => x",
    "type mismatch",
  ))
}

test "Type is not a Type" {
  assert(rejects_with("def t: Type = Type", "type mismatch"))
}

test "inner binders shadow outer ones" {
  assert(accepts("symbol A: Type\nsymbol B: Type\ndef f: (A, B) -> B = (x: A, x: B) => x"))
  assert(rejects_with(
    "symbol A: Type\nsymbol B: Type\ndef f: (A, B) -> A = (x: A, x: B) => x",
    "type mismatch",
  ))
}

test "dependent application substitutes the argument into the result type" {
  assert(accepts("""
    symbol a: Prop
    symbol refl_imp(p: Prop) -> Prf(imp(p, p))
    def r: Prf(imp(a, a)) = refl_imp(a)
    """))
}

test "defs unfold during conversion but theorems stay opaque" {
  assert(accepts("""
    symbol a: Prop
    def p: Prop = a
    def q: Prf(p) -> Prf(a) = (h: Prf(p)) => h
    """))
  assert(rejects_with(
    """
    symbol a: Prop
    symbol pa: Prf(a)
    theorem p: Prop = a
    def q: Prf(p) -> Prf(a) = (h: Prf(p)) => h
    """,
    "type mismatch",
  ))
}

test "a rule must preserve types" {
  assert(rejects_with(
    """
    symbol f(p: Prop) -> Prop
    rule f(x) = Prf(x)  where x: Prop
    """,
    "rule does not preserve types",
  ))
}

test "a rule can only extend a symbol of the current room" {
  assert(rejects_with(
    """
    room other uses logic
    symbol a: Prop
    rule Prf(imp(x, x)) = Prf(a)  where x: Prop
    """,
    "rules can only be added to symbols of the current room",
  ))
}

test "rules cannot be attached to defs or theorems" {
  assert(rejects_with(
    """
    symbol a: Prop
    def d(p: Prop) -> Prop = p
    rule d(x) = a  where x: Prop
    """,
    "only symbols can have rules",
  ))
}

test "non-linear and unbound pattern variables are rejected" {
  assert(rejects_with("symbol f(p: Prop, q: Prop) -> Prop\nrule f(x, x) = x  where x: Prop", "only once"))
  assert(rejects_with(
    "symbol f(p: Prop) -> Prop\nsymbol a: Prop\nrule f(x) = a  where x: Prop, y: Prop",
    "must appear",
  ))
}

test "rooms are sealed once left" {
  assert(rejects_with("room other uses logic\nroom logic", "sealed"))
}

test "a room only sees the rooms it uses" {
  assert(rejects_with("room island\nsymbol x: logic.Prop", "does not use"))
  assert(rejects_with("room island\nsymbol x: Prop", "unknown name Prop"))
  assert(accepts("room shore uses logic\nsymbol x: Prop"))
}

test "visibility is transitive through uses" {
  assert(accepts("room mid uses logic\nroom top uses mid\nsymbol x: Prop"))
}

test "duplicate declarations are rejected" {
  assert(rejects_with("symbol Prop: Type", "already declared"))
}

test "rewriting computes inside the kernel" {
  assert(accepts("""
    room nat uses logic
    symbol Nat: Type
    symbol z: Nat
    symbol s(n: Nat) -> Nat
    symbol add(m: Nat, n: Nat) -> Nat
    rule add(z, n) = n  where n: Nat
    rule add(s(m), n) = s(add(m, n))  where m: Nat, n: Nat
    symbol eq(m: Nat, n: Nat) -> Prop
    symbol refl(n: Nat) -> Prf(eq(n, n))
    theorem t: Prf(eq(add(s(z), s(z)), s(s(z)))) = refl(s(s(z)))
    """))
  assert(rejects_with(
    """
    room nat uses logic
    symbol Nat: Type
    symbol z: Nat
    symbol s(n: Nat) -> Nat
    symbol eq(m: Nat, n: Nat) -> Prop
    symbol refl(n: Nat) -> Prf(eq(n, n))
    theorem t: Prf(eq(s(z), z)) = refl(z)
    """,
    "type mismatch",
  ))
}

test "eta: a function equals its own expansion" {
  assert(accepts("""
    symbol f(p: Prop) -> Prop
    symbol P(g: Prop -> Prop) -> Prop
    symbol pf: Prf(P(f))
    def g: Prf(P((x: Prop) => f(x))) = pf
    """))
}

test "axioms reports only what a theorem actually uses" {
  let src = PRELUDE + "\n" + """
    room classical uses logic
    symbol bot: Prop
    symbol em(p: Prop) -> Prf(p)
    theorem plain(a: Prop) -> Prf(imp(a, a)) = (h: Prf(a)) => h
    theorem uses_em(a: Prop) -> Prf(a) = em(a)
    """
  match syntax.parse(src) {
    ok(ds) => {
      let out = checker.check_all(kernel.empty(), ds)
      assert_eq(out.error, none)
      let plain = checker.deps(out.env, "classical.plain")
      assert(not list.contains(plain.symbols, "classical.em"))
      let used = checker.deps(out.env, "classical.uses_em")
      assert(list.contains(used.symbols, "classical.em"))
    },
    err(e) => assert_eq(e, ""),
  }
}

test "a bracket matches by conversion, so a variable can be repeated" {
  assert(accepts("""
    room nat uses logic
    symbol Nat: Type
    symbol z: Nat
    symbol s(n: Nat) -> Nat
    symbol Vec(n: Nat) -> Type
    symbol vnil: Vec(z)
    symbol vcons(n: Nat, x: Nat, v: Vec(n)) -> Vec(s(n))
    symbol tail(n: Nat, v: Vec(s(n))) -> Vec(n)
    rule tail({n}, vcons(n, x, v)) = v  where n: Nat, x: Nat, v: Vec(n)
    symbol eqv(n: Nat, v: Vec(n), w: Vec(n)) -> Prop
    symbol reflv(n: Nat, v: Vec(n)) -> Prf(eqv(n, v, v))
    theorem t: Prf(eqv(z, tail(z, vcons(z, z, vnil)), vnil)) = reflv(z, vnil)
    """))
}

test "without the bracket the same rule does not type-check" {
  assert(rejects_with("""
    room nat uses logic
    symbol Nat: Type
    symbol s(n: Nat) -> Nat
    symbol Vec(n: Nat) -> Type
    symbol vcons(n: Nat, x: Nat, v: Vec(n)) -> Vec(s(n))
    symbol tail(n: Nat, v: Vec(s(n))) -> Vec(n)
    rule tail(m, vcons(n, x, v)) = v  where m: Nat, n: Nat, x: Nat, v: Vec(n)
    """, "type mismatch"))
}

test "brackets are only allowed in rule patterns" {
  assert(rejects_with("symbol a: Prop\ndef b: Prop = {a}", "only allowed in the left-hand side"))
  assert(rejects_with("symbol f(p: Prop) -> Prop\nsymbol a: Prop\nrule f(x) = {a}  where x: Prop", "only allowed in the left-hand side"))
}

test "a bracket cannot mention a variable the pattern leaves unbound" {
  assert(rejects_with("symbol f(p: Prop, q: Prop) -> Prop\nrule f(x, {y}) = x  where x: Prop, y: Prop", "must appear"))
}

test "names inside a room may contain dots" {
  assert(accepts("""
    room nat uses logic
    symbol Nat: Type
    symbol Nat.zero: Nat
    def Nat.one@0: Nat = Nat.zero
    def two: Nat = nat.Nat.one@0
    """))
}

test "irrelevant: two proofs of the same proposition are equal" {
  let without = """
    symbol a: Prop
    symbol h1: Prf(a)
    symbol h2: Prf(a)
    symbol P(h: Prf(a)) -> Prop
    symbol ph1: Prf(P(h1))
    def q: Prf(P(h2)) = ph1
    """
  assert(rejects_with(without, "type mismatch"))
  assert(accepts("irrelevant Prf(a)  where a: Prop\n" + without))
}

test "irrelevant only applies to the declared types" {
  assert(rejects_with("""
    room p uses logic
    symbol N: Type
    symbol a: N
    symbol b: N
    symbol P(n: N) -> Prop
    symbol pa: Prf(P(a))
    def q: Prf(P(b)) = pa
    """, "type mismatch"))
}

test "an irrelevant declaration may only target symbols of its own room" {
  assert(rejects_with("room p uses logic\nirrelevant Prf(a)  where a: Prop", "rules can only be added to symbols of the current room"))
}

test "functions into an irrelevant type are irrelevant too" {
  assert(accepts("""
    irrelevant Prf(a)  where a: Prop
    symbol a: Prop
    symbol b: Prop
    symbol f: Prf(imp(a, b))
    symbol g: Prf(imp(a, b))
    symbol P(h: Prf(imp(a, b))) -> Prop
    symbol pf: Prf(P(f))
    def q: Prf(P(g)) = pf
    """))
}

test "the Almide-style surface: calls, lambdas and arrows" {
  assert(accepts("""
    symbol a: Prop
    def twice(f: Prop -> Prop, x: Prop) -> Prop = f(f(x))
    def same: Prop -> Prop = (p: Prop) => twice((q: Prop) => q, p)
    theorem self_imp: Prf(imp(a, a)) = (h: Prf(a)) => h
    """))
}

// Issue #1: a looping rule must end in an explicit out-of-budget error,
// both when comparing types and when normalising.
let LOOP = """
  room loop
  symbol A: Type
  symbol z: A
  symbol g(x: A) -> A
  symbol f(x: A) -> A
  rule f(x) = g(f(x))  where x: A
  symbol P(x: A) -> Type
  symbol p: P(f(z))
  """

test "a looping rule runs out of budget instead of running forever" {
  assert(rejects_with(LOOP + "theorem stuck: P(f(g(z))) = p", "out of budget"))
  assert(rejects_with(LOOP + "eval f(z)", "out of budget"))
}

test "terminating rules and reflexive conversion still work next to a loop" {
  assert(accepts(LOOP + "theorem same: P(f(z)) = p"))
}

// Issue #2: a dotted declaration in room `a` must not leak into room `a.b`.
test "a dotted name cannot reach a room that is not used" {
  assert(rejects_with("room a\nsymbol b.T: Type\nroom a.b\nsymbol x: T", "does not use"))
  assert(accepts("room a\nsymbol b.T: Type\nroom a.b uses a\nsymbol x: T"))
  assert(accepts("room n uses logic\nsymbol Nat: Type\nsymbol Nat.add(m: Nat, k: Nat) -> Nat\nsymbol two: Nat\ndef four: Nat = Nat.add(two, two)"))
}

// Issue #3: a rule's {bracket} is compared in the context of the term
// being reduced, so proof irrelevance applies to bound variables.
let BRACKET = """
  room r
  symbol Prop: Type
  symbol Prf(q: Prop) -> Type
  symbol p: Prop
  IRRELEVANT
  symbol N: Type
  symbol z: N
  symbol f(h1: Prf(p), h2: Prf(p)) -> N
  rule f(h, {h}) = z  where h: Prf(p)
  symbol Pred(n: N) -> Type
  symbol pz: Pred(z)
  """

fn bracket(irrelevant: Bool, rest: String) -> String =
  string.replace(BRACKET, "IRRELEVANT", if irrelevant then "irrelevant Prf(q)  where q: Prop" else "") + rest

test "brackets see the binders of the term they match" {
  assert(accepts(bracket(true, "theorem t(h1: Prf(p), h2: Prf(p)) -> Pred(f(h1, h2)) = pz")))
  assert(accepts(bracket(true, "theorem t(h1: Prf(p)) -> Pred(f(h1, h1)) = pz")))
  assert(accepts(bracket(true, "symbol c1: Prf(p)\nsymbol c2: Prf(p)\ntheorem t: Pred(f(c1, c2)) = pz")))
  assert(rejects_with(bracket(false, "theorem t(h1: Prf(p), h2: Prf(p)) -> Pred(f(h1, h2)) = pz"), "type mismatch"))
}

// ── Inductive types ─────────────────────────────────────────────────

let NAT = """
  room data
  type Nat: Type =
    | zero
    | succ(n: Nat)
  """

test "an inductive type gets a recursor that computes" {
  assert(accepts(NAT + """
    type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
      | refl: Eq[u](A, a, a)
    def add(m: Nat, n: Nat) -> Nat = Nat.rec[1]((k: Nat) => Nat, m, (k: Nat, r: Nat) => Nat.succ(r), n)
    theorem two: Eq[1](Nat, add(Nat.succ(Nat.zero), Nat.succ(Nat.zero)), Nat.succ(Nat.succ(Nat.zero))) =
      Eq.refl
    """))
  assert(rejects_with(NAT + """
    type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
      | refl: Eq[u](A, a, a)
    theorem wrong: Eq[1](Nat, Nat.zero, Nat.succ(Nat.zero)) = Eq.refl
    """, "type mismatch"))
}

test "a type in a negative position is rejected, and leaves nothing behind" {
  assert(rejects_with(NAT + "type Bad: Type = | mk(f: Bad -> Nat)", "negative position"))
  assert(rejects_with(NAT + "type Bad: Type = | mk(f: (Bad -> Nat) -> Nat)", "negative position"))
  // Nothing of a rejected type stays declared, so a later file can reuse its names.
  match syntax.parse(NAT + "type Bad: Type = | mk(f: Bad -> Nat)") {
    ok(ds) => {
      var env = kernel.empty()
      for d in ds {
        match checker.process(env, d) {
          _ => (),
        }
      }
      assert(kernel.resolve_const(env, "Nat") == ok("data.Nat"))
      assert(kernel.resolve_const(env, "Bad") != ok("data.Bad"))
      assert(kernel.resolve_const(env, "Bad.mk") != ok("data.Bad.mk"))
    },
    err(e) => assert_eq(e, ""),
  }
}

test "constructor arguments must fit the type's universe" {
  assert(rejects_with(NAT + "type Big: Type = | mk(A: Type)", "too large"))
  assert(accepts(NAT + "type Big: Type(1) = | mk(A: Type)"))
  // Propositions may quantify over anything (impredicativity).
  assert(accepts(NAT + "type Any: Sort(0) = | mk(A: Type(3))"))
}

test "constructors build the type itself at its own parameters" {
  assert(rejects_with(NAT + "type T: Type = | mk: Nat", "must build T"))
  assert(rejects_with(NAT + "type L(A: Type): Type = | mk(x: L(Nat))", "own parameters"))
}

test "propositions eliminate into Type only when they are subsingletons" {
  let base = NAT + """
    type Or(a: Sort(0), b: Sort(0)): Sort(0) =
      | inl(h: a)
      | inr(h: b)
    type And(a: Sort(0), b: Sort(0)): Sort(0) =
      | intro(l: a, r: b)
    """
  // And may compute a Nat from a proof; Or may not (it would reveal which side holds).
  assert(accepts(base + "def f(a: Sort(0), b: Sort(0), h: And(a, b)) -> Nat = And.rec((x: And(a, b)) => Nat, (l: a, r: b) => Nat.zero, h)"))
  // Or's recursor has no universe parameter: its motive must land in Prop.
  assert(rejects_with(base + "def f(a: Sort(0), b: Sort(0), h: Or(a, b)) -> Nat = Or.rec[1]((x: Or(a, b)) => Nat, (l: a) => Nat.zero, (r: b) => Nat.zero, h)", "universe levels"))
  assert(rejects_with(base + "def f(a: Sort(0), b: Sort(0), h: Or(a, b)) -> Nat = Or.rec((x: Or(a, b)) => Nat, (l: a) => Nat.zero, (r: b) => Nat.zero, h)", "mismatch"))
}

// ── Elaboration: implicit arguments, inferred levels, holes ─────────

let LISTS = NAT + """
  type List[u](A: Type(u)): Type(u) =
    | nil
    | cons(head: A, tail: List(A))
  type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
    | refl: Eq(A, a, a)
  def length[u, A: Type(u)](xs: List(A)) -> Nat =
    List.rec((l: List(A)) => Nat, Nat.zero, (h: A, t: List(A), r: Nat) => Nat.succ(r), xs)
  def id[u, A: Sort(u)](x: A) -> A = x
  def two: Nat = Nat.succ(Nat.succ(Nat.zero))
  def xs: List(Nat) = List.cons(Nat.zero, List.cons(two, List.nil))
  """

test "implicit arguments and universe levels are inferred" {
  assert(accepts(LISTS + "theorem len: Eq(Nat, length(xs), two) = Eq.refl"))
  assert(accepts(LISTS + "theorem len: Eq(_, length(xs), id(two)) = Eq.refl"))
  assert(accepts(LISTS + "def t: Type = id(Nat)"))
}

test "inference never makes a false statement true" {
  assert(rejects_with(LISTS + "theorem bad: Eq(_, length(xs), Nat.zero) = Eq.refl", "type mismatch"))
  assert(rejects_with(LISTS + "def bad: List(Nat) = List.cons(Nat.zero, List.cons(Type, List.nil))", "expected"))
}

test "what cannot be inferred is reported, not guessed" {
  assert(rejects_with(LISTS + "def e: Nat = length(List.nil)", "cannot infer"))
}

// ── Pattern matching ────────────────────────────────────────────────

let ADD = NAT + """
  type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
    | refl: Eq(A, a, a)
  def add(m: Nat, n: Nat) -> Nat = match n {
    zero => m,
    succ(k) => Nat.succ(add(m, k)),
  }
  def cong[u, v, A: Sort(u), B: Sort(v)](f: A -> B, x: A, y: A, h: Eq(A, x, y)) -> Eq(B, f(x), f(y)) =
    Eq.rec((y': A, e: Eq(A, x, y')) => Eq(B, f(x), f(y')), Eq.refl, y, h)
  """

test "a match compiles to the recursor, and computes" {
  assert(accepts(ADD + "theorem two: Eq(Nat, add(Nat.succ(Nat.zero), Nat.succ(Nat.zero)), Nat.succ(Nat.succ(Nat.zero))) = Eq.refl"))
}

test "a theorem proved by a match is a proof by induction" {
  assert(accepts(ADD + """
    theorem zero_add(n: Nat) -> Eq(Nat, add(Nat.zero, n), n) = match n {
      zero => Eq.refl,
      succ(k) => cong(Nat.succ, add(Nat.zero, k), k, zero_add(k)),
    }
    """))
  // The induction hypothesis is for k, not for anything: a wrong step fails.
  assert(rejects_with(ADD + """
    theorem bad(n: Nat) -> Eq(Nat, add(Nat.zero, n), Nat.zero) = match n {
      zero => Eq.refl,
      succ(k) => bad(k),
    }
    """, "mismatch"))
}

test "only structural recursion is accepted" {
  assert(rejects_with(NAT + "def loop(n: Nat) -> Nat = match n {\n  zero => Nat.zero,\n  succ(k) => loop(Nat.succ(k)),\n}", "structural recursion"))
  assert(rejects_with(NAT + "def loop(n: Nat) -> Nat = match n {\n  zero => loop(n),\n  succ(k) => k,\n}", "structural recursion"))
}

test "every constructor needs an arm, each at most one" {
  assert(rejects_with(NAT + "def f(n: Nat) -> Nat = match n {\n  zero => n,\n}", "no arm for"))
  assert(rejects_with(NAT + "def f(n: Nat) -> Nat = match n {\n  zero => n,\n  zero => n,\n  succ(k) => k,\n}", "two arms"))
  assert(accepts(NAT + "def pred(n: Nat) -> Nat = match n {\n  succ(k) => k,\n  _ => Nat.zero,\n}"))
}

// ── Records ─────────────────────────────────────────────────────────

let RECORDS = NAT + """
  type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
    | refl: Eq(A, a, a)
  type Point = { x: Nat, y: Nat }
  def swap(p: Point) -> Point = Point { x: p.y, y: p.x }
  def p1: Point = Point { y: Nat.succ(Nat.zero), x: Nat.zero }
  type Sigma[u, v](A: Type(u), B: A -> Type(v)): Type(max(u, v)) = { fst: A, snd: B(fst) }
  """

test "records: values, fields, and projections that compute" {
  assert(accepts(RECORDS + "theorem sx: Eq(Nat, swap(p1).x, Nat.succ(Nat.zero)) = Eq.refl"))
  assert(rejects_with(RECORDS + "theorem sx: Eq(Nat, swap(p1).x, Nat.zero) = Eq.refl", "mismatch"))
  assert(rejects_with(RECORDS + "def q: Point = Point { x: Nat.zero }", "every field"))
  assert(rejects_with(RECORDS + "def q: Point = Point { x: Nat.zero, y: Nat.zero, z: Nat.zero }", "no field z"))
}

test "records: a field's type may depend on earlier fields" {
  assert(accepts(RECORDS + """
    type Vec(n: Nat): Type = | mkv
    def second(s: Sigma(Nat, (n: Nat) => Vec(n))) -> Vec(s.fst) = s.snd
    def sized: Sigma(Nat, (n: Nat) => Vec(n)) = Sigma { fst: Nat.zero, snd: Vec.mkv }
    """))
}

// Issue #6: a `_` arm also covers constructors with fields.
test "a wildcard arm covers constructors with fields, without capturing names" {
  assert(accepts(NAT + "def constant(n: Nat) -> Nat = match n {\n  zero => Nat.zero,\n  _ => Nat.zero,\n}"))
  assert(accepts(NAT + "def all(n: Nat) -> Nat = match n {\n  _ => n,\n}"))
  // Several fields, one of them recursive; the body uses `_1`, which the
  // generated field names must not capture.
  assert(accepts(NAT + """
    type Tree: Type =
      | leaf
      | node(l: Tree, x: Nat, r: Tree)
    def _1: Nat = Nat.succ(Nat.zero)
    def shape(t: Tree) -> Nat = match t {
      leaf => Nat.zero,
      _ => _1,
    }
    type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
      | refl: Eq(A, a, a)
    theorem one: Eq(Nat, shape(Tree.node(Tree.leaf, Nat.zero, Tree.leaf)), Nat.succ(Nat.zero)) = Eq.refl
    """))
  // Explicit arms still need the right number of names.
  assert(rejects_with(NAT + "def f(n: Nat) -> Nat = match n {\n  zero => n,\n  succ => n,\n}", "takes 1 arguments"))
}

// Issue #7: matching a rule reduces arguments, which may match rules again.
test "a cycle through rule matching runs out of budget instead of the stack" {
  let src = """
    room nested
    symbol A: Type
    symbol z: A
    symbol f(x: A) -> A
    symbol g(x: A) -> A
    rule f(g(x)) = x  where x: A
    rule g(x) = f(g(x))  where x: A
    """
  assert(rejects_with(src + "\neval f(g(z))", "out of budget"))
  assert(rejects_with(src + "\nsymbol P(x: A) -> Type\nsymbol p: P(z)\ntheorem t: P(f(g(z))) = p", "out of budget"))
}

// ── Views ───────────────────────────────────────────────────────────

let VIEW_LOGIC = """
room implog
symbol Prop: Type
symbol Prf(p: Prop) -> Sort(0)
symbol imp(a: Prop, b: Prop) -> Prop
rule Prf(imp(a, b)) = Prf(a) -> Prf(b)  where a: Prop, b: Prop
theorem k(a: Prop, b: Prop) -> Prf(imp(a, imp(b, a))) = (x: Prf(a), y: Prf(b)) => x

room implog2 uses implog
theorem k2(a: Prop) -> Prf(imp(a, imp(a, a))) = k(a, a)
"""

test "a view maps symbols, keeps rules, and carries theorems along, checked again" {
  let src = VIEW_LOGIC + """
room native
view v from implog {
  Prop = Sort(0),
  Prf = (p: Sort(0)) => p,
  imp = (a: Sort(0), b: Sort(0)) => a -> b,
}
translate v implog2.k2
theorem use_it(p: Sort(0), x: p) -> p = v.implog2.k2(p, x, x)
"""
  assert_eq(run(src), none)
}

test "a view must keep the source's rules" {
  let src = """
room implog
symbol Prop: Type
symbol Prf(p: Prop) -> Sort(0)
symbol imp(a: Prop, b: Prop) -> Prop
rule Prf(imp(a, b)) = Prf(a) -> Prf(b)  where a: Prop, b: Prop

room native
view v from implog {
  Prop = Sort(0),
  Prf = (p: Sort(0)) => p,
  imp = (a: Sort(0), b: Sort(0)) => b,
}
"""
  assert(rejects_with(src, "does not keep the rule"))
}

test "a translation is checked again in the target" {
  // Theorems of a room built on the source come along, checked again.
  let src = """
room weak
symbol Prop: Type
symbol Prf(p: Prop) -> Sort(0)
symbol top: Prop
symbol bot: Prop
symbol triv: Prf(top)
theorem t: Prf(top) = triv

room uses_weak uses weak
theorem t2: Prf(top) = t

room native
type Unit: Sort(0) =
  | star
type Empty: Sort(0) =
view v from weak {
  Prop = Sort(0),
  Prf = (p: Sort(0)) => p,
  top = Unit,
  bot = Empty,
  triv = Unit.star,
}
translate v uses_weak.t2
theorem from_view: Unit = v.uses_weak.t2
"""
  assert_eq(run(src), none)
  // A theorem about bot cannot be produced: bot's image has no proof, and
  // the view refuses a wrong image for triv.
  let bad = """
room weak
symbol Prop: Type
symbol Prf(p: Prop) -> Sort(0)
symbol bot: Prop
symbol triv: Prf(bot)

room native
type Unit: Sort(0) =
  | star
type Empty: Sort(0) =
view v from weak {
  Prop = Sort(0),
  Prf = (p: Sort(0)) => p,
  bot = Empty,
  triv = Unit.star,
}
"""
  assert(rejects_with(bad, "type mismatch"))
}

// ── Blocks and goals ────────────────────────────────────────────────

let EQ = """
room eqs
type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
  | refl: Eq(A, a, a)
theorem symm[u, A: Sort(u)](x: A, y: A, h: Eq(A, x, y)) -> Eq(A, y, x) =
  Eq.rec((y': A, e: Eq(A, x, y')) => Eq(A, y', x), Eq.refl, y, h)
"""

test "a block names the steps of a proof" {
  let src = EQ + """
theorem trans3[u, A: Sort(u)](a: A, b: A, c: A, d: A, h1: Eq(A, a, b), h2: Eq(A, c, b), h3: Eq(A, c, d)) -> Eq(A, a, d) = {
  let h2': Eq(A, b, c) = symm(c, b, h2)
  let ac = Eq.rec((z: A, e: Eq(A, b, z)) => Eq(A, a, z), h1, c, h2')
  Eq.rec((z: A, e: Eq(A, c, z)) => Eq(A, a, z), ac, d, h3)
}
"""
  assert_eq(run(src), none)
}

test "a step of a block must prove what it claims" {
  let src = EQ + """
theorem wrong[u, A: Sort(u)](a: A, b: A, h: Eq(A, a, b)) -> Eq(A, a, b) = {
  let back: Eq(A, a, b) = symm(a, b, h)
  back
}
"""
  assert(rejects_with(src, "mismatch"))
}

test "an open goal is reported with its type and what is at hand" {
  let src = EQ + """
theorem later[u, A: Sort(u)](x: A, y: A, h: Eq(A, x, y)) -> Eq(A, y, x) = ?
"""
  match run(src) {
    some(e) => {
      assert(string.contains(e, "1 open goal"))
      assert(string.contains(e, "goal: Eq[u](A, y, x)"))
      assert(string.contains(e, "h: Eq[u](A, x, y)"))
    },
    none => assert(false),
  }
}

// ── Pattern matching: nested patterns, inner matches, indexed families ─

let NATS = """
room pm
type Nat: Type =
  | zero
  | succ(n: Nat)
type Bool: Type =
  | tt
  | ff
type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
  | refl: Eq(A, a, a)
"""

test "nested patterns are tried in order" {
  let src = NATS + """
def pred2(n: Nat) -> Nat = match n {
  succ(succ(m)) => m,
  _ => Nat.zero,
}
theorem pred2_ss(m: Nat) -> Eq(Nat, pred2(Nat.succ(Nat.succ(m))), m) = Eq.refl
theorem pred2_one: Eq(Nat, pred2(Nat.succ(Nat.zero)), Nat.zero) = Eq.refl
"""
  assert_eq(run(src), none)
}

test "a match may leave a case out only if another arm covers it" {
  let src = NATS + """
def f(n: Nat) -> Nat = match n {
  zero => Nat.zero,
  succ(succ(m)) => m,
}
"""
  assert(rejects_with(src, "no arm for pm.Nat.zero"))
}

test "an arm may match again, and recursion on the outer field is structural" {
  let src = NATS + """
def le(m: Nat, n: Nat) -> Bool = match m {
  zero => Bool.tt,
  succ(k) => match n {
    zero => Bool.ff,
    succ(j) => le(k, j),
  },
}
theorem le_refl(n: Nat) -> Eq(Bool, le(n, n), Bool.tt) = match n {
  zero => Eq.refl,
  succ(k) => le_refl(k),
}
"""
  assert_eq(run(src), none)
}

test "recursion two constructors deep is not structural here" {
  let src = NATS + """
def even(n: Nat) -> Bool = match n {
  zero => Bool.tt,
  succ(zero) => Bool.ff,
  succ(succ(k)) => even(k),
}
"""
  assert(rejects_with(src, "structural recursion"))
}

test "an indexed family is matched with its indices generalised" {
  let src = NATS + """
type Vec[u](A: Type(u)): (n: Nat) -> Type(u) =
  | vnil: Vec(A, Nat.zero)
  | vcons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Nat.succ(n))
def vmap[u, v, A: Type(u), B: Type(v)](f: A -> B, n: Nat, xs: Vec(A, n)) -> Vec(B, n) = match xs {
  vnil => Vec.vnil,
  vcons(m, x, rest) => Vec.vcons(m, f(x), vmap(f, m, rest)),
}
def vhead_or[u, A: Type(u)](d: A, n: Nat, xs: Vec(A, n)) -> A = match xs {
  vnil => d,
  vcons(m, x, rest) => x,
}
"""
  assert_eq(run(src), none)
}

test "an index that is a constructor pattern is unified by cases; any other term is refused" {
  let vec = NATS + """
type Vec[u](A: Type(u)): (n: Nat) -> Type(u) =
  | vnil: Vec(A, Nat.zero)
  | vcons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Nat.succ(n))
"""
  assert_eq(run(vec + """
def vhead[u, A: Type(u)](n: Nat, xs: Vec(A, Nat.succ(n))) -> A = match xs {
  vcons(m, x, rest) => x,
}
"""), none)
  assert(rejects_with(vec + """
def double(n: Nat) -> Nat = match n {
  zero => Nat.zero,
  succ(k) => Nat.succ(Nat.succ(double(k))),
}
def vhead[u, A: Type(u)](n: Nat, xs: Vec(A, double(n))) -> A = match xs {
  vcons(m, x, rest) => x,
}
""", "a constructor applied to such parameters"))
}

// ── Proof search (#14) ──────────────────────────────────────────────

test "search composes hypotheses into an ordinary term" {
  let src = """
room s
theorem compose(P: Sort(0), Q: Sort(0), R: Sort(0), f: P -> Q, g: Q -> R, h: P) -> R = search
"""
  assert_eq(run(src), none)
}

test "search instantiates a listed polymorphic lemma" {
  let src = EQ + """
type Nat: Type =
  | zero
  | succ(n: Nat)
theorem back(n: Nat, m: Nat, h: Eq(Nat, Nat.succ(n), m)) -> Eq(Nat, m, Nat.succ(n)) = search(symm)
"""
  assert_eq(run(src), none)
}

test "search does not guess side goals, and says so" {
  let src = EQ + """
theorem trans[u, A: Sort(u)](a: A, b: A, c: A, h1: Eq(A, a, b), h2: Eq(A, b, c)) -> Eq(A, a, c) =
  Eq.rec((z: A, e: Eq(A, b, z)) => Eq(A, a, z), h1, c, h2)
theorem t[u, A: Sort(u)](a: A, c: A) -> Eq(A, a, c) = search(trans)
"""
  assert(rejects_with(src, "side goals the search does not guess"))
}

test "an impossible goal gets no proof, and a forged one is rejected" {
  let base = """
room s
symbol P: Sort(0)
symbol Q: Sort(0)
symbol f: P -> Q
"""
  assert(rejects_with(base + "\ntheorem no: P = search(f)\n", "inconclusive"))
  assert(rejects_with(base + "\ntheorem forged: P = f\n", "mismatch"))
}

test "a lemma that loops stops at the budget" {
  let src = """
room s
symbol P: Sort(0)
symbol again: P -> P
theorem no: P = search(again, depth: 50)
"""
  assert(rejects_with(src, "inconclusive"))
}

// ── Finding and composing views (#13) ───────────────────────────────

let THREE = """
room a
symbol Prop: Type
symbol Prf(p: Prop) -> Sort(0)
symbol imp(p: Prop, q: Prop) -> Prop
rule Prf(imp(p, q)) = Prf(p) -> Prf(q)  where p: Prop, q: Prop
theorem k(p: Prop, q: Prop) -> Prf(imp(p, imp(q, p))) = (x: Prf(p), y: Prf(q)) => x

room b
symbol Form: Type
symbol Holds(f: Form) -> Sort(0)
symbol arrow(f: Form, g: Form) -> Form
rule Holds(arrow(f, g)) = Holds(f) -> Holds(g)  where f: Form, g: Form
view ab from a {
  Prop = Form,
  Prf = Holds,
  imp = arrow,
}
translate ab a.k

room c
view bc from b {
  Form = Sort(0),
  Holds = (p: Sort(0)) => p,
  arrow = (p: Sort(0), q: Sort(0)) => p -> q,
}
"""

fn lines_of(src: String) -> List[String] = match syntax.parse(PRELUDE + "\n" + src) {
  err(e) => ["parse: " + e],
  ok(ds) => checker.check_all(kernel.empty(), ds).output,
}

test "a two-view route is found, composed, and agrees with going through both" {
  let src = THREE + """
routes from a
view ac from a via ab, bc
translate ac a.k
translate bc b.ab.a.k
theorem one_way(p: Sort(0), q: Sort(0)) -> p -> q -> p = ac.a.k(p, q)
theorem other_way(p: Sort(0), q: Sort(0)) -> p -> q -> p = bc.b.ab.a.k(p, q)
"""
  assert_eq(run(src), none)
  assert(list.any(lines_of(src), (l) => string.starts_with(l, "route a -> b -> c: b.ab then c.bc")))
}

test "several routes are all shown, none chosen" {
  let src = THREE + """
view ac1 from a via ab, bc
routes from a
"""
  let out = lines_of(src)
  assert(list.any(out, (l) => string.contains(l, "2 routes; none is chosen")))
}

test "no route is reported as inconclusive" {
  let src = THREE + """
room d
routes from a
"""
  assert(list.any(lines_of(src), (l) => string.contains(l, "no route from a to d within two views")))
}

// ── Record eta ──────────────────────────────────────────────────────

test "a record equals the record of its fields (eta)" {
  let src = """
room r
type Nat: Type =
  | zero
  | succ(n: Nat)
type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
  | refl: Eq(A, a, a)
type Point = { x: Nat, y: Nat }
theorem eta(p: Point) -> Eq(Point, p, Point { x: p.x, y: p.y }) = Eq.refl
theorem eta_back(p: Point) -> Eq(Point, Point { x: p.x, y: p.y }, p) = Eq.refl
"""
  assert_eq(run(src), none)
}

test "eta does not equate a record with a different one" {
  let src = """
room r
type Nat: Type =
  | zero
  | succ(n: Nat)
type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
  | refl: Eq(A, a, a)
type Point = { x: Nat, y: Nat }
theorem swapped(p: Point) -> Eq(Point, p, Point { x: p.y, y: p.x }) = Eq.refl
"""
  assert(rejects_with(src, "mismatch"))
}

// ── Nested matches refine the outer constructor (#19) ──────────────

let NESTED_BASE = """
room nested
type Nat: Type = | zero | succ(pred: Nat)
type Unit: Type = | unit
type Empty: Type =
type Sum(A: Type, B: Type): Type = | left(value: A) | right(value: B)
type Flag: Type = | ff | tt
type Eq(A: Type, a: A): (b: A) -> Sort(0) = | refl: Eq(A, a, a)
def LE(a: Nat, b: Nat) -> Type = match a {
  zero => Unit,
  succ(a1) => match b {
    zero => Empty,
    succ(b1) => LE(a1, b1),
  },
}
"""

test "an inner match sees the outer constructor in its motive" {
  let src = NESTED_BASE + """
def le_case(x: Nat, h: Nat) -> Sum(LE(x, h), LE(h, x)) = match x {
  zero => match h {
    zero => Sum.left(Unit.unit),
    succ(b) => Sum.left(Unit.unit),
  },
  succ(a) => match h {
    zero => Sum.right(Unit.unit),
    succ(b) => le_case(a, b),
  },
}
"""
  assert_eq(run(src), none)
}

test "the explicit-recursor form still checks" {
  let src = NESTED_BASE + """
def le_case(x: Nat, h: Nat) -> Sum(LE(x, h), LE(h, x)) = match x {
  zero => Sum.left(Unit.unit),
  succ(a) => Nat.rec((b: Nat) => Sum(LE(Nat.succ(a), b), LE(b, Nat.succ(a))),
    Sum.right(Unit.unit),
    (b: Nat, ih: _) => le_case(a, b), h),
}
"""
  assert_eq(run(src), none)
}

test "two nested levels, and references under binders" {
  let src = NESTED_BASE + """
def bump(b: Flag, n: Nat) -> Nat = match b {
  tt => Nat.succ(n),
  ff => n,
}
theorem bump_swap(a: Flag, b: Flag, n: Nat) -> Eq(Nat, bump(a, bump(b, n)), bump(b, bump(a, n))) = match a {
  tt => match b {
    tt => Eq.refl,
    ff => Eq.refl,
  },
  ff => match b {
    tt => Eq.refl,
    ff => Eq.refl,
  },
}
def three(x: Flag, y: Flag, z: Flag) -> (k: Nat) -> Eq(Nat, bump(x, bump(y, bump(z, k))), bump(z, bump(y, bump(x, k)))) = match x {
  tt => match y {
    tt => match z {
      tt => (k: Nat) => Eq.refl,
      ff => (k: Nat) => Eq.refl,
    },
    ff => match z {
      tt => (k: Nat) => Eq.refl,
      ff => (k: Nat) => Eq.refl,
    },
  },
  ff => match y {
    tt => match z {
      tt => (k: Nat) => Eq.refl,
      ff => (k: Nat) => Eq.refl,
    },
    ff => match z {
      tt => (k: Nat) => Eq.refl,
      ff => (k: Nat) => Eq.refl,
    },
  },
}
"""
  assert_eq(run(src), none)
}

test "a wrong branch of a nested match is still rejected" {
  let src = NESTED_BASE + """
def le_case(x: Nat, h: Nat) -> Sum(LE(x, h), LE(h, x)) = match x {
  zero => match h {
    zero => Sum.left(Unit.unit),
    succ(b) => Sum.right(Unit.unit),
  },
  succ(a) => match h {
    zero => Sum.right(Unit.unit),
    succ(b) => le_case(a, b),
  },
}
"""
  assert(rejects_with(src, "mismatch"))
}

test "a nested match still allows only structural recursion" {
  let src = NESTED_BASE + """
def le_case(x: Nat, h: Nat) -> Sum(LE(x, h), LE(h, x)) = match x {
  zero => match h {
    zero => Sum.left(Unit.unit),
    succ(b) => Sum.left(Unit.unit),
  },
  succ(a) => match h {
    zero => Sum.right(Unit.unit),
    succ(b) => le_case(Nat.succ(a), b),
  },
}
"""
  assert(rejects_with(src, "structural recursion"))
}

// ── Unification leaves nothing behind when an attempt fails ────────

test "a failed attempt at unification does not fix a universe level" {
  // `length[?l](B, ..) =?= length[u](A, ..)` agrees on the head, so the
  // spines are tried first: ?l := u, then B against A fails. Both sides
  // then compute to zero; ?l must still be free, and become v.
  let src = """
room lv
type Nat: Type = | zero | succ(pred: Nat)
type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) = | refl: Eq(A, a, a)
type List[u](A: Type(u)): Type(u) = | nil | cons(head: A, tail: List(A))
def length[u, A: Type(u)](xs: List(A)) -> Nat = match xs {
  nil => Nat.zero,
  cons(h, t) => Nat.succ(length(t)),
}
def map[u, v, A: Type(u), B: Type(v)](f: A -> B, xs: List(A)) -> List(B) = match xs {
  nil => List.nil,
  cons(h, t) => List.cons(f(h), map(f, t)),
}
def cong_succ(m: Nat, n: Nat, h: Eq(Nat, m, n)) -> Eq(Nat, Nat.succ(m), Nat.succ(n)) =
  Eq.rec((n': Nat, e: Eq(Nat, m, n')) => Eq(Nat, Nat.succ(m), Nat.succ(n')), Eq.refl, n, h)
theorem length_map[u, v, A: Type(u), B: Type(v)](f: A -> B, xs: List(A)) -> Eq(Nat, length(map(f, xs)), length(xs)) = match xs {
  nil => Eq.refl,
  cons(h, t) => cong_succ(length(map(f, t)), length(t), length_map(f, t)),
}
"""
  assert_eq(run(src), none)
}

// ── Deep computations cost budget, not stack (#17) ─────────────────

// add(N_n, N_n) = N_2n, with numerals as a chain of definitions.
fn numeral_source(n: Int) -> String = {
  var out: List[String] = ["room deep", "type Nat: Type = | zero | succ(pred: Nat)", "type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) = | refl: Eq(A, a, a)", "def add(m: Nat, n: Nat) -> Nat = match m {", "  zero => n,", "  succ(k) => Nat.succ(add(k, n)),", "}", "def N0: Nat = Nat.zero"]
  var k = 1
  while k <= 2 * n {
    list.push(out, "def N${int.to_string(k)}: Nat = Nat.succ(N${int.to_string(k - 1)})")
    k = k + 1
  }
  list.push(out, "theorem sum: Eq(Nat, add(N${int.to_string(n)}, N${int.to_string(n)}), N${int.to_string(2 * n)}) = Eq.refl")
  list.join(out, "\n")
}

test "a long chain of definitions unfolds in a loop" {
  assert_eq(run(numeral_source(400)), none)
}

test "a computation too deep to compare runs out of budget" {
  assert(rejects_with(numeral_source(3000), "out of budget"))
}

// ── Mutual inductive types and definitions ─────────────────────────

let MUTUAL_BASE = """
room mt
type Nat: Type = | zero | succ(pred: Nat)
type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) = | refl: Eq(A, a, a)
def add(m: Nat, n: Nat) -> Nat = match m {
  zero => n,
  succ(k) => Nat.succ(add(k, n)),
}
type Tree: Type =
  | node(x: Nat, kids: Forest)
type Forest: Type =
  | nil
  | cons(t: Tree, rest: Forest)
"""

test "mutually recursive definitions compute" {
  let src = MUTUAL_BASE + """
def tree_size(t: Tree) -> Nat = match t {
  node(x, kids) => Nat.succ(forest_size(kids)),
}
def forest_size(f: Forest) -> Nat = match f {
  nil => Nat.zero,
  cons(t, rest) => add(tree_size(t), forest_size(rest)),
}
theorem two: Eq(Nat, tree_size(Tree.node(Nat.zero, Forest.cons(Tree.node(Nat.zero, Forest.nil), Forest.nil))), Nat.succ(Nat.succ(Nat.zero))) = Eq.refl
"""
  assert_eq(run(src), none)
}

test "a mutual definition that is not structural is rejected" {
  let src = MUTUAL_BASE + """
def tree_size(t: Tree) -> Nat = match t {
  node(x, kids) => Nat.succ(forest_size(Forest.cons(t, kids))),
}
def forest_size(f: Forest) -> Nat = match f {
  nil => Nat.zero,
  cons(t, rest) => add(tree_size(t), forest_size(rest)),
}
"""
  assert(rejects_with(src, "structural recursion"))
}

test "a wrong value from a mutual definition is rejected" {
  let src = MUTUAL_BASE + """
def tree_size(t: Tree) -> Nat = match t {
  node(x, kids) => Nat.succ(forest_size(kids)),
}
def forest_size(f: Forest) -> Nat = match f {
  nil => Nat.zero,
  cons(t, rest) => add(tree_size(t), forest_size(rest)),
}
theorem wrong: Eq(Nat, tree_size(Tree.node(Nat.zero, Forest.nil)), Nat.zero) = Eq.refl
"""
  assert(rejects_with(src, "mismatch"))
}

test "a negative occurrence across a mutual group is rejected" {
  let src = """
room bad
type A: Type =
  | mk(f: B -> A)
type B: Type =
  | mk(f: A -> B)
"""
  assert(rejects_with(src, "negative"))
}

test "a proposition group cannot be matched into data" {
  let src = MUTUAL_BASE + """
type Bool: Type = | tt | ff
type Even: (n: Nat) -> Sort(0) =
  | zero: Even(Nat.zero)
  | succ(n: Nat, h: Odd(n)): Even(Nat.succ(n))
type Odd: (n: Nat) -> Sort(0) =
  | succ(n: Nat, h: Even(n)): Odd(Nat.succ(n))
def even_bool(n: Nat, e: Even(n)) -> Bool = match e {
  zero => Bool.tt,
  succ(m, o) => odd_bool(m, o),
}
def odd_bool(n: Nat, o: Odd(n)) -> Bool = match o {
  succ(m, e) => even_bool(m, e),
}
"""
  assert(rejects_with(src, "only into Prop"))
}

test "a function on some types of a mutual group, in any order" {
  let src = MUTUAL_BASE + """
type Bool: Type = | tt | ff
def label(t: Tree) -> Nat = match t {
  node(x, kids) => x,
}
def is_nil(f: Forest) -> Bool = match f {
  nil => Bool.tt,
  _ => Bool.ff,
}
def forest_len(f: Forest) -> Nat = match f {
  nil => Nat.zero,
  cons(t, rest) => Nat.succ(forest_len(rest)),
}
def forest_size(f: Forest) -> Nat = match f {
  nil => Nat.zero,
  cons(t, rest) => add(tree_size(t), forest_size(rest)),
}
def tree_size(t: Tree) -> Nat = match t {
  node(x, kids) => Nat.succ(forest_size(kids)),
}
def two: Forest = Forest.cons(Tree.node(Nat.zero, Forest.nil), Forest.cons(Tree.node(Nat.zero, Forest.nil), Forest.nil))
theorem len_two: Eq(Nat, forest_len(two), Nat.succ(Nat.succ(Nat.zero))) = Eq.refl
theorem size_two: Eq(Nat, forest_size(two), Nat.succ(Nat.succ(Nat.zero))) = Eq.refl
theorem not_nil: Eq(Bool, is_nil(two), Bool.ff) = Eq.refl
"""
  assert_eq(run(src), none)
}

test "a recursive call on a part of another type is not structural for a single function" {
  let src = MUTUAL_BASE + """
def forest_len(f: Forest) -> Nat = match f {
  nil => Nat.zero,
  cons(t, rest) => Nat.succ(forest_len(Forest.cons(t, rest))),
}
"""
  assert(rejects_with(src, "structural recursion"))
}

let VARIED = """
room mv
type Nat: Type = | zero | succ(pred: Nat)
type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) = | refl: Eq(A, a, a)
type A: (n: Nat) -> Type =
  | a0: A(Nat.zero)
  | a1(n: Nat, b: B): A(Nat.succ(n))
type B: Type =
  | b0
  | b1(n: Nat, a: A(n))
"""

test "mutual types with different indices, and functions on them" {
  let src = VARIED + """
def a_size(n: Nat, a: A(n)) -> Nat = match a {
  a0 => Nat.zero,
  a1(m, b) => Nat.succ(b_size(b)),
}
def b_size(b: B) -> Nat = match b {
  b0 => Nat.zero,
  b1(m, a) => Nat.succ(a_size(m, a)),
}
def deep: B = B.b1(Nat.succ(Nat.zero), A.a1(Nat.zero, B.b1(Nat.zero, A.a0)))
theorem three: Eq(Nat, b_size(deep), Nat.succ(Nat.succ(Nat.succ(Nat.zero)))) = Eq.refl
theorem by_rec: Eq(Nat, B.rec((n: Nat, a: A(n)) => Nat, (b: B) => Nat, Nat.zero, (n: Nat, b: B, ih: Nat) => Nat.succ(ih), Nat.zero, (n: Nat, a: A(n), ih: Nat) => Nat.succ(ih), deep), Nat.succ(Nat.succ(Nat.succ(Nat.zero)))) = Eq.refl
"""
  assert_eq(run(src), none)
}

test "a wrong value on a varied group is rejected" {
  let src = VARIED + """
def b_size(b: B) -> Nat = match b {
  b0 => Nat.zero,
  b1(m, a) => Nat.succ(Nat.zero),
}
theorem wrong: Eq(Nat, b_size(B.b0), Nat.succ(Nat.zero)) = Eq.refl
"""
  assert(rejects_with(src, "mismatch"))
}

test "mutual types in different universes are refused with a reason" {
  let src = """
room mu
type Nat: Type = | zero | succ(pred: Nat)
type P: (n: Nat) -> Sort(0) =
  | p(q: Q)
type Q: Type =
  | q0
  | q1(n: Nat, x: P(n))
"""
  assert(rejects_with(src, "same universe"))
}

// ── Nested inductive types ─────────────────────────────────────────

let NESTED_TYPES = """
room nt
type Nat: Type = | zero | succ(pred: Nat)
type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) = | refl: Eq(A, a, a)
type List[u](A: Type(u)): Type(u) = | nil | cons(head: A, tail: List(A))
def add(m: Nat, n: Nat) -> Nat = match m {
  zero => n,
  succ(k) => Nat.succ(add(k, n)),
}
type Rose: Type = | node(kids: List(Rose))
def leaf: Rose = Rose.node(List.nil)
"""

test "a nested type gets a recursor through the type it is nested in" {
  let src = NESTED_TYPES + """
def count(r: Rose) -> Nat = Rose.rec((r: Rose) => Nat, (l: List(Rose)) => Nat,
  (kids: List(Rose), ih: Nat) => Nat.succ(ih), Nat.zero,
  (h: Rose, t: List(Rose), a: Nat, b: Nat) => add(a, b), r)
theorem c: Eq(Nat, count(Rose.node(List.cons(leaf, List.nil))), Nat.succ(Nat.succ(Nat.zero))) = Eq.refl
"""
  assert_eq(run(src), none)
}

test "functions over a nested type and its occurrence compute, and match splits it" {
  let src = NESTED_TYPES + """
def size(r: Rose) -> Nat = match r {
  node(kids) => Nat.succ(sizes(kids)),
}
def sizes(l: List(Rose)) -> Nat = match l {
  nil => Nat.zero,
  cons(h, t) => add(size(h), sizes(t)),
}
theorem three: Eq(Nat, size(Rose.node(List.cons(leaf, List.cons(leaf, List.nil)))), Nat.succ(Nat.succ(Nat.succ(Nat.zero)))) = Eq.refl
def bare(r: Rose) -> Nat = match r {
  node(kids) => match kids {
    nil => Nat.succ(Nat.zero),
    cons(h, t) => Nat.zero,
  },
}
theorem leaf_bare: Eq(Nat, bare(leaf), Nat.succ(Nat.zero)) = Eq.refl
"""
  assert_eq(run(src), none)
}

test "a wrong value over a nested type is rejected" {
  let src = NESTED_TYPES + """
def size(r: Rose) -> Nat = match r {
  node(kids) => Nat.succ(sizes(kids)),
}
def sizes(l: List(Rose)) -> Nat = match l {
  nil => Nat.zero,
  cons(h, t) => add(size(h), sizes(t)),
}
theorem wrong: Eq(Nat, size(leaf), Nat.zero) = Eq.refl
"""
  assert(rejects_with(src, "mismatch"))
}

test "recursion over a nested type must call each function on a field of its type" {
  let src = NESTED_TYPES + """
def size(r: Rose) -> Nat = match r {
  node(kids) => Nat.succ(sizes(kids)),
}
def sizes(l: List(Rose)) -> Nat = match l {
  nil => Nat.zero,
  cons(h, t) => sizes(h),
}
"""
  assert(rejects_with(src, "structural recursion"))
  let alone = NESTED_TYPES + """
def size(r: Rose) -> Nat = match r {
  node(kids) => size(kids),
}
"""
  assert(rejects_with(alone, "structural recursion"))
}

test "a type nested in a negative position or in an indexed family is rejected" {
  let neg = NESTED_TYPES + """
type Neg(A: Type): Type = | mk(f: A -> Nat)
type Bad: Type = | b(x: Neg(Bad))
"""
  assert(rejects_with(neg, "negative position"))
  let vec = NESTED_TYPES + """
type Vec(A: Type): (n: Nat) -> Type =
  | vnil: Vec(A, Nat.zero)
  | vcons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Nat.succ(n))
type Bad: Type = | b(n: Nat, x: Vec(Bad, n))
"""
  assert(rejects_with(vec, "without indices"))
}

test "nesting goes through several levels and parameters" {
  let src = NESTED_TYPES + """
type T: Type = | n(x: List(List(T)))
type Tree[u](A: Type(u)): Type(u) = | node(a: A, kids: List(Tree(A)))
def count(t: T) -> Nat = T.rec((r: T) => Nat, (l: List(List(T))) => Nat, (l: List(T)) => Nat,
  (x: List(List(T)), ih: Nat) => Nat.succ(ih),
  Nat.zero, (h: List(T), t: List(List(T)), a: Nat, b: Nat) => Nat.succ(a),
  Nat.zero, (h: T, t: List(T), a: Nat, b: Nat) => a, t)
theorem c: Eq(Nat, count(T.n(List.cons(List.cons(T.n(List.nil), List.nil), List.nil))), Nat.succ(Nat.succ(Nat.succ(Nat.zero)))) = Eq.refl
def tsum(t: Tree(Nat)) -> Nat = match t {
  node(a, kids) => add(a, tsums(kids)),
}
def tsums(l: List(Tree(Nat))) -> Nat = match l {
  nil => Nat.zero,
  cons(h, t) => add(tsum(h), tsums(t)),
}
theorem s: Eq(Nat, tsum(Tree.node(Nat.succ(Nat.zero), List.cons(Tree.node(Nat.succ(Nat.zero), List.nil), List.nil))), Nat.succ(Nat.succ(Nat.zero))) = Eq.refl
"""
  assert_eq(run(src), none)
}

// ── Well-founded recursion ─────────────────────────────────────────

// The native library (eq, logic, nat, wf) under the source.
effect fn run_wf(src: String) -> String? = {
  let std = ["lib/std/eq.arlk", "lib/std/logic.arlk", "lib/std/nat.arlk", "lib/std/wf.arlk"] |> list.map((f) => fs.read_text(f) ?? "")
  match syntax.parse(list.join(std, "\n") + "\n" + src) {
    err(e) => some("parse: " + e),
    ok(ds) => checker.check_all(kernel.empty(), ds).error,
  }
}

let WF_DIV = """
room wft uses eq, logic, nat, wf
def div(n: Nat, d: Nat) -> Nat decreasing n by lt_wf = match d {
  zero => Nat.zero,
  succ(k) => match le_dec(Nat.succ(k), n) {
    yes(h) => Nat.succ(div(sub(n, Nat.succ(k)), Nat.succ(k), sub_lt(n, k, le_trans(succ_le_succ(le_zero(k)), h)))),
    no(h) => Nat.zero,
  },
}
def two: Nat = Nat.succ(Nat.succ(Nat.zero))
def seven: Nat = add(two, add(two, Nat.succ(two)))
"""

test "well-founded recursion computes, and its unfolding law is proved" {
  assert_eq(run_wf(WF_DIV + """
theorem seven_div_two: Eq(Nat, div(seven, two), Nat.succ(two)) = Eq.refl
theorem one_step(n: Nat, d: Nat) -> Eq(Nat, div(n, d), div.step(n, d, (m: Nat, r: Lt(m, n), e: Nat) => div(m, e))) = div.unfold(n, d)
""")!, none)
}

test "a wrong result of well-founded recursion is rejected" {
  assert(match run_wf(WF_DIV + "theorem wrong: Eq(Nat, div(seven, two), two) = Eq.refl\n")! {
    some(e) => string.contains(e, "mismatch"),
    none => false,
  })
}

test "a recursive call must prove that it decreases" {
  let missing = "room wft uses eq, logic, nat, wf\ndef f(n: Nat) -> Nat decreasing n by lt_wf = f(n)\n"
  assert(match run_wf(missing)! {
    some(e) => string.contains(e, "a proof that the decreasing one is smaller"),
    none => false,
  })
  let bogus = "room wft uses eq, logic, nat, wf\ndef f(n: Nat) -> Nat decreasing n by lt_wf = f(n, Le.refl)\n"
  assert(match run_wf(bogus)! {
    some(e) => string.contains(e, "mismatch"),
    none => false,
  })
  let not_wf = "room wft uses eq, logic, nat, wf\ndef f(n: Nat) -> Nat decreasing n by Nat.zero = Nat.zero\n"
  assert(match run_wf(not_wf)! {
    some(e) => string.contains(e, "WellFounded"),
    none => false,
  })
}

test "a match on a call splits its value, and inner splits refine later parameters" {
  assert_eq(run_wf("""
room wft uses eq, logic, nat, wf
def is_le(m: Nat, n: Nat) -> Nat = match le_dec(m, n) {
  yes(h) => Nat.succ(Nat.zero),
  no(h) => Nat.zero,
}
theorem zero_le: Eq(Nat, is_le(Nat.zero, Nat.succ(Nat.zero)), Nat.succ(Nat.zero)) = Eq.refl
def pick(m: Nat, h: Lt(Nat.zero, m)) -> Nat = match m {
  zero => absurd(Nat, not_lt_zero(Nat.zero, h)),
  succ(k) => match k {
    zero => Nat.zero,
    succ(j) => j,
  },
}
""")!, none)
}

// ── Structure eta for structures given by symbols ──────────────────

let STRUCT_BASE = """
room st
type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) = | refl: Eq(A, a, a)
symbol N: Type
symbol P: Type
symbol P.mk(x: N, y: N) -> P
symbol P.fst(p: P) -> N
symbol P.snd(p: P) -> N
rule P.fst(P.mk(x, y)) = x  where x: N, y: N
rule P.snd(P.mk(x, y)) = y  where x: N, y: N
symbol P.rec(C: P -> Type, m: (x: N, y: N) -> C(P.mk(x, y)), p: P) -> C(p)
rule P.rec(C, m, P.mk(x, y)) = m(x, y)  where C: P -> Type, m: (x: N, y: N) -> C(P.mk(x, y)), x: N, y: N
"""

let STRUCT_USE = """
theorem rec_on_var(p: P) -> Eq(N, P.rec((q: P) => N, (x: N, y: N) => y, p), P.snd(p)) = Eq.refl
theorem eta(p: P) -> Eq(P, p, P.mk(P.fst(p), P.snd(p))) = Eq.refl
"""

test "a declared structure has eta: its recursor computes on a variable" {
  assert_eq(run(STRUCT_BASE + "\nstructure P = P.mk(P.fst, P.snd)\n" + STRUCT_USE), none)
  assert(rejects_with(STRUCT_BASE + "\n" + STRUCT_USE, "mismatch"))
}

test "a structure declaration is checked against its projections" {
  assert(rejects_with(STRUCT_BASE + "\nstructure P = P.mk(P.snd, P.fst)\n", "does not compute to field"))
  assert(rejects_with(STRUCT_BASE + "\nstructure P = P.mk(P.fst)\n", "must build"))
  assert(rejects_with(STRUCT_BASE + "\nroom other uses st\nstructure P = P.mk(P.fst, P.snd)\n", "symbol of this room"))
}

// ── simp: rewriting with equations ─────────────────────────────────

let SIMP_BASE = """
room simpt uses eq, logic, nat
theorem add_zero'(n: Nat) -> Eq(Nat, add(n, Nat.zero), n) = by induction n simp
theorem add_succ'(m: Nat, n: Nat) -> Eq(Nat, add(m, Nat.succ(n)), Nat.succ(add(m, n))) = by induction m simp
"""

test "simp proves equations by rewriting, with definitions' cases and induction hypotheses" {
  assert_eq(run_wf(SIMP_BASE + "\n" + """
theorem comm(m: Nat, n: Nat) -> Eq(Nat, add(m, n), add(n, m)) = by induction m simp(add_zero', add_succ')
theorem assoc(a: Nat, b: Nat, c: Nat) -> Eq(Nat, add(add(a, b), c), add(a, add(b, c))) = by induction a simp
theorem ordered(a: Nat, b: Nat) -> Eq(Nat, add(add(a, Nat.zero), b), add(b, a)) = by simp(add_zero', comm)
""")!, none)
}

test "simp rejects what it cannot rewrite to the same term" {
  let false_law = SIMP_BASE + "\ntheorem bad(n: Nat) -> Eq(Nat, add(n, Nat.zero), Nat.succ(n)) = by induction n simp\n"
  assert(match run_wf(false_law)! {
    some(e) => string.contains(e, "simp could not prove it"),
    none => false,
  })
  let not_eq = SIMP_BASE + "\ntheorem bad(n: Nat) -> Nat = by simp\n"
  assert(match run_wf(not_eq)! {
    some(e) => string.contains(e, "must be an equation"),
    none => false,
  })
}

// ── Error messages ──────────────────────────────────────────────────

test "an unknown name suggests close spellings or the room that declares it" {
  let base = "room ea\nsymbol Thing: Type\nsymbol thing_a: Thing\nroom eb\nsymbol other: Type\n"
  assert(rejects_with(base + "room ec uses ea\nsymbol x: Thng", "did you mean Thing?"))
  assert(rejects_with(base + "room ec uses ea\nsymbol f(t: Thing) -> Type\nsymbol y: f(thing_b)", "did you mean thing_a?"))
  assert(rejects_with(base + "room ec uses ea\nsymbol x: other", "declared in room eb: add `uses eb`"))
  assert(rejects_with(base + "room ec uses ea\nsymbol x: Zzzzzz", "unknown name Zzzzzz"))
  assert(not rejects_with(base + "room ec uses ea\nsymbol x: Zzzzzz", "did you mean"))
}

test "an open goal says which visible theorem closes it, and nothing for a false one" {
  let open_goal = "room gs uses eq, logic, nat\ntheorem c(m: Nat, n: Nat) -> Eq(Nat, add(m, n), add(n, m)) = ?\n"
  assert(match run_wf(open_goal)! {
    some(e) => string.contains(e, "search closes it: nat.add_comm(m, n)"),
    none => false,
  })
  let false_goal = "room gs uses eq, logic, nat\ntheorem c(m: Nat) -> Eq(Nat, add(m, Nat.zero), Nat.succ(m)) = ?\n"
  assert(match run_wf(false_goal)! {
    some(e) => string.contains(e, "1 open goal") and not string.contains(e, "search closes it"),
    none => false,
  })
}

// ── Quotients ──────────────────────────────────────────────────────

effect fn run_quot(src: String) -> String? = {
  let std = ["lib/std/eq.arlk", "lib/std/logic.arlk", "lib/std/nat.arlk", "lib/quot.arlk"] |> list.map((f) => fs.read_text(f) ?? "")
  match syntax.parse(list.join(std, "\n") + "\n" + src) {
    err(e) => some("parse: " + e),
    ok(ds) => checker.check_all(kernel.empty(), ds).error,
  }
}

let QUOT_BASE = """
room qt uses eq, logic, nat, quot
def Par(m: Nat, n: Nat) -> Sort(0) = Eq(Nat, m, m)
def Q: Type = Quot(Nat, Par)
def is_zero(n: Nat) -> Nat = match n {
  zero => Nat.succ(Nat.zero),
  succ(k) => Nat.zero,
}
"""

test "quotients: lift computes on a class, and funext follows from sound" {
  assert_eq(run_quot(QUOT_BASE + "\n" + """
def const(q: Q) -> Nat = Quot.lift(Nat, Par, Nat, (n: Nat) => Nat.zero, (a: Nat, b: Nat, p: Par(a, b)) => Eq.refl, q)
theorem const_mk: Eq(Nat, const(Quot.mk(Nat, Par, Nat.succ(Nat.zero))), Nat.zero) = Eq.refl
theorem ext: Eq(Nat -> Nat, (n: Nat) => add(n, Nat.zero), (n: Nat) => n) = funext(Nat, (n: Nat) => Nat, (n: Nat) => add(n, Nat.zero), (n: Nat) => n, add_zero)
""")!, none)
}

test "quotients: a function that does not respect the relation cannot be lifted, and lift is stuck on a variable" {
  let unsound = QUOT_BASE + "\ndef bad(q: Q) -> Nat = Quot.lift(Nat, Par, Nat, is_zero, (a: Nat, b: Nat, p: Par(a, b)) => Eq.refl, q)\n"
  assert(match run_quot(unsound)! {
    some(e) => string.contains(e, "mismatch"),
    none => false,
  })
  let stuck = QUOT_BASE + "\ndef const(q: Q) -> Nat = Quot.lift(Nat, Par, Nat, (n: Nat) => Nat.zero, (a: Nat, b: Nat, p: Par(a, b)) => Eq.refl, q)\ntheorem bad(q: Q) -> Eq(Q, q, Quot.mk(Nat, Par, const(q))) = Eq.refl\n"
  assert(match run_quot(stuck)! {
    some(e) => string.contains(e, "mismatch"),
    none => false,
  })
}

// ── Index patterns: unification by cases, absurd arms left out ─────

let IXP = """
room ixp uses eq, logic, nat
type Lte: (m: Nat, n: Nat) -> Sort(0) =
  | z_le(n: Nat): Lte(Nat.zero, n)
  | s_le(m: Nat, n: Nat, h: Lte(m, n)): Lte(Nat.succ(m), Nat.succ(n))
type Vec(A: Type): (n: Nat) -> Type =
  | nil: Vec(A, Nat.zero)
  | cons(n: Nat, x: A, xs: Vec(A, n)): Vec(A, Nat.succ(n))
"""

test "a match whose indices are constructor patterns leaves out the clashing constructors" {
  assert_eq(run_wf(IXP + "\n" + """
theorem le_pred(m: Nat, n: Nat, h: Lte(Nat.succ(m), Nat.succ(n))) -> Lte(m, n) = match h {
  s_le(a, b, p) => p,
}
theorem not_succ_le_zero(m: Nat, h: Lte(Nat.succ(m), Nat.zero)) -> False = match h {
}
def tail(A: Type, n: Nat, v: Vec(A, Nat.succ(n))) -> Vec(A, n) = match v {
  cons(_, x, xs) => xs,
}
def head(A: Type, n: Nat, v: Vec(A, Nat.succ(n))) -> A = match v {
  cons(k, x, xs) => x,
}
theorem head_computes: Eq(Nat, head(Nat, Nat.zero, Vec.cons(Nat.zero, Nat.succ(Nat.zero), Vec.nil)), Nat.succ(Nat.zero)) = Eq.refl
theorem not_succ_le_self(n: Nat, h: Lte(Nat.succ(n), n)) -> False = match n {
  zero => match h {
  },
  succ(k) => not_succ_le_self(k, le_pred(Nat.succ(k), k, h)),
}
""")!, none)
}

test "index patterns: an impossible arm, a wrong body, non-linear and variable-against-constructor indices are rejected" {
  let cases = [
    ("theorem t(m: Nat, h: Lte(Nat.succ(m), Nat.zero)) -> False = match h {\n  z_le(n) => h,\n}\n", "is impossible"),
    ("theorem t(m: Nat, n: Nat, h: Lte(Nat.succ(m), Nat.succ(n))) -> Lte(Nat.succ(m), n) = match h {\n  s_le(a, b, p) => p,\n}\n", "mismatch"),
    ("theorem t(m: Nat, h: Lte(Nat.succ(m), Nat.succ(m))) -> Lte(m, m) = match h {\n  s_le(a, b, p) => p,\n}\n", "non-linear"),
    ("theorem t(m: Nat, n: Nat, h: Lte(m, Nat.succ(n))) -> Lte(m, Nat.succ(n)) = match h {\n  s_le(a, b, p) => h,\n}\n", "cannot be unified by cases"),
    ("theorem t(m: Nat, n: Nat, h: Lte(Nat.succ(m), Nat.succ(n))) -> Lte(m, n) = match h {\n}\n", "no arm for"),
  ]
  for (src, want) in cases {
    assert(match run_wf(IXP + "\n" + src)! {
      some(e) => string.contains(e, want),
      none => false,
    })
  }
}

// ── Coinductive types (codata), defined from paths ─────────────────

let CODATA = """
room cd uses eq, logic, nat
codata Stream(A: Type) = { head: A, tail: Stream(A) }
def from(n: Nat) -> Stream(Nat) = Stream.corec((k: Nat) => k, Nat.succ, n)
"""

test "codata: destructors compute on corecursive values, and the corecursion laws hold by computation" {
  assert_eq(run_wf(CODATA + "\n" + """
theorem second: Eq(Nat, Stream.head(Stream.tail(from(Nat.zero))), Nat.succ(Nat.zero)) = Eq.refl
theorem tail_corec[A: Type, S: Type](h: S -> A, t: S -> S, s: S) -> Eq(Stream(A), Stream.tail(Stream.corec(h, t, s)), Stream.corec(h, t, t(s))) = Eq.refl
codata Tree(A: Type) = { label: A, left: Tree(A), right: Tree(A) }
def t(n: Nat) -> Tree(Nat) = Tree.corec((k: Nat) => k, Nat.succ, (k: Nat) => Nat.succ(Nat.succ(k)), n)
theorem rl: Eq(Nat, Tree.label(Tree.right(Tree.left(t(Nat.zero)))), Nat.succ(Nat.succ(Nat.succ(Nat.zero)))) = Eq.refl
""")!, none)
}

test "codata: a false value, a field that hides the type, and a type that is not coinductive are rejected" {
  let cases = [
    (CODATA + "\ntheorem wrong: Eq(Nat, Stream.head(Stream.tail(from(Nat.zero))), Nat.zero) = Eq.refl\n", "mismatch"),
    ("room cd uses eq, nat\ncodata Bad(A: Type) = { head: A, next: Nat -> Bad(A) }\n", "must be Bad applied to its parameters"),
    ("room cd uses eq, nat\ncodata Flat(A: Type) = { head: A }\n", "not coinductive"),
    ("room cd uses eq, nat\ncodata Ix: (n: Nat) -> Type = { here: Nat, next: Ix }\n", "indices are not supported"),
  ]
  for (src, want) in cases {
    assert(match run_wf(src)! {
      some(e) => string.contains(e, want),
      none => false,
    })
  }
}
