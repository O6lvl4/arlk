// The kernel must accept good proofs and, more importantly, reject bad ones.
import self.syntax
import self.kernel
import self.checker

let PRELUDE = """
  room logic
  symbol Prop: Type
  symbol Prf(p: Prop) -> Type
  symbol imp(a: Prop, b: Prop) -> Prop
  rule Prf(imp(a, b)) = Prf(a) -> Prf(b)  where a: Prop, b: Prop
  """

// none = accepted; some(msg) = rejected with msg.
fn run(src: String) -> String? = match syntax.parse(PRELUDE + "\n" + src) {
  err(e) => some("parse: " + e),
  ok(ds) => checker.check_all(kernel.empty(), ds).error,
}

fn accepts(src: String) -> Bool = run(src) == none

fn rejects_with(src: String, needle: String) -> Bool = match run(src) {
  some(e) => string.contains(e, needle),
  none => false,
}

test "a correct proof is accepted" {
  assert(accepts("theorem k(a: Prop, b: Prop) -> Prf(imp(a, imp(b, a))) = (x: Prf(a), y: Prf(b)) => x"))
}

test "returning the wrong hypothesis is rejected" {
  assert(rejects_with(
    "theorem k(a: Prop, b: Prop) -> Prf(imp(a, imp(b, a))) = (x: Prf(a), y: Prf(b)) => y",
    "type mismatch",
  ))
}

test "a proof of a different proposition is rejected" {
  assert(rejects_with(
    "theorem bad(a: Prop, b: Prop) -> Prf(imp(a, b)) = (x: Prf(a)) => x",
    "type mismatch",
  ))
}

test "Type is not a Type" {
  assert(rejects_with("def t: Type = Type", "type mismatch"))
}

test "inner binders shadow outer ones" {
  assert(accepts("symbol A: Type\nsymbol B: Type\ndef f: (A, B) -> B = (x: A, x: B) => x"))
  assert(rejects_with(
    "symbol A: Type\nsymbol B: Type\ndef f: (A, B) -> A = (x: A, x: B) => x",
    "type mismatch",
  ))
}

test "dependent application substitutes the argument into the result type" {
  assert(accepts("""
    symbol a: Prop
    symbol refl_imp(p: Prop) -> Prf(imp(p, p))
    def r: Prf(imp(a, a)) = refl_imp(a)
    """))
}

test "defs unfold during conversion but theorems stay opaque" {
  assert(accepts("""
    symbol a: Prop
    def p: Prop = a
    def q: Prf(p) -> Prf(a) = (h: Prf(p)) => h
    """))
  assert(rejects_with(
    """
    symbol a: Prop
    symbol pa: Prf(a)
    theorem p: Prop = a
    def q: Prf(p) -> Prf(a) = (h: Prf(p)) => h
    """,
    "type mismatch",
  ))
}

test "a rule must preserve types" {
  assert(rejects_with(
    """
    symbol f(p: Prop) -> Prop
    rule f(x) = Prf(x)  where x: Prop
    """,
    "rule does not preserve types",
  ))
}

test "a rule can only extend a symbol of the current room" {
  assert(rejects_with(
    """
    room other uses logic
    symbol a: Prop
    rule Prf(imp(x, x)) = Prf(a)  where x: Prop
    """,
    "rules can only be added to symbols of the current room",
  ))
}

test "rules cannot be attached to defs or theorems" {
  assert(rejects_with(
    """
    symbol a: Prop
    def d(p: Prop) -> Prop = p
    rule d(x) = a  where x: Prop
    """,
    "only symbols can have rules",
  ))
}

test "non-linear and unbound pattern variables are rejected" {
  assert(rejects_with("symbol f(p: Prop, q: Prop) -> Prop\nrule f(x, x) = x  where x: Prop", "only once"))
  assert(rejects_with(
    "symbol f(p: Prop) -> Prop\nsymbol a: Prop\nrule f(x) = a  where x: Prop, y: Prop",
    "must appear",
  ))
}

test "rooms are sealed once left" {
  assert(rejects_with("room other uses logic\nroom logic", "sealed"))
}

test "a room only sees the rooms it uses" {
  assert(rejects_with("room island\nsymbol x: logic.Prop", "does not use"))
  assert(rejects_with("room island\nsymbol x: Prop", "unknown name Prop"))
  assert(accepts("room shore uses logic\nsymbol x: Prop"))
}

test "visibility is transitive through uses" {
  assert(accepts("room mid uses logic\nroom top uses mid\nsymbol x: Prop"))
}

test "duplicate declarations are rejected" {
  assert(rejects_with("symbol Prop: Type", "already declared"))
}

test "rewriting computes inside the kernel" {
  assert(accepts("""
    room nat uses logic
    symbol Nat: Type
    symbol z: Nat
    symbol s(n: Nat) -> Nat
    symbol add(m: Nat, n: Nat) -> Nat
    rule add(z, n) = n  where n: Nat
    rule add(s(m), n) = s(add(m, n))  where m: Nat, n: Nat
    symbol eq(m: Nat, n: Nat) -> Prop
    symbol refl(n: Nat) -> Prf(eq(n, n))
    theorem t: Prf(eq(add(s(z), s(z)), s(s(z)))) = refl(s(s(z)))
    """))
  assert(rejects_with(
    """
    room nat uses logic
    symbol Nat: Type
    symbol z: Nat
    symbol s(n: Nat) -> Nat
    symbol eq(m: Nat, n: Nat) -> Prop
    symbol refl(n: Nat) -> Prf(eq(n, n))
    theorem t: Prf(eq(s(z), z)) = refl(z)
    """,
    "type mismatch",
  ))
}

test "eta: a function equals its own expansion" {
  assert(accepts("""
    symbol f(p: Prop) -> Prop
    symbol P(g: Prop -> Prop) -> Prop
    symbol pf: Prf(P(f))
    def g: Prf(P((x: Prop) => f(x))) = pf
    """))
}

test "axioms reports only what a theorem actually uses" {
  let src = PRELUDE + "\n" + """
    room classical uses logic
    symbol bot: Prop
    symbol em(p: Prop) -> Prf(p)
    theorem plain(a: Prop) -> Prf(imp(a, a)) = (h: Prf(a)) => h
    theorem uses_em(a: Prop) -> Prf(a) = em(a)
    """
  match syntax.parse(src) {
    ok(ds) => {
      let out = checker.check_all(kernel.empty(), ds)
      assert_eq(out.error, none)
      let plain = checker.deps(out.env, "classical.plain")
      assert(not list.contains(plain.symbols, "classical.em"))
      let used = checker.deps(out.env, "classical.uses_em")
      assert(list.contains(used.symbols, "classical.em"))
    },
    err(e) => assert_eq(e, ""),
  }
}

test "a bracket matches by conversion, so a variable can be repeated" {
  assert(accepts("""
    room nat uses logic
    symbol Nat: Type
    symbol z: Nat
    symbol s(n: Nat) -> Nat
    symbol Vec(n: Nat) -> Type
    symbol vnil: Vec(z)
    symbol vcons(n: Nat, x: Nat, v: Vec(n)) -> Vec(s(n))
    symbol tail(n: Nat, v: Vec(s(n))) -> Vec(n)
    rule tail({n}, vcons(n, x, v)) = v  where n: Nat, x: Nat, v: Vec(n)
    symbol eqv(n: Nat, v: Vec(n), w: Vec(n)) -> Prop
    symbol reflv(n: Nat, v: Vec(n)) -> Prf(eqv(n, v, v))
    theorem t: Prf(eqv(z, tail(z, vcons(z, z, vnil)), vnil)) = reflv(z, vnil)
    """))
}

test "without the bracket the same rule does not type-check" {
  assert(rejects_with("""
    room nat uses logic
    symbol Nat: Type
    symbol s(n: Nat) -> Nat
    symbol Vec(n: Nat) -> Type
    symbol vcons(n: Nat, x: Nat, v: Vec(n)) -> Vec(s(n))
    symbol tail(n: Nat, v: Vec(s(n))) -> Vec(n)
    rule tail(m, vcons(n, x, v)) = v  where m: Nat, n: Nat, x: Nat, v: Vec(n)
    """, "type mismatch"))
}

test "brackets are only allowed in rule patterns" {
  assert(rejects_with("symbol a: Prop\ndef b: Prop = {a}", "only allowed in the left-hand side"))
  assert(rejects_with("symbol f(p: Prop) -> Prop\nsymbol a: Prop\nrule f(x) = {a}  where x: Prop", "only allowed in the left-hand side"))
}

test "a bracket cannot mention a variable the pattern leaves unbound" {
  assert(rejects_with("symbol f(p: Prop, q: Prop) -> Prop\nrule f(x, {y}) = x  where x: Prop, y: Prop", "must appear"))
}

test "names inside a room may contain dots" {
  assert(accepts("""
    room nat uses logic
    symbol Nat: Type
    symbol Nat.zero: Nat
    def Nat.one@0: Nat = Nat.zero
    def two: Nat = nat.Nat.one@0
    """))
}

test "irrelevant: two proofs of the same proposition are equal" {
  let without = """
    symbol a: Prop
    symbol h1: Prf(a)
    symbol h2: Prf(a)
    symbol P(h: Prf(a)) -> Prop
    symbol ph1: Prf(P(h1))
    def q: Prf(P(h2)) = ph1
    """
  assert(rejects_with(without, "type mismatch"))
  assert(accepts("irrelevant Prf(a)  where a: Prop\n" + without))
}

test "irrelevant only applies to the declared types" {
  assert(rejects_with("""
    room p uses logic
    symbol N: Type
    symbol a: N
    symbol b: N
    symbol P(n: N) -> Prop
    symbol pa: Prf(P(a))
    def q: Prf(P(b)) = pa
    """, "type mismatch"))
}

test "an irrelevant declaration may only target symbols of its own room" {
  assert(rejects_with("room p uses logic\nirrelevant Prf(a)  where a: Prop", "rules can only be added to symbols of the current room"))
}

test "functions into an irrelevant type are irrelevant too" {
  assert(accepts("""
    irrelevant Prf(a)  where a: Prop
    symbol a: Prop
    symbol b: Prop
    symbol f: Prf(imp(a, b))
    symbol g: Prf(imp(a, b))
    symbol P(h: Prf(imp(a, b))) -> Prop
    symbol pf: Prf(P(f))
    def q: Prf(P(g)) = pf
    """))
}

test "the Almide-style surface: calls, lambdas and arrows" {
  assert(accepts("""
    symbol a: Prop
    def twice(f: Prop -> Prop, x: Prop) -> Prop = f(f(x))
    def same: Prop -> Prop = (p: Prop) => twice((q: Prop) => q, p)
    theorem self_imp: Prf(imp(a, a)) = (h: Prf(a)) => h
    """))
}

// Issue #1: a looping rule must end in an explicit out-of-budget error,
// both when comparing types and when normalising.
let LOOP = """
  room loop
  symbol A: Type
  symbol z: A
  symbol g(x: A) -> A
  symbol f(x: A) -> A
  rule f(x) = g(f(x))  where x: A
  symbol P(x: A) -> Type
  symbol p: P(f(z))
  """

test "a looping rule runs out of budget instead of running forever" {
  assert(rejects_with(LOOP + "theorem stuck: P(f(g(z))) = p", "out of budget"))
  assert(rejects_with(LOOP + "eval f(z)", "out of budget"))
}

test "terminating rules and reflexive conversion still work next to a loop" {
  assert(accepts(LOOP + "theorem same: P(f(z)) = p"))
}

// Issue #2: a dotted declaration in room `a` must not leak into room `a.b`.
test "a dotted name cannot reach a room that is not used" {
  assert(rejects_with("room a\nsymbol b.T: Type\nroom a.b\nsymbol x: T", "does not use"))
  assert(accepts("room a\nsymbol b.T: Type\nroom a.b uses a\nsymbol x: T"))
  assert(accepts("room n uses logic\nsymbol Nat: Type\nsymbol Nat.add(m: Nat, k: Nat) -> Nat\nsymbol two: Nat\ndef four: Nat = Nat.add(two, two)"))
}

// Issue #3: a rule's {bracket} is compared in the context of the term
// being reduced, so proof irrelevance applies to bound variables.
let BRACKET = """
  room r
  symbol Prop: Type
  symbol Prf(q: Prop) -> Type
  symbol p: Prop
  IRRELEVANT
  symbol N: Type
  symbol z: N
  symbol f(h1: Prf(p), h2: Prf(p)) -> N
  rule f(h, {h}) = z  where h: Prf(p)
  symbol Pred(n: N) -> Type
  symbol pz: Pred(z)
  """

fn bracket(irrelevant: Bool, rest: String) -> String =
  string.replace(BRACKET, "IRRELEVANT", if irrelevant then "irrelevant Prf(q)  where q: Prop" else "") + rest

test "brackets see the binders of the term they match" {
  assert(accepts(bracket(true, "theorem t(h1: Prf(p), h2: Prf(p)) -> Pred(f(h1, h2)) = pz")))
  assert(accepts(bracket(true, "theorem t(h1: Prf(p)) -> Pred(f(h1, h1)) = pz")))
  assert(accepts(bracket(true, "symbol c1: Prf(p)\nsymbol c2: Prf(p)\ntheorem t: Pred(f(c1, c2)) = pz")))
  assert(rejects_with(bracket(false, "theorem t(h1: Prf(p), h2: Prf(p)) -> Pred(f(h1, h2)) = pz"), "type mismatch"))
}

// ── Inductive types ─────────────────────────────────────────────────

let NAT = """
  room data
  type Nat: Type =
    | zero
    | succ(n: Nat)
  """

test "an inductive type gets a recursor that computes" {
  assert(accepts(NAT + """
    type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
      | refl: Eq[u](A, a, a)
    def add(m: Nat, n: Nat) -> Nat = Nat.rec[1]((k: Nat) => Nat, m, (k: Nat, r: Nat) => Nat.succ(r), n)
    theorem two: Eq[1](Nat, add(Nat.succ(Nat.zero), Nat.succ(Nat.zero)), Nat.succ(Nat.succ(Nat.zero))) =
      Eq.refl
    """))
  assert(rejects_with(NAT + """
    type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
      | refl: Eq[u](A, a, a)
    theorem wrong: Eq[1](Nat, Nat.zero, Nat.succ(Nat.zero)) = Eq.refl
    """, "type mismatch"))
}

test "a type in a negative position is rejected, and leaves nothing behind" {
  assert(rejects_with(NAT + "type Bad: Type = | mk(f: Bad -> Nat)", "negative position"))
  assert(rejects_with(NAT + "type Bad: Type = | mk(f: (Bad -> Nat) -> Nat)", "negative position"))
  // Nothing of a rejected type stays declared, so a later file can reuse its names.
  match syntax.parse(NAT + "type Bad: Type = | mk(f: Bad -> Nat)") {
    ok(ds) => {
      var env = kernel.empty()
      for d in ds {
        match checker.process(env, d) {
          _ => (),
        }
      }
      assert(kernel.resolve_const(env, "Nat") == ok("data.Nat"))
      assert(kernel.resolve_const(env, "Bad") != ok("data.Bad"))
      assert(kernel.resolve_const(env, "Bad.mk") != ok("data.Bad.mk"))
    },
    err(e) => assert_eq(e, ""),
  }
}

test "constructor arguments must fit the type's universe" {
  assert(rejects_with(NAT + "type Big: Type = | mk(A: Type)", "too large"))
  assert(accepts(NAT + "type Big: Type(1) = | mk(A: Type)"))
  // Propositions may quantify over anything (impredicativity).
  assert(accepts(NAT + "type Any: Sort(0) = | mk(A: Type(3))"))
}

test "constructors build the type itself at its own parameters" {
  assert(rejects_with(NAT + "type T: Type = | mk: Nat", "must build T"))
  assert(rejects_with(NAT + "type L(A: Type): Type = | mk(x: L(Nat))", "own parameters"))
}

test "propositions eliminate into Type only when they are subsingletons" {
  let base = NAT + """
    type Or(a: Sort(0), b: Sort(0)): Sort(0) =
      | inl(h: a)
      | inr(h: b)
    type And(a: Sort(0), b: Sort(0)): Sort(0) =
      | intro(l: a, r: b)
    """
  // And may compute a Nat from a proof; Or may not (it would reveal which side holds).
  assert(accepts(base + "def f(a: Sort(0), b: Sort(0), h: And(a, b)) -> Nat = And.rec((x: And(a, b)) => Nat, (l: a, r: b) => Nat.zero, h)"))
  // Or's recursor has no universe parameter: its motive must land in Prop.
  assert(rejects_with(base + "def f(a: Sort(0), b: Sort(0), h: Or(a, b)) -> Nat = Or.rec[1]((x: Or(a, b)) => Nat, (l: a) => Nat.zero, (r: b) => Nat.zero, h)", "universe levels"))
  assert(rejects_with(base + "def f(a: Sort(0), b: Sort(0), h: Or(a, b)) -> Nat = Or.rec((x: Or(a, b)) => Nat, (l: a) => Nat.zero, (r: b) => Nat.zero, h)", "mismatch"))
}

// ── Elaboration: implicit arguments, inferred levels, holes ─────────

let LISTS = NAT + """
  type List[u](A: Type(u)): Type(u) =
    | nil
    | cons(head: A, tail: List(A))
  type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
    | refl: Eq(A, a, a)
  def length[u, A: Type(u)](xs: List(A)) -> Nat =
    List.rec((l: List(A)) => Nat, Nat.zero, (h: A, t: List(A), r: Nat) => Nat.succ(r), xs)
  def id[u, A: Sort(u)](x: A) -> A = x
  def two: Nat = Nat.succ(Nat.succ(Nat.zero))
  def xs: List(Nat) = List.cons(Nat.zero, List.cons(two, List.nil))
  """

test "implicit arguments and universe levels are inferred" {
  assert(accepts(LISTS + "theorem len: Eq(Nat, length(xs), two) = Eq.refl"))
  assert(accepts(LISTS + "theorem len: Eq(_, length(xs), id(two)) = Eq.refl"))
  assert(accepts(LISTS + "def t: Type = id(Nat)"))
}

test "inference never makes a false statement true" {
  assert(rejects_with(LISTS + "theorem bad: Eq(_, length(xs), Nat.zero) = Eq.refl", "type mismatch"))
  assert(rejects_with(LISTS + "def bad: List(Nat) = List.cons(Nat.zero, List.cons(Type, List.nil))", "expected"))
}

test "what cannot be inferred is reported, not guessed" {
  assert(rejects_with(LISTS + "def e: Nat = length(List.nil)", "cannot infer"))
}

// ── Pattern matching ────────────────────────────────────────────────

let ADD = NAT + """
  type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
    | refl: Eq(A, a, a)
  def add(m: Nat, n: Nat) -> Nat = match n {
    zero => m,
    succ(k) => Nat.succ(add(m, k)),
  }
  def cong[u, v, A: Sort(u), B: Sort(v)](f: A -> B, x: A, y: A, h: Eq(A, x, y)) -> Eq(B, f(x), f(y)) =
    Eq.rec((y': A, e: Eq(A, x, y')) => Eq(B, f(x), f(y')), Eq.refl, y, h)
  """

test "a match compiles to the recursor, and computes" {
  assert(accepts(ADD + "theorem two: Eq(Nat, add(Nat.succ(Nat.zero), Nat.succ(Nat.zero)), Nat.succ(Nat.succ(Nat.zero))) = Eq.refl"))
}

test "a theorem proved by a match is a proof by induction" {
  assert(accepts(ADD + """
    theorem zero_add(n: Nat) -> Eq(Nat, add(Nat.zero, n), n) = match n {
      zero => Eq.refl,
      succ(k) => cong(Nat.succ, add(Nat.zero, k), k, zero_add(k)),
    }
    """))
  // The induction hypothesis is for k, not for anything: a wrong step fails.
  assert(rejects_with(ADD + """
    theorem bad(n: Nat) -> Eq(Nat, add(Nat.zero, n), Nat.zero) = match n {
      zero => Eq.refl,
      succ(k) => bad(k),
    }
    """, "mismatch"))
}

test "only structural recursion is accepted" {
  assert(rejects_with(NAT + "def loop(n: Nat) -> Nat = match n {\n  zero => Nat.zero,\n  succ(k) => loop(Nat.succ(k)),\n}", "structural recursion"))
  assert(rejects_with(NAT + "def loop(n: Nat) -> Nat = match n {\n  zero => loop(n),\n  succ(k) => k,\n}", "structural recursion"))
}

test "every constructor needs an arm, each at most one" {
  assert(rejects_with(NAT + "def f(n: Nat) -> Nat = match n {\n  zero => n,\n}", "no arm for"))
  assert(rejects_with(NAT + "def f(n: Nat) -> Nat = match n {\n  zero => n,\n  zero => n,\n  succ(k) => k,\n}", "two arms"))
  assert(accepts(NAT + "def pred(n: Nat) -> Nat = match n {\n  succ(k) => k,\n  _ => Nat.zero,\n}"))
}

// ── Records ─────────────────────────────────────────────────────────

let RECORDS = NAT + """
  type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
    | refl: Eq(A, a, a)
  type Point = { x: Nat, y: Nat }
  def swap(p: Point) -> Point = Point { x: p.y, y: p.x }
  def p1: Point = Point { y: Nat.succ(Nat.zero), x: Nat.zero }
  type Sigma[u, v](A: Type(u), B: A -> Type(v)): Type(max(u, v)) = { fst: A, snd: B(fst) }
  """

test "records: values, fields, and projections that compute" {
  assert(accepts(RECORDS + "theorem sx: Eq(Nat, swap(p1).x, Nat.succ(Nat.zero)) = Eq.refl"))
  assert(rejects_with(RECORDS + "theorem sx: Eq(Nat, swap(p1).x, Nat.zero) = Eq.refl", "mismatch"))
  assert(rejects_with(RECORDS + "def q: Point = Point { x: Nat.zero }", "every field"))
  assert(rejects_with(RECORDS + "def q: Point = Point { x: Nat.zero, y: Nat.zero, z: Nat.zero }", "no field z"))
}

test "records: a field's type may depend on earlier fields" {
  assert(accepts(RECORDS + """
    type Vec(n: Nat): Type = | mkv
    def second(s: Sigma(Nat, (n: Nat) => Vec(n))) -> Vec(s.fst) = s.snd
    def sized: Sigma(Nat, (n: Nat) => Vec(n)) = Sigma { fst: Nat.zero, snd: Vec.mkv }
    """))
}

// Issue #6: a `_` arm also covers constructors with fields.
test "a wildcard arm covers constructors with fields, without capturing names" {
  assert(accepts(NAT + "def constant(n: Nat) -> Nat = match n {\n  zero => Nat.zero,\n  _ => Nat.zero,\n}"))
  assert(accepts(NAT + "def all(n: Nat) -> Nat = match n {\n  _ => n,\n}"))
  // Several fields, one of them recursive; the body uses `_1`, which the
  // generated field names must not capture.
  assert(accepts(NAT + """
    type Tree: Type =
      | leaf
      | node(l: Tree, x: Nat, r: Tree)
    def _1: Nat = Nat.succ(Nat.zero)
    def shape(t: Tree) -> Nat = match t {
      leaf => Nat.zero,
      _ => _1,
    }
    type Eq[u](A: Sort(u), a: A): (b: A) -> Sort(0) =
      | refl: Eq(A, a, a)
    theorem one: Eq(Nat, shape(Tree.node(Tree.leaf, Nat.zero, Tree.leaf)), Nat.succ(Nat.zero)) = Eq.refl
    """))
  // Explicit arms still need the right number of names.
  assert(rejects_with(NAT + "def f(n: Nat) -> Nat = match n {\n  zero => n,\n  succ => n,\n}", "takes 1 arguments"))
}

// Issue #7: matching a rule reduces arguments, which may match rules again.
test "a cycle through rule matching runs out of budget instead of the stack" {
  let src = """
    room nested
    symbol A: Type
    symbol z: A
    symbol f(x: A) -> A
    symbol g(x: A) -> A
    rule f(g(x)) = x  where x: A
    rule g(x) = f(g(x))  where x: A
    """
  assert(rejects_with(src + "\neval f(g(z))", "out of budget"))
  assert(rejects_with(src + "\nsymbol P(x: A) -> Type\nsymbol p: P(z)\ntheorem t: P(f(g(z))) = p", "out of budget"))
}
